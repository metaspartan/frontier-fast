#!/usr/bin/env bash
# Compatibility shim for the frontier.fast rebrand.
#
# Agents are mid-campaign with `gainzfast ...` in their notes, their shell
# history and their own generated scripts. Renaming the command out from under a
# running submission would be a self-inflicted outage for no benefit, so the old
# name keeps working and says once, on stderr, what it is now called. stderr so
# it never contaminates a command whose stdout is being parsed.
set -euo pipefail
echo "note: 'gainzfast' is now 'frontierfast' — this alias still works and will keep working." >&2
exec "$(dirname "$0")/frontierfast" "$@"
