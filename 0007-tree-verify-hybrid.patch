+    const auto kv_head  = mctx_cur->get_head();
+    const auto mem_size = mctx_cur->get_size();
+
+    const int64_t n_seqs   = ubatch.n_seqs;
+    const int64_t n_tokens = ubatch.n_tokens;
+    const int64_t d_conv   = conv_kernel_size;
+
+    GGML_ASSERT(n_seqs == 1);
+    GGML_ASSERT(inp->tree_cidx != nullptr);
+    GGML_ASSERT(inp->tree_cidx->ne[0] == d_conv * n_tokens);
+    GGML_ASSERT((int64_t) cparams.n_rs_seq + 1 >= n_tokens);
+
+    // gathered previous conv state: one row of [d_conv-1, channels], tap-major
+    ggml_tensor * conv_states = build_rs(inp, conv_states_all, hparams.n_embd_r(), n_seqs);
+    conv_states = ggml_reshape_2d(ctx0, conv_states, d_conv - 1, conv_channels);
+    cb(conv_states, "tree_conv_states", il);
+
+    // prompt taps as channel-major rows: [channels, d_conv-1], oldest tap first
+    ggml_tensor * taps = ggml_cont(ctx0, ggml_transpose(ctx0, conv_states));
+    cb(taps, "tree_conv_taps", il);
+
+    // token inputs are already channel-major rows: [channels, n_tokens]
+    ggml_tensor * toks = ggml_reshape_2d(ctx0, qkv_mixed, conv_channels, n_tokens);
+
+    // V rows: [taps ++ tokens] -> [channels, d_conv-1 + n_tokens]
+    ggml_tensor * V = ggml_concat(ctx0, taps, toks, 1);
+    cb(V, "tree_conv_src", il);
+
+    // gather each token's window along its ancestor path:
+    // W[:, t*d_conv + j] = window entry j of token t (j = 0 oldest, d_conv-1 self)
+    ggml_tensor * W = ggml_get_rows(ctx0, V, inp->tree_cidx);
+    W = ggml_reshape_3d(ctx0, W, conv_channels, d_conv, n_tokens);
+    cb(W, "tree_conv_windows", il);
+
+    // conv: out[c, t] = sum_j W[c, j, t] * kernel[j, c]
+    ggml_tensor * Wp = ggml_cont(ctx0, ggml_permute(ctx0, W, 1, 0, 2, 3)); // [d_conv, channels, n_tokens]
+    ggml_tensor * prod = ggml_mul(ctx0, Wp, conv_kernel);                  // kernel [d_conv, channels] bcast over tokens
+    ggml_tensor * out  = ggml_sum_rows(ctx0, prod);                        // [1, channels, n_tokens]
+    out = ggml_reshape_3d(ctx0, out, conv_channels, n_tokens, 1);
+    cb(out, "tree_conv_out", il);
+
+    // write each token's post-window (entries 1..d_conv-1) into snapshot slot t,
+    // tap-major, mirroring the ssm state's slot-t-per-token mapping
+    const int64_t row_count = (d_conv - 1) * conv_channels;
+    const size_t  row_size  = ggml_row_size(conv_states_all->type, row_count);
+
+    for (int64_t t = 0; t < n_tokens; ++t) {
+        ggml_tensor * win_t = ggml_view_2d(ctx0, W, conv_channels, d_conv - 1,
+                W->nb[1], W->nb[1] + t*W->nb[2]);          // [channels, d_conv-1], entries 1..d_conv-1
+        ggml_tensor * win_tt = ggml_transpose(ctx0, win_t); // [d_conv-1, channels]
+
+        ggml_tensor * dst_t = ggml_view_2d(ctx0, conv_states_all,
+                d_conv - 1, conv_channels,
