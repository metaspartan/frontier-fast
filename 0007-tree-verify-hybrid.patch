+bool llm_graph_ubatch_is_tree(const llama_ubatch & ubatch) {
+    if (ubatch.n_seqs != 1 || ubatch.n_seq_tokens < 2) {
+        return false;
+    }
+
+    // a TREE needs both coupled seq sets AND an actual branch (repeated position).
+    // A chain-shaped "tree" (every node a single child) is processed by the plain
+    // chain path so that it stays bit-identical with ordinary chain verification.
+    bool coupled  = false;
+    bool branched = false;
+
+    for (uint32_t i = 0; i < ubatch.n_tokens; ++i) {
+        coupled |= ubatch.n_seq_id[i] > 1;
+        // positions are nondecreasing in these batches, so equal positions are adjacent
+        branched |= i > 0 && ubatch.pos[i] == ubatch.pos[i - 1];
+    }
+
+    return coupled && branched;
+}
+
+// recover the tree topology of a split_tree() ubatch from its seq sets:
+// parent[i] = the latest earlier token at pos[i]-1 whose seq set covers token i's.
+// split_tree() guarantees existence and laminarity, so this is well-defined.
+static void llm_graph_tree_parents(const llama_ubatch & ubatch, std::vector<int32_t> & parent) {
+    const int32_t n = (int32_t) ubatch.n_tokens;
+
+    parent.assign(n, -1);
+
+    auto covers = [&](int32_t j, int32_t i) {
+        for (int32_t a = 0; a < ubatch.n_seq_id[i]; ++a) {
+            bool found = false;
+            for (int32_t b = 0; b < ubatch.n_seq_id[j]; ++b) {
+                if (ubatch.seq_id[j][b] == ubatch.seq_id[i][a]) {
+                    found = true;
+                    break;
+                }
+            }
+            if (!found) {
+                return false;
+            }
+        }
+        return true;
+    };
+
+    for (int32_t i = 1; i < n; ++i) {
+        for (int32_t j = i - 1; j >= 0; --j) {
+            if (ubatch.pos[j] == ubatch.pos[i] - 1 && covers(j, i)) {
+                parent[i] = j;
+                break;
+            }
+        }
+    }
+}
+
+// fill the tree-verify input tensors (parent indices + conv window rows)
+static void llm_graph_input_rs_set_tree(llm_graph_input_rs * inp, const llama_ubatch * ubatch) {
+    if (inp->tree_src == nullptr) {
+        return;
+    }
+
+    GGML_ASSERT(llm_graph_ubatch_is_tree(*ubatch));
+
+    const int32_t n = (int32_t) ubatch->n_tokens;
+    GGML_ASSERT(inp->tree_src->ne[0] == n);
+
+    std::vector<int32_t> parent;
+    llm_graph_tree_parents(*ubatch, parent);
+
+    GGML_ASSERT(ggml_backend_buffer_is_host(inp->tree_src->buffer));
+    int32_t * ts = (int32_t *) inp->tree_src->data;
+    for (int32_t i = 0; i < n; ++i) {
+        ts[i] = parent[i];
+    }
+
+    if (inp->tree_cidx != nullptr) {
+        GGML_ASSERT(ggml_backend_buffer_is_host(inp->tree_cidx->buffer));
+        const int32_t d_conv = (int32_t) (inp->tree_cidx->ne[0] / n);
+        int32_t * ci = (int32_t *) inp->tree_cidx->data;
+
+        // rows of the gathered conv source: rows 0..d_conv-2 are the prompt taps
+        // (oldest first), row d_conv-1+t is token t. Window entry j of token t is
+        // the input m = d_conv-1-j steps back along t's ancestor path; walking
+        // past the root steps into the prompt taps (a = -1 is the newest tap).
+        for (int32_t t = 0; t < n; ++t) {
+            for (int32_t j = 0; j < d_conv; ++j) {
+                const int32_t m = d_conv - 1 - j;
+
+                int32_t a = t;
+                for (int32_t s = 0; s < m; ++s) {
+                    a = a >= 0 ? parent[a] : a - 1;
+                }
+
+                ci[t*d_conv + j] = d_conv - 1 + a;
+            }
+        }
+    }
+}
