+llama_ubatch llama_batch_allocr::split_tree(uint32_t n_ubatch) {
+    // only meaningful on a fresh split of a batch that has coupled sequences
+    // (a speculative tree couples every ancestor to its descendants' leaf ids;
+    // a plain chain or prefill batch never produces multi-seq tokens here)
+    if (n_used > 0 || !has_cpl) {
+        return {};
+    }
+
+    const uint32_t n_tokens = get_n_tokens();
+
+    if (n_tokens < 2 || n_tokens > n_ubatch) {
+        return {};
+    }
+
+    // token 0 must be the tree's root: its sequence set contains every other
+    // token's set, and every other token sits at a strictly later position
+    if (batch.n_seq_id[0] < 2) {
+        return {};
+    }
+
+    for (uint32_t i = 1; i < n_tokens; ++i) {
+        if ((seq_set[0] & seq_set[i]) != seq_set[i]) {
+            return {};
+        }
+        if (batch.pos[i] < batch.pos[0] + 1) {
+            return {};
+        }
+    }
+
+    // the non-root sets must form a laminar family: pairwise nested or disjoint.
+    // This is what makes "parent = latest earlier token at pos-1 whose set covers
+    // mine" well-defined, which is how the graph recovers the tree topology.
+    for (uint32_t i = 1; i < n_tokens; ++i) {
+        for (uint32_t j = i + 1; j < n_tokens; ++j) {
+            const auto isect = seq_set[i] & seq_set[j];
+            if (isect.none()) {
+                continue;
+            }
+            if (isect != seq_set[i] && isect != seq_set[j]) {
+                return {};
+            }
+        }
+    }
+
+    // every non-root token needs a parent: a token at pos-1 whose set covers its set
+    for (uint32_t i = 1; i < n_tokens; ++i) {
+        bool found = false;
+        for (int32_t j = (int32_t) i - 1; j >= 0; --j) {
+            if (batch.pos[j] == batch.pos[i] - 1 && (seq_set[j] & seq_set[i]) == seq_set[i]) {
+                found = true;
+                break;
+            }
+        }
+        if (!found) {
+            return {};
+        }
+    }
+
+    std::vector<int32_t> idxs;
+    idxs.reserve(n_tokens);
+
+    for (uint32_t i = 0; i < n_tokens; ++i) {
+        idxs.push_back(i);
+
+        used[i] = true;
+        ++n_used;
+    }
+
+    // one lane: the recurrent memory sees a single sequence owning the whole tree
+    return ubatch_add(idxs, 1, true);
+}
