+    def fuse_qkvg_weights(self) -> None:
+        """Concatenate the qkv_proj and g_proj weights into one matrix.
+
+        Both projections are unquantized linears over the SAME
+        ``hidden_states`` (Laguna's NVFP4 recipe exempts every attention
+        projection), so one GEMM over the row-concatenated weight computes
+        exactly the same set of output elements as the two separate GEMMs.
+        Row-concatenating ``[num_out, K]`` weights preserves each output
+        row's memory layout and K-reduction chain bit for bit -- rows are
+        merely dispatched from one launch grid instead of two.  At serial
+        decode (M=1) the separate ``g_proj`` GEMV is launch-wave-bound
+        (its N is 48/72), so folding it into the qkv launch removes an
+        essentially fixed ~0.05-0.06 ms per layer per step on GB10.
+
+        The originals' storage is released by rebinding their parameters
+        to views of the fused buffer, keeping weight memory flat.  The
+        fused row count is padded to a multiple of 16; padding rows are
+        zero, their outputs are sliced off and never read.
+        """
+        if self.g_proj is None or self._qkvg_fused_weight is not None:
+            return
+        wq = self.qkv_proj.weight
+        wg = self.g_proj.weight
+        if (
+            wq.dtype != wg.dtype
+            or wq.device != wg.device
+            or wq.dim() != 2
+            or wg.dim() != 2
+            or wq.shape[1] != wg.shape[1]
+            or not wq.is_contiguous()
+            or not wg.is_contiguous()
+            or getattr(self.qkv_proj, "bias", None) is not None
+            or getattr(self.g_proj, "bias", None) is not None
+        ):
+            return
+        n_qkv, n_g = wq.shape[0], wg.shape[0]
+        pad = -(n_qkv + n_g) % 16
+        fused = torch.empty(
+            n_qkv + n_g + pad, wq.shape[1], dtype=wq.dtype, device=wq.device
+        )
+        fused[:n_qkv].copy_(wq.data)
+        fused[n_qkv : n_qkv + n_g].copy_(wg.data)
+        if pad:
+            fused[n_qkv + n_g :].zero_()
+        self.qkv_proj.weight.data = fused[:n_qkv]
+        self.g_proj.weight.data = fused[n_qkv : n_qkv + n_g]
+        self._qkvg_split = (n_qkv, n_g)
+        self._qkvg_fused_weight = fused
+
