                 if (!disable_pre_add_norm && stream_ctx.concurrent_events.empty() && node->op == GGML_OP_ADD) {
                     const int n_adds = ggml_cuda_rms_norm_pre_add_detect(cgraph, i);
                     if (n_adds > 0) {
@@ -4805,8 +4969,16 @@ static void ggml_cuda_graph_evaluate_and_capture(ggml_backend_cuda_context * cud
                         for (int k = 0; k < n_adds; ++k) {
                             adds[k] = cgraph->nodes[i + k];
                         }
-                        ggml_cuda_op_rms_norm_fused_pre_add(*cuda_ctx, adds, n_adds,
-                            cgraph->nodes[i + n_adds], cgraph->nodes[i + n_adds + 1]);
+                        ggml_tensor * norm_node = cgraph->nodes[i + n_adds];
+                        ggml_tensor * mul_node   = cgraph->nodes[i + n_adds + 1];
+                        char * q8_1_dst = disable_norm_quant ? nullptr :
+                            ggml_cuda_norm_quant_register(cuda_ctx, cgraph, i + n_adds + 2, mul_node);
+                        if (q8_1_dst != nullptr) {
+                            ggml_cuda_op_rms_norm_fused_pre_add_quant(*cuda_ctx, adds, n_adds,
+                                norm_node, mul_node, q8_1_dst);
+                        } else {
+                            ggml_cuda_op_rms_norm_fused_pre_add(*cuda_ctx, adds, n_adds, norm_node, mul_node);
+                        }
