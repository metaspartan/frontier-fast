+
+// ----- folding the q8_1 quantization into the norm that produces it ----------
+//
+// The activation a decoder layer feeds to its projections is produced by an
+// rms_norm+mul and then quantized to q8_1 by the first mul_mat_vec_q that
+// consumes it (patch 0003 makes the later consumers reuse that result). The
+// norm kernel already has the value in a register the instant before the
+// quantize kernel would load it back, and its blocks already cover whole rows,
+// so the quantization can be produced by the norm itself - one dispatch fewer
+// per activation.
+//
+// The buffer is registered in the same per-graph cache the consumers look in,
+// under exactly the parameter tuple ggml_cuda_mul_mat_vec_q would use. A
+// mismatch can therefore only cost a cache miss (the consumer re-quantizes as
+// before), never a wrong result.
+
+// does `t` feed a mul_mat / mul_mat_id that routes through mul_mat_vec_q?
+static bool ggml_cuda_norm_quant_has_mmvq_consumer(const ggml_cgraph * cgraph, const int from, const ggml_tensor * t) {
+    const int cc  = ggml_cuda_info().devices[ggml_cuda_get_device()].cc;
+    // The consumer can sit well past the producer (the MoE router, top-k cluster
+    // and expert matvecs all run between the ffn norm and the shared-expert
+    // projections), so the window is generous. Distance is irrelevant to
+    // correctness: the cache entry describes the value written here, and the
+    // cache's own lifetime rules (patch 0003) govern when it may be reused.
+    const int end = std::min(cgraph->n_nodes, from + 64);
+
+    for (int j = from; j < end; ++j) {
+        const ggml_tensor * n = cgraph->nodes[j];
+        if (n->op != GGML_OP_MUL_MAT && n->op != GGML_OP_MUL_MAT_ID) {
+            continue;
+        }
+        // match the cache's identity rule: a reshape/view of the producer's
+        // result is the same data and hits the same entry
+        const ggml_tensor * s1 = n->src[1];
+        if (s1 == nullptr) {
+            continue;
+        }
+        const ggml_tensor * s1_origin = s1->view_src != nullptr ? s1->view_src : s1;
+        if (s1_origin != t || s1->data != t->data) {
+            continue;
+        }
+        if (s1->ne[0] != t->ne[0] || s1->nb[1] != t->nb[1] ||
+                s1->ne[1] != t->ne[1] || s1->ne[2] != t->ne[2] || s1->ne[3] != t->ne[3]) {
+            continue;
+        }
+        const ggml_tensor * w = n->src[0];
+        if (w == nullptr || !ggml_is_quantized(w->type)) {
+            continue;
+        }
+        if (t->type != GGML_TYPE_F32 || n->type != GGML_TYPE_F32) {
+            continue;
+        }
+        if (!ggml_cuda_should_use_mmvq(w->type, cc, s1->ne[1])) {
+            continue;
+        }
+        return true;
+    }
+    return false;
+}
+
+// Shape requirements of the folded epilogue: every warp of the norm block must
+// cover exactly one 32-element q8_1 block of one row, and the q8_1 row length
+// must equal the tensor row length (no padding tail to zero-fill).
+static bool ggml_cuda_norm_quant_shape_ok(const ggml_tensor * t) {
+    const int64_t ncols = t->ne[0];
+    if (ncols % QK8_1 != 0) {
+        return false;
+    }
+    if (GGML_PAD(ncols, MATRIX_ROW_PADDING) != ncols) {
+        return false;
+    }
+    const int block_size = ncols < 1024 ? 256 : 1024;
+    if (ncols % block_size != 0 || block_size % QK8_1 != 0) {
+        return false;
+    }
+    if (!ggml_is_contiguous(t)) {
+        return false;
+    }
+    if (t->ne[2] != 1 || t->ne[3] != 1) {
+        return false;
+    }
+    return true;
+}
+
+// Registers the q8_1 buffer for `t` in the per-graph cache and returns it, or
+// nullptr when the fold should not be done (already cached, wrong shape, no
+// consumer).
+static char * ggml_cuda_norm_quant_register(ggml_backend_cuda_context * ctx, const ggml_cgraph * cgraph,
+                                            const int from, ggml_tensor * t) {
+    if (!ggml_cuda_norm_quant_shape_ok(t)) {
+        return nullptr;
+    }
+    if (!ggml_cuda_norm_quant_has_mmvq_consumer(cgraph, from, t)) {
+        return nullptr;
+    }
+
+    cudaStream_t stream = ctx->stream();
+
+    const size_t  ts          = ggml_type_size(t->type);
+    const int64_t ne10        = t->ne[0];
+    const int64_t s11         = t->nb[1] / ts;
+    const int64_t s12         = t->nb[2] / ts;
+    const int64_t s13         = t->nb[3] / ts;
+    const int64_t ne10_padded = GGML_PAD(ne10, MATRIX_ROW_PADDING);
+
+    if (ctx->quantized_src1_cache.find(t, stream, ne10, s11, s12, s13,
+            ne10_padded, t->ne[1], t->ne[2], t->ne[3]) != nullptr) {
+        return nullptr; // already quantized in this evaluation
+    }
+
+    const size_t size_q8_1 = t->ne[3]*t->ne[2] * t->ne[1]*ne10_padded * sizeof(block_q8_1)/QK8_1;
+    return ctx->quantized_src1_cache.insert(t, stream, ne10, s11, s12, s13,
+        ne10_padded, t->ne[1], t->ne[2], t->ne[3], size_q8_1);
+}
+
+// A plain rms_norm+mul (no residual add to fold) that stock would run through
+// ggml_cuda_op_rms_norm_fused.
+static bool ggml_cuda_norm_quant_plain_ok(const ggml_cgraph * cgraph, const int i) {
+    if (cgraph->nodes[i]->op != GGML_OP_RMS_NORM) {
+        return false;
+    }
+    if (i + 1 >= cgraph->n_nodes) {
+        return false;
+    }
+    if (ggml_cuda_can_fuse(cgraph, i, { GGML_OP_RMS_NORM, GGML_OP_MUL, GGML_OP_ADD }, {})) {
+        return false;
+    }
+    if (!ggml_cuda_can_fuse(cgraph, i, { GGML_OP_RMS_NORM, GGML_OP_MUL }, {})) {
+        return false;
+    }
+
+    const ggml_tensor * norm = cgraph->nodes[i];
+    const ggml_tensor * mul  = cgraph->nodes[i + 1];
+    const ggml_tensor * x    = norm->src[0];
+
+    const ggml_tensor * mul_src = (mul->src[0] == norm) ? mul->src[1] : mul->src[0];
+    if (mul_src == nullptr || mul_src->type != GGML_TYPE_F32 ||
+            mul_src->nb[0] != ggml_type_size(mul_src->type) ||
+            mul_src->ne[2] != 1 || mul_src->ne[3] != 1) {
+        return false;
+    }
+    if (x->type != GGML_TYPE_F32 || x->ne[2] != 1 || x->ne[3] != 1 ||
+            x->nb[0] != ggml_type_size(x->type)) {
+        return false;
+    }
+    if (!ggml_is_contiguous(mul) || !ggml_are_same_shape(mul, x)) {
+        return false;
+    }
+    return true;
+}
+
