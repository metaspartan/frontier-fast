@@ -4692,6 +4843,8 @@ static void ggml_cuda_graph_evaluate_and_capture(ggml_backend_cuda_context * cud
                                                    std::atoi(getenv("GGML_CUDA_DISABLE_SET_ROWS_GROUP"));
             static const bool disable_pre_add_norm = getenv("GGML_CUDA_DISABLE_PRE_ADD_NORM") != nullptr &&
                                                    std::atoi(getenv("GGML_CUDA_DISABLE_PRE_ADD_NORM"));
+            static const bool disable_norm_quant = getenv("GGML_CUDA_DISABLE_NORM_QUANT") != nullptr &&
+                                                   std::atoi(getenv("GGML_CUDA_DISABLE_NORM_QUANT"));
             static const bool disable_mmvq_group = getenv("GGML_CUDA_DISABLE_MMVQ_GROUP") != nullptr &&
                                                    std::atoi(getenv("GGML_CUDA_DISABLE_MMVQ_GROUP"));
             const bool mmvq_group_enabled = !disable_mmvq_group && stream_ctx.concurrent_events.empty();
@@ -4798,6 +4951,17 @@ static void ggml_cuda_graph_evaluate_and_capture(ggml_backend_cuda_context * cud
                     }
                 }
 
+                if (!disable_norm_quant && stream_ctx.concurrent_events.empty() &&
+                        node->op == GGML_OP_RMS_NORM && ggml_cuda_norm_quant_plain_ok(cgraph, i)) {
+                    ggml_tensor * mul_node  = cgraph->nodes[i + 1];
