diff --git a/ggml/src/ggml-cuda/mmvq.cu b/ggml/src/ggml-cuda/mmvq.cu
index 0589e65bd..82aee9402 100644
--- a/ggml/src/ggml-cuda/mmvq.cu
+++ b/ggml/src/ggml-cuda/mmvq.cu
@@ -394,12 +394,24 @@ static constexpr __host__ __device__ int calc_nwarps(ggml_type type, int ncols_d
                 case GGML_TYPE_Q5_1:
                 case GGML_TYPE_Q8_0:
                 case GGML_TYPE_Q2_K:
-                case GGML_TYPE_Q4_K:
-                case GGML_TYPE_Q5_K:
-                case GGML_TYPE_Q6_K:
                 case GGML_TYPE_IQ4_NL:
                 case GGML_TYPE_IQ4_XS:
                     return 8;
+                // Q4_K/Q5_K/Q6_K reduce over qi/vdr threads per 256-element super-block, so
+                // one iteration of the K loop consumes nwarps*warp_size*vdr/qi super-blocks:
+                // 2*nwarps for Q4_K/Q5_K and 1*nwarps for Q6_K. The narrower block lets more
+                // workgroups stay resident per CU, which is what raises achieved read
+                // bandwidth on these bandwidth-bound row reductions.
+                //
+                // That matters far more on a 256-expert A3B trunk than on a dense one. A
+                // dense decode is a few large matvecs; this one is ~40 layers x 8 routed
+                // experts of [2048 x 512] plus a shared expert, i.e. hundreds of small,
+                // independent row reductions per token, and small reductions are exactly
+                // where occupancy rather than tile efficiency sets the achieved bandwidth.
+                case GGML_TYPE_Q4_K:
+                case GGML_TYPE_Q5_K:
+                case GGML_TYPE_Q6_K:
+                    return 5;
                 default:
                     return 1;
             }
