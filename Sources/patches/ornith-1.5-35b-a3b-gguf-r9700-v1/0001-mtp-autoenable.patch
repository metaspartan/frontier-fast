+// True when the GGUF at `path` ships its own NextN / MTP head, i.e. it carries
+// `<arch>.nextn_predict_layers` with a non-zero value. Reads the metadata block
+// only (no_alloc, no tensor data), so it costs one open and a header parse even
+// on a 21 GB file. Returns false for anything it cannot open, which is the
+// conservative answer: the caller then leaves speculation off.
+static bool model_ships_nextn_head(const std::string & path) {
+    if (path.empty()) {
+        return false;
+    }
+
+    struct gguf_init_params gparams = {
+        /* .no_alloc = */ true,
+        /* .ctx      = */ nullptr,
+    };
+
+    struct gguf_context * meta = gguf_init_from_file(path.c_str(), gparams);
+    if (meta == nullptr) {
+        return false;
+    }
+
+    static const std::string suffix = ".nextn_predict_layers";
+
+    bool found = false;
+
+    const int64_t n_kv = gguf_get_n_kv(meta);
+    for (int64_t i = 0; i < n_kv && !found; ++i) {
+        const std::string key = gguf_get_key(meta, i);
+        if (key.size() <= suffix.size() || key.compare(key.size() - suffix.size(), suffix.size(), suffix) != 0) {
+            continue;
+        }
+
+        switch (gguf_get_kv_type(meta, i)) {
+            case GGUF_TYPE_UINT32: found = gguf_get_val_u32(meta, i) > 0; break;
+            case GGUF_TYPE_INT32:  found = gguf_get_val_i32(meta, i) > 0; break;
+            case GGUF_TYPE_UINT64: found = gguf_get_val_u64(meta, i) > 0; break;
+            case GGUF_TYPE_INT64:  found = gguf_get_val_i64(meta, i) > 0; break;
+            default:               found = true;                         break;
+        }
+    }
+
+    gguf_free(meta);
+
+    return found;
+}
