+// Alias guard for the rms_norm pre-add fold.
+//
+// The fused kernel keeps TWO live destinations (the residual sum and the normed
+// output) and writes them while other blocks of the SAME dispatch are still
+// reading their own rows. ggml-alloc recycles buffers, so a destination can land
+// part-way into a tensor the fold still reads: block r's store then corrupts
+// block r-1's input. That is a write-after-read between independent blocks -
+// __syncthreads() orders threads inside one block and a fence only makes the
+// store land sooner, so neither can fix it. The fold has to be refused.
+//
+// One overlap is safe and worth keeping, because it is the common in-place add:
+// an EXACT shared base with a matching shape means row r of the destination is
+// row r of the source, so a block only ever overwrites the row it just read.
+// Anything else - any partial overlap - declines.
+static bool ggml_cuda_preadd_norm_alias_ok(const ggml_tensor * const * dsts, const int n_dst,
+                                           const ggml_tensor * const * srcs, const int n_src) {
+    auto lo = [](const ggml_tensor * t) { return (int64_t) t->data; };
+    auto hi = [](const ggml_tensor * t) {
+        return (int64_t) t->data + (int64_t) ggml_backend_buft_get_alloc_size(t->buffer->buft, t);
+    };
+
+    for (int i = 0; i < n_dst; ++i) {
+        for (int j = 0; j < n_src; ++j) {
+            if (!srcs[j] || srcs[j] == dsts[i]) {
+                continue;
+            }
+            const bool overlap = (lo(srcs[j]) <= lo(dsts[i]) && lo(dsts[i]) < hi(srcs[j])) ||
+                                 (lo(dsts[i]) <= lo(srcs[j]) && lo(srcs[j]) < hi(dsts[i]));
+            if (!overlap) {
+                continue;
+            }
+            // exact base + same shape:a block only rewrites its own row
+            if (dsts[i]->data == srcs[j]->data && ggml_are_same_shape(dsts[i], srcs[j])) {
+                continue;
+            }
+            return false;
+        }
+    }
+
+    return true;
+}
