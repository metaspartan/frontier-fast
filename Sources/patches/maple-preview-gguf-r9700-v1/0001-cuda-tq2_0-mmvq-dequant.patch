+static __device__ __forceinline__ void dequantize_tq2_0(const void * vx, const int64_t ib, const int iqs, float2 & v){
+    const block_tq2_0 * x = (const block_tq2_0 *) vx;
+
+    const float d = x[ib].d;
+
+    // TQ2_0: 256 elements per block, qs[64]; byte k of half h (h in {0,1}) packs
+    // elements h*128 + l*32 + k at bit shift 2*l, code c in {0,1,2} -> c - 1.
+    // Template contract (qr = 2): produce elements iqs and iqs + 128.
+    const int l = (iqs / 32) & 3;
+    const int k = iqs % 32;
+
+    const int c0 = (x[ib].qs[k +  0] >> (2*l)) & 0x3;
+    const int c1 = (x[ib].qs[k + 32] >> (2*l)) & 0x3;
+
+    v.x = (c0 - 1) * d;
+    v.y = (c1 - 1) * d;
+}
