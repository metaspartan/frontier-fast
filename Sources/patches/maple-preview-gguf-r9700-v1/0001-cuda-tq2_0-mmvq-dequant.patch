+#define VDR_TQ2_0_Q8_1_MMVQ 2
+
+static __device__ __forceinline__ float vec_dot_tq2_0_q8_1(
+    const void * __restrict__ vbq, const block_q8_1 * __restrict__ bq8_1, const int & kbx, const int & iqs) {
+
+    const block_tq2_0 * bq = (const block_tq2_0 *) vbq + kbx;
+
+    // TQ2_0: 256 elements per block, one f16 scale, qs[64] bytes. Byte k of
+    // half h (h in {0,1}) packs elements h*128 + l*32 + k at bit shift 2*l,
+    // code c in {0,1,2} -> value c - 1 in {-1, 0, +1}.
+    // iqs selects two consecutive int32s of qs (VDR = 2) inside half h; each
+    // x-int feeds the same int lane of 4 different q8_1 chunks (one per shift).
+    const int h  = iqs / 8;       // which 32-byte half of qs
+    const int ky = iqs % 8;       // int lane within each 32-element y chunk
+
+    const int v0 = get_int_b2(bq->qs, iqs + 0);
+    const int v1 = get_int_b2(bq->qs, iqs + 1);
+
+    const block_q8_1 * y = bq8_1 + 4*h;
+
+    float sumf = 0.0f;
+#pragma unroll
+    for (int l = 0; l < 4; ++l) {
+        const int q0 = __vsubss4((v0 >> (2*l)) & 0x03030303, 0x01010101);
+        const int q1 = __vsubss4((v1 >> (2*l)) & 0x03030303, 0x01010101);
+
+        int sumi = ggml_cuda_dp4a(get_int_b4(y[l].qs, ky + 0), q0, 0);
+        sumi     = ggml_cuda_dp4a(get_int_b4(y[l].qs, ky + 1), q1, sumi);
+
+        sumf += __low2float(y[l].ds) * (float) sumi;
+    }
+
+    return (float) bq->d * sumf;
+}
