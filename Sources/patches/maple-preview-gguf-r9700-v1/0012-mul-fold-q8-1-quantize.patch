+// ----- broadcast-mul with a folded q8_1 quantization -------------------------
+//
+// The attention output gate multiplies the attention result by a per-head gate
+// that broadcasts over the head dimension, and the o-projection then quantizes
+// that product straight back out of memory. This kernel does both.
+//
+// Bit-identical to the k_bin_bcast<op_mul> + quantize_q8_1 pair it replaces:
+//   * the product is src0 * src1 in that order, the operands read from the same
+//     addresses (src1's dim-0 broadcast means index i1*s11, exactly what
+//     k_bin_bcast computes with ne10 == 1);
+//   * the value quantized is the float just stored to dst;
+//   * dst is contiguous and the caller requires nelements % QK8_1 == 0, so warp
+//     lane L of warp w holds flat element 32*w + L - the mapping
+//     quantize_q8_1 has - and the amax / sum warp reductions see the same
+//     values in the same lanes;
+//   * d = amax/127.0f, q = roundf(val/d) and the (d, sum) ds write are the
+//     stock quantize_q8_1 statements.
+
+static __global__ void k_mul_bcast0_quant(const float * __restrict__ src0,
+                                          const float * __restrict__ src1,
+                                          float * __restrict__ dst,
+                                          const int64_t k,
+                                          const uint3   ne0,
+                                          const int64_t s11,
+                                          void *        q8_1_dst) {
+    ggml_cuda_pdl_lc();
+    const int64_t i = int64_t(blockDim.x)*blockIdx.x + threadIdx.x;
+
+    if (i >= k) {
+        return;
+    }
+
+    const uint32_t i1 = fastdiv((uint32_t) i, ne0);
+
+    ggml_cuda_pdl_sync();
+    const float val = src0[i] * src1[(int64_t) i1 * s11];
+    dst[i] = val;
+
+    block_q8_1 * y = (block_q8_1 *) q8_1_dst;
+
+    const int64_t ib  = i / QK8_1;
+    const int64_t iqs = i % QK8_1;
+
+    float amax = fabsf(val);
+    float sum  = val;
+
+    amax = warp_reduce_max<QK8_1>(amax);
+    sum  = warp_reduce_sum<QK8_1>(sum);
+
+    const float  d = amax / 127.0f;
+    const int8_t q = amax == 0.0f ? 0 : roundf(val / d);
+
+    y[ib].qs[iqs] = q;
+
+    if (iqs == 0) {
+        y[ib].ds = make_half2(d, sum);
+    }
+}
+
+void ggml_cuda_op_mul_bcast0_quant(ggml_backend_cuda_context & ctx, ggml_tensor * dst, char * q8_1_dst) {
+    const ggml_tensor * src0 = dst->src[0];
+    const ggml_tensor * src1 = dst->src[1];
+
+    GGML_ASSERT(src0->type == GGML_TYPE_F32 && src1->type == GGML_TYPE_F32 && dst->type == GGML_TYPE_F32);
+    GGML_ASSERT(ggml_is_contiguous(src0) && ggml_is_contiguous(dst));
+    GGML_ASSERT(src1->ne[0] == 1);
+    GGML_ASSERT(src1->nb[0] == sizeof(float));
+
+    const int64_t k = ggml_nelements(dst);
+    GGML_ASSERT(k % QK8_1 == 0);
+
+    const uint3   ne0 = init_fastdiv_values((uint32_t) dst->ne[0]);
+    const int64_t s11 = src1->nb[1] / sizeof(float);
+
+    const int64_t num_blocks = (k + 255) / 256;
+    const ggml_cuda_kernel_launch_params launch_params =
+        ggml_cuda_kernel_launch_params((dim3) num_blocks, (dim3) 256, 0, ctx.stream());
+    ggml_cuda_kernel_launch(k_mul_bcast0_quant, launch_params,
+        (const float *) src0->data, (const float *) src1->data, (float *) dst->data, k, ne0, s11, q8_1_dst);
+}
