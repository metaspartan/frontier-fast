+// Like ggml_cuda_norm_quant_register, but for a producer whose own shape
+// differs from the shape the consumer looks the entry up with (the attention
+// gate product is [head_dim, n_head] while the o-projection consumes the same
+// bytes as a flat [n_embd] row). The cache entry must be keyed on the
+// consumer's view; the bytes are the same either way because both tensors are
+// contiguous over the same elements in the same order.
+static char * ggml_cuda_quant_register_for_consumer(ggml_backend_cuda_context * ctx, const ggml_cgraph * cgraph,
+                                                    const int from, ggml_tensor * t) {
+    if (!ggml_is_contiguous(t) || t->type != GGML_TYPE_F32) {
+        return nullptr;
+    }
+    if (ggml_nelements(t) % QK8_1 != 0) {
+        return nullptr;
+    }
+
+    const int cc  = ggml_cuda_info().devices[ggml_cuda_get_device()].cc;
+    const int end = std::min(cgraph->n_nodes, from + 64);
+
+    for (int j = from; j < end; ++j) {
+        const ggml_tensor * n = cgraph->nodes[j];
+        if (n->op != GGML_OP_MUL_MAT && n->op != GGML_OP_MUL_MAT_ID) {
+            continue;
+        }
+        const ggml_tensor * s1 = n->src[1];
+        if (s1 == nullptr) {
+            continue;
+        }
+        const ggml_tensor * s1_origin = s1->view_src != nullptr ? s1->view_src : s1;
+        const ggml_tensor * t_origin  = t->view_src  != nullptr ? t->view_src  : t;
+        if (s1_origin != t_origin || s1->data != t->data) {
+            continue;
+        }
+        // same bytes, in the same order
+        if (!ggml_is_contiguous(s1) || ggml_nelements(s1) != ggml_nelements(t)) {
+            continue;
+        }
+        const ggml_tensor * w = n->src[0];
+        if (w == nullptr || !ggml_is_quantized(w->type) || s1->type != GGML_TYPE_F32 || n->type != GGML_TYPE_F32) {
+            continue;
+        }
+        if (!ggml_cuda_should_use_mmvq(w->type, cc, s1->ne[1])) {
+            continue;
+        }
+
+        const size_t  ts          = ggml_type_size(s1->type);
+        const int64_t ne10        = s1->ne[0];
+        const int64_t ne10_padded = GGML_PAD(ne10, MATRIX_ROW_PADDING);
+        if (ne10_padded != ne10 || ne10 % QK8_1 != 0) {
+            return nullptr; // a padding tail would have to be zero-filled
+        }
+        const int64_t s11 = s1->nb[1] / ts;
+        const int64_t s12 = s1->nb[2] / ts;
+        const int64_t s13 = s1->nb[3] / ts;
+
+        cudaStream_t stream = ctx->stream();
+        if (ctx->quantized_src1_cache.find(s1, stream, ne10, s11, s12, s13,
+                ne10_padded, s1->ne[1], s1->ne[2], s1->ne[3]) != nullptr) {
+            return nullptr;
+        }
+        const size_t size_q8_1 = s1->ne[3]*s1->ne[2] * s1->ne[1]*ne10_padded * sizeof(block_q8_1)/QK8_1;
+        return ctx->quantized_src1_cache.insert(ctx->pool(), s1, stream, ne10, s11, s12, s13,
+            ne10_padded, s1->ne[1], s1->ne[2], s1->ne[3], size_q8_1);
+    }
+    return nullptr;
+}
+
+// dst = src0 * src1 with src1 broadcasting over dim 0 only, everything F32 and
+// contiguous - the shape the folded-quantize multiply kernel handles.
+static bool ggml_cuda_mul_bcast0_quant_ok(const ggml_tensor * node) {
+    if (node->op != GGML_OP_MUL) {
+        return false;
+    }
+    const ggml_tensor * src0 = node->src[0];
+    const ggml_tensor * src1 = node->src[1];
+    if (src0 == nullptr || src1 == nullptr) {
+        return false;
+    }
+    if (src0->type != GGML_TYPE_F32 || src1->type != GGML_TYPE_F32 || node->type != GGML_TYPE_F32) {
+        return false;
+    }
+    if (!ggml_is_contiguous(src0) || !ggml_is_contiguous(node) || !ggml_are_same_shape(src0, node)) {
+        return false;
+    }
+    if (src1->ne[0] != 1 || src1->nb[0] != ggml_type_size(src1->type)) {
+        return false;
+    }
+    // src1 must supply exactly one value per dim-1 index, no further broadcast
+    if (src1->ne[1] != node->ne[1] || src1->ne[2] != 1 || src1->ne[3] != 1) {
+        return false;
+    }
+    if (node->ne[2] != 1 || node->ne[3] != 1) {
+        return false;
+    }
+    return true;
+}
