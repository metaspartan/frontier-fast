+// Number of strided k-steps whose loads are issued back-to-back before the FMAs that
+// consume them.  Scaled down as the per-step register footprint grows (one float2 of y
+// per dst column per step, plus one float2 of x, doubled when a gate is fused) so the
+// kernel keeps full occupancy.
+#define GGML_CUDA_MMVF_NUNROLL 4
+
+template <int ncols_dst, bool has_fusion>
+static constexpr int mmvf_nunroll() {
+    return ncols_dst > 2 ? 1
+         : ncols_dst > 1 ? (has_fusion ? 1 : 2)
+         : (has_fusion ? 2 : GGML_CUDA_MMVF_NUNROLL);
+}
