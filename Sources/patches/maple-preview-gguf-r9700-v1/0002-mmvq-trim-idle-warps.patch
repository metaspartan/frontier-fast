+// Trailing warps of an mmvq block are dead weight whenever the block spans more k-blocks than the
+// row actually has: their k-loop start index tid/(qi/vdr) is already >= blocks_per_row_x, so they
+// fall straight through to the reduction contributing +0.0f. They still cost a full wave of
+// occupancy each. Returns how many warps have real work; the rest are simply not launched.
+//
+// This deliberately does NOT touch rows_per_cuda_block. blocks_per_iter inside the kernel is a
+// compile-time constant built from the full nwarps, so trimming the launch cannot move a k-block
+// from one thread to another and cannot re-associate any row's accumulation - bit-exact by
+// construction. Only valid while blocks_per_row_x <= blocks_per_iter (a single k-loop pass), which
+// is exactly the case in which idle warps exist.
+template<ggml_type type>
+static __host__ int calc_nwarps_launched(const int ncols_x, const int nwarps, const int warp_size) {
+    constexpr int qk  = ggml_cuda_type_traits<type>::qk;
+    constexpr int qi  = ggml_cuda_type_traits<type>::qi;
+    constexpr int vdr = get_vdr_mmvq(type);
+
+    if (nwarps <= 1 || vdr <= 0 || qi % vdr != 0) {
+        return nwarps;
+    }
+    const int threads_per_kblock = qi / vdr;
+    if (threads_per_kblock <= 0 || (vdr * nwarps * warp_size) % qi != 0) {
+        return nwarps;
+    }
+    const int blocks_per_row_x = ncols_x / qk;
+    const int blocks_per_iter  = vdr * nwarps * warp_size / qi;
+    if (blocks_per_iter <= 0 || blocks_per_row_x > blocks_per_iter) {
+        return nwarps; // every warp already enters the k-loop
+    }
+    const int threads_needed  = blocks_per_row_x * threads_per_kblock;
+    int       nwarps_launched = (threads_needed + warp_size - 1) / warp_size;
+    if (nwarps_launched < MMVQ_MIN_LAUNCHED_WARPS) {
+        nwarps_launched = MMVQ_MIN_LAUNCHED_WARPS;
+    }
+    return nwarps_launched < 1 ? 1 : (nwarps_launched > nwarps ? nwarps : nwarps_launched);
+}
