-    MMVQ_PARAMETERS_RDNA4
+    MMVQ_PARAMETERS_RDNA4,
+    MMVQ_PARAMETERS_SM121
 };
 
 static constexpr __device__ mmvq_parameter_table_id get_device_table_id() {
@@ -83,6 +84,8 @@ static constexpr __device__ mmvq_parameter_table_id get_device_table_id() {
     return MMVQ_PARAMETERS_GCN;
 #elif defined(__CUDA_ARCH__) && __CUDA_ARCH__ >= GGML_CUDA_CC_TURING && __CUDA_ARCH__ < GGML_CUDA_CC_AMPERE
     return MMVQ_PARAMETERS_TURING;
+#elif defined(__CUDA_ARCH__) && __CUDA_ARCH__ == 1210
+    return MMVQ_PARAMETERS_SM121;
 #else
     return MMVQ_PARAMETERS_GENERIC;
 #endif
@@ -104,9 +107,28 @@ static __host__ mmvq_parameter_table_id get_device_table_id(int cc) {
     if (GGML_CUDA_CC_IS_NVIDIA(cc) && ggml_cuda_highest_compiled_arch(cc) >= GGML_CUDA_CC_TURING && ggml_cuda_highest_compiled_arch(cc) < GGML_CUDA_CC_AMPERE) {
         return MMVQ_PARAMETERS_TURING;
     }
+    if (GGML_CUDA_CC_IS_NVIDIA(cc) && ggml_cuda_highest_compiled_arch(cc) == 1210) {
+        return MMVQ_PARAMETERS_SM121;
+    }
     return MMVQ_PARAMETERS_GENERIC;
 }
 
+// Table-aware vdr. sm_121 runs the Q4_K mmvq vec_dot two columns wide (see the
+// sm_121 vec_dot_q4_K_q8_1 variant in vecdotq.cuh): block_q4_K is 144 bytes and
+// its qs array starts 16 bytes in, so the weight fetches become 8-byte aligned
+// int2 loads and the scale/min unpack is done once per column pair instead of
+// twice. Host launch math and device kernels must agree, so both route through
+// this overload with their table id.
+static constexpr __host__ __device__ int get_vdr_mmvq(ggml_type type, mmvq_parameter_table_id table_id) {
+    if (table_id == MMVQ_PARAMETERS_SM121) {
+        switch (type) {
+            case GGML_TYPE_Q4_K: return 4;
+            default: break;
+        }
+    }
+    return get_vdr_mmvq(type);
+}
+
 // Per-architecture maximum batch size for which MMVQ should be used for MUL_MAT_ID.
 // Returns a value <= MMVQ_MAX_BATCH_SIZE. Default is MMVQ_MAX_BATCH_SIZE.
 // Check https://github.com/ggml-org/llama.cpp/pull/20905#issuecomment-4145835627 for details
@@ -352,6 +374,28 @@ static constexpr __device__ int get_mmvq_mmid_max_batch_for_device() {
 }
 
 static constexpr __host__ __device__ int calc_nwarps(ggml_type type, int ncols_dst, mmvq_parameter_table_id table_id) {
+    if (table_id == MMVQ_PARAMETERS_SM121) {
+        // Q4_K at vdr = 4 covers twice as many k-blocks per warp, so halving
+        // nwarps keeps blocks_per_iter equal to what it is at stock vdr = 2 and
+        // the k-loop trip count unchanged. Everything else mirrors GENERIC.
+        if (ncols_dst == 1 && type == GGML_TYPE_Q4_K) {
+            return 2;
+        }
+        switch (ncols_dst) {
+            case 1:
+            case 2:
+            case 3:
+            case 4:
+                return 4;
+            case 5:
+            case 6:
+            case 7:
+            case 8:
+                return 2;
+            default:
+                return 1;
+        }
+    }
     if (table_id == MMVQ_PARAMETERS_GENERIC) {
         switch (ncols_dst) {
             case 1:
@@ -458,7 +502,7 @@ static constexpr __host__ __device__ int calc_nwarps(ggml_type type, int ncols_d
 }
 
 static constexpr __host__ __device__ int calc_rows_per_block(int ncols_dst, int table_id, bool small_k = false, int nwarps = 1) {
-    if (table_id == MMVQ_PARAMETERS_GENERIC || table_id == MMVQ_PARAMETERS_GCN || table_id == MMVQ_PARAMETERS_TURING) {
+    if (table_id == MMVQ_PARAMETERS_SM121 || table_id == MMVQ_PARAMETERS_GENERIC || table_id == MMVQ_PARAMETERS_GCN || table_id == MMVQ_PARAMETERS_TURING) {
         switch (ncols_dst) {
             case 1:
                 return small_k ? nwarps : 1;
@@ -493,8 +537,8 @@ static __global__ void mul_mat_vec_q(
 
     constexpr int qk  = ggml_cuda_type_traits<type>::qk;
     constexpr int qi  = ggml_cuda_type_traits<type>::qi;
-    constexpr int vdr = get_vdr_mmvq(type);
     constexpr mmvq_parameter_table_id table_id = get_device_table_id();
+    constexpr int vdr = get_vdr_mmvq(type, table_id);
     constexpr int nwarps = calc_nwarps(type, ncols_dst, table_id);
     constexpr int rows_per_cuda_block = calc_rows_per_block(ncols_dst, table_id, small_k, nwarps);
     constexpr int warp_size = ggml_cuda_get_physical_warp_size();
@@ -815,8 +859,8 @@ static __global__ void mul_mat_vec_q_grouped(
     constexpr int ncols_dst = 1;
     constexpr int qk  = ggml_cuda_type_traits<type>::qk;
     constexpr int qi  = ggml_cuda_type_traits<type>::qi;
-    constexpr int vdr = get_vdr_mmvq(type);
     constexpr mmvq_parameter_table_id table_id = get_device_table_id();
+    constexpr int vdr = get_vdr_mmvq(type, table_id);
     constexpr int nwarps = calc_nwarps(type, ncols_dst, table_id);
     constexpr int rows_per_cuda_block = calc_rows_per_block(ncols_dst, table_id, /*small_k=*/false, nwarps);
     static_assert(rows_per_cuda_block == 1, "grouped mmvq requires the block index to be the row index");
@@ -942,7 +986,7 @@ template <ggml_type type>
 static bool mmvq_may_use_small_k(const int ncols_x, const mmvq_parameter_table_id table_id, const int warp_size) {
     constexpr int qk  = ggml_cuda_type_traits<type>::qk;
     constexpr int qi  = ggml_cuda_type_traits<type>::qi;
-    constexpr int vdr = get_vdr_mmvq(type);
+    const int vdr = get_vdr_mmvq(type, table_id);
 
     const int blocks_per_row_x      = ncols_x / qk;
     const int blocks_per_iter_1warp = vdr * warp_size / qi;
@@ -1106,7 +1150,7 @@ static void mul_mat_vec_q_switch_ncols_dst(
         // Trigger when the full thread block covers all K blocks in a single loop iteration and few threads remain idle.
         constexpr int qk                    = ggml_cuda_type_traits<type>::qk;
         constexpr int qi                    = ggml_cuda_type_traits<type>::qi;
-        constexpr int vdr                   = get_vdr_mmvq(type);
+        const int     vdr                   = get_vdr_mmvq(type, table_id);
         const int     blocks_per_row_x      = ncols_x / qk;
         const int     blocks_per_iter_1warp = vdr * warp_size / qi;
         const int     nwarps                = calc_nwarps(type, c_ncols_dst, table_id);
diff --git a/ggml/src/ggml-cuda/vecdotq.cuh b/ggml/src/ggml-cuda/vecdotq.cuh
index 0f039c7..d160cf6 100644
--- a/ggml/src/ggml-cuda/vecdotq.cuh
+++ b/ggml/src/ggml-cuda/vecdotq.cuh
@@ -907,6 +907,70 @@ static __device__ __forceinline__ float vec_dot_q3_K_q8_1(
     return vec_dot_q3_K_q8_1_impl_mmvq(vl, vh, u, bq3_K->scales, scale_offset, d, d8);
 }
 
+#if defined(__CUDA_ARCH__) && __CUDA_ARCH__ == 1210
+// sm_121 wide variant: one call covers the column pair (iqs, iqs+2) of the stock
+// vdr = 2 form (vdr = 4, iqs is a multiple of 4). The pair shares bq8_offset, the
+// unpacked scale/min pair and d8, so that work is done once instead of twice, and
+// each weight fetch becomes an 8-byte int2 load. block_q4_K is 144 bytes with qs
+// at offset 16, and a row is a whole number of blocks, so qs is 16-byte aligned
+// and q4 + i0 (i0 in {0, 2}) is 8-byte aligned - the int2 load is well formed.
+// The q8_1 side keeps 4-byte loads: block_q8_1 is 36 bytes, so its qs is only
+// 4-byte aligned at odd block indices.
+static __device__ __forceinline__ float vec_dot_q4_K_q8_1(
+    const void * __restrict__ vbq, const block_q8_1 * __restrict__ bq8_1, const int & kbx, const int & iqs) {
+
+    const block_q4_K * bq4_K = (const block_q4_K *) vbq + kbx;
+
+    const int bq8_offset = QR4_K * ((iqs/2) / (QI8_1/2));
+    const int i0         = (iqs/2) % 4; // {0, 2}: columns i0 and i0+1
+
+    const int2 * q4 = (const int2 *)(bq4_K->qs + 16*bq8_offset);
+    const int2 va = q4[i0/2];
+    const int2 vb = q4[i0/2 + 2];
+
+    const uint16_t * scales = (const uint16_t *)bq4_K->scales;
+    uint16_t aux[2];
+    const int j = bq8_offset/2;
+    if (j < 2) {
+        aux[0] = scales[j+0] & 0x3f3f;
+        aux[1] = scales[j+2] & 0x3f3f;
+    } else {
+        aux[0] = ((scales[j+2] >> 0) & 0x0f0f) | ((scales[j-2] & 0xc0c0) >> 2);
+        aux[1] = ((scales[j+2] >> 4) & 0x0f0f) | ((scales[j-0] & 0xc0c0) >> 2);
+    }
+    const uint8_t * sc = (const uint8_t *)aux;
+    const uint8_t * m  = sc + 2;
+
+    float sumf_d = 0.0f;
+    float sumf_m = 0.0f;
+#pragma unroll
+    for (int i = 0; i < QR4_K; ++i) {
+        const block_q8_1 * bq8i = bq8_1 + bq8_offset + i;
+        const float d8 = __low2float(bq8i->ds);
+        const int * q8 = (const int *)bq8i->qs;
+        const int uax = q8[i0 + 0];
+        const int uay = q8[i0 + 1];
+        const int ubx = q8[i0 + 4];
+        const int uby = q8[i0 + 5];
+
+        const int vax = (va.x >> (4*i)) & 0x0F0F0F0F;
+        const int vay = (va.y >> (4*i)) & 0x0F0F0F0F;
+        const int vbx = (vb.x >> (4*i)) & 0x0F0F0F0F;
+        const int vby = (vb.y >> (4*i)) & 0x0F0F0F0F;
+
+        int dot1 = ggml_cuda_dp4a(vbx, ubx, ggml_cuda_dp4a(vax, uax, 0));
+        dot1     = ggml_cuda_dp4a(vby, uby, ggml_cuda_dp4a(vay, uay, dot1));
+        int dot2 = ggml_cuda_dp4a(0x01010101, ubx, ggml_cuda_dp4a(0x01010101, uax, 0));
+        dot2     = ggml_cuda_dp4a(0x01010101, uby, ggml_cuda_dp4a(0x01010101, uay, dot2));
+
+        sumf_d += d8 * (dot1 * sc[i]);
+        sumf_m += d8 * (dot2 * m[i]);
+    }
+
+    const float2 dm4f = __half22float2(bq4_K->dm);
+    return dm4f.x*sumf_d - dm4f.y*sumf_m;
+}
+#else
 static __device__ __forceinline__ float vec_dot_q4_K_q8_1(
     const void * __restrict__ vbq, const block_q8_1 * __restrict__ bq8_1, const int & kbx, const int & iqs) {
 
@@ -952,6 +1016,7 @@ static __device__ __forceinline__ float vec_dot_q4_K_q8_1(
 
     return vec_dot_q4_K_q8_1_impl_vmmq(v, u, sc, m, bq4_K->dm, d8);
 }
+#endif // defined(__CUDA_ARCH__) && __CUDA_ARCH__ == 1210
 
