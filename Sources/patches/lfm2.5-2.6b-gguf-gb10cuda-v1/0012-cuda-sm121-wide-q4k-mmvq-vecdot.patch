 ggml/src/ggml-cuda/mmvq.cu     | 56 +++++++++++++++++++++++++----
 ggml/src/ggml-cuda/vecdotq.cuh | 65 ++++++++++++++++++++++++++++++++++
 2 files changed, 115 insertions(+), 6 deletions(-)

diff --git a/ggml/src/ggml-cuda/mmvq.cu b/ggml/src/ggml-cuda/mmvq.cu
