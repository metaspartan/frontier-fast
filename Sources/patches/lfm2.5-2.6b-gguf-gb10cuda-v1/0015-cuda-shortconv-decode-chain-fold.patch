diff --git a/ggml/src/ggml-cuda/ggml-cuda.cu b/ggml/src/ggml-cuda/ggml-cuda.cu
index fb3cadb3..6def7814 100644
--- a/ggml/src/ggml-cuda/ggml-cuda.cu
+++ b/ggml/src/ggml-cuda/ggml-cuda.cu
@@ -4105,6 +4105,276 @@ static bool ggml_cuda_mul_bcast0_quant_ok(const ggml_tensor * node) {
 }
 
 // try and fuse nodes and return the number of nodes to skip
+// ----- LFM shortconv decode-shape chain fold --------------------------------
+//
+// At decode the shortconv block spends four launches on ~80 KB of data:
+//
+//   i    MUL(b, x)                    (b, x are chunks of the in_proj result)
+//        TRANSPOSE                    metadata
+//   ic   CONCAT(conv_window, bx)      [d_conv, n_embd]
+//   ip   CPY(concat[1..], cache)      recurrent conv-state writeback
+//   iv   SSM_CONV(concat, conv_w)
+//   ig   MUL(c, ssm_conv)             the c-gate
+//
+// All four compute nodes collapse into one kernel per layer. Detection runs at
+// the b*x MUL because that is the earliest point at which every input is live:
+// the conv window for layer L+1 is gathered into the SAME allocator block a few
+// nodes later, so a fold issued at the CONCAT or SSM_CONV position would read a
+// window that has already been overwritten.
+static const ggml_tensor * ggml_cuda_view_root(const ggml_tensor * t) {
+    while (t != nullptr && t->view_src != nullptr) {
+        t = t->view_src;
+    }
+    return t;
+}
+
+static bool ggml_cuda_ranges_disjoint(const void * a, size_t na, const void * b, size_t nb) {
+    const char * a0 = (const char *) a, * a1 = a0 + na;
+    const char * b0 = (const char *) b, * b1 = b0 + nb;
+    return a1 <= b0 || b1 <= a0;
+}
+
+static bool ggml_cuda_shortconv_fold_collect(const ggml_cgraph * cgraph, int i, ggml_shortconv_fold_plan & p) {
+    ggml_tensor * mul_bx = cgraph->nodes[i];
+    if (mul_bx->op != GGML_OP_MUL || mul_bx->type != GGML_TYPE_F32) {
+        return false;
+    }
+    const ggml_tensor * bt = mul_bx->src[0];
+    const ggml_tensor * xt = mul_bx->src[1];
+    if (bt == nullptr || xt == nullptr) {
+        return false;
+    }
+    // decode shape only: one token, one sequence
+    if (mul_bx->ne[1] != 1 || mul_bx->ne[2] != 1 || mul_bx->ne[3] != 1) {
+        return false;
+    }
+    if (bt->type != GGML_TYPE_F32 || xt->type != GGML_TYPE_F32) {
+        return false;
+    }
+    if (!ggml_are_same_shape(bt, mul_bx) || !ggml_are_same_shape(xt, mul_bx)) {
+        return false;
+    }
+
+    const int64_t n_ch = mul_bx->ne[0];
+
+    // forward search window: the chain is emitted within a handful of nodes
+    const int window = 64;
+    const int last   = cgraph->n_nodes < i + 1 + window ? cgraph->n_nodes : i + 1 + window;
+
+    ggml_tensor * concat = nullptr; int ic = -1;
+    for (int k = i + 1; k < last; ++k) {
+        ggml_tensor * n = cgraph->nodes[k];
+        if (n->op == GGML_OP_CONCAT && n->src[1] != nullptr && ggml_cuda_view_root(n->src[1]) == mul_bx) {
+            concat = n; ic = k; break;
+        }
+    }
+    if (concat == nullptr || concat->type != GGML_TYPE_F32) {
+        return false;
+    }
+    const ggml_tensor * state = concat->src[0];
+    if (state == nullptr || state->type != GGML_TYPE_F32) {
+        return false;
+    }
+    const int64_t nc = concat->ne[0];
+    if (nc < 2 || nc > 5 || state->ne[0] != nc - 1 || concat->src[1]->ne[0] != 1) {
+        return false;
+    }
+    if (concat->ne[1] != n_ch || concat->ne[2] != 1 || concat->ne[3] != 1) {
+        return false;
+    }
+    if (state->ne[1] != n_ch || state->ne[2] != 1) {
+        return false;
+    }
+
+    ggml_tensor * conv = nullptr; int iv = -1;
+    for (int k = ic + 1; k < last; ++k) {
+        ggml_tensor * n = cgraph->nodes[k];
+        if (n->op == GGML_OP_SSM_CONV && n->src[0] == concat) {
+            conv = n; iv = k; break;
+        }
+    }
+    if (conv == nullptr || conv->type != GGML_TYPE_F32) {
+        return false;
+    }
+    const ggml_tensor * w = conv->src[1];
+    if (w == nullptr || w->type != GGML_TYPE_F32 || w->ne[0] != nc || w->ne[1] != n_ch) {
+        return false;
+    }
+    if (conv->ne[0] != n_ch || conv->ne[1] != 1 || conv->ne[2] != 1) {
+        return false;
+    }
+
+    ggml_tensor * cpy = nullptr;
+    for (int k = ic + 1; k < last; ++k) {
+        ggml_tensor * n = cgraph->nodes[k];
+        if (n->op == GGML_OP_CPY && n->src[0] != nullptr && ggml_cuda_view_root(n->src[0]) == concat) {
+            cpy = n; break;
+        }
+    }
+    if (cpy == nullptr || cpy->type != GGML_TYPE_F32 || cpy->src[0]->type != GGML_TYPE_F32) {
+        return false;
+    }
+    // the writeback must be exactly the trailing (nc-1) columns of the window,
+    // contiguous at the destination
+    const ggml_tensor * cpy_src = cpy->src[0];
+    if (cpy_src->ne[0] != nc - 1 || cpy_src->ne[1] != n_ch ||
+        (size_t) ((const char *) cpy_src->data - (const char *) concat->data) != sizeof(float) ||
+        cpy_src->nb[1] != concat->nb[1] || cpy_src->nb[0] != sizeof(float)) {
+        return false;
+    }
+    if (!ggml_is_contiguous(cpy) || ggml_nelements(cpy) != (nc - 1) * n_ch) {
+        return false;
+    }
+
+    // the c-gate multiply
+    ggml_tensor * mul_g = nullptr;
+    for (int k = iv + 1; k < last; ++k) {
+        ggml_tensor * n = cgraph->nodes[k];
+        if (ggml_cuda_is_view_or_noop(n)) {
+            continue;
+        }
+        if (n->op == GGML_OP_MUL && (n->src[0] == conv || n->src[1] == conv)) {
+            mul_g = n;
+        }
+        break;  // must be the first compute node after the conv
+    }
+    if (mul_g == nullptr || mul_g->type != GGML_TYPE_F32 || !ggml_are_same_shape(mul_g, conv)) {
+        return false;
+    }
+    const ggml_tensor * g = (mul_g->src[0] == conv) ? mul_g->src[1] : mul_g->src[0];
+    if (g->type != GGML_TYPE_F32 || !ggml_are_same_shape(g, mul_g)) {
+        return false;
+    }
+
+    // strides must be expressible per channel
+    if (bt->nb[0] != sizeof(float) || xt->nb[0] != sizeof(float) ||
+        g->nb[0] != sizeof(float) || mul_g->nb[0] != sizeof(float) ||
+        state->nb[0] != sizeof(float) || w->nb[0] != sizeof(float)) {
+        return false;
+    }
+    // b/x/g are single-token views: their per-channel stride is nb[0]
+    if (!ggml_is_contiguous(bt) || !ggml_is_contiguous(xt) || !ggml_is_contiguous(g) ||
+        !ggml_is_contiguous(mul_g)) {
+        return false;
+    }
+
+    p.b     = (const float *) bt->data;
+    p.x     = (const float *) xt->data;
+    p.g     = (const float *) g->data;
+    p.state = (const float *) state->data;
+    p.w     = (const float *) w->data;
+    p.dst   = (float *) mul_g->data;
+    p.cache = (float *) cpy->data;
+
+    p.b_stride     = 1;
+    p.x_stride     = 1;
+    p.g_stride     = 1;
+    p.dst_stride   = 1;
+    p.state_stride = (int) (state->nb[1] / sizeof(float));
+    p.w_stride     = (int) (w->nb[1] / sizeof(float));
+    p.cache_stride = (int) (nc - 1);
+    p.n_ch         = (int) n_ch;
+    p.nc           = (int) nc;
+
+    // The kernel reads every input before it stores, but only within a thread.
+    // Require the two destinations to be disjoint from all inputs, except the
+    // window/cache pair which may be the SAME buffer (the identity mapping) -
+    // there each thread rewrites exactly the slots it just read.
+    const size_t dst_bytes   = (size_t) n_ch * sizeof(float);
+    const size_t cache_bytes = (size_t) (nc - 1) * n_ch * sizeof(float);
+    const size_t state_bytes = (size_t) state->nb[1] * n_ch;
+    const size_t bx_bytes    = (size_t) n_ch * sizeof(float);
+
+    if (!ggml_cuda_ranges_disjoint(p.dst, dst_bytes, p.b, bx_bytes) ||
+        !ggml_cuda_ranges_disjoint(p.dst, dst_bytes, p.x, bx_bytes) ||
+        !ggml_cuda_ranges_disjoint(p.dst, dst_bytes, p.g, bx_bytes) ||
+        !ggml_cuda_ranges_disjoint(p.dst, dst_bytes, p.state, state_bytes) ||
+        !ggml_cuda_ranges_disjoint(p.dst, dst_bytes, p.cache, cache_bytes)) {
+        return false;
+    }
+    const bool cache_is_window = (const void *) p.cache == (const void *) p.state &&
+                                 p.cache_stride == p.state_stride;
+    if (!cache_is_window &&
+        !ggml_cuda_ranges_disjoint(p.cache, cache_bytes, p.state, state_bytes)) {
+        return false;
+    }
+    if (!ggml_cuda_ranges_disjoint(p.cache, cache_bytes, p.b, bx_bytes) ||
+        !ggml_cuda_ranges_disjoint(p.cache, cache_bytes, p.x, bx_bytes) ||
+        !ggml_cuda_ranges_disjoint(p.cache, cache_bytes, p.g, bx_bytes)) {
+        return false;
+    }
+
+    // nothing later in the graph may read the intermediates we stop writing
+    for (int k = iv + 1; k < cgraph->n_nodes; ++k) {
+        ggml_tensor * n = cgraph->nodes[k];
+        if (n == mul_g) {
+            continue;
+        }
+        for (int sidx = 0; sidx < GGML_MAX_SRC; ++sidx) {
+            const ggml_tensor * src = n->src[sidx];
+            if (src == nullptr) {
+                continue;
+            }
+            const ggml_tensor * r = ggml_cuda_view_root(src);
+            if (r == mul_bx || r == concat || r == conv) {
+                return false;
+            }
+        }
+    }
+    if ((mul_bx->flags & GGML_TENSOR_FLAG_OUTPUT) || (concat->flags & GGML_TENSOR_FLAG_OUTPUT) ||
+        (conv->flags & GGML_TENSOR_FLAG_OUTPUT)) {
+        return false;
+    }
+
+    // Hoisting legality. The fold issues BOTH stores - the layer output and the
+    // conv-state writeback - at node i, which is up to ~20 nodes earlier than
+    // the CPY and the gate MUL it replaces. ggml-alloc reuses blocks across
+    // disjoint lifetimes, so an early store can land on a block some node in
+    // between still reads or writes (the next conv layer's state gather is
+    // emitted inside this window and lands on exactly this class of block).
+    // Require both destinations to be disjoint from every input and output of
+    // every node that stays in the window.
+    {
+        int i_mulg = -1;
+        for (int k = iv + 1; k < cgraph->n_nodes; ++k) {
+            if (cgraph->nodes[k] == mul_g) { i_mulg = k; break; }
+        }
+        if (i_mulg < 0) {
+            return false;
+        }
+        const size_t d_bytes = (size_t) n_ch * sizeof(float);
+        const size_t c_bytes = (size_t) (nc - 1) * n_ch * sizeof(float);
+        for (int k = i + 1; k < i_mulg; ++k) {
+            ggml_tensor * n = cgraph->nodes[k];
+            if (n == concat || n == cpy || n == conv || ggml_cuda_is_view_or_noop(n)) {
+                continue;
+            }
+            if ((n->flags & GGML_TENSOR_FLAG_COMPUTE) == 0) {
+                continue;
+            }
+            const ggml_tensor * ranges[1 + GGML_MAX_SRC];
+            int n_ranges = 0;
+            ranges[n_ranges++] = n;
+            for (int sidx = 0; sidx < GGML_MAX_SRC; ++sidx) {
+                if (n->src[sidx] != nullptr) { ranges[n_ranges++] = n->src[sidx]; }
+            }
+            for (int r = 0; r < n_ranges; ++r) {
+                const void * base = ranges[r]->data;
+                if (base == nullptr) { continue; }
+                const size_t nb = ggml_nbytes(ranges[r]);
+                if (!ggml_cuda_ranges_disjoint(p.dst, d_bytes, base, nb)) { return false; }
+                if (!ggml_cuda_ranges_disjoint(p.cache, c_bytes, base, nb)) { return false; }
+            }
+        }
+    }
+
+    p.folded[0] = concat;
+    p.folded[1] = cpy;
+    p.folded[2] = conv;
+    p.folded[3] = mul_g;
+    return true;
+}
+
