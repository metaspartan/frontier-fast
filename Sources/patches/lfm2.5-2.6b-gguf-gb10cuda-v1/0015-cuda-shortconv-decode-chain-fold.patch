+
+// ---------------------------------------------------------------------------
+// LFM shortconv decode-shape chain fold
+//
+// At decode (n_tokens == 1, one sequence) the shortconv block is six graph
+// nodes over ~80 KB of data:
+//
+//   MUL(b, x)  ->  TRANSPOSE  ->  CONCAT(state_window, bx)
+//                                    |-> CPY(last d_conv-1 cols) -> conv cache
+//                                    `-> SSM_CONV(.., conv_w) -> MUL(c, .)
+//
+// Every one of those is a separate kernel launch whose kernel time is pure
+// latency. This collapses the four compute nodes into ONE kernel: a thread per
+// channel reads its conv window and its b/x pair, multiplies, runs the stock
+// accumulation loop, writes the new window back to the cache in place and
+// applies the c-gate.
+//
+// Bit-identity is by construction:
+//   - the accumulation is the stock loop nest over the same three values in the
+//     same order, with the same (absent) bias add;
+//   - b*x reaches the accumulator through an arithmetic fence, because in stock
+//     it is stored to memory and reloaded, and a load is an opaque value that
+//     `x[nc-1] * w[nc-1]` cannot be reassociated into;
+//   - the writeback reads its window into registers before storing, so it is
+//     alias-safe when the state source IS the cache slot.
+
+// Blocks floating-point reassociation across this value: the value becomes
+// opaque to the surrounding expression tree, exactly as a store/reload pair
+// makes it opaque in the unfused graph. The host pass sees a plain identity.
+static __device__ __forceinline__ float ggml_cuda_assoc_fence(float v) {
+#if defined(GGML_USE_HIP)
+#  if defined(__HIP_DEVICE_COMPILE__)
+    asm volatile("" : "+v"(v));
+#  endif
+#elif defined(__CUDA_ARCH__)
+    asm volatile("" : "+f"(v));
+#endif
+    return v;
+}
+
+template <int nc>
+static __global__ void shortconv_fold_f32(
+        const float * __restrict__ b_ptr,     const float * __restrict__ x_ptr,
+        const float * __restrict__ g_ptr,     const float * __restrict__ state_ptr,
+        const float * __restrict__ w_ptr,
+        float * __restrict__ dst_ptr,         float * __restrict__ cache_ptr,
+        const int b_stride,   const int x_stride, const int g_stride,
+        const int state_stride, const int w_stride,
+        const int dst_stride, const int cache_stride,
+        const int n_ch) {
+    ggml_cuda_pdl_lc();
+    const int c = blockIdx.x * blockDim.x + threadIdx.x;
+    ggml_cuda_pdl_sync();
+    if (c >= n_ch) {
+        return;
+    }
+
+    float x[nc];
+#pragma unroll
+    for (int j = 0; j < nc - 1; ++j) {
+        x[j] = state_ptr[c * state_stride + j];
+    }
+    x[nc - 1] = ggml_cuda_assoc_fence(b_ptr[c * b_stride] * x_ptr[c * x_stride]);
+
+    float w[nc];
+#pragma unroll
+    for (int j = 0; j < nc; ++j) {
+        w[j] = w_ptr[c * w_stride + j];
+    }
+
+    // stock ssm_conv_f32 accumulation at n_t == 1 (i == 0, so (i+j)%nc == j)
+    float sumf = 0.0f;
+#pragma unroll
+    for (int j = 0; j < nc; ++j) {
+        sumf += x[j] * w[j];
+    }
+    sumf += 0.0f;  // stock adds the bias register, which is 0 when unfused
+
+    // conv-state writeback: the last nc-1 entries of the window
+#pragma unroll
+    for (int j = 0; j < nc - 1; ++j) {
+        cache_ptr[c * cache_stride + j] = x[j + 1];
+    }
+
+    dst_ptr[c * dst_stride] = sumf * g_ptr[c * g_stride];
+}
+
+void ggml_cuda_op_shortconv_fold(ggml_backend_cuda_context & ctx, const ggml_shortconv_fold_plan & p) {
+    static const int fold_threads = [] {
+        const char * e = getenv("GGML_SHORTCONV_FOLD_THREADS");
+        const int    v = e ? atoi(e) : 128;
+        return (v == 64 || v == 128 || v == 256 || v == 512) ? v : 128;
+    }();
+
+    const dim3   blocks((p.n_ch + fold_threads - 1) / fold_threads, 1, 1);
+    cudaStream_t stream = ctx.stream();
+
+    const ggml_cuda_kernel_launch_params lp = ggml_cuda_kernel_launch_params(blocks, fold_threads, 0, stream);
+
+#define GGML_SHORTCONV_FOLD_CASE(NC)                                                                      \
+    case NC:                                                                                              \
+        ggml_cuda_kernel_launch(shortconv_fold_f32<NC>, lp, p.b, p.x, p.g, p.state, p.w, p.dst, p.cache,   \
+                                p.b_stride, p.x_stride, p.g_stride, p.state_stride, p.w_stride,           \
+                                p.dst_stride, p.cache_stride, p.n_ch);                                    \
+        break;
+
+    switch (p.nc) {
+        GGML_SHORTCONV_FOLD_CASE(3)
+        GGML_SHORTCONV_FOLD_CASE(4)
+        GGML_SHORTCONV_FOLD_CASE(5)
+        default: GGML_ABORT("shortconv fold: unsupported d_conv %d", p.nc);
+    }
+#undef GGML_SHORTCONV_FOLD_CASE
+}
