diff --git a/ggml/src/ggml-cuda/mmvq.cu b/ggml/src/ggml-cuda/mmvq.cu
index 0589e65bd..5e36b0934 100644
--- a/ggml/src/ggml-cuda/mmvq.cu
+++ b/ggml/src/ggml-cuda/mmvq.cu
@@ -394,12 +394,21 @@ static constexpr __host__ __device__ int calc_nwarps(ggml_type type, int ncols_d
                 case GGML_TYPE_Q5_1:
                 case GGML_TYPE_Q8_0:
                 case GGML_TYPE_Q2_K:
-                case GGML_TYPE_Q4_K:
-                case GGML_TYPE_Q5_K:
-                case GGML_TYPE_Q6_K:
                 case GGML_TYPE_IQ4_NL:
                 case GGML_TYPE_IQ4_XS:
                     return 8;
+                // Q4_K/Q5_K/Q6_K reduce over qi/vdr threads per 256-element super-block, so
+                // one iteration of the K loop consumes nwarps*warp_size*vdr/qi super-blocks:
+                // 2*nwarps for Q4_K/Q5_K and 1*nwarps for Q6_K. A 5-warp (160-thread) block
+                // therefore covers 10 and 5 super-blocks per iteration, both of which divide
+                // the 20 super-blocks of a K=5120 row exactly, while the 8-warp block leaves
+                // 12 of its 32 Q4_K thread-slots idle in the second iteration. The narrower
+                // block also lets more workgroups stay resident per CU, which is what raises
+                // achieved read bandwidth on these bandwidth-bound row reductions.
+                case GGML_TYPE_Q4_K:
+                case GGML_TYPE_Q5_K:
+                case GGML_TYPE_Q6_K:
+                    return 5;
                 default:
                     return 1;
             }
