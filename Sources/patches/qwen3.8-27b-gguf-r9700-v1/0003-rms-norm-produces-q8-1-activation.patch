-template <int block_size, bool do_multiply = false, bool do_add = false>
+template <int block_size, bool do_multiply = false, bool do_add = false, bool do_q8_1 = false>
 static __global__ void rms_norm_f32(const float * x,
                                     float *       dst,
                                     const int     ncols,
@@ -96,7 +96,8 @@ static __global__ void rms_norm_f32(const float * x,
                                     const uint3   add_ncols_packed     = make_uint3(0, 0, 0),
                                     const uint3   add_nrows_packed     = make_uint3(0, 0, 0),
                                     const uint3   add_nchannels_packed = make_uint3(0, 0, 0),
-                                    const uint3   add_nsamples_packed  = make_uint3(0, 0, 0)) {
+                                    const uint3   add_nsamples_packed  = make_uint3(0, 0, 0),
+                                    void *        q8_1_dst             = nullptr) {
     ggml_cuda_pdl_lc();
     const int nrows     = gridDim.x;
     const int nchannels = gridDim.y;
@@ -140,16 +141,45 @@ static __global__ void rms_norm_f32(const float * x,
     const float mean = tmp / ncols;
     const float scale = rsqrtf(mean + eps);
 
+    block_q8_1 * yq = nullptr;
+    if constexpr (do_q8_1) {
+        // Same flat row order as the f32 destination above, and the same layout
+        // quantize_q8_1 writes: row-major blocks of QK8_1, ncols/QK8_1 per row.
+        yq = (block_q8_1 *) q8_1_dst + ((int64_t)(sample*nchannels + channel)*nrows + row) * (ncols/QK8_1);
+    }
+
     for (int col = tid; col < ncols; col += block_size) {
+        float val;
         if constexpr (do_multiply && do_add) {
             const int mul_col = fastmodulo(col, mul_ncols_packed);
             const int add_col = fastmodulo(col, add_ncols_packed);
-            dst[col]          = scale * x[col] * mul[mul_col] + add[add_col];
+            val               = scale * x[col] * mul[mul_col] + add[add_col];
         } else if constexpr (do_multiply) {
             const int mul_col = fastmodulo(col, mul_ncols_packed);
-            dst[col]          = scale * x[col] * mul[mul_col];
+            val               = scale * x[col] * mul[mul_col];
         } else {
-            dst[col] = scale * x[col];
+            val = scale * x[col];
+        }
+        dst[col] = val;
+
+        if constexpr (do_q8_1) {
+            // Reproduces quantize_q8_1 exactly, on the value still in registers.
+            // block_size and ncols are both multiples of QK8_1, so the QK8_1 columns of
+            // one q8_1 block are held by QK8_1 consecutive threads that are always
+            // active on the same loop iteration - the reduction below is the same
+            // butterfly over the same lanes and the same inputs as the stock kernel's,
+            // hence bit-identical.
+            const float  amax = warp_reduce_max<QK8_1>(fabsf(val));
+            const float  sum  = warp_reduce_sum<QK8_1>(val);
+            const float  d    = amax / 127.0f;
+            const int8_t q    = amax == 0.0f ? 0 : roundf(val / d);
+
+            const int ib  = col / QK8_1;
+            const int iqs = col % QK8_1;
+            yq[ib].qs[iqs] = q;
+            if (iqs == 0) {
+                yq[ib].ds = make_half2(d, sum);
+            }
         }
     }
 }
@@ -312,14 +342,16 @@ static void rms_norm_f32_cuda(
             x, dst, ncols, stride_row, stride_channel, stride_sample, eps,
         // underlying cudaLaunchKernelEx does not support default params
         nullptr, 0, 0, 0, make_uint3(0, 0, 0), make_uint3(0, 0, 0), make_uint3(0, 0, 0), make_uint3(0, 0, 0),
-        nullptr, 0, 0, 0, make_uint3(0, 0, 0), make_uint3(0, 0, 0), make_uint3(0, 0, 0), make_uint3(0, 0, 0));
+        nullptr, 0, 0, 0, make_uint3(0, 0, 0), make_uint3(0, 0, 0), make_uint3(0, 0, 0), make_uint3(0, 0, 0),
+        (void *) nullptr);
     } else {
         const dim3 block_dims(1024, 1, 1);
         const ggml_cuda_kernel_launch_params launch_params = ggml_cuda_kernel_launch_params{blocks_num, block_dims, block_dims.x > WARP_SIZE ? 32 * sizeof(float): 0, stream};
         ggml_cuda_kernel_launch(rms_norm_f32<1024, false>, launch_params, x, dst, ncols, stride_row, stride_channel, stride_sample, eps,
         // underlying cudaLaunchKernelEx does not support default params
         nullptr, 0, 0, 0, make_uint3(0, 0, 0), make_uint3(0, 0, 0), make_uint3(0, 0, 0), make_uint3(0, 0, 0),
-        nullptr, 0, 0, 0, make_uint3(0, 0, 0), make_uint3(0, 0, 0), make_uint3(0, 0, 0), make_uint3(0, 0, 0));
+        nullptr, 0, 0, 0, make_uint3(0, 0, 0), make_uint3(0, 0, 0), make_uint3(0, 0, 0), make_uint3(0, 0, 0),
+        (void *) nullptr);
     }
 }
 
@@ -349,8 +381,12 @@ static void rms_norm_mul_f32_cuda(const float *  x,
                                   const uint32_t add_nchannels,
                                   const uint32_t add_nsamples,
