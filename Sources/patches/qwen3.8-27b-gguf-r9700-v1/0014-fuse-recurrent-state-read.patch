+// match the get_rows that materialises the recurrent state for a gated_delta_net, so the kernel
+// can index the rs cache itself and the [state_size, 1] copy never happens. The graph builder tags
+// the node, which is also the guarantee that the gdn op is its only consumer.
+static bool ggml_cuda_try_gdn_state_read_fusion(
+        const ggml_cgraph * cgraph, int node_idx,
+        ggml_cuda_gated_delta_net_fused_read & rd, int & gdn_off) {
+    const ggml_tensor * gr = cgraph->nodes[node_idx];
+
+    if (gr->op != GGML_OP_GET_ROWS || gr->type != GGML_TYPE_F32 ||
+        (gr->flags & GGML_TENSOR_FLAG_OUTPUT) || strcmp(gr->name, "gdn_rs_read") != 0) {
+        return false;
+    }
+
+    const ggml_tensor * rows = gr->src[0]; // the rs cache, [state_size, rs_size]
+    const ggml_tensor * ids  = gr->src[1]; // one selected row per sequence
+
+    if (rows == nullptr || ids == nullptr || rows->type != GGML_TYPE_F32 || rows->data == nullptr ||
+        !ggml_is_contiguous(rows) || ids->type != GGML_TYPE_I32 || ids->data == nullptr ||
+        !ggml_is_contiguous(ids)) {
+        return false;
+    }
+
+    // the gdn op must be the next node that actually computes anything
+    const ggml_tensor * gdn = nullptr;
+    for (int j = node_idx + 1; j < cgraph->n_nodes; ++j) {
+        if (ggml_cuda_is_view_or_noop(cgraph->nodes[j])) {
+            continue;
+        }
+        gdn     = cgraph->nodes[j];
+        gdn_off = j - node_idx;
+        break;
+    }
+    if (gdn == nullptr || gdn->op != GGML_OP_GATED_DELTA_NET) {
+        return false;
+    }
+
+    // ... and it must consume this get_rows as its state input (through reshapes)
+    const ggml_tensor * st = gdn->src[5];
+    while (st != nullptr && st != gr) {
+        st = st->view_src;
+    }
+    if (st != gr) {
+        return false;
+    }
+
+    // the kernel indexes ids[sequence], so there must be exactly one row per sequence
+    const int64_t n_seqs = gdn->src[2]->ne[3];
+    if (ids->ne[0] != n_seqs || gr->ne[1] != n_seqs || gr->ne[0] != rows->ne[0]) {
+        return false;
+    }
+
+    rd.base       = (const float *) rows->data;
+    rd.ids        = (const int32_t *) ids->data;
+    rd.row_stride = (int64_t) (rows->nb[1] / sizeof(float));
+    return true;
+}
