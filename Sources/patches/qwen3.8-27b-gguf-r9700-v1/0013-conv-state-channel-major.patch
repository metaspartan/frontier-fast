+// [TAG_CONV_STATE_CHANNEL_MAJOR]
+// Conv-state plane layout. Tap-major [d_conv-1, channels] is what the chain
+// path concat wants; channel-major [channels, d_conv-1] is what the tree
+// gather wants, on both the read and the write. The tree only ever runs in a
+// context with rollback snapshots, so keying the layout on n_rs_seq gives each
+// context the layout its hot path wants and keeps every context internally
+// consistent (the recurrent cache is per-context, and so is its state blob).
+// GAINZ_CONV_CMAJ=0 restores the tap-major layout so both graphs can be
+// measured on one binary, one boot per arm, same token stream.
+static bool llm_conv_state_channel_major(uint32_t n_rs_seq) {
+    static const bool enabled = [] {
+        const char * e = getenv("GAINZ_CONV_CMAJ");
+        return !(e != nullptr && *e && strcmp(e, "0") == 0);
+    }();
+    return enabled && n_rs_seq > 0;
+}
