diff --git a/ggml/src/ggml-cuda/ggml-cuda.cu b/ggml/src/ggml-cuda/ggml-cuda.cu
index 257e870d2..ab41f9b36 100644
--- a/ggml/src/ggml-cuda/ggml-cuda.cu
+++ b/ggml/src/ggml-cuda/ggml-cuda.cu
@@ -2726,6 +2726,205 @@ static int ggml_cuda_try_gdn_cache_fusion(
     return skip;
 }
 
+
+// ---------------------------------------------------------------------------
+// gated_delta_net activation fold
+//
+// A Qwen3.5-style linear-attention layer produces the gated_delta_net gate and beta
+// with three tiny launches that each occupy a SINGLE workgroup:
+//     g    = mul(softplus(add(alpha, ssm_dt)), ssm_a)     [ADD] + [UNARY softplus x MUL]
+//     beta = sigmoid(beta_proj)                           [UNARY sigmoid]
+// gated_delta_net already runs one block per (head, column group) and reads exactly
+// g[h] and beta[h], so every value these launches produce is consumed by the block that
+// needs it and by nothing else: the grids agree at the only granularity that matters and
+// the fold costs a handful of scalar flops per block instead of a device-wide barrier.
+//
+// The producers sit BEFORE the gated_delta_net in graph order, so this cannot be expressed
+// as the usual "skip the next n nodes" fusion. Instead both the skip and the fold are
+// derived from ONE pure function of the graph, evaluated twice: once at each producer node
+// (skip it) and once at the gated_delta_net (apply it). Two evaluations of the same pure
+// predicate over the same graph cannot disagree.
+// ---------------------------------------------------------------------------
+
+// 0 = off, 1 = fold and skip the producers, 2 = fold but STILL RUN the producers
+// (mode 2 is a bisect: it isolates the kernel arithmetic from the node-skipping)
+static int ggml_cuda_gdn_act_fold_mode() {
+    static const int mode = [] {
+        const char * e = getenv("GGML_GDN_ACT_FOLD");
+        return e == nullptr ? 1 : std::atoi(e);
+    }();
+    return mode;
+}
+
+static bool ggml_cuda_gdn_act_fold_enabled() {
+    return ggml_cuda_gdn_act_fold_mode() != 0;
+}
+
+// resolve a tensor to the node that actually writes its bytes
+static const ggml_tensor * ggml_cuda_gdn_writer(const ggml_tensor * t) {
+    while (t != nullptr && t->view_src != nullptr &&
+           (t->op == GGML_OP_RESHAPE || t->op == GGML_OP_VIEW ||
+            t->op == GGML_OP_PERMUTE || t->op == GGML_OP_TRANSPOSE || t->op == GGML_OP_CONT)) {
+        if (t->view_offs != 0 || !ggml_is_contiguous(t)) {
+            return nullptr;
+        }
+        t = t->view_src;
+    }
+    return t;
+}
+
+static bool ggml_cuda_gdn_is_unary(const ggml_tensor * t, ggml_unary_op op) {
+    return t != nullptr && t->op == GGML_OP_UNARY && ggml_get_unary_op(t) == op;
+}
+
+// a per-head parameter vector: contiguous f32, exactly H elements
+static bool ggml_cuda_gdn_is_head_vec(const ggml_tensor * t, int64_t H) {
+    return t != nullptr && t->type == GGML_TYPE_F32 && ggml_is_contiguous(t) && ggml_nelements(t) == H;
+}
+
+struct ggml_cuda_gdn_act_match {
+    ggml_cuda_gated_delta_net_act_fold fold;
+    const ggml_tensor * skip[8] = {};
+    int                 n_skip  = 0;
+};
+
+// window (in nodes) searched around a gated_delta_net for its activation producers
+static constexpr int GGML_CUDA_GDN_ACT_WINDOW = 48;
+
+static bool ggml_cuda_gdn_private(const ggml_cgraph * cgraph, int gdn_idx, const ggml_tensor * t) {
+    // the node must sit just upstream of the gdn and have exactly one consumer, because
+    // the fold stops its buffer from ever being written
+    const int lo = gdn_idx - GGML_CUDA_GDN_ACT_WINDOW < 0 ? 0 : gdn_idx - GGML_CUDA_GDN_ACT_WINDOW;
+    for (int j = gdn_idx - 1; j >= lo; --j) {
+        if (cgraph->nodes[j] == t) {
+            return !(t->flags & GGML_TENSOR_FLAG_OUTPUT) && ggml_node_get_use_count(cgraph, j) == 1;
+        }
+    }
+    return false;
+}
+
+static bool ggml_cuda_try_gdn_act_fusion(const ggml_cgraph * cgraph, int gdn_idx, ggml_cuda_gdn_act_match & m) {
+    const ggml_tensor * gdn = cgraph->nodes[gdn_idx];
+    if (gdn->op != GGML_OP_GATED_DELTA_NET) {
+        return false;
+    }
+
+    const ggml_tensor * src_g    = gdn->src[3];
+    const ggml_tensor * src_beta = gdn->src[4];
+    const ggml_tensor * src_v    = gdn->src[2];
+    if (src_g == nullptr || src_beta == nullptr || src_v == nullptr) {
+        return false;
+    }
+
+    const int64_t H = src_v->ne[1];
+
+    // Decode only. At prefill the kernel loops over n_tokens inside each block, so the fold
+    // recomputes the two transcendentals once per (token, column-block) instead of once per
+    // (token, head) - 32x redundancy - while the three launches it removes are amortised over
+    // the whole ubatch and worth nothing. Measured -0.7% prefill when left enabled there.
+    if (src_v->ne[2] != 1) {
+        return false;
+    }
+
+    // scalar gate only (ne[0] == 1); the KDA per-column gate keeps the stock path
+    if (src_g->ne[0] != 1 || !ggml_is_contiguous(src_g) || !ggml_is_contiguous(src_beta) ||
+        src_g->type != GGML_TYPE_F32 || src_beta->type != GGML_TYPE_F32) {
+        return false;
+    }
+
+    // --- gate: reshape(mul(softplus(add(alpha, dt)), a)) ---
+    const ggml_tensor * mul = ggml_cuda_gdn_writer(src_g);
+    if (mul == nullptr || mul->op != GGML_OP_MUL || !ggml_is_contiguous(mul)) {
+        return false;
+    }
+    const ggml_tensor * sp = mul->src[0];
+    const ggml_tensor * a  = mul->src[1];
+    if (!ggml_cuda_gdn_is_unary(sp, GGML_UNARY_OP_SOFTPLUS) || !ggml_cuda_gdn_is_head_vec(a, H)) {
+        return false;
+    }
+    const ggml_tensor * add = ggml_cuda_gdn_writer(sp->src[0]);
+    if (add == nullptr || add->op != GGML_OP_ADD || !ggml_is_contiguous(add) || !ggml_is_contiguous(sp)) {
+        return false;
+    }
+    const ggml_tensor * alpha = add->src[0];
+    const ggml_tensor * dt    = add->src[1];
+    if (!ggml_cuda_gdn_is_head_vec(dt, H) || alpha == nullptr || alpha->type != GGML_TYPE_F32 ||
+        !ggml_is_contiguous(alpha) || ggml_nelements(alpha) != ggml_nelements(src_g)) {
+        return false;
+    }
+
+    // --- beta: sigmoid(beta_proj) ---
+    const ggml_tensor * sig = src_beta;
+    if (!ggml_cuda_gdn_is_unary(sig, GGML_UNARY_OP_SIGMOID)) {
+        return false;
+    }
+    const ggml_tensor * braw = sig->src[0];
+    if (braw == nullptr || braw->type != GGML_TYPE_F32 || !ggml_is_contiguous(braw) ||
+        ggml_nelements(braw) != ggml_nelements(src_beta)) {
+        return false;
+    }
+
+    // the fold reads alpha and braw AFTER the elementwise nodes that consume them have been
+    // skipped, which is past the point ggml-alloc considers them dead. Only fold when the
+    // graph carries the explicit liveness edges that keep their blocks reserved until here.
+    if (gdn->src[6] != alpha || gdn->src[7] != braw) {
+        return false;
+    }
+
+    // every node whose write we are about to elide must be privately consumed
+    const ggml_tensor * elided[] = { add, sp, mul, sig };
+    for (const ggml_tensor * t : elided) {
+        if (!ggml_cuda_gdn_private(cgraph, gdn_idx, t)) {
+            return false;
+        }
+    }
+    // ... and so must the view that carries the gate to the gdn, if there is one
+    if (src_g != mul && !ggml_cuda_gdn_private(cgraph, gdn_idx, src_g)) {
+        return false;
+    }
+
+    m.fold.g_raw   = (const float *) alpha->data;
+    m.fold.g_bias  = (const float *) dt->data;
+    m.fold.g_scale = (const float *) a->data;
+    m.fold.b_raw   = (const float *) braw->data;
+    if (!m.fold.g_raw || !m.fold.g_bias || !m.fold.g_scale || !m.fold.b_raw) {
+        return false;
+    }
+
+    m.n_skip = 0;
+    for (const ggml_tensor * t : elided) {
+        m.skip[m.n_skip++] = t;
+    }
+    return true;
+}
+
+// is node i one of the activation producers a downstream gated_delta_net will compute itself?
+static bool ggml_cuda_gdn_act_producer_folded(const ggml_cgraph * cgraph, int i) {
+    if (ggml_cuda_gdn_act_fold_mode() != 1) {
+        return false;
+    }
