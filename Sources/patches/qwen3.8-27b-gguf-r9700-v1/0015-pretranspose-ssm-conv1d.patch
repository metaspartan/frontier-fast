index 13023c643..7c06066ee 100644
--- a/src/llama-model.cpp
+++ b/src/llama-model.cpp
@@ -1250,6 +1250,17 @@ void llama_model_base::load_vocab(llama_model_loader & ml) {
     vocab.load(ml, kv);
 }
 
+// Derived weights are a pure re-layout of a loaded weight that every graph wants in that layout.
+// Building them once at load time removes a per-layer copy from every forward pass.
+// GAINZ_CONV1D_PRET=0 leaves them null so one binary can run both graphs.
+static bool llm_ssm_conv1d_pretranspose() {
+    static const bool enabled = [] {
+        const char * e = getenv("GAINZ_CONV1D_PRET");
+        return e == nullptr || atoi(e) != 0;
+    }();
+    return enabled;
+}
+
 bool llama_model_base::load_tensors(llama_model_loader & ml) {
     const auto & split_mode   = params.split_mode;
     const bool use_mlock      = params.load_mode == LLAMA_LOAD_MODE_MLOCK || params.load_mode == LLAMA_LOAD_MODE_MMAP_MLOCK;
@@ -1661,6 +1672,75 @@ bool llama_model_base::load_tensors(llama_model_loader & ml) {
         }
     }
 
+    // ssm_conv1d^T: the tree conv path needs the kernel as [channels, d_conv] and materialised
+    // (ggml_mul goes through binbcast, which assumes a unit innermost stride, so a permuted view
+    // is silently wrong there). It is the same 160 KB per layer on every pass - derive it once.
+    if (llm_ssm_conv1d_pretranspose()) {
+        std::map<ggml_backend_buffer_type_t, std::vector<size_t>> by_buft;
+        for (size_t il = 0; il < layers.size(); ++il) {
+            const ggml_tensor * w = layers[il].ssm_conv1d;
+            if (w == nullptr || w->buffer == nullptr || w->type != GGML_TYPE_F32 ||
+                !ggml_is_contiguous(w) || w->ne[2] != 1 || w->ne[3] != 1) {
+                continue;
+            }
+            by_buft[ggml_backend_buffer_get_type(w->buffer)].push_back(il);
+        }
+
+        for (const auto & [buft, ils] : by_buft) {
+            ggml_init_params ip = {
+                /*.mem_size   =*/ ils.size()*ggml_tensor_overhead(),
+                /*.mem_buffer =*/ nullptr,
+                /*.no_alloc   =*/ true,
+            };
+            ggml_context_ptr ctx_ptr { ggml_init(ip) };
+            if (!ctx_ptr) {
+                break;
+            }
+            ggml_context * ctx = ctx_ptr.get();
+
+            std::vector<ggml_tensor *> ts;
+            ts.reserve(ils.size());
+            for (size_t il : ils) {
+                const ggml_tensor * w = layers[il].ssm_conv1d;
+                ggml_tensor * t = ggml_new_tensor_2d(ctx, GGML_TYPE_F32, w->ne[1], w->ne[0]);
+                ggml_format_name(t, "blk.%d.ssm_conv1d.weight_t", (int) il);
+                ts.push_back(t);
+            }
+
+            ggml_backend_buffer_ptr buf { ggml_backend_alloc_ctx_tensors_from_buft(ctx, buft) };
+            if (!buf) {
+                break;
+            }
+            ggml_backend_buffer_set_usage(buf.get(), GGML_BACKEND_BUFFER_USAGE_WEIGHTS);
+
+            std::vector<float> src;
+            std::vector<float> dst;
+            for (size_t k = 0; k < ils.size(); ++k) {
+                ggml_tensor * w = layers[ils[k]].ssm_conv1d;
+                const int64_t n0 = w->ne[0]; // d_conv
+                const int64_t n1 = w->ne[1]; // channels
+                src.resize((size_t) n0*n1);
+                dst.resize((size_t) n0*n1);
+                ggml_backend_tensor_get(w, src.data(), 0, src.size()*sizeof(float));
+                for (int64_t j = 0; j < n1; ++j) {
+                    for (int64_t i = 0; i < n0; ++i) {
+                        dst[(size_t) i*n1 + j] = src[(size_t) j*n0 + i];
+                    }
+                }
+                ggml_backend_tensor_set(ts[k], dst.data(), 0, dst.size()*sizeof(float));
+                layers[ils[k]].ssm_conv1d_t = ts[k];
+            }
+
+            LLAMA_LOG_INFO("%s: %12s derived ssm_conv1d^T buffer size = %8.2f MiB (%zu layers)\n",
+                    __func__, ggml_backend_buffer_name(buf.get()),
+                    ggml_backend_buffer_get_size(buf.get()) / 1024.0 / 1024.0, ils.size());
+
+            std::vector<ggml_backend_buffer_ptr> bufs;
+            bufs.emplace_back(std::move(buf));
+            pimpl->ctxs_bufs.emplace_back(std::move(ctx_ptr), std::move(bufs));
+        }
+    }
+
     return true;
 }
 
