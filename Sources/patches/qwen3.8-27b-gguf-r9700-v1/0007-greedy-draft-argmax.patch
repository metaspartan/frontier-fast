+int32_t llama_context::get_logits_argmax_ith(int32_t i) {
+    output_reorder();
+
+    try {
+        auto * res = gf_res_prev ? (llm_graph_result *) gf_res_prev.get() : nullptr;
+        if (!res) {
+            return -1;
+        }
+        auto * t_argmax = res->get_logits_argmax();
+        if (!t_argmax) {
+            return -1;
+        }
+
+        const int64_t j = output_resolve_row(i);
+
+        int32_t id = -1;
+        ggml_backend_tensor_get(t_argmax, &id, j * (int64_t) sizeof(int32_t), sizeof(int32_t));
+        return id;
+    } catch (const std::exception & err) {
+        LLAMA_LOG_ERROR("%s: invalid argmax id %d, reason: %s\n", __func__, i, err.what());
+        return -1;
+    }
+}
+
 float * llama_context::get_embeddings() {
     output_reorder();
 
@@ -3723,6 +3747,11 @@ float * llama_get_logits_ith(llama_context * ctx, int32_t i) {
 
     return res;
 }
+int32_t llama_get_logits_argmax_ith(llama_context * ctx, int32_t i) {
+    ctx->synchronize();
+
+    return ctx->get_logits_argmax_ith(i);
+}
 
