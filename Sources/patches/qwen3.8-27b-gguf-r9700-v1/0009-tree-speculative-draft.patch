+// A tree-shaped speculative draft.
+//
+// Node i is a drafted token at depth `level[i]` (1-based) whose parent is node
+// `parent[i]`; `parent[i] == -1` means the parent is the already-sampled token
+// the draft hangs off (`common_speculative_draft_params::id_last`), which is the
+// tree's implicit root and is NOT stored here.
+//
+// Nodes are emitted in breadth-first order, so `parent[i] < i` for every i and a
+// single forward scan is enough to walk the tree. Siblings share a position
+// (`n_past + level[i]`) and are distinguished only by sequence id, which is what
+// makes the whole tree verifiable in one target forward pass.
+struct common_speculative_tree {
+    llama_tokens         tok;     // [n] drafted token
+    std::vector<int32_t> parent;  // [n] parent node index, -1 for depth-1 nodes
+    std::vector<int32_t> level;   // [n] depth, 1-based
+
+    size_t size()  const { return tok.size(); }
+    bool   empty() const { return tok.empty(); }
+
+    void clear() {
+        tok.clear();
+        parent.clear();
+        level.clear();
+    }
+
+    int32_t add(llama_token id, int32_t par, int32_t lvl) {
+        tok.push_back(id);
+        parent.push_back(par);
+        level.push_back(lvl);
+        return (int32_t) tok.size() - 1;
+    }
+
+    // Assign one sequence id per LEAF, then give every node the ids of the leaves
+    // beneath it, smallest first.
+    //
+    // The KQ mask keys off the query's FIRST sequence id only
+    // (llama-kv-cache.cpp: `ubatch->seq_id[i][0]`). A node's smallest leaf id sits
+    // on all of that node's ancestors and on no other node, so seq_id[0] alone
+    // reproduces exactly its root-to-here path - which is what lets a single
+    // forward pass verify every branch with no custom mask.
+    void seq_sets(llama_seq_id base,
+                  std::vector<std::vector<llama_seq_id>> & out,
+                  std::vector<llama_seq_id> & all) const {
+        const size_t n = size();
+
+        out.assign(n, {});
+        all.clear();
+
+        std::vector<bool> has_child(n, false);
+        for (size_t i = 0; i < n; ++i) {
+            if (parent[i] >= 0) {
+                has_child[parent[i]] = true;
+            }
+        }
+
+        for (size_t i = 0; i < n; ++i) {
+            if (has_child[i]) {
