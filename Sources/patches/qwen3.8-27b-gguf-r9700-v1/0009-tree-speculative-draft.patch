+std::vector<llama_token> common_sampler_sample_and_accept_tree(
+        struct common_sampler * gsmpl,
+        struct llama_context * ctx,
+        const std::vector<int> & idxs,
+        const common_speculative_tree & tree,
+        std::vector<int32_t> & path,
+        bool grammar_first) {
+    GGML_ASSERT(idxs.size() == tree.size() + 1 && "idxs.size() must be tree.size() + 1");
+
+    // idxs[0] is the logit row of the tree's implicit root (the already-sampled
+    // token); idxs[1 + i] is the logit row of node i. Sampling at a node's row
+    // yields the target's true continuation *after* that node, so the walk
+    // descends by matching that token against the node's children.
+    //
+    // This is the same accept rule as the linear case - a plain compare, which is
+    // lossless at greedy only - just over a branching draft instead of a chain.
+
+    std::vector<llama_token> result;
+    result.reserve(tree.depth() + 1);
+
+    path.clear();
+
+    int32_t cur = -1; // current node index, -1 = the root
+
+    while (true) {
+        const int   row = (cur < 0) ? idxs[0] : idxs[1 + cur];
+        const llama_token id = common_sampler_sample(gsmpl, ctx, row, grammar_first);
+
+        common_sampler_accept(gsmpl, id, true);
+
+        result.push_back(id);
+
+        // descend into the child of `cur` that proposed exactly this token
+        int32_t next = -1;
+        for (size_t i = 0; i < tree.size(); ++i) {
+            if (tree.parent[i] == cur && tree.tok[i] == id) {
+                next = (int32_t) i;
+                break;
+            }
+        }
+
+        if (next < 0) {
+            // no child matched: this token was not drafted, so it is the last one
+            break;
+        }
+
+        path.push_back(next);
+        cur = next;
+    }
+
+    return result;
+}
