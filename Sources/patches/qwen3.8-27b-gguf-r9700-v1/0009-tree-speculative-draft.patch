+    // costs no draft time at all - only verify positions, which are flat to 8.
+    void draft_tree(common_speculative_draft_params_vec & dparams) {
+        const llama_seq_id seq_id = 0; // tree drafting is single-slot by construction
+
+        auto & dp = dparams[seq_id];
+
+        auto * ctx_dft = params.ctx_dft;
+        auto * mem_dft = llama_get_memory(ctx_dft);
+
+        auto & tree = *dp.tree;
+
+        tree.clear();
+        dp.result->clear();
+
+        const size_t row_bytes = (size_t) n_embd * sizeof(float);
+
+        // Every branch has to see the prompt, which process() wrote under seq 0.
+        // The mask keys off seq_id[0], so a node whose key is a leaf id would not
+        // see seq 0 at all - hence one cell-bitset copy per LEAF, once per pass
+        // (3 copies for the default shape, not one per node).
+        for (llama_seq_id s : tree_leaf_seqs) {
+            llama_memory_seq_rm(mem_dft, s, -1, -1);
+            llama_memory_seq_cp(mem_dft, seq_id, s, -1, -1);
+        }
