+        for (int32_t lvl = 1; lvl <= tree_depth; ++lvl) {
+            if (llama_decode(ctx_dft, batch) != 0) {
+                SPC_ERR("draft_tree: llama_decode failed at level %d\n", lvl);
+                break;
+            }
