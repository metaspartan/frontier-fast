+// 0053: arrival counters for the cross-block q8_1 epilogue below. One slot per
+// 32-element destination group; every slot is left at 0 by the block that
+// closes it, so the array is self-resetting across launches and across the
+// graph replay. Sized for the largest routed-expert destination this fires on
+// (n_expert_used * ffn_len / QK8_1 = 128 on this model).
+__device__ unsigned int mmvq_q8_1_tail_counters[MMVQ_Q8_1_TAIL_MAX_GROUPS];
+
