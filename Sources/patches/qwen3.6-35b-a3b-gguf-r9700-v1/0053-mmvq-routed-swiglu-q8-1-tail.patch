+// 0053: the routed SwiGLU's q8_1 quantize, run as a cross-block EPILOGUE of the
+// gate+up matvec that produces it rather than as its own dispatch. A q8_1 block
+// needs 32 consecutive destination elements and this kernel gives each block
+// rows_per_cuda_block of them, so no block can quantize alone - round 37 closed
+// the guest and fold framings on exactly that. An arrival counter per 32-element
+// group reaches it without a grid barrier: each block fences and bumps its
+// group's counter, and the block that observes the last arrival re-reads the 32
+// floats and quantizes them. Nobody spins and nobody waits; the closing block
+// resets the slot, so the counters are self-clearing across a graph replay.
+//
+// `q8_1_dst` is the shared quantized-src1 cache entry the consuming expert-down
+// MUL_MAT_ID will look up. It is registered BEFORE the launch, so a launch whose
+// geometry cannot carry the epilogue must be followed by the standalone
+// quantize into that same buffer - `tail_launched` reports which happened.
+#define MMVQ_Q8_1_TAIL_MAX_GROUPS 2048
+struct mmvq_q8_1_tail {
+    void *   q8_1_dst = nullptr;
+    uint32_t nrows    = 0;   // filled in by ggml_cuda_mul_mat_vec_q
+};
