     const void    * GGML_CUDA_RESTRICT vx  = vx_ptr;
     const void    * GGML_CUDA_RESTRICT vy  = vy_ptr;
     const int32_t * GGML_CUDA_RESTRICT ids = ids_ptr;
@@ -796,6 +804,66 @@ static __global__ void mul_mat_vec_q(
         }
     }
 
+    // ---- 0053: the routed SwiGLU's q8_1 quantize, as a cross-block epilogue --
+    // The standalone `quantize_q8_1` launch exists only because a q8_1 block
+    // needs 32 CONSECUTIVE destination elements while this kernel gives each
+    // block rows_per_cuda_block of them - the 32 live in QK8_1/rpb different
+    // blocks, so no block can quantize on its own and the guest/fold framings
+    // are both blocked (round 37 closed them for exactly this reason).
+    //
+    // An arrival counter reaches it without a grid barrier. Each block
+    // publishes its outputs with a device-scope fence and bumps its group's
+    // counter; the block that observes the last arrival is, by that
+    // observation, ordered after every other block's store, so it - and only
+    // it - re-reads the group's 32 floats and runs glu_quant_store on them.
+    // Nobody spins: the other QK8_1/rpb-1 blocks retire immediately, and the
+    // closing block resets the slot so the next launch starts at zero.
+    //
+    // Bit-identity is by construction and does not rest on the fence being
+    // fast: the 32 values are the exact f32 words this launch stored, read back
+    // through memory precisely as the separate `quantize_q8_1` launch would
+    // have read them, and glu_quant_store is that kernel's arithmetic
+    // statement for statement - lane L holds flat element 32g+L, the same
+    // warp_reduce_max/warp_reduce_sum over the same 32 lanes, the same
+    // d = amax/127, the same roundf, the same packed ds.
+    if constexpr (has_q8_1_tail) {
+        constexpr int blocks_per_group = QK8_1 / rows_per_cuda_block;
+        static_assert(rows_per_cuda_block <= QK8_1 && QK8_1 % rows_per_cuda_block == 0,
+                      "the q8_1 tail needs rows_per_cuda_block to tile a QK8_1 group");
+        if (tail.q8_1_dst != nullptr) {
+            const uint32_t group_in_ch = (uint32_t) row0 / QK8_1;
+            const uint32_t group       = channel_dst*(stride_channel_dst / QK8_1) + group_in_ch;
+
+            // release: this block's stores are visible before its arrival is
+            __threadfence();
+            unsigned int prev = 0;
+            if (threadIdx.x == 0) {
+                prev = atomicAdd(&mmvq_q8_1_tail_counters[group], 1u);
+            }
+            // broadcast lane 0's ticket; every other lane contributes 0 and the
+            // ticket is non-negative, so a max is an exact broadcast here
+            prev = (unsigned int) warp_reduce_max<warp_size>((float) prev);
+
+            if (prev + 1 == (unsigned int) blocks_per_group) {
+                if (threadIdx.x == 0) {
+                    mmvq_q8_1_tail_counters[group] = 0; // self-reset for the next launch
+                }
+                // acquire: pick up the other blocks' stores rather than a
+                // cached line. `dst` is __restrict__ and this block wrote only
+                // its own rows, so the load has to be volatile as well.
+                __threadfence();
+                const int64_t group_base = (int64_t) group_in_ch*QK8_1;
+                const int64_t rel        = group_base - (int64_t) row0 + (int64_t) threadIdx.x;
+                const float   v          = *(const volatile float *) (dst + rel);
+                // flat contiguous element index of the destination tensor:
+                // the slots sit on ne[1] with stride_channel_dst == nrows
+                const int64_t flat = (int64_t) channel_dst*stride_channel_dst +
+                                     (int64_t) group_in_ch*QK8_1 + (int64_t) threadIdx.x;
+                glu_quant_store(v, tail.q8_1_dst, flat);
+            }
+        }
+    }
