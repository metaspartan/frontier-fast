+// ----- grouped mmvf (tiny F32 matvec class) launch detection ------------------
+//
+// The GDN/linear-attention layers issue several tiny F32 matvecs over the same
+// activation (alpha/beta projections, the MoE router, the shared-expert gate).
+// Each is a one-warp-per-row launch of a few dozen rows: pure launch latency.
+// Grouping them mirrors the grouped mmvq launch: same-src1 plain F32 matvecs
+// become one kernel with concatenated row ranges, per-row arithmetic unchanged.
+// Restricted to RDNA, where the decode mmvf path always uses one-warp blocks,
+// so the grouped kernel reproduces the exact stock instruction sequence.
+
+static bool ggml_cuda_mmvf_can_group(const ggml_tensor * node, const int cc) {
+    if (!GGML_CUDA_CC_IS_RDNA(cc)) {
+        return false;
+    }
+    if (node->op != GGML_OP_MUL_MAT) {
+        return false;
+    }
+    const ggml_tensor * src0 = node->src[0];
+    const ggml_tensor * src1 = node->src[1];
+    if (src0 == nullptr || src1 == nullptr || node->src[2] != nullptr) {
+        return false;
+    }
+    if ((node->flags & GGML_TENSOR_FLAG_COMPUTE) == 0) {
+        return false;
+    }
+    if (ggml_get_op_params_i32(node, 1) == GGML_HINT_SRC0_IS_HADAMARD) {
+        return false;
+    }
+    if (src0->type != GGML_TYPE_F32 || src1->type != GGML_TYPE_F32 || node->type != GGML_TYPE_F32) {
+        return false;
+    }
+    if (src0->ne[2] != 1 || src0->ne[3] != 1 || src0->nb[0] != sizeof(float)) {
+        return false;
+    }
+    if (src1->ne[1] != 1 || src1->ne[2] != 1 || src1->ne[3] != 1 || !ggml_is_contiguous(src1)) {
+        return false;
+    }
+    if (node->ne[1] != 1 || node->ne[2] != 1 || node->ne[3] != 1 || !ggml_is_contiguous(node)) {
+        return false;
+    }
+    if (src0->ne[0] % 2 != 0) {
+        return false; // float2 loads
+    }
+    if (src0->buffer == nullptr ||
+            ggml_backend_buffer_get_usage(src0->buffer) == GGML_BACKEND_BUFFER_USAGE_COMPUTE) {
+        return false;
+    }
+    // must be exactly the mmvf route of ggml_cuda_mul_mat (checked first there)
+    if (!ggml_cuda_should_use_mmvf(src0->type, cc, src0->ne, src0->nb, /*ne11 =*/ 1)) {
+        return false;
+    }
+    return true;
+}
+
+static int ggml_cuda_mmvf_collect_group(const ggml_cgraph * cgraph, const int start, ggml_tensor ** members, const int cc) {
+    ggml_tensor * first = cgraph->nodes[start];
+    const ggml_tensor * src1 = first->src[1];
+    members[0] = first;
+    int n = 1;
+
+    constexpr int scan_window = 40;
+    const int end = std::min(cgraph->n_nodes, start + 1 + scan_window);
+
+    for (int j = start + 1; j < end && n < MMVF_MAX_GROUP_SIZE; ++j) {
+        ggml_tensor * cand = cgraph->nodes[j];
+        if (ggml_cuda_is_view_or_noop(cand)) {
+            continue;
+        }
+        if (cand->op == GGML_OP_MUL_MAT && cand->src[1] == src1 &&
+                cand->src[0]->ne[0] == first->src[0]->ne[0] &&
+                cand->src[0]->nb[1] == first->src[0]->nb[1] &&
+                ggml_cuda_mmvf_can_group(cand, cc) &&
+                !ggml_cuda_mmvq_would_glu_fuse(cgraph, j) &&
+                ggml_cuda_mmvq_hoist_legal(cgraph, start, j)) {
+            members[n++] = cand;
+        }
+    }
+    return n;
+}
