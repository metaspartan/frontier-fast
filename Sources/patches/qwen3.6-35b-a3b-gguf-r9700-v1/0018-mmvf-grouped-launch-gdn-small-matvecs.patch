diff --git a/ggml/src/ggml-cuda/mmvf.cu b/ggml/src/ggml-cuda/mmvf.cu
index d6170701b..223845cb8 100644
--- a/ggml/src/ggml-cuda/mmvf.cu
+++ b/ggml/src/ggml-cuda/mmvf.cu
@@ -750,6 +750,129 @@ static void mul_mat_vec_f_cuda(
         stride_channel_dst, nsamples_x, nsamples_dst, stride_sample_x, stride_sample_y, stride_sample_dst, ids_stride, stream);
 }
 
+struct mmvf_grouped_args {
+    const float * vx[MMVF_MAX_GROUP_SIZE];
+    float       * dst[MMVF_MAX_GROUP_SIZE];
+    uint32_t      seg_end[MMVF_MAX_GROUP_SIZE - 1];
+};
+
+// The mul_mat_vec_f<float, float, /*ncols_dst=*/1, warp_size, false, false>
+// body with the dead channel/sample/ids indexing constant-folded away, plus
+// integer-only segment routing on blockIdx.x. One warp per row, identical
+// unroll-batched k-loop, identical warp reduction: results are byte-identical
+// to the individual launches.
+static __global__ void mul_mat_vec_f_grouped(
+        const mmvf_grouped_args args, const float * __restrict__ y_ptr,
+        const int ncols2, const int stride_row) {
+    constexpr int warp_size = ggml_cuda_get_physical_warp_size();
+    constexpr int block_size = warp_size;
+    const int tid = threadIdx.x;
+
+    uint32_t seg       = 0;
+    uint32_t seg_start = 0;
+#pragma unroll
+    for (int s = 0; s < MMVF_MAX_GROUP_SIZE - 1; ++s) {
+        if (blockIdx.x >= args.seg_end[s]) {
+            seg       = s + 1;
+            seg_start = args.seg_end[s];
+        }
+    }
+    const int row = blockIdx.x - seg_start;
+
+    ggml_cuda_pdl_sync();
+
+    const float2 * x2 = (const float2 *) (args.vx[seg] + (int64_t) row * stride_row);
+    const float2 * y2 = (const float2 *) y_ptr;
+    float        * dst = args.dst[seg];
+
+    float sumf = 0.0f;
+
+    constexpr int nunroll = mmvf_nunroll<1, false>();
+    int col2 = tid;
+    for (; col2 + (nunroll - 1)*block_size < ncols2; col2 += nunroll*block_size) {
+        float2 tmpx[nunroll];
+        float2 tmpy[nunroll];
+#pragma unroll
+        for (int u = 0; u < nunroll; ++u) {
+            tmpx[u] = x2[col2 + u*block_size];
+        }
+#pragma unroll
+        for (int u = 0; u < nunroll; ++u) {
+            tmpy[u] = y2[col2 + u*block_size];
+        }
+#pragma unroll
+        for (int u = 0; u < nunroll; ++u) {
+            ggml_cuda_mad(sumf, tmpx[u].x, tmpy[u].x);
+            ggml_cuda_mad(sumf, tmpx[u].y, tmpy[u].y);
+        }
+    }
+    for (; col2 < ncols2; col2 += block_size) {
+        const float2 tmpx = x2[col2];
+        const float2 tmpy = y2[col2];
+        ggml_cuda_mad(sumf, tmpx.x, tmpy.x);
+        ggml_cuda_mad(sumf, tmpx.y, tmpy.y);
+    }
+
+    ggml_cuda_pdl_lc();
+    sumf = warp_reduce_sum<warp_size>(sumf);
+
+    if (tid != 0) {
+        return;
+    }
+    dst[row] = sumf;
+}
+
+void ggml_cuda_mul_mat_vec_f_grouped(ggml_backend_cuda_context & ctx, ggml_tensor * const * nodes, int n_nodes) {
+    GGML_ASSERT(n_nodes >= 2 && n_nodes <= MMVF_MAX_GROUP_SIZE);
+
+    const ggml_tensor * src1       = nodes[0]->src[1];
+    const ggml_tensor * src0_first = nodes[0]->src[0];
+
+    GGML_ASSERT(src1->type == GGML_TYPE_F32);
+    GGML_ASSERT(src0_first->type == GGML_TYPE_F32);
+    GGML_ASSERT(src1->ne[1] == 1 && src1->ne[2] == 1 && src1->ne[3] == 1);
+
+    const int64_t ne10 = src1->ne[0];
+    GGML_ASSERT(ne10 % 2 == 0);
+
+    const int64_t stride_row = src0_first->nb[1] / sizeof(float);
+
+    mmvf_grouped_args args = {};
+    uint32_t total_rows = 0;
+    for (int m = 0; m < n_nodes; ++m) {
+        const ggml_tensor * src0 = nodes[m]->src[0];
+        ggml_tensor       * dst  = nodes[m];
+        GGML_ASSERT(dst->op == GGML_OP_MUL_MAT);
+        GGML_ASSERT(dst->src[1] == src1 && dst->src[2] == nullptr);
+        GGML_ASSERT(src0->type == GGML_TYPE_F32);
+        GGML_ASSERT(src0->ne[0] == ne10);
+        GGML_ASSERT(src0->ne[2] == 1 && src0->ne[3] == 1);
+        GGML_ASSERT((int64_t)(src0->nb[1]/sizeof(float)) == stride_row);
+        GGML_ASSERT(dst->type == GGML_TYPE_F32);
+        GGML_ASSERT(dst->ne[0] == src0->ne[1]);
+        GGML_ASSERT(dst->ne[1] == 1 && dst->ne[2] == 1 && dst->ne[3] == 1);
+
+        args.vx[m]  = (const float *) src0->data;
+        args.dst[m] = (float *) dst->data;
+        total_rows += (uint32_t) src0->ne[1];
+        if (m < MMVF_MAX_GROUP_SIZE - 1) {
+            args.seg_end[m] = total_rows;
+        }
+    }
+    // pad the routing table so unused slots never match
+    for (int m = n_nodes - 1; m < MMVF_MAX_GROUP_SIZE - 1; ++m) {
+        args.seg_end[m] = total_rows;
+    }
+
+    const int warp_size = ggml_cuda_info().devices[ggml_cuda_get_device()].warp_size;
+    const dim3 block_nums(total_rows, 1, 1);
+    const dim3 block_dims(warp_size, 1, 1);
+
+    const ggml_cuda_kernel_launch_params launch_params = {block_nums, block_dims, 0, ctx.stream()};
+    ggml_cuda_kernel_launch(mul_mat_vec_f_grouped, launch_params,
+        args, (const float *) src1->data, (int)(ne10/2), (int) stride_row);
+}
