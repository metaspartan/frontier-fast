+    }
+    dst[row] = out;
 }
 
-void ggml_cuda_mul_mat_vec_f_grouped(ggml_backend_cuda_context & ctx, ggml_tensor * const * nodes, int n_nodes) {
+void ggml_cuda_mul_mat_vec_f_grouped(ggml_backend_cuda_context & ctx, ggml_tensor * const * nodes, ggml_tensor * const * sigmoid_nodes, int n_nodes) {
     GGML_ASSERT(n_nodes >= 2 && n_nodes <= MMVF_MAX_GROUP_SIZE);
 
     const ggml_tensor * src1       = nodes[0]->src[1];
@@ -853,7 +858,17 @@ void ggml_cuda_mul_mat_vec_f_grouped(ggml_backend_cuda_context & ctx, ggml_tenso
         GGML_ASSERT(dst->ne[1] == 1 && dst->ne[2] == 1 && dst->ne[3] == 1);
 
         args.vx[m]  = (const float *) src0->data;
-        args.dst[m] = (float *) dst->data;
+        if (sigmoid_nodes != nullptr && sigmoid_nodes[m] != nullptr) {
+            // fused epilogue: write sigmoid(sum) straight into the sigmoid
+            // node's destination; the matvec's own dst is never materialized
+            // (its only consumer is the fused sigmoid)
+            GGML_ASSERT(sigmoid_nodes[m]->src[0] == dst);
+            args.dst[m]    = (float *) sigmoid_nodes[m]->data;
+            args.postop[m] = 1;
+        } else {
+            args.dst[m]    = (float *) dst->data;
+            args.postop[m] = 0;
+        }
         total_rows += (uint32_t) src0->ne[1];
         if (m < MMVF_MAX_GROUP_SIZE - 1) {
             args.seg_end[m] = total_rows;
