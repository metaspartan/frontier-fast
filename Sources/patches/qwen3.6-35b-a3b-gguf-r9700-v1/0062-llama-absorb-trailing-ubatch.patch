---
diff --git a/src/llama-context.cpp b/src/llama-context.cpp
index 19cca7df1..eda40da9e 100644
--- a/src/llama-context.cpp
+++ b/src/llama-context.cpp
@@ -574,6 +574,50 @@ void llama_context::resolve_fused_ops(const llama_memory_context_i * mctx, uint3
     }
 }
 
+// [gainz] Adaptive tail-ubatch absorption.
+//
+// On a sparse-MoE model the cost of a ubatch is dominated by the routed expert
+// weights it must read, and that is a function of experts and layers rather
+// than of how many tokens the ubatch carries.  A batch that overhangs n_ubatch
+// by a little therefore pays a SECOND full sweep of the expert weights for that
+// handful of tokens: on Qwen3.6-35B-A3B (256 experts, top-8) at the default
+// n_ubatch = 512 the ranked 534-token prompt splits 512 + 22, and the 22-token
+// tail costs nearly what the 512-token ubatch does.
+//
+// This is only reachable once the server stops pre-chunking the prompt to build
+// context checkpoints (see the server-side adaptive checkpointing patch); while
+// it did, llama_decode never saw more than n_ubatch and the test below was
+// never true.
+//
+// Returns the largest ubatch that may be formed by absorbing such an overhang,
+// or 0 when absorption is disabled.
+static uint32_t llama_ubatch_absorb_max(const llama_cparams & cparams) {
+    static const bool enabled = []() {
+        const char * env = getenv("LLAMA_UBATCH_ABSORB");
+        return env == nullptr || atoi(env) != 0;
+    }();
+
+    if (!enabled) {
+        return 0;
+    }
+
+    const uint32_t n_max = std::min(cparams.n_batch, cparams.n_ubatch + cparams.n_ubatch/8);
+
+    return n_max > cparams.n_ubatch ? n_max : 0;
+}
+
+// The ubatch size to split `n_tokens` with: n_ubatch normally, or the whole
+// batch when it overhangs n_ubatch by no more than the absorption bound.
+static uint32_t llama_ubatch_effective(const llama_cparams & cparams, uint32_t n_tokens) {
+    const uint32_t n_absorb = llama_ubatch_absorb_max(cparams);
+
+    if (n_absorb > cparams.n_ubatch && n_tokens > cparams.n_ubatch && n_tokens <= n_absorb) {
+        return n_tokens;
+    }
+
+    return cparams.n_ubatch;
+}
+
 void llama_context::sched_reserve() {
     if (!sched_need_reserve) {
         return;
@@ -588,7 +632,8 @@ void llama_context::sched_reserve() {
     const int64_t t_start_us = ggml_time_us();
 
     const uint32_t n_seqs = cparams.n_seq_max;
-    const uint32_t n_tokens = std::min(cparams.n_ctx, cparams.n_ubatch);
+    const uint32_t n_ubatch_res = std::max(cparams.n_ubatch, llama_ubatch_absorb_max(cparams));
+    const uint32_t n_tokens = std::min(cparams.n_ctx, n_ubatch_res);
 
     const size_t max_nodes = this->graph_max_nodes(n_tokens);
 
@@ -819,7 +864,8 @@ bool llama_context::memory_update(bool optimize) {
         }
 
         const uint32_t n_seqs = cparams.n_seq_max;
-        const uint32_t n_tokens = std::min(cparams.n_ctx, cparams.n_ubatch);
+        const uint32_t n_ubatch_res = std::max(cparams.n_ubatch, llama_ubatch_absorb_max(cparams));
+        const uint32_t n_tokens = std::min(cparams.n_ctx, n_ubatch_res);
 
         const uint32_t n_outputs_max = std::min(n_tokens, cparams.n_outputs_max);
 
@@ -1794,8 +1840,10 @@ int llama_context::decode(const llama_batch & batch_inp) {
 
     llama_memory_context_ptr mctx;
 
+    const uint32_t n_ubatch_eff = llama_ubatch_effective(cparams, balloc->get_n_tokens());
+
     while (true) {
-        mctx = memory->init_batch(*balloc, cparams.n_ubatch, output_all);
+        mctx = memory->init_batch(*balloc, n_ubatch_eff, output_all);
         if (!mctx) {
             return -2;
         }
