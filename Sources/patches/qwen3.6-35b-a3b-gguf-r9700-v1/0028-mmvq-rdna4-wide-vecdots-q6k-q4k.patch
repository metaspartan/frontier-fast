     const dim3 block_nums(total_rows, 1, 1);
-    const dim3 block_dims(warp_size, calc_nwarps_launched<type>(ncols_x, nwarps, warp_size), 1);
+    const dim3 block_dims(warp_size, calc_nwarps_launched<type>(ncols_x, nwarps, warp_size, table_id), 1);
 
     const ggml_cuda_kernel_launch_params launch_params = ggml_cuda_kernel_launch_params(block_nums, block_dims, 0, stream);
     ggml_cuda_kernel_launch(mul_mat_vec_q_grouped<type>, launch_params, args_in, vy, ncols_x, stride_row_x);
@@ -1213,7 +1229,7 @@ static void mul_mat_vec_q_switch_ncols_dst(
         // Trigger when the full thread block covers all K blocks in a single loop iteration and few threads remain idle.
         constexpr int qk                    = ggml_cuda_type_traits<type>::qk;
         constexpr int qi                    = ggml_cuda_type_traits<type>::qi;
-        constexpr int vdr                   = get_vdr_mmvq(type);
+        const     int vdr                   = get_vdr_mmvq(type, table_id);
         const int     blocks_per_row_x      = ncols_x / qk;
         const int     blocks_per_iter_1warp = vdr * warp_size / qi;
         const int     nwarps                = calc_nwarps(type, c_ncols_dst, table_id);
diff --git a/ggml/src/ggml-cuda/vecdotq.cuh b/ggml/src/ggml-cuda/vecdotq.cuh
index 0f039c735..5d454ba32 100644
--- a/ggml/src/ggml-cuda/vecdotq.cuh
+++ b/ggml/src/ggml-cuda/vecdotq.cuh
@@ -907,6 +907,66 @@ static __device__ __forceinline__ float vec_dot_q3_K_q8_1(
     return vec_dot_q3_K_q8_1_impl_mmvq(vl, vh, u, bq3_K->scales, scale_offset, d, d8);
 }
 
+#if defined(GGML_USE_HIP) && defined(RDNA4)
+// RDNA4 wide variant: one call covers the column pair (iqs, iqs+2) of the vdr = 2 form
+// (vdr = 4, iqs is a multiple of 4). The pair shares bq8_offset, the unpacked
+// scale/min pair and d8, so that work is done once, and every q4/q8 fetch becomes an
+// 8-byte load (block_q4_K is 144 bytes, so the loads stay 16-byte aligned).
+static __device__ __forceinline__ float vec_dot_q4_K_q8_1(
+    const void * __restrict__ vbq, const block_q8_1 * __restrict__ bq8_1, const int & kbx, const int & iqs) {
+
+    const block_q4_K * bq4_K = (const block_q4_K *) vbq + kbx;
+
+    const int bq8_offset = QR4_K * ((iqs/2) / (QI8_1/2));
+    const int i0         = (iqs/2) % 4; // {0, 2}: columns i0 and i0+1
+
+    const int * q4 = (const int *)(bq4_K->qs + 16*bq8_offset);
+    int2 va, vb;
+    __builtin_memcpy(&va, q4 + i0,     sizeof(va));
+    __builtin_memcpy(&vb, q4 + i0 + 4, sizeof(vb));
+
+    const uint16_t * scales = (const uint16_t *)bq4_K->scales;
+    uint16_t aux[2];
+    const int j = bq8_offset/2;
+    if (j < 2) {
+        aux[0] = scales[j+0] & 0x3f3f;
+        aux[1] = scales[j+2] & 0x3f3f;
+    } else {
+        aux[0] = ((scales[j+2] >> 0) & 0x0f0f) | ((scales[j-2] & 0xc0c0) >> 2);
+        aux[1] = ((scales[j+2] >> 4) & 0x0f0f) | ((scales[j-0] & 0xc0c0) >> 2);
+    }
+    const uint8_t * sc = (const uint8_t *)aux;
+    const uint8_t * m  = sc + 2;
+
+    float sumf_d = 0.0f;
+    float sumf_m = 0.0f;
+#pragma unroll
+    for (int i = 0; i < QR4_K; ++i) {
+        const block_q8_1 * bq8i = bq8_1 + bq8_offset + i;
+        const float d8 = __low2float(bq8i->ds);
+        const int * q8 = (const int *)bq8i->qs;
+        int2 ua, ub;
+        __builtin_memcpy(&ua, q8 + i0,     sizeof(ua));
+        __builtin_memcpy(&ub, q8 + i0 + 4, sizeof(ub));
+
+        const int vax = (va.x >> (4*i)) & 0x0F0F0F0F;
+        const int vay = (va.y >> (4*i)) & 0x0F0F0F0F;
+        const int vbx = (vb.x >> (4*i)) & 0x0F0F0F0F;
+        const int vby = (vb.y >> (4*i)) & 0x0F0F0F0F;
+
+        int dot1 = ggml_cuda_dp4a(vbx, ub.x, ggml_cuda_dp4a(vax, ua.x, 0));
+        dot1     = ggml_cuda_dp4a(vby, ub.y, ggml_cuda_dp4a(vay, ua.y, dot1));
+        int dot2 = ggml_cuda_dp4a(0x01010101, ub.x, ggml_cuda_dp4a(0x01010101, ua.x, 0));
+        dot2     = ggml_cuda_dp4a(0x01010101, ub.y, ggml_cuda_dp4a(0x01010101, ua.y, dot2));
+
+        sumf_d += d8 * (dot1 * sc[i]);
+        sumf_m += d8 * (dot2 * m[i]);
+    }
+
+    const float2 dm4f = __half22float2(bq4_K->dm);
+    return dm4f.x*sumf_d - dm4f.y*sumf_m;
+}
+#else
 static __device__ __forceinline__ float vec_dot_q4_K_q8_1(
     const void * __restrict__ vbq, const block_q8_1 * __restrict__ bq8_1, const int & kbx, const int & iqs) {
 
@@ -952,6 +1012,7 @@ static __device__ __forceinline__ float vec_dot_q4_K_q8_1(
 
     return vec_dot_q4_K_q8_1_impl_vmmq(v, u, sc, m, bq4_K->dm, d8);
 }
+#endif // defined(GGML_USE_HIP) && defined(RDNA4)
 
 static __device__ __forceinline__ float vec_dot_q5_K_q8_1(
     const void * __restrict__ vbq, const block_q8_1 * __restrict__ bq8_1, const int & kbx, const int & iqs) {
@@ -999,6 +1060,54 @@ static __device__ __forceinline__ float vec_dot_q5_K_q8_1(
     return vec_dot_q5_K_q8_1_impl_vmmq(vl, vh, u, sc, m, bq5_K->dm, d8);
 }
 
+#if defined(GGML_USE_HIP) && defined(RDNA4)
+// RDNA4 wide variant: one call consumes TWO consecutive 32-bit words of ql (vdr = 2,
+// iqs is even). The pair shares its scale pair, q8_1 blocks, d8 factors and qh shift,
+// so those fetches are issued once instead of twice, and the ql/qh/q8 fetches become
+// 8-byte loads. Q6_K blocks are 210 bytes so the 8-byte loads are only 2-byte aligned;
+// gfx12 global loads support that in hardware.
+static __device__ __forceinline__ float vec_dot_q6_K_q8_1(
+    const void * __restrict__ vbq, const block_q8_1 * __restrict__ bq8_1, const int & kbx, const int & iqs) {
+
+    const block_q6_K * bq6_K = (const block_q6_K *) vbq + kbx;
+
+    const int bq8_offset   = 2 * QR6_K * (iqs / (QI6_K/2)) + (iqs % (QI6_K/2)) / (QI6_K/4);
+    const int scale_offset = (QI6_K/4) * (iqs / (QI6_K/2)) + (iqs % (QI6_K/2)) / (QI6_K/8);
+    const int vh_shift     = 2 * ((iqs % (QI6_K/2)) / (QI6_K/4));
+    const int vh_idx       = (QI6_K/4) * (iqs / (QI6_K/2)) + iqs % (QI6_K/4);
+
+    int2 vl2, vh2;
+    __builtin_memcpy(&vl2, bq6_K->ql + sizeof(int)*iqs,    sizeof(vl2));
+    __builtin_memcpy(&vh2, bq6_K->qh + sizeof(int)*vh_idx, sizeof(vh2));
+    const int vh2x = vh2.x >> vh_shift;
+    const int vh2y = vh2.y >> vh_shift;
+
+    const int   sc0 = bq6_K->scales[scale_offset];
+    const int   sc1 = bq6_K->scales[scale_offset + 4];
+    const float d   = bq6_K->d;
+
+    float sumf = 0.0f;
+#pragma unroll
+    for (int i = 0; i < QR6_K; ++i) {
+        const int sc = i == 0 ? sc0 : sc1;
+
+        int2 u2;
+        __builtin_memcpy(&u2, bq8_1[bq8_offset + 2*i].qs + sizeof(int)*(iqs % QI8_1), sizeof(u2));
+        const float d8 = __low2float(bq8_1[bq8_offset + 2*i].ds);
+
+        const int vi0 = __vsubss4(((vl2.x >> (4*i)) & 0x0F0F0F0F) | (((vh2x >> (4*i)) << 4) & 0x30303030), 0x20202020);
+        const int vi1 = __vsubss4(((vl2.y >> (4*i)) & 0x0F0F0F0F) | (((vh2y >> (4*i)) << 4) & 0x30303030), 0x20202020);
+
+        int sumi = 0;
+        sumi = ggml_cuda_dp4a(vi0, u2.x, sumi);
+        sumi = ggml_cuda_dp4a(vi1, u2.y, sumi);
+
+        sumf += d8 * (sumi * sc);
+    }
+
+    return d * sumf;
+}
+#else
 static __device__ __forceinline__ float vec_dot_q6_K_q8_1(
     const void * __restrict__ vbq, const block_q8_1 * __restrict__ bq8_1, const int & kbx, const int & iqs) {
 
@@ -1024,6 +1133,7 @@ static __device__ __forceinline__ float vec_dot_q6_K_q8_1(
 
     return vec_dot_q6_K_q8_1_impl_mmvq(vl, vh, u, scales, bq6_K->d, d8);
 }
+#endif // defined(GGML_USE_HIP) && defined(RDNA4)
 
 #define VDR_IQ2_XXS_Q8_1_MMVQ 2
 #define VDR_IQ2_XXS_Q8_1_MMQ  2
