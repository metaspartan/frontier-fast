From: Claude Fable 5 <noreply@anthropic.com>
Subject: [PATCH 28/28] cuda/hip: RDNA4 wide mmvq vec_dots (Q6_K vdr=2, Q4_K vdr=4)

Decode is 64%+ mmvq and every K-quant path runs at 54-89% of the 644
GB/s DRAM peak. This widens the per-lane column footprint of the Q6_K
and Q4_K mmvq vec_dots on RDNA4 so consecutive 32-bit quant words are
fetched with one 8-byte load and the per-column bookkeeping is shared:

- Q6_K vdr 1 -> 2: the (iqs, iqs+1) word pair shares its scale pair,
  q8_1 blocks, d8 factors and qh shift, so those fetches halve and
  ql/qh/q8 move as b64 loads (block_q6_K is 210 bytes, the loads are
  2-byte aligned; gfx12 handles that in hardware).
- Q4_K vdr 2 -> 4: the (iqs, iqs+2) column pair shares bq8_offset and
  the unpacked scale/min pair, and the 144-byte block keeps every q4/q8
  b64 load 16-byte aligned.

Host launch math (calc_nwarps_launched trim, should_use_small_k) and the
device kernels must agree on vdr, so both route through a new
table-aware get_vdr_mmvq(type, table_id) overload; non-RDNA4 tables keep
stock vdr everywhere and the CUDA path compiles unchanged.

Swept and rejected on the same box, recorded as findings: Q4_K vdr=8
(b128 loads, 21.4us - the k=2048 expert rows lose too much per-row wave
parallelism), Q5_K vdr=4 (14.0us vs 13.2 - k=512 is 2 blocks/row),
Q6_K nwarps 8 -> 4 (attn_output 14.1 -> 21.1us), small_k rpb 2 -> 4
(everything flat-to-worse). Dense Q6_K streams (lm head 626 GB/s = 97%
of peak) do not respond to load widening; the expert (MUL_MAT_ID)
gathers do.

Measured on the R9700 box (Qwen3.6-35B-A3B-UD-Q4_K_M):

- kernels (rocprofv3, tg32): Q4_K expert gate+up 19.97 -> 18.22us
  (473 -> 519 GB/s); Q6_K expert down 17.55 -> 13.82us (472 -> 599
  GB/s); attn_output 14.59 -> 14.11us; dense Q6_K flat.
- model (5-round interleaved A/B vs 26-patch control, combined with
  0027): tg128 119.77 -> 120.18 (+0.34%), pp512 +3.24% (0027-dominated),
  pp16384 +1.6%.
- correctness: full test-backend-ops suite all OK; ppl
  3.9256/3.9294/3.9271 (stock 3.9314, all deltas within +-0.15%, same
  cluster as the control binary in the same session). The merged
  integer dot products reassociate the per-column float accumulation
  (d8*(sc*(a+b)) vs d8*sc*a + d8*sc*b): greedy drifts mid-completion on
  long prompts as with 0024/0026 - reassociation class, ppl-gated.
  Short-prompt batched server smoke (4 concurrent greedy requests)
  coherent and consistent.
---
diff --git a/ggml/src/ggml-cuda/mmvq.cu b/ggml/src/ggml-cuda/mmvq.cu
index 417d82235..d1de35df1 100644
--- a/ggml/src/ggml-cuda/mmvq.cu
+++ b/ggml/src/ggml-cuda/mmvq.cu
@@ -111,6 +111,22 @@ static __host__ mmvq_parameter_table_id get_device_table_id(int cc) {
     return MMVQ_PARAMETERS_GENERIC;
 }
 
+// Table-aware vdr: RDNA4 runs the Q6_K mmvq vec_dot two words wide (see the
+// vec_dot_q6_K_q8_1 RDNA4 variant in vecdotq.cuh). Host launch math and device
+// kernels must agree, so both route through this overload with their table id.
+static constexpr __host__ __device__ int get_vdr_mmvq(ggml_type type, mmvq_parameter_table_id table_id) {
+#if defined(GGML_USE_HIP)
+    if (table_id == MMVQ_PARAMETERS_RDNA4) {
+        switch (type) {
+            case GGML_TYPE_Q6_K: return 2;
+            case GGML_TYPE_Q4_K: return 4;
+            default: break;
+        }
+    }
+#endif // defined(GGML_USE_HIP)
+    return get_vdr_mmvq(type);
+}
+
 // Per-architecture maximum batch size for which MMVQ should be used for MUL_MAT_ID.
 // Returns a value <= MMVQ_MAX_BATCH_SIZE. Default is MMVQ_MAX_BATCH_SIZE.
 // Check https://github.com/ggml-org/llama.cpp/pull/20905#issuecomment-4145835627 for details
@@ -503,8 +519,8 @@ static __global__ void mul_mat_vec_q(
 
     constexpr int qk  = ggml_cuda_type_traits<type>::qk;
     constexpr int qi  = ggml_cuda_type_traits<type>::qi;
-    constexpr int vdr = get_vdr_mmvq(type);
     constexpr mmvq_parameter_table_id table_id = get_device_table_id();
+    constexpr int vdr = get_vdr_mmvq(type, table_id);
     constexpr int nwarps = calc_nwarps(type, ncols_dst, table_id);
     constexpr int rows_per_cuda_block = calc_rows_per_block(ncols_dst, table_id, small_k, nwarps);
     constexpr int warp_size = ggml_cuda_get_physical_warp_size();
@@ -756,7 +772,7 @@ static __global__ void mul_mat_vec_q_moe(
 
     constexpr int qk  = ggml_cuda_type_traits<type>::qk;
     constexpr int qi  = ggml_cuda_type_traits<type>::qi;
-    constexpr int vdr = get_vdr_mmvq(type);
+    constexpr int vdr = get_vdr_mmvq(type, get_device_table_id());
     constexpr int warp_size = ggml_cuda_get_physical_warp_size();
 
     constexpr vec_dot_q_cuda_t vec_dot_q_cuda = get_vec_dot_q_cuda(type);
@@ -817,10 +833,10 @@ static __global__ void mul_mat_vec_q_moe(
 // construction. Only valid while blocks_per_row_x <= blocks_per_iter (a single k-loop pass), which
 // is exactly the case in which idle warps exist.
 template<ggml_type type>
-static __host__ int calc_nwarps_launched(const int ncols_x, const int nwarps, const int warp_size) {
+static __host__ int calc_nwarps_launched(const int ncols_x, const int nwarps, const int warp_size, const mmvq_parameter_table_id table_id) {
     constexpr int qk  = ggml_cuda_type_traits<type>::qk;
     constexpr int qi  = ggml_cuda_type_traits<type>::qi;
-    constexpr int vdr = get_vdr_mmvq(type);
+    const     int vdr = get_vdr_mmvq(type, table_id);
 
     if (nwarps <= 1 || vdr <= 0 || qi % vdr != 0) {
         return nwarps;
@@ -890,7 +906,7 @@ static std::pair<dim3, dim3> calc_launch_params(
     const int rpb = calc_rows_per_block(ncols_dst, table_id, small_k, nwarps);
     const int64_t nblocks = (nrows_x + rpb - 1) / rpb;
     const dim3 block_nums(nblocks, nchannels_dst, nsamples_or_ntokens);
-    int nwarps_launched = calc_nwarps_launched<type>(ncols_x, nwarps, warp_size);
+    int nwarps_launched = calc_nwarps_launched<type>(ncols_x, nwarps, warp_size, table_id);
     const int64_t total_blocks = (int64_t) block_nums.x * block_nums.y * block_nums.z;
     if (total_blocks < (int64_t) mmvq_untrim_below_blocks()) {
         nwarps_launched = nwarps;
@@ -932,8 +948,8 @@ static __global__ void mul_mat_vec_q_grouped(
     constexpr int ncols_dst = 1;
     constexpr int qk  = ggml_cuda_type_traits<type>::qk;
     constexpr int qi  = ggml_cuda_type_traits<type>::qi;
-    constexpr int vdr = get_vdr_mmvq(type);
     constexpr mmvq_parameter_table_id table_id = get_device_table_id();
+    constexpr int vdr = get_vdr_mmvq(type, table_id);
     constexpr int nwarps = calc_nwarps(type, ncols_dst, table_id);
     constexpr int rows_per_cuda_block = calc_rows_per_block(ncols_dst, table_id, small_k, nwarps);
     // seg_end is given in block units, so the segment scan works for any
@@ -1078,7 +1094,7 @@ static void mul_mat_vec_q_grouped_launch(
             }
             if (divisible) {
                 const dim3 block_nums(total_rows / rpb, 1, 1);
-                const dim3 block_dims(warp_size, calc_nwarps_launched<type>(ncols_x, nwarps, warp_size), 1);
+                const dim3 block_dims(warp_size, calc_nwarps_launched<type>(ncols_x, nwarps, warp_size, table_id), 1);
                 const ggml_cuda_kernel_launch_params launch_params = ggml_cuda_kernel_launch_params(block_nums, block_dims, 0, stream);
                 ggml_cuda_kernel_launch(mul_mat_vec_q_grouped<type, true>, launch_params, args_blk, vy, ncols_x, stride_row_x);
                 return;
@@ -1089,7 +1105,7 @@ static void mul_mat_vec_q_grouped_launch(
     // Same block shape (including the idle-warp trim, which depends only on the
