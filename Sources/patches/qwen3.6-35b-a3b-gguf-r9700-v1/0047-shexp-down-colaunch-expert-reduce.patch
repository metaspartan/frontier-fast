+// Returns false (having launched nothing) when this type/shape does not reduce
+// to the single-k-split-warp launch the kernel above is byte-exact against.
+// 0047: warps per guest row = what the guest's OWN standalone launch would use
+// (calc_launch_params + the untrim rule), so the guest's thread->k-block map is
+// unchanged. Returns 0 when the guest cannot be expressed at this block shape.
+template <ggml_type type_g>
+static int mmvq_expert_reduce_guest_warps(const int ncols_g, const int nrows_g, const int n_slots,
+                                          const int warp_size, const mmvq_parameter_table_id table_id) {
+    constexpr int qk_g = ggml_cuda_type_traits<type_g>::qk;
+    const int nwarps_g = calc_nwarps(type_g, 1, table_id);
+    if (calc_rows_per_block(1, table_id, /*small_k=*/false, nwarps_g) != 1) {
+        return 0;
+    }
+    if (ncols_g % qk_g != 0) {
+        return 0;
+    }
+    int gw = calc_nwarps_launched<type_g>(ncols_g, nwarps_g, warp_size, table_id);
+    if ((int64_t) nrows_g < (int64_t) mmvq_untrim_below_blocks()) {
+        gw = nwarps_g;
+    }
+    if (gw < 1 || gw > nwarps_g || n_slots % gw != 0) {
+        return 0;
+    }
+    const int rows_per_block_g = n_slots / gw;
+    if (rows_per_block_g < 1 || nrows_g % rows_per_block_g != 0) {
+        return 0;
+    }
+    return gw;
+}
