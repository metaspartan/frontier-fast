+// ---- 0047: the shared-expert down projection hidden in the expert-reduce ----
+//
+// Round 34's t(d) fit prices a removed MATVEC dispatch at 2.99 us of replay gap
+// plus ~2.85 us of bandwidth ramp; the shared-expert down projection is 40 of
+// them per token. It is a plain Q8_0 matvec of exactly the routed reduce's
+// output width (n_embd) over an entirely independent activation, so the two
+// grids concatenate. Both stay bit-identical: the guest blocks run the
+// mul_mat_vec_q<Q8_0,...> body verbatim (see mmvq.cu).
+//
+// The graph half (qwen35moe.cpp + llama-graph.cpp) pins the shared-expert
+// swiglu, down projection and gate multiply between the routed gate+up and the
+// routed down, so that (a) the two matvecs are adjacent in node order and (b)
+// ggml-alloc places the shared-expert output while the expert ids and routing
+// weights are still live - which is what makes the disjointness check pass at
+// all (round 31: the allocator, not the detector, is the usual blocker).
+struct mmvq_shexp_down_colaunch_info {
+    mmvq_expert_reduce_guest guest;
+    const ggml_tensor * guest_mul   = nullptr; // 0035 gate multiply, absorbed
+    ggml_tensor *       host        = nullptr; // the routed MUL_MAT_ID
+    const ggml_tensor * host_weights = nullptr;
+    ggml_tensor *       host_out    = nullptr;
+    int                 host_idx    = -1;
+    int                 host_last   = -1;
+};
+
+static bool ggml_cuda_shexp_down_colaunch_detect(
+        const ggml_cgraph * cgraph, const int i, mmvq_shexp_down_colaunch_info * out) {
+    ggml_tensor * guest = cgraph->nodes[i];
+    if (guest->op != GGML_OP_MUL_MAT || guest->src[2] != nullptr) {
+        return false;
+    }
+    if (guest->src[0]->type != GGML_TYPE_Q8_0 || guest->ne[1] != 1 || guest->ne[2] != 1 || guest->ne[3] != 1) {
+        return false;
+    }
+    if (!ggml_cuda_should_fuse_mul_mat_vec_q(guest)) {
+        return false;
+    }
+
+    // the 0035 shared-expert gate multiply, if it is fused into this matvec
+    const ggml_tensor * g_mul   = nullptr;
+    const ggml_tensor * g_scale = nullptr;
+    int                 j       = i + 1;
+    if (ggml_cuda_moe_weight_fuse_detect(cgraph, i, &g_mul, &g_scale, GGML_OP_MUL_MAT)) {
+        j = i + 2;
+    } else {
+        g_mul   = nullptr;
+        g_scale = nullptr;
+    }
+
+    // the very next real node must be the routed expert-down matvec
+    while (j < cgraph->n_nodes && ggml_cuda_is_view_or_noop(cgraph->nodes[j])) {
+        ++j;
+    }
+    if (j >= cgraph->n_nodes || cgraph->nodes[j]->op != GGML_OP_MUL_MAT_ID) {
+        return false;
+    }
+
+    const ggml_tensor * host_w    = nullptr;
+    ggml_tensor       * host_out  = nullptr;
+    int                 host_last = -1;
+    if (!ggml_cuda_moe_expert_reduce_detect(cgraph, j, &host_w, &host_out, &host_last)) {
+        return false;
+    }
+
+    ggml_tensor * host = cgraph->nodes[j];
+    // What the guest writes: the gate multiply's destination when that is fused
+    // in, the matvec's own otherwise.
+    const ggml_tensor * g_dst = g_mul != nullptr ? g_mul : guest;
+
+    // The two halves run in ONE kernel with no ordering between them, so every
+    // guest write must be disjoint from every host read AND write, and the
+    // other way round. This is the check 0045 shipped without once, and the
+    // race it produced was visible only at long context.
+    const ggml_tensor * host_reads[3] = { host->src[0], host->src[2], host_w };
+    for (int k = 0; k < 3; ++k) {
+        if (host_reads[k] != nullptr && !ggml_cuda_mmvq_ranges_disjoint(g_dst, host_reads[k])) {
+            return false;
+        }
+    }
+    if (!ggml_cuda_mmvq_ranges_disjoint(g_dst, host_out)) {
+        return false;
+    }
+    const ggml_tensor * guest_reads[3] = { guest->src[0], guest->src[1], g_scale };
+    for (int k = 0; k < 3; ++k) {
+        if (guest_reads[k] != nullptr && !ggml_cuda_mmvq_ranges_disjoint(host_out, guest_reads[k])) {
+            return false;
+        }
+    }
+    // the guest's own scale is read by guest blocks while other guest blocks write
+    if (g_scale != nullptr && !ggml_cuda_mmvq_ranges_disjoint(g_dst, g_scale)) {
+        return false;
+    }
+    // NOTE: host->src[1] is deliberately not checked - the host reads only its
+    // q8_1 copy in the pool, and the quantize that produces it is a separate
+    // dispatch that has completed before this launch starts (same reasoning as
+    // ggml_cuda_moe_expert_reduce_detect).
+
+    out->guest.src0  = guest->src[0];
+    out->guest.src1  = guest->src[1];
+    out->guest.scale = g_scale;
+    out->guest.dst   = (ggml_tensor *) g_dst;
+    out->guest_mul   = g_mul;
+    out->host        = host;
+    out->host_weights = host_w;
+    out->host_out    = host_out;
+    out->host_idx    = j;
+    out->host_last   = host_last;
+    return true;
+}
