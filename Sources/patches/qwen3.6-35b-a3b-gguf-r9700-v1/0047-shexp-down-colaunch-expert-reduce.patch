+                // 0047: the shared-expert down projection co-launched inside the
+                // routed expert-reduce that follows it. Tried before the plain
+                // shared-expert gate fold below, which is the fallback.
+                if (shexp_down_colaunch_enabled && stream_ctx.concurrent_events.empty() &&
+                        node->op == GGML_OP_MUL_MAT && mmvq_grouped_done.count(node) == 0 &&
+                        grouped_done.count(node) == 0) {
+                    mmvq_shexp_down_colaunch_info ci;
+                    if (ggml_cuda_shexp_down_colaunch_detect(cgraph, i, &ci) &&
+                            ggml_cuda_mul_mat_vec_q_expert_reduce(*cuda_ctx,
+                                ci.host->src[0], ci.host->src[1], ci.host->src[2],
+                                ci.host_weights, ci.host_out, &ci.guest)) {
+                        if (ci.guest_mul != nullptr) {
+                            grouped_done.insert(ci.guest_mul);
+                        }
+                        for (int k = ci.host_idx; k <= ci.host_last; ++k) {
+                            grouped_done.insert(cgraph->nodes[k]);
+                        }
+                        continue;
+                    }
+                }
+
                 if (!disable_shexp_gate_fuse && stream_ctx.concurrent_events.empty() &&
                         node->op == GGML_OP_MUL_MAT && mmvq_grouped_done.count(node) == 0 &&
                         grouped_done.count(node) == 0) {
