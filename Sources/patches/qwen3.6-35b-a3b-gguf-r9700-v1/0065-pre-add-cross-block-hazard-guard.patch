+// ---- cross-block write/read hazard on the folded add chain ----------------
+//
+// rms_norm_pre_add_launch issues one block per row.  Block r writes add_dst
+// row r in loop 1 and dst row r in loop 2, with only the block-scope
+// __syncthreads() inside block_reduce between them, and reads operand row r in
+// loop 1.  Nothing orders one block's loop 2 against another block's loop 1,
+// so a WRITE range belonging to block r must never intersect a READ range
+// belonging to block r' != r.
+//
+// Every writer and reader here is contiguous and the same shape, so their row
+// grids are congruent.  An overlapping pair is therefore safe only when the two
+// tensors start at exactly the same address - block r then writes precisely the
+// row block r reads, which is the in-place residual add and is what the kernel
+// already assumes.  Any other overlap, INCLUDING one that is a whole number of
+// rows apart, puts block r's store on top of block r+k's load.
+static bool ggml_cuda_pre_add_write_safe(const ggml_tensor * w, const ggml_tensor * r) {
+    if (r == nullptr) {
+        return true;
+    }
+    if (w->data == r->data) {
+        return true;
+    }
+    return ggml_cuda_mmvq_ranges_disjoint(w, r);
+}
+
+static void ggml_cuda_pre_add_audit(const ggml_cgraph * cgraph, int i, int n_adds,
+                                    const ggml_tensor * add_last, const ggml_tensor * mul,
+                                    int64_t nrows, bool hazard) {
+    static int calls = 0;
+    fprintf(stderr, "[PREADD] call=%d nrows=%lld n_adds=%d hazard=%d dst=%p+%zu add_dst=%p+%zu",
+            calls++, (long long) nrows, n_adds, (int) hazard,
+            mul->data, ggml_nbytes(mul), add_last->data, ggml_nbytes(add_last));
+    const ggml_tensor * r0 = cgraph->nodes[i]->src[0];
+    fprintf(stderr, " src0=%p+%zu", r0 ? r0->data : nullptr, r0 ? ggml_nbytes(r0) : 0);
+    for (int k = 0; k < n_adds; ++k) {
+        const ggml_tensor * rk = cgraph->nodes[i + k]->src[1];
+        fprintf(stderr, " src%d=%p+%zu", k + 1, rk ? rk->data : nullptr, rk ? ggml_nbytes(rk) : 0);
+    }
+    fprintf(stderr, "\n");
+}
