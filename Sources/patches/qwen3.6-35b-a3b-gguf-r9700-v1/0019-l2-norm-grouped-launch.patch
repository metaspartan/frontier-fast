+// ----- grouped l2_norm (GDN q/k conv-norm class) launch detection -------------
+//
+// A GDN layer L2-normalises q_conv and k_conv with two independent launches of
+// identical ncols and eps over disjoint views. One grouped launch removes a
+// dispatch with byte-identical per-row work (same warp reduction and scale).
+
+static bool ggml_cuda_l2_norm_can_group(const ggml_tensor * node) {
+    if (node->op != GGML_OP_L2_NORM) {
+        return false;
+    }
+    const ggml_tensor * src0 = node->src[0];
+    if (src0 == nullptr || src0->type != GGML_TYPE_F32 || node->type != GGML_TYPE_F32) {
+        return false;
+    }
+    if ((node->flags & GGML_TENSOR_FLAG_COMPUTE) == 0) {
+        return false;
+    }
+    if (src0->ne[0] >= 1024) {
+        return false; // only the WARP_SIZE kernel branch is mirrored
+    }
+    if (src0->ne[2] != 1 || src0->ne[3] != 1 || src0->nb[0] != sizeof(float)) {
+        return false;
+    }
+    if (!ggml_is_contiguous(node)) {
+        return false;
+    }
+    return true;
+}
+
+static int ggml_cuda_l2_norm_collect_group(const ggml_cgraph * cgraph, const int start, ggml_tensor ** members,
+        const std::unordered_set<const ggml_tensor *> & grouped_done) {
+    ggml_tensor * first = cgraph->nodes[start];
+    float eps0; memcpy(&eps0, first->op_params, sizeof(float));
+    members[0] = first;
+    int n = 1;
+
+    constexpr int scan_window = 12;
+    const int end = std::min(cgraph->n_nodes, start + 1 + scan_window);
+
+    for (int j = start + 1; j < end && n < L2_NORM_MAX_GROUP_SIZE; ++j) {
+        ggml_tensor * cand = cgraph->nodes[j];
+        if (ggml_cuda_is_view_or_noop(cand)) {
+            continue;
+        }
+        float epsc = 0.0f;
+        if (cand->op == GGML_OP_L2_NORM) {
+            memcpy(&epsc, cand->op_params, sizeof(float));
+        }
+        if (cand->op == GGML_OP_L2_NORM && grouped_done.count(cand) == 0 &&
+                cand->src[0]->ne[0] == first->src[0]->ne[0] &&
+                epsc == eps0 &&
+                ggml_cuda_l2_norm_can_group(cand) &&
+                ggml_cuda_mmvq_hoist_legal(cgraph, start, j)) {
+            members[n++] = cand;
+        }
+    }
+    return n;
+}
