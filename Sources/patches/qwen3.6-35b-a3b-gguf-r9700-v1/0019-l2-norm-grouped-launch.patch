+struct l2_norm_grouped_args {
+    const float * x[L2_NORM_MAX_GROUP_SIZE];
+    float       * dst[L2_NORM_MAX_GROUP_SIZE];
+    int64_t       stride_row[L2_NORM_MAX_GROUP_SIZE];
+    uint32_t      seg_end[L2_NORM_MAX_GROUP_SIZE - 1];
+};
+
+// The l2_norm_f32<WARP_SIZE> body (2D-row case: channel = sample = 0) with
+// integer-only segment routing on blockIdx.x. Same reduction, same scale,
+// same store order per row -> byte-identical to the separate launches.
+template <int block_size>
+static __global__ void l2_norm_f32_grouped(
+        const l2_norm_grouped_args args, const int ncols, const float eps) {
+    const int tid = threadIdx.x;
+
+    uint32_t seg = 0, seg_start = 0;
+#pragma unroll
+    for (int s = 0; s < L2_NORM_MAX_GROUP_SIZE - 1; ++s) {
+        if (blockIdx.x >= args.seg_end[s]) {
+            seg       = s + 1;
+            seg_start = args.seg_end[s];
+        }
+    }
+    const int row = blockIdx.x - seg_start;
+
+    const float * x   = args.x[seg] + row*args.stride_row[seg];
+    float       * dst = args.dst[seg] + (int64_t) row*ncols;
+
+    float tmp = 0.0f;
+
+    ggml_cuda_pdl_sync();
+    for (int col = tid; col < ncols; col += block_size) {
+        const float xi = x[col];
+        tmp += xi * xi;
+    }
+
+    extern __shared__ float s_sum[];
+    tmp = block_reduce<block_reduce_method::SUM, block_size>(tmp, s_sum);
+    ggml_cuda_pdl_lc();
+
+    const float scale = rsqrtf(fmaxf(tmp, eps * eps));
+
+    for (int col = tid; col < ncols; col += block_size) {
+        dst[col] = scale * x[col];
+    }
+}
+
+void ggml_cuda_op_l2_norm_grouped(ggml_backend_cuda_context & ctx, ggml_tensor * const * nodes, int n_nodes) {
+    GGML_ASSERT(n_nodes >= 2 && n_nodes <= L2_NORM_MAX_GROUP_SIZE);
+
+    const ggml_tensor * first = nodes[0]->src[0];
+    const int64_t ncols = first->ne[0];
+    GGML_ASSERT(ncols < 1024); // grouped path only mirrors the WARP_SIZE branch
+
+    float eps;
+    memcpy(&eps, nodes[0]->op_params, sizeof(float));
+
+    l2_norm_grouped_args args = {};
+    uint32_t total_rows = 0;
+    for (int m = 0; m < n_nodes; ++m) {
+        const ggml_tensor * src0 = nodes[m]->src[0];
+        ggml_tensor       * dst  = nodes[m];
+        GGML_ASSERT(dst->op == GGML_OP_L2_NORM);
+        GGML_ASSERT(src0->type == GGML_TYPE_F32 && dst->type == GGML_TYPE_F32);
+        GGML_ASSERT(src0->ne[0] == ncols);
+        GGML_ASSERT(src0->ne[2] == 1 && src0->ne[3] == 1);
+        GGML_ASSERT(src0->nb[0] == sizeof(float));
+        float e; memcpy(&e, dst->op_params, sizeof(float));
+        GGML_ASSERT(e == eps);
+
+        args.x[m]          = (const float *) src0->data;
+        args.dst[m]        = (float *) dst->data;
+        args.stride_row[m] = src0->nb[1] / sizeof(float);
+        total_rows += (uint32_t) src0->ne[1];
+        if (m < L2_NORM_MAX_GROUP_SIZE - 1) {
+            args.seg_end[m] = total_rows;
+        }
+    }
+    for (int m = n_nodes - 1; m < L2_NORM_MAX_GROUP_SIZE - 1; ++m) {
+        args.seg_end[m] = total_rows;
+    }
+
+    const dim3 block_nums(total_rows, 1, 1);
+    const dim3 block_dims(WARP_SIZE, 1, 1);
+    const ggml_cuda_kernel_launch_params launch_params = {block_nums, block_dims, 0, ctx.stream()};
+    ggml_cuda_kernel_launch(l2_norm_f32_grouped<WARP_SIZE>, launch_params, args, (int) ncols, eps);
+}
