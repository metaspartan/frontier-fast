diff --git a/ggml/src/ggml-cuda/ggml-cuda.cu b/ggml/src/ggml-cuda/ggml-cuda.cu
index 7fec340eb..77cdede98 100644
--- a/ggml/src/ggml-cuda/ggml-cuda.cu
+++ b/ggml/src/ggml-cuda/ggml-cuda.cu
@@ -1944,6 +1944,189 @@ static bool ggml_cuda_moe_weight_fuse_detect_q(const ggml_cgraph * cgraph, const
     return true;
 }
 
+
+// ---------------------------------------------------------------------------
+// The two GDN conv norms, collected for the decode conv-fold epilogue.
+//
+// qwen35moe convolves [q | k | v] as one 8192-channel block and then l2-normalises
+// the q and k halves per 128-wide head. Grouped (0019) that is still 30 launches
+// per token of 2.0 us each, and each one re-reads 16 KB the conv fold had in
+// registers a moment earlier. A 256-thread conv block owns exactly two norm rows,
+// so the fold can do them - but only if writing the norm destinations early is
+// safe, which is an allocation question, not a kernel question (0032 rule 1).
+static void ggml_cuda_tensor_byte_span(const ggml_tensor * t, const char ** lo, const char ** hi) {
+    const char * base = (const char *) t->data;
+    size_t span = ggml_type_size(t->type);
+    for (int d = 0; d < GGML_MAX_DIMS; ++d) {
+        if (t->ne[d] > 1) {
+            span += (size_t) (t->ne[d] - 1) * t->nb[d];
+        }
+    }
+    *lo = base;
+    *hi = base + span;
+}
+
+static bool ggml_cuda_spans_overlap(const ggml_tensor * a, const ggml_tensor * b) {
+    if (a == nullptr || b == nullptr || a->data == nullptr || b->data == nullptr) {
+        return false;
+    }
+    if (a->buffer != b->buffer) {
+        return false;
+    }
+    const char *alo, *ahi, *blo, *bhi;
+    ggml_cuda_tensor_byte_span(a, &alo, &ahi);
+    ggml_cuda_tensor_byte_span(b, &blo, &bhi);
+    return alo < bhi && blo < ahi;
+}
+
+static bool ggml_cuda_ssm_conv_l2_dbg() {
+    static const bool v = getenv("GGML_CUDA_SSM_CONV_L2_DBG") != nullptr;
+    return v;
+}
+
+// Collects the L2_NORM nodes that ride along in the fold. Returns the count, or
+// 0 to decline. `silu` is the conv output the fold writes.
+static int ggml_cuda_ssm_conv_l2_collect(const ggml_cgraph * cgraph, const int i,
+        const ggml_tensor * concat, const ggml_tensor * ssm_conv,
+        const ggml_tensor * silu, const ggml_tensor * wb_cpy,
+        ggml_tensor ** out_nodes) {
+    static const bool disable = getenv("GGML_CUDA_DISABLE_SSM_CONV_L2_FOLD") != nullptr &&
+                                std::atoi(getenv("GGML_CUDA_DISABLE_SSM_CONV_L2_FOLD"));
+    if (disable) {
+        return 0;
+    }
+    constexpr int block_size = 256;
+
+    int n = 0;
+    int last_idx = i;
+    int64_t ncols = 0;
+    float   eps   = 0.0f;
+
+    const int window = std::min(i + 48, cgraph->n_nodes);
+    for (int j = i + 1; j < window; ++j) {
+        ggml_tensor * cand = cgraph->nodes[j];
+        if (cand->op != GGML_OP_L2_NORM) {
+            continue;
+        }
+        const ggml_tensor * src = cand->src[0];
+        if (src == nullptr || src->view_src != silu) {
+            continue;
+        }
+        if (n >= SSM_CONV_L2_MAX_SEG) {
+            return 0; // more norms than the epilogue can carry: take none
+        }
+        if (src->type != GGML_TYPE_F32 || cand->type != GGML_TYPE_F32) {
+            return 0;
+        }
+        if (src->ne[2] != 1 || src->ne[3] != 1 || src->nb[0] != sizeof(float) ||
+                src->nb[1] != (size_t) src->ne[0] * sizeof(float)) {
+            return 0;
+        }
+        if (!ggml_is_contiguous(cand) || !ggml_are_same_shape(cand, src)) {
+            return 0;
+        }
+        float e;
+        memcpy(&e, cand->op_params, sizeof(float));
+        if (n == 0) {
+            ncols = src->ne[0];
+            eps   = e;
+            // rows must tile the conv block exactly, and each row must fit one warp pass
+            if (ncols <= 0 || ncols % WARP_SIZE != 0 || block_size % ncols != 0) {
+                return 0;
+            }
+        } else if (src->ne[0] != ncols || e != eps) {
+            return 0;
+        }
+        const size_t off = (const char *) src->data - (const char *) silu->data;
+        if ((const char *) src->data < (const char *) silu->data ||
+                off % (block_size * sizeof(float)) != 0 ||
+                (src->ne[1] * ncols) % block_size != 0 ||
+                off / sizeof(float) + src->ne[1] * ncols > (size_t) ggml_nelements(silu)) {
+            return 0;
+        }
+        // the fold writes this destination while it is still reading the
+        // activation and the conv state, and blocks are not synchronised with
+        // each other, so any overlap with an input is a genuine race
+        // NOT including the CONCAT output: when this fold fires the concat is
+        // never materialised (the fold reads the state window and the activation
+        // directly and builds the writeback from registers), and the 0031
+        // detector has already rejected any consumer of it other than the
+        // SSM_CONV and the writeback CPY, both of which are folded away. Its
+        // buffer is dead, and ggml-alloc hands it to the norm destinations on
+        // every layer - guarding on it declines the whole fold for nothing.
+        // An in-place norm writes back exactly the bytes it read, inside the
+        // buffer this fold already owns and has in registers - that is not an
+        // alias, it is the point (see qwen35moe.cpp). Every other overlap is.
+        const bool in_place = cand->data == src->data;
+        // The activation and the conv output are routinely co-located at the
+        // decode shape - the CONCAT is the activation last consumer, so
+        // ggml-alloc reuses its buffer - and the fold already depends on that
+        // being EXACT: thread ch reads x[ch] and then writes y[ch], the same
+        // address. An in-place norm write lands on the same 256 channels the
+        // block has already read, after a __syncthreads, so it is safe under
+        // the same condition and nothing weaker.
+        const ggml_tensor * x_in = concat->src[1];
+        const bool x_exact = in_place && x_in->data == silu->data &&
+                             x_in->nb[1] == sizeof(float) && silu->nb[0] == sizeof(float);
+        const ggml_tensor * ins[] = { concat->src[0], x_exact ? nullptr : x_in, ssm_conv->src[1],
+                                      in_place ? nullptr : silu, wb_cpy->src[1] };
+        static const char * innames[] = { "state", "x", "w", "silu", "wb" };
+        for (int q = 0; q < 5; ++q) {
+            if (ggml_cuda_spans_overlap(cand, ins[q])) {
+                if (ggml_cuda_ssm_conv_l2_dbg()) {
+                    fprintf(stderr, "ssm-conv-l2: decline, dst overlaps %s\n", innames[q]);
+                }
+                return 0;
+            }
+        }
+        out_nodes[n++] = cand;
+        last_idx = j;
+    }
+
+    if (n == 0) {
+        return 0;
+    }
+
+    // nothing executed between the fold and the norms may read or write the
+    // memory the fold is about to write early
+    for (int j = i + 1; j <= last_idx; ++j) {
+        ggml_tensor * mid = cgraph->nodes[j];
+        bool is_member = mid == ssm_conv || mid == silu || mid == wb_cpy || mid == concat;
+        for (int m = 0; m < n; ++m) {
+            is_member = is_member || mid == out_nodes[m];
+        }
+        if (is_member || mid->op == GGML_OP_NONE || mid->op == GGML_OP_VIEW ||
+                mid->op == GGML_OP_RESHAPE || mid->op == GGML_OP_PERMUTE ||
+                mid->op == GGML_OP_TRANSPOSE) {
+            continue;
+        }
+        for (int m = 0; m < n; ++m) {
+            if (out_nodes[m]->data == out_nodes[m]->src[0]->data) {
+                continue; // in place inside the fold's own output
+            }
+            if (ggml_cuda_spans_overlap(mid, out_nodes[m])) {
+                if (ggml_cuda_ssm_conv_l2_dbg()) {
+                    fprintf(stderr, "ssm-conv-l2: decline, node %d dst overlaps a norm dst\n", j);
+                }
+                return 0;
+            }
+            for (int k = 0; k < GGML_MAX_SRC; ++k) {
+                if (ggml_cuda_spans_overlap(mid->src[k], out_nodes[m])) {
+                    if (ggml_cuda_ssm_conv_l2_dbg()) {
+                        fprintf(stderr, "ssm-conv-l2: decline, node %d src overlaps a norm dst\n", j);
+                    }
+                    return 0;
+                }
+            }
+        }
+    }
+
+    if (ggml_cuda_ssm_conv_l2_dbg()) {
+        fprintf(stderr, "ssm-conv-l2: accept %d norms, ncols=%d\n", n, (int) ncols);
+    }
+    return n;
+}
