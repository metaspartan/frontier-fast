+                            ggml_tensor * l2_nodes[SSM_CONV_L2_MAX_SEG];
+                            const int n_l2 = ggml_cuda_ssm_conv_l2_collect(cgraph, i, node, f_conv, f_silu, f_cpy, l2_nodes);
+                            ggml_cuda_op_ssm_conv_fold(*cuda_ctx, node, f_conv, f_silu, f_cpy, l2_nodes, n_l2);
