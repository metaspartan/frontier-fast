+            state_d, x_d, w_d, (const float *) nullptr, y_d, wb_d, (int) nr,
+            (int) state->nb[1], (int) x->nb[1], (int) w->nb[1], (int64_t) 1, l2);
+        ssm_conv_fold_dump(silu, ctx.stream());
+        return;
+    }
     if (ssm_conv_fold_stock_shape()) {
         ggml_cuda_kernel_launch(ssm_conv_fold_stock_f32, launch_params,
             state_d, x_d, w_d, (const float *) nullptr, y_d, wb_d, (int) nr,
diff --git a/ggml/src/ggml-cuda/ssm-conv.cuh b/ggml/src/ggml-cuda/ssm-conv.cuh
index 7826ab317..a8b07e862 100644
--- a/ggml/src/ggml-cuda/ssm-conv.cuh
+++ b/ggml/src/ggml-cuda/ssm-conv.cuh
@@ -2,10 +2,25 @@
 
 void ggml_cuda_op_ssm_conv(ggml_backend_cuda_context & ctx, ggml_tensor * dst, ggml_tensor * bias_add_node = nullptr, ggml_tensor * silu_dst = nullptr);
 
+// Up to this many L2_NORM nodes may ride along in the decode conv fold epilogue
+// (qwen35moe emits exactly two: the q and k conv norms).
+#define SSM_CONV_L2_MAX_SEG 2
+
+// A contiguous run of conv-output channels that becomes `nrows` rows of `ncols`,
+// each l2-normalised into its own destination tensor.
+struct ssm_conv_l2_seg {
+    float * dst;
+    int     ch_begin;
