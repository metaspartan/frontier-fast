index 19bb827d1..656803cd8 100644
--- a/ggml/src/ggml-cuda/ssm-conv.cu
+++ b/ggml/src/ggml-cuda/ssm-conv.cu
@@ -292,6 +292,123 @@ static __global__ void ssm_conv_fold_stock_f32(const float * __restrict__ state,
     wbc[2] = xv;
 }
 
+
+// ---------------------------------------------------------------------------
+// The decode fold with the GDN q/k l2 norms in its epilogue.
+//
+// The conv output is 8192 channels; a 256-thread block owns 256 of them, which
+// is exactly two 128-wide norm rows, and the value each thread needs is already
+// in its register. So warps 0 and 1 replay the stock one-warp l2_norm body out
+// of shared memory - same `col = lane; col += 32` accumulation order, the same
+// warp_reduce_sum (block_reduce<SUM,32> IS warp_reduce_sum), the same
+// rsqrtf(fmaxf(tmp, eps*eps)) and the same store order - so the result is
+// byte-identical to l2_norm_f32_grouped and 30 launches per token disappear.
+//
+// This is a separate kernel from ssm_conv_fold_stock_f32 rather than a runtime
+// branch inside it: see 0040 for what a not-taken branch in a hot kernel costs.
+struct ssm_conv_l2_args {
+    float * dst     [SSM_CONV_L2_MAX_SEG];
+    int     ch_begin[SSM_CONV_L2_MAX_SEG];
+    int     ch_end  [SSM_CONV_L2_MAX_SEG];
+    int     nseg;
+    int     ncols;
+    float   eps;
+};
+
+template <int block_size>
+static __global__ void ssm_conv_fold_l2_f32(const float * __restrict__ state, const float * __restrict__ x,
+                                            const float * __restrict__ w_all, const float * __restrict__ bias,
+                                            float * __restrict__ y, float * __restrict__ wb, const int nr,
+                                            const int state_nb1, const int x_nb1, const int w_nb1,
+                                            const int64_t n_t, const ssm_conv_l2_args l2) {
+    const int ch = blockIdx.x * block_size + threadIdx.x;
+
+    __shared__ float sy[block_size];
+
+    float yv = 0.0f;
+
+    if (ch < nr) {
+        const float * st = (const float *) ((const char *) state + ch * state_nb1);
+        const float * wc = (const float *) ((const char *) w_all + ch * w_nb1);
+        const float   xv = *(const float *) ((const char *) x + ch * x_nb1);
+
+        float x_r[4] = { 0.0f };
+        float w[4]   = { 0.0f };
+
+#pragma unroll
+        for (size_t j = 0; j < 4; j++) {
+            w[j] = wc[j];
+        }
+
+        float b = bias != nullptr ? bias[ch] : 0.0f;
+
+        for (int64_t i = 0; i < n_t; i++) {
+            float sumf = 0.0f;
+
+            if (i == 0) {
+                for (size_t j = 0; j < 3; j++) {
+                    x_r[j] = st[j];
+                }
+                x_r[3] = xv;
+            }
+
+#pragma unroll
+            for (size_t j = 0; j < 4; j++) {
+                sumf += x_r[(i + j) % 4] * w[j];
+            }
+            sumf += b;
+            yv = ggml_cuda_op_silu_single(sumf);
+            y[i * nr + ch] = yv;
+        }
+
+        float * wbc = wb + ch * 3;
+        wbc[0] = x_r[1];
+        wbc[1] = x_r[2];
+        wbc[2] = xv;
+    }
+
+    sy[threadIdx.x] = yv;
+    __syncthreads();
+
+    constexpr int warp_size = 32;
+    const int lane = threadIdx.x % warp_size;
+    const int warp = threadIdx.x / warp_size;
+    const int ncols = l2.ncols;
+    const int rows_per_block = block_size / ncols;
+
+    if (warp < rows_per_block) {
+        const int ch0 = blockIdx.x * block_size + warp * ncols;
+
+        int     seg_row = -1;
+        float * seg_dst = nullptr;
+#pragma unroll
+        for (int s = 0; s < SSM_CONV_L2_MAX_SEG; ++s) {
+            if (s < l2.nseg && ch0 >= l2.ch_begin[s] && ch0 < l2.ch_end[s]) {
+                seg_row = (ch0 - l2.ch_begin[s]) / ncols;
+                seg_dst = l2.dst[s];
+            }
+        }
+
+        if (seg_dst != nullptr) {
+            const float * row = sy + warp * ncols;
+
+            float tmp = 0.0f;
+            for (int col = lane; col < ncols; col += warp_size) {
+                const float xi = row[col];
+                tmp += xi * xi;
+            }
+            tmp = warp_reduce_sum(tmp);
+
+            const float scale = rsqrtf(fmaxf(tmp, l2.eps * l2.eps));
+
+            float * d = seg_dst + (int64_t) seg_row * ncols;
+            for (int col = lane; col < ncols; col += warp_size) {
+                d[col] = scale * row[col];
+            }
+        }
+    }
+}
