index 7442e20a7..cd7d61cc6 100644
--- a/ggml/src/ggml-cuda/ggml-cuda.cu
+++ b/ggml/src/ggml-cuda/ggml-cuda.cu
@@ -3321,6 +3321,141 @@ static bool ggml_cuda_mmvq_ranges_disjoint(const ggml_tensor * a, const ggml_ten
     return a1 <= b0 || b1 <= a0;
 }
 
+// ---- 0037: the MoE expert-slot reduction folded into the down matvec ----
+//
+// Matches the whole tail of build_moe_ffn's expert combine as it appears in the
+// cgraph at decode (one token):
+//
+//   i    MUL_MAT_ID   ffn_moe_down      [n_embd, n_expert_used, 1]
+//   i+1  MUL          ffn_moe_weighted  (routing weights; folded by 0034)
+//   ...  VIEW x n     one per expert slot, slot-ordered
+//   ...  ADD  x n-1   left-folded chain, fused into one k_bin_bcast upstream
+//
+// and reports the final ADD, whose destination the folded matvec writes
+// directly; every node in between is absorbed. The slot ORDER matters: the fold
+// sums slot 0..n-1 in that order, which is what launch_bin_bcast_pack's fused
+// multi-add does, so the result is bit-identical rather than merely equivalent.
+static bool ggml_cuda_moe_expert_reduce_detect(
+        const ggml_cgraph * cgraph, const int i,
+        const ggml_tensor ** out_w, ggml_tensor ** out_final, int * out_last_idx) {
+    static const bool debug = getenv("GGML_CUDA_MOE_REDUCE_DEBUG") != nullptr &&
+                              std::atoi(getenv("GGML_CUDA_MOE_REDUCE_DEBUG"));
+#define GGML_MOE_REDUCE_DECLINE(reason)                                              \
+    do {                                                                             \
+        if (debug) { GGML_LOG_INFO("moe-reduce: decline @%d: %s\n", i, (reason)); }   \
+        return false;                                                                \
+    } while (0)
+
+    const ggml_tensor * mm = cgraph->nodes[i];
+    if (mm->op != GGML_OP_MUL_MAT_ID) {
+        return false;
+    }
+
+    // reuse the 0034 pair check: it establishes the MUL at i+1, the per-slot
+    // routing-weight vector, mmvq routing, ne[2] == 1 and the layout match
+    const ggml_tensor * mul = nullptr;
+    const ggml_tensor * w   = nullptr;
+    if (!ggml_cuda_moe_weight_fuse_detect(cgraph, i, &mul, &w, GGML_OP_MUL_MAT_ID)) {
+        return false;
+    }
+
+    const int64_t n_slots = mm->ne[1];
+    if (n_slots < 2 || n_slots > MMVQ_EXPERT_REDUCE_MAX_SLOTS) {
+        GGML_MOE_REDUCE_DECLINE("expert slot count out of range");
+    }
+    if (mm->ne[2] != 1 || mm->ne[3] != 1) {
+        GGML_MOE_REDUCE_DECLINE("not a single-token matvec");
+    }
+    if (mul->flags & GGML_TENSOR_FLAG_OUTPUT) {
+        GGML_MOE_REDUCE_DECLINE("weighted experts is a graph output");
+    }
+    // the weighted experts must be consumed by the n slot views and nothing else
+    if (ggml_node_get_use_count(cgraph, i + 1) != (int32_t) n_slots) {
+        GGML_MOE_REDUCE_DECLINE("weighted experts has other consumers");
+    }
+
+    const ggml_tensor * views[MMVQ_EXPERT_REDUCE_MAX_SLOTS] = { nullptr };
+    int j = i + 2;
+    for (int64_t s = 0; s < n_slots; ++s, ++j) {
+        if (j >= cgraph->n_nodes) {
+            GGML_MOE_REDUCE_DECLINE("graph ends inside the slot views");
+        }
+        const ggml_tensor * v = cgraph->nodes[j];
+        if (v->op != GGML_OP_VIEW || v->view_src != mul) {
+            GGML_MOE_REDUCE_DECLINE("not a slot view of the weighted experts");
+        }
+        if (v->type != GGML_TYPE_F32 || v->ne[0] != mul->ne[0] || v->ne[1] != mul->ne[2] ||
+                v->ne[2] != 1 || v->ne[3] != 1 || v->nb[0] != sizeof(float)) {
+            GGML_MOE_REDUCE_DECLINE("slot view has an unexpected shape");
+        }
+        if ((const char *) v->data != (const char *) mul->data + s*mul->nb[1]) {
+            GGML_MOE_REDUCE_DECLINE("slot views are not in slot order");
+        }
+        if ((v->flags & GGML_TENSOR_FLAG_OUTPUT) || ggml_node_get_use_count(cgraph, j) != 1) {
+            GGML_MOE_REDUCE_DECLINE("slot view has other consumers");
+        }
+        views[s] = v;
+    }
+
+    const ggml_tensor * acc = views[0];
+    for (int64_t s = 1; s < n_slots; ++s, ++j) {
+        if (j >= cgraph->n_nodes) {
+            GGML_MOE_REDUCE_DECLINE("graph ends inside the add chain");
+        }
+        const ggml_tensor * a = cgraph->nodes[j];
+        if (a->op != GGML_OP_ADD || a->src[0] != acc || a->src[1] != views[s]) {
+            GGML_MOE_REDUCE_DECLINE("add chain is not the left-folded slot sum");
+        }
+        const bool is_last = (s == n_slots - 1);
+        if (!is_last && ((a->flags & GGML_TENSOR_FLAG_OUTPUT) ||
+                         ggml_node_get_use_count(cgraph, j) != 1)) {
+            GGML_MOE_REDUCE_DECLINE("intermediate add has other consumers");
+        }
+        acc = a;
+    }
+
+    ggml_tensor * final_add = cgraph->nodes[j - 1];
+    if (final_add->type != GGML_TYPE_F32 || !ggml_is_contiguous(final_add) ||
+            final_add->nb[0] != sizeof(float) || ggml_nelements(final_add) != mm->ne[0]) {
+        GGML_MOE_REDUCE_DECLINE("reduced output is not a plain contiguous row");
+    }
+    // An out-of-place chain gets a fresh allocation that ggml-alloc almost always
+    // takes from the just-freed routing weights, which this kernel reads while it
+    // writes - see the in-place combine in build_moe_ffn.
+    if (final_add->data != views[0]->data) {
+        GGML_MOE_REDUCE_DECLINE("reduced output is not the slot-0 block");
+    }
+
+    // The store moves back to matvec time, so the destination must not alias
+    // anything the matvec reads (0032's lesson: a hoisted epilogue write is an
+    // allocation problem). Nothing else executes in the window - the absorbed
+    // nodes are the only ones between - so these are the whole hazard set.
+    const ggml_tensor * ids = mm->src[2];
+    if (!ggml_cuda_mmvq_ranges_disjoint(final_add, w)) {
+        GGML_MOE_REDUCE_DECLINE("reduced output aliases the routing weights");
+    }
+    if (!ggml_cuda_mmvq_ranges_disjoint(final_add, mm->src[0])) {
+        GGML_MOE_REDUCE_DECLINE("reduced output aliases the weight slab");
+    }
+    // NOTE: src[1] deliberately not checked. The matvec never reads it - it
+    // reads the q8_1 copy in the pool - and any quantize this launch issues
+    // runs before it on the same stream.
+    if (ids != nullptr && !ggml_cuda_mmvq_ranges_disjoint(final_add, ids)) {
+        GGML_MOE_REDUCE_DECLINE("reduced output aliases the ids");
+    }
+
+    if (debug) {
+        GGML_LOG_INFO("moe-reduce: accept @%d slots=%d absorbing %d..%d\n",
+                      i, (int) n_slots, i + 1, j - 1);
+    }
+
+    *out_w        = w;
+    *out_final    = final_add;
+    *out_last_idx = j - 1;
+    return true;
+#undef GGML_MOE_REDUCE_DECLINE
+}
+
 static bool ggml_cuda_mmvq_hoist_legal(const ggml_cgraph * cgraph, const int start, const int j) {
     const ggml_tensor * cand = cgraph->nodes[j];
     for (int k = start + 1; k < j; ++k) {
@@ -5712,6 +5847,8 @@ static void ggml_cuda_graph_evaluate_and_capture(ggml_backend_cuda_context * cud
                                                    std::atoi(getenv("GGML_CUDA_DISABLE_SSM_CONV_FOLD_SEQ"));
             static const bool disable_moe_weight_fuse = getenv("GGML_CUDA_DISABLE_MOE_WEIGHT_FUSE") != nullptr &&
                                                    std::atoi(getenv("GGML_CUDA_DISABLE_MOE_WEIGHT_FUSE"));
+            static const bool disable_moe_expert_reduce = getenv("GGML_CUDA_DISABLE_MOE_EXPERT_REDUCE") != nullptr &&
+                                                   std::atoi(getenv("GGML_CUDA_DISABLE_MOE_EXPERT_REDUCE"));
             static const bool disable_shexp_gate_fuse = getenv("GGML_CUDA_DISABLE_SHEXP_GATE_FUSE") != nullptr &&
                                                    std::atoi(getenv("GGML_CUDA_DISABLE_SHEXP_GATE_FUSE"));
             const bool mmvq_group_enabled = !disable_mmvq_group && stream_ctx.concurrent_events.empty();
@@ -5776,6 +5913,27 @@ static void ggml_cuda_graph_evaluate_and_capture(ggml_backend_cuda_context * cud
                     continue; // already computed as part of a grouped rms_norm / rope launch
                 }
 
+                // 0037: fold the routing-weight multiply AND the n-way expert-slot
+                // reduction into the down matvec. Tried before the 0034 pair fold
+                // below, which is the fallback when the add chain does not match.
+                if (!disable_moe_expert_reduce && stream_ctx.concurrent_events.empty() &&
+                        node->op == GGML_OP_MUL_MAT_ID) {
+                    const ggml_tensor * f_w    = nullptr;
+                    ggml_tensor       * f_out  = nullptr;
+                    int                 f_last = -1;
+                    const bool per_slot = ggml_cuda_moe_reduce_per_slot_mode();
+                    if (ggml_cuda_moe_expert_reduce_detect(cgraph, i, &f_w, &f_out, &f_last) &&
+                            ggml_cuda_mul_mat_vec_q_expert_reduce(*cuda_ctx, node->src[0], node->src[1],
+                                                                  node->src[2], f_w,
+                                                                  per_slot ? cgraph->nodes[i + 1] : f_out)) {
+                        const int k_end = per_slot ? i + 1 : f_last;
+                        for (int k = i + 1; k <= k_end; ++k) {
+                            grouped_done.insert(cgraph->nodes[k]);
+                        }
+                        continue;
+                    }
+                }
+
                 if (!disable_moe_weight_fuse && stream_ctx.concurrent_events.empty() &&
                         node->op == GGML_OP_MUL_MAT_ID) {
                     const ggml_tensor * f_mul = nullptr;
diff --git a/ggml/src/ggml-cuda/mmvq.cu b/ggml/src/ggml-cuda/mmvq.cu
index e3e7ab423..0df713326 100644
--- a/ggml/src/ggml-cuda/mmvq.cu
+++ b/ggml/src/ggml-cuda/mmvq.cu
@@ -1564,6 +1564,196 @@ static void mul_mat_vec_q_switch_type(
     }
 }
 
+
+// ----- 0037: the MoE expert-slot reduction folded into the down matvec -----
+//
+// After 0034 the expert-down MUL_MAT_ID writes [n_embd, n_expert_used] with the
+// routing weight already applied in its epilogue, and a fused multi-add then
+// sums the eight slices into [n_embd]: one launch per layer moving 64 KB of
+// reads and 64 KB of writes to produce 8 KB, when the matvec that wrote those
+// bytes held every one of them in a register.
+//
+// The parallelism is the whole difficulty. In the launch this replaces
+// blockIdx.y IS the expert slot, so nrows_x * n_expert_used warps are in
+// flight; looping one warp over the eight experts would cut that 8x on a
+// matvec that is latency-bound (444 GB/s measured), which costs more than the
+// fold saves. Instead threadIdx.y becomes the expert slot - it is free, because
+// this shape trims to a single k-split warp (see calc_nwarps_launched) - so the
+// same number of warps run and there is one store instead of eight.
+//
+// Byte-exactness: each expert warp keeps exactly the k-block assignment, the
+// vec_dot sequence and the warp reduction of the single-warp launch it
+// replaces, including the nwarps-1 identically-zero partials the host-trimmed
+// warps contribute; the slot results are then summed in slot order 0..n-1 in a
+// single lane, which is the left-to-right fold launch_bin_bcast_pack applies to
+// the fused ADD chain it replaces.
+template <ggml_type type>
+__launch_bounds__(MMVQ_EXPERT_REDUCE_MAX_SLOTS*ggml_cuda_get_physical_warp_size(), 1)
+static __global__ void mul_mat_vec_q_expert_reduce(
+        const void * vx_ptr, const void * vy_ptr, const int32_t * ids_ptr,
+        const float * dst_scale_ptr, float * dst_ptr,
+        const uint32_t ncols_x, const uint3 nchannels_y,
+        const uint32_t stride_row_x, const uint32_t stride_channel_x, const uint32_t stride_channel_y,
+        const uint32_t stride_channel_dst) {
+    const void    * GGML_CUDA_RESTRICT vx        = vx_ptr;
+    const void    * GGML_CUDA_RESTRICT vy        = vy_ptr;
+    const int32_t * GGML_CUDA_RESTRICT ids       = ids_ptr;
+    const float   * GGML_CUDA_RESTRICT dst_scale = dst_scale_ptr;
+    float         * GGML_CUDA_RESTRICT dst       = dst_ptr;
+
+    constexpr int qk  = ggml_cuda_type_traits<type>::qk;
+    constexpr int qi  = ggml_cuda_type_traits<type>::qi;
+    constexpr mmvq_parameter_table_id table_id = get_device_table_id();
+    constexpr int vdr       = get_vdr_mmvq(type, table_id);
+    constexpr int nwarps    = calc_nwarps(type, 1, table_id);
+    constexpr int warp_size = ggml_cuda_get_physical_warp_size();
+    constexpr vec_dot_q_cuda_t vec_dot_q_cuda = get_vec_dot_q_cuda(type);
+
+    // one k-split warp per expert slot; the host gate guarantees a single pass
+    constexpr int blocks_per_iter = vdr * warp_size / qi;
+
+    const uint32_t channel_dst      = threadIdx.y;
+    const int      row0             = blockIdx.x;
+    dst += row0;
+    const int      blocks_per_row_x = ncols_x / qk;
+
+    ggml_cuda_pdl_sync();
+    const uint32_t channel_x = ids[channel_dst];
+    const uint32_t channel_y = fastmodulo(channel_dst, nchannels_y);
+
+    const float dst_scale_v = dst_scale[channel_dst];
+
+    float tmp = 0.0f;
+
+    const block_q8_1 * y = ((const block_q8_1 *) vy) + channel_y*stride_channel_y;
+    const int kbx_offset = channel_x*stride_channel_x + row0*stride_row_x;
+
+    for (int kbx = threadIdx.x / (qi/vdr); kbx < blocks_per_row_x; kbx += blocks_per_iter) {
+        const int kby = kbx * (qk/QK8_1); // y block index that aligns with kbx
+        const int kqs = vdr * (threadIdx.x % (qi/vdr));
+        tmp += vec_dot_q_cuda(vx, &y[kby], kbx_offset + kbx, kqs);
+    }
+
+    // The launch this replaces runs one warp and adds the nwarps-1 trimmed
+    // (identically +0.0f) partials before the warp reduction. Keep them: for a
+    // -0.0f accumulator that addition is not the identity, and dropping it
+    // would be the only place this kernel could differ from stock bit patterns.
+#pragma unroll
+    for (int l = 0; l < nwarps-1; ++l) {
+        tmp += 0.0f;
+    }
+    tmp = warp_reduce_sum<warp_size>(tmp);
+
+    // Bisect mode (GGML_CUDA_MOE_REDUCE_PER_SLOT=1): store each slot where the
+    // launch this replaces would, and leave the add chain in the graph. Isolates
+    // the matvec restructure from the reduction.
+    if (stride_channel_dst != 0) {
+        if (threadIdx.x == 0) {
+            dst[channel_dst*stride_channel_dst] = tmp * dst_scale_v;
+        }
+        return;
+    }
+
+    __shared__ float slot_sums[MMVQ_EXPERT_REDUCE_MAX_SLOTS];
+    if (threadIdx.x == 0) {
+        slot_sums[channel_dst] = tmp * dst_scale_v;
+    }
+    __syncthreads();
+
+    if (threadIdx.x == 0 && threadIdx.y == 0) {
+        float sum = slot_sums[0];
+        for (uint32_t s = 1; s < blockDim.y; ++s) {
+            sum += slot_sums[s];
+        }
+        dst[0] = sum;
+    }
+}
+
+// Returns false (having launched nothing) when this type/shape does not reduce
+// to the single-k-split-warp launch the kernel above is byte-exact against.
+template <ggml_type type>
+static bool mul_mat_vec_q_expert_reduce_launch(
+        const void * vx, const void * vy, const int32_t * ids, const float * dst_scale, float * dst,
+        const int ncols_x, const int nrows_x, const int n_slots, const int nchannels_y,
+        const int stride_row_x, const int stride_channel_x, const int stride_channel_y,
+        const int stride_channel_dst, cudaStream_t stream) {
+    constexpr int qk = ggml_cuda_type_traits<type>::qk;
+    constexpr int qi = ggml_cuda_type_traits<type>::qi;
+
+    const int device    = ggml_cuda_get_device();
+    const int cc        = ggml_cuda_info().devices[device].cc;
+    const int warp_size = ggml_cuda_info().devices[device].warp_size;
+    const mmvq_parameter_table_id table_id = get_device_table_id(cc);
+
+    if (n_slots < 2 || n_slots > MMVQ_EXPERT_REDUCE_MAX_SLOTS) {
+        return false;
+    }
+    const int vdr    = get_vdr_mmvq(type, table_id);
+    const int nwarps = calc_nwarps(type, 1, table_id);
+    if (vdr <= 0 || qi % vdr != 0) {
+        return false;
+    }
+    // the replaced launch must be one row per block, or blockIdx.x is not the row
+    if (calc_rows_per_block(1, table_id, /*small_k=*/false, nwarps) != 1) {
+        return false;
+    }
+    if (ncols_x % qk != 0) {
+        return false;
+    }
+    // ... and must cover every k-block with one warp in a single pass, or the
+    // per-thread k-block assignment (and so the FP op order) would move
+    const int blocks_per_row_x   = ncols_x / qk;
+    const int threads_per_kblock = qi / vdr;
+    if (blocks_per_row_x * threads_per_kblock > warp_size) {
+        return false;
+    }
+    if (calc_nwarps_launched<type>(ncols_x, nwarps, warp_size, table_id) != 1) {
+        return false;
+    }
+    // ... and the host must actually be trimming this launch (GGML_MMVQ_UNTRIM_BLOCKS)
+    if ((int64_t) nrows_x * (int64_t) n_slots < (int64_t) mmvq_untrim_below_blocks()) {
+        return false;
+    }
+
+    const dim3  block_nums(nrows_x, 1, 1);
+    const dim3  block_dims(warp_size, n_slots, 1);
+    const uint3 nchannels_y_fd = init_fastdiv_values(nchannels_y);
+
+    const ggml_cuda_kernel_launch_params launch_params = ggml_cuda_kernel_launch_params(block_nums, block_dims, 0, stream);
+    ggml_cuda_kernel_launch(mul_mat_vec_q_expert_reduce<type>, launch_params,
+        vx, vy, ids, dst_scale, dst, (uint32_t) ncols_x, nchannels_y_fd,
