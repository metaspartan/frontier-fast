+bool ggml_cuda_mul_mat_vec_q_expert_reduce(
+        ggml_backend_cuda_context & ctx, const ggml_tensor * src0, const ggml_tensor * src1,
+        const ggml_tensor * ids, const ggml_tensor * weights, ggml_tensor * dst) {
+    GGML_ASSERT(src1->type    == GGML_TYPE_F32);
+    GGML_ASSERT(dst->type     == GGML_TYPE_F32);
+    GGML_ASSERT(weights->type == GGML_TYPE_F32);
+    GGML_ASSERT(ids != nullptr && ids->type == GGML_TYPE_I32);
+
+    const int64_t ne00 = src0->ne[0];
+    const int64_t ne01 = src0->ne[1];
+    const int64_t ne10 = src1->ne[0];
+    const int64_t ne11 = src1->ne[1];
+    const int64_t ne12 = src1->ne[2];
+    const int64_t ne13 = src1->ne[3];
+
+    const size_t ts_src0 = ggml_type_size(src0->type);
+    const size_t ts_src1 = ggml_type_size(src1->type);
+
+    GGML_ASSERT(src0->nb[0] == ts_src0);
+    GGML_ASSERT(src1->nb[0] == ts_src1);
+    GGML_ASSERT(ids->nb[0]  == ggml_type_size(ids->type));
+
+    const int64_t n_slots = ggml_nelements(weights);
+    if (n_slots < 2 || n_slots > MMVQ_EXPERT_REDUCE_MAX_SLOTS) {
+        return false;
+    }
+
+    cudaStream_t stream = ctx.stream();
+
+    // If src0 is a temporary compute buffer it may have padding that mmvq reads.
+    if (ggml_backend_buffer_get_usage(src0->buffer) == GGML_BACKEND_BUFFER_USAGE_COMPUTE) {
+        const size_t size_data  = ggml_nbytes(src0);
+        const size_t size_alloc = ggml_backend_buffer_get_alloc_size(src0->buffer, src0);
+        if (size_alloc > size_data) {
+            GGML_ASSERT(ggml_is_contiguously_allocated(src0));
+            GGML_ASSERT(!src0->view_src);
+            CUDA_CHECK(cudaMemsetAsync((char *) src0->data + size_data, 0, size_alloc - size_data, stream));
+        }
+    }
+
+    // Exactly the shared q8_1 quantization ggml_cuda_mul_mat_vec_q would use, so
+    // a fall-through to that path (this function returning false) is free.
+    const int64_t ne10_padded = GGML_PAD(ne10, MATRIX_ROW_PADDING);
+    const char * src1_q8_1 = nullptr;
+    {
+        const int64_t s11 = src1->nb[1] / ts_src1;
+        const int64_t s12 = src1->nb[2] / ts_src1;
+        const int64_t s13 = src1->nb[3] / ts_src1;
+        src1_q8_1 = ctx.quantized_src1_cache.find(src1, stream, ne10, s11, s12, s13, ne10_padded, ne11, ne12, ne13);
+        if (src1_q8_1 == nullptr) {
+            const size_t size_q8_1 = ne13*ne12 * ne11*ne10_padded * sizeof(block_q8_1)/QK8_1;
+            char * dst_q8_1 = ctx.quantized_src1_cache.insert(
+                ctx.pool(), src1, stream, ne10, s11, s12, s13, ne10_padded, ne11, ne12, ne13, size_q8_1);
+            quantize_row_q8_1_cuda((const float *) src1->data, nullptr, dst_q8_1, src0->type,
+                                   ne10, s11, s12, s13, ne10_padded, ne11, ne12, ne13, stream);
+            src1_q8_1 = dst_q8_1;
+        }
+    }
+
+    const int64_t s01 = src0->nb[1] / ts_src0;
+    const int64_t s02 = src0->nb[2] / ts_src0;
+    const int64_t s11 = ne10_padded / QK8_1;
+
+    const int stride_channel_dst = ggml_cuda_moe_reduce_per_slot_mode()
+        ? (int) (dst->nb[1] / ggml_type_size(dst->type)) : 0;
+
+    return mul_mat_vec_q_expert_reduce_switch_type(
+        src0->data, src0->type, src1_q8_1, (const int32_t *) ids->data,
+        (const float *) weights->data, (float *) dst->data,
+        ne00, ne01, n_slots, ne11, s01, s02, s11, stride_channel_dst, stream);
+}
