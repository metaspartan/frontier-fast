new file mode 100644
index 000000000..841576a55
--- /dev/null
+++ b/ggml/src/ggml-cuda/glu-quant-body.cuh
@@ -0,0 +1,49 @@
+#pragma once
+
+#include "common.cuh"
+
+// 0048: the fused GLU + q8_1 quantize body, shared by the standalone kernel in
+// unary.cu and by the co-launch guest inside mul_mat_vec_q (mmvq.cu).
+//
+// `i` is the flat destination element index. The only requirement for the guest
+// to be bit-identical to the standalone launch is that each warp covers 32
+// CONSECUTIVE, 32-ALIGNED destination elements - which holds for any block
+// shape whose thread count is a multiple of the warp size, over a contiguous
+// dst whose length is a multiple of QK8_1, because the index is flat. The two
+// reductions below are then over exactly the same 32 values in the same lanes
+// as in the standalone kernel, so d, q and ds come out bit for bit the same.
+template <float (*op)(float)>
+static __device__ __forceinline__ void glu_quant_body(
+        const float * x, const float * g, float * dst,
+        const int64_t k, const int64_t n, const int64_t o0, const int64_t o1,
+        void * q8_1_dst, const int64_t i) {
+    if (i >= k) {
+        return;
+    }
+
+    const int64_t j0 = (i / n) * o0 + (i % n);
+    const int64_t j1 = o0 == o1 ? j0 : (i / n) * o1 + (i % n);
+
+    const float val = op(x[j0]) * g[j1];
+    dst[i] = val;
+
+    block_q8_1 * y = (block_q8_1 *) q8_1_dst;
+
+    const int64_t ib  = i / QK8_1;
+    const int64_t iqs = i % QK8_1;
+
+    float amax = fabsf(val);
+    float sum  = val;
+
+    amax = warp_reduce_max<QK8_1>(amax);
+    sum  = warp_reduce_sum<QK8_1>(sum);
+
+    const float  d = amax / 127.0f;
+    const int8_t q = amax == 0.0f ? 0 : roundf(val / d);
+
+    y[ib].qs[iqs] = q;
+
+    if (iqs == 0) {
+        y[ib].ds = make_half2(d, sum);
+    }
+}
