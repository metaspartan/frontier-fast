+    out->g        = (const float *) gs1->data;
+    out->dst      = (float *) guest->data;
+    out->q8_1_dst = q8_1_dst;
+    out->k        = k_elem;
+    out->n        = guest->ne[0];
+    out->o0       = gs0->nb[1] / sizeof(float);
+    out->o1       = gs1->nb[1] / sizeof(float);
+    out->active   = true;
+    return j;
