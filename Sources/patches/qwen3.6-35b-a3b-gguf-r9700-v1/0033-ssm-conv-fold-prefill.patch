+// ---------------------------------------------------------------------------
+// Multi-token (prefill) generalisation of the GDN conv-chain fold.
+//
+// The stock prefill chain materialises conv_input = CONCAT(state_window,
+// TRANSPOSE(qkv_mixed)) - a [d_conv-1+n_t, C] time-major buffer built by
+// concat_non_cont from a channel-major activation, ~32 MB of scalar-indexed
+// traffic per layer - only for ggml_ssm_conv to transpose it straight back.
+// This fold reads qkv_mixed in its natural channel-major layout, keeps the
+// d_conv-wide window in registers, and writes the (silu of the) convolution
+// directly, in exactly the stock accumulation order.
+//
+// Hazard note: ggml-alloc is free to place the conv/silu output ON TOP of
+// qkv_mixed (the CONCAT is that tensor only consumer, so it is dead right
+// after it). Writing y therefore clobbers x. Within one thread that is safe -
+// output token i is written only after column i+d_conv-1 has been loaded, and
+// no later output of that channel needs it - but the d_conv-1 prologue columns
+// of a token chunk belong to the PREVIOUS chunk outputs, and the conv-state
+// writeback reads the last d_conv-1 input columns. Both are therefore
+// pre-staged by ssm_conv_fold_seq_pre_f32 before any output is written.
+// ---------------------------------------------------------------------------
+
+// Stage, from the still-pristine inputs, into a scratch buffer: the d_conv-1
+// prologue columns of every token chunk (slots 0..n_chunks-1) plus the
+// conv-state writeback triple (slot n_chunks). Nothing outside the scratch is
+// written here, so this kernel cannot race the conv state it reads - the
+// writeback lands later, from the fold kernel, once state is dead.
+template <int d_conv>
+static __global__ void ssm_conv_fold_seq_pre_f32(const float * __restrict__ state, const float * __restrict__ x,
+                                                 float * __restrict__ pro,
+                                                 const int nr, const int n_t, const int n_chunks, const int split_n_t,
+                                                 const int state_nb1, const int state_nb2,
+                                                 const int x_nb0, const int x_nb1, const int x_nb2) {
+    const int ch = blockIdx.x * blockDim.x + threadIdx.x;
+    if (ch >= nr) {
+        return;
+    }
+    const int seq = blockIdx.z;
+    const float * st = (const float *) ((const char *) state + (size_t) seq * state_nb2 + (size_t) ch * state_nb1);
+    const char  * xb = (const char *) x + (size_t) seq * x_nb2 + (size_t) ch * x_nb1;
+    pro += (size_t) seq * (n_chunks + 1) * (d_conv - 1) * nr;
+
+    const int k  = blockIdx.y;  // chunk index, or n_chunks for the writeback triple
+    const int c0 = k < n_chunks ? k * split_n_t : n_t;
+
+    float v[d_conv - 1];
+#pragma unroll
+    for (int j = 0; j < d_conv - 1; ++j) {
+        const int c = c0 + j;
+        v[j] = c < d_conv - 1 ? st[c] : *(const float *) (xb + (size_t) (c - (d_conv - 1)) * x_nb0);
+    }
+
+    float * out = pro + (size_t) k * (d_conv - 1) * nr;
+#pragma unroll
+    for (int j = 0; j < d_conv - 1; ++j) {
+        out[(size_t) j * nr + ch] = v[j];  // channel-major: coalesced
+    }
+}
+
+// One thread per channel per token chunk. Register window, stock accumulation.
+template <int d_conv>
+static __global__ void ssm_conv_fold_seq_f32(const float * __restrict__ x, const float * __restrict__ w_all,
+                                             const float * __restrict__ pro, float * __restrict__ y,
+                                             float * __restrict__ wb, const int n_chunks,
+                                             const int nr, const int n_t, const int split_n_t,
+                                             const int x_nb0, const int x_nb1, const int x_nb2,
+                                             const int y_nb1, const int y_nb2, const int w_nb1, const int wb_nb1) {
+    const int ch = blockIdx.x * blockDim.x + threadIdx.x;
+    if (ch >= nr) {
+        return;
+    }
+    const int t0 = blockIdx.y * split_n_t;
+    if (t0 >= n_t) {
+        return;
+    }
+    const int t1 = min(t0 + split_n_t, n_t);
+
+    const int seq = blockIdx.z;
+    x   = (const float *) ((const char *) x + (size_t) seq * x_nb2);
+    y   = (float *) ((char *) y + (size_t) seq * y_nb2);
+    wb  = (float *) ((char *) wb + (size_t) seq * wb_nb1);
+    pro += (size_t) seq * (n_chunks + 1) * (d_conv - 1) * nr;
+
+    // conv-state writeback, from the staged triple. Safe here: the fold reads
+    // its prologues from the scratch, so nothing reads the conv state any more.
+    if (blockIdx.y == 0) {
+        const float * wbs = pro + (size_t) n_chunks * (d_conv - 1) * nr;
+#pragma unroll
+        for (int j = 0; j < d_conv - 1; ++j) {
+            wb[(size_t) ch * (d_conv - 1) + j] = wbs[(size_t) j * nr + ch];
+        }
+    }
+
+    const float * wc = (const float *) ((const char *) w_all + (size_t) ch * w_nb1);
+    const char  * xb = (const char *) x + (size_t) ch * x_nb1;
+    const float * pb = pro + (size_t) blockIdx.y * (d_conv - 1) * nr;
+
+    // mirror the stock register structure (preloaded w[], rolling x window) so
+    // the compiler contracts the accumulation the same way
+    float w[d_conv];
+#pragma unroll
+    for (int j = 0; j < d_conv; ++j) {
+        w[j] = wc[j];
+    }
+
+    float b[d_conv];
+#pragma unroll
+    for (int j = 0; j < d_conv - 1; ++j) {
+        b[j] = pb[(size_t) j * nr + ch];
+    }
+    b[d_conv - 1] = *(const float *) (xb + (size_t) t0 * x_nb0);  // column t0+d_conv-1
+
+    for (int i = t0; i < t1; ++i) {
+        if (i > t0) {
+#pragma unroll
+            for (int j = 0; j < d_conv - 1; ++j) {
+                b[j] = b[j + 1];
+            }
+            // column i+d_conv-1 == x index i (always >= 0 here)
+            b[d_conv - 1] = *(const float *) (xb + (size_t) i * x_nb0);
+        }
+
+        float sumf = 0.0f;
+#pragma unroll
+        for (int j = 0; j < d_conv; ++j) {
+            sumf += b[j] * w[j];
+        }
+        // The stock kernels accumulate from a literal 0.0f that the compiler
+        // keeps; here it folds that add away, so a window of all zeros lands
+        // on -0.0 where stock produces +0.0. Value-equal, but not byte-equal,
+        // and the sign does survive silu into the rest of the graph. Normalise
+        // it back on the bit pattern - an arithmetic (sumf + 0.0f) is legal to
+        // optimise away here and duly was. One VALU op per output.
+        if (__float_as_int(sumf) == (int) 0x80000000) {
+            sumf = 0.0f;
+        }
+        *(float *) ((char *) y + (size_t) i * y_nb1 + (size_t) ch * sizeof(float)) = ggml_cuda_op_silu_single(sumf);
+    }
+}
+
+// Diagnostic: GGML_SSM_CONV_DUMP=<prefix> writes the first 60 conv outputs
+// (stock or folded, whichever ran) to <prefix>.<n>.bin. Two runs of the same
+// prompt with the fold toggled therefore give a direct max-abs-diff on the
+// convolution result, which is the only thing this fold is allowed to change.
+static void ssm_conv_fold_dump(const ggml_tensor * out, cudaStream_t stream) {
+    static const char * pfx = getenv("GGML_SSM_CONV_DUMP");
+    if (pfx == nullptr || ssm_dump_capturing(stream)) {
+        return;
+    }
+    static const int64_t min_t = getenv("GGML_SSM_CONV_DUMP_MINT") ? atoi(getenv("GGML_SSM_CONV_DUMP_MINT")) : 0;
+    if (out->ne[1] < min_t) {
+        return;
+    }
+    static int n = 0;
+    if (n >= ssm_dump_max()) {
+        return;
+    }
+    const size_t nb = ggml_nbytes(out);
+    std::vector<char> host(nb);
+    CUDA_CHECK(cudaStreamSynchronize(stream));
+    CUDA_CHECK(cudaMemcpy(host.data(), out->data, nb, cudaMemcpyDeviceToHost));
+    char path[512];
+    snprintf(path, sizeof(path), "%s.%03d.bin", pfx, n++);
+    FILE * f = fopen(path, "wb");
+    if (f) {
+        fwrite(host.data(), 1, nb, f);
+        fclose(f);
+    }
+}
+
+// Diagnostic: GGML_SSM_WB_DUMP=<prefix> writes the conv-state writeback triple
+// as each arm computes it - the stock arm from the tail columns of the
+// materialised conv_input, the folded arm from the cache row it just wrote -
+// in the same compact [d_conv-1, nr] channel-major layout, so the two are
+// directly comparable.
+static void ssm_conv_wb_dump_raw(const void * src, size_t dpitch, size_t spitch,
+                                 size_t width, size_t height, cudaStream_t stream) {
+    static const char * pfx = getenv("GGML_SSM_WB_DUMP");
+    if (pfx == nullptr || ssm_dump_capturing(stream)) {
+        return;
+    }
+    static int n = 0;
+    if (n >= ssm_dump_max()) {
+        return;
+    }
+    std::vector<char> host(dpitch * height);
+    CUDA_CHECK(cudaStreamSynchronize(stream));
+    #ifdef GGML_USE_HIP
+    CUDA_CHECK(hipMemcpy2D(host.data(), dpitch, src, spitch, width, height, hipMemcpyDeviceToHost));
+#else
+    CUDA_CHECK(cudaMemcpy2D(host.data(), dpitch, src, spitch, width, height, cudaMemcpyDeviceToHost));
+#endif
+    char path[512];
+    snprintf(path, sizeof(path), "%s.%03d.bin", pfx, n++);
+    FILE * f = fopen(path, "wb");
+    if (f) { fwrite(host.data(), 1, host.size(), f); fclose(f); }
+}
+
+// Single-chunk form: one thread owns a channel for the whole ubatch, so the
+// d_conv-1 window that the state writeback needs is still in its registers at
+// the end and no staging buffer (and no pool allocation, and no second kernel)
+// is required. Used whenever one chunk covers all the tokens.
+template <int d_conv>
+static __global__ void ssm_conv_fold_seq1_f32(const float * __restrict__ state, const float * __restrict__ x,
+                                              const float * __restrict__ w_all, float * __restrict__ y,
+                                              float * __restrict__ wb,
+                                              const int nr, const int n_t,
+                                              const int state_nb1, const int state_nb2,
+                                              const int x_nb0, const int x_nb1, const int x_nb2,
+                                              const int y_nb1, const int y_nb2, const int w_nb1, const int wb_nb1) {
+    const int ch = blockIdx.x * blockDim.x + threadIdx.x;
+    if (ch >= nr) {
+        return;
+    }
+    const int seq = blockIdx.y;
+
+    const float * st = (const float *) ((const char *) state + (size_t) seq * state_nb2 + (size_t) ch * state_nb1);
+    const float * wc = (const float *) ((const char *) w_all + (size_t) ch * w_nb1);
+    const char  * xb = (const char *) x + (size_t) seq * x_nb2 + (size_t) ch * x_nb1;
+    char        * yb = (char *) y + (size_t) seq * y_nb2 + (size_t) ch * sizeof(float);
+    float       * wbc = (float *) ((char *) wb + (size_t) seq * wb_nb1) + (size_t) ch * (d_conv - 1);
+
+    float w[d_conv];
+#pragma unroll
+    for (int j = 0; j < d_conv; ++j) {
+        w[j] = wc[j];
+    }
+
+    float b[d_conv];
+#pragma unroll
+    for (int j = 0; j < d_conv; ++j) {
+        const int c = j;  // window for output token 0: columns 0..d_conv-1
+        b[j] = c < d_conv - 1 ? st[c] : *(const float *) (xb + (size_t) (c - (d_conv - 1)) * x_nb0);
+    }
+
+    for (int i = 0; i < n_t; ++i) {
+        if (i > 0) {
+#pragma unroll
+            for (int j = 0; j < d_conv - 1; ++j) {
+                b[j] = b[j + 1];
+            }
+            const int c = i + d_conv - 1;
+            b[d_conv - 1] = c < d_conv - 1 ? st[c] : *(const float *) (xb + (size_t) (c - (d_conv - 1)) * x_nb0);
+        }
+
+        float sumf = 0.0f;
+#pragma unroll
+        for (int j = 0; j < d_conv; ++j) {
+            sumf += b[j] * w[j];
+        }
+        // see the note in ssm_conv_fold_seq_f32
+        if (__float_as_int(sumf) == (int) 0x80000000) {
+            sumf = 0.0f;
+        }
+        *(float *) (yb + (size_t) i * y_nb1) = ggml_cuda_op_silu_single(sumf);
+    }
+
+    // after the last output the window holds columns n_t-1 .. n_t+d_conv-2,
+    // and the conv state is exactly columns n_t .. n_t+d_conv-2
+#pragma unroll
+    for (int j = 0; j < d_conv - 1; ++j) {
+        wbc[j] = b[j + 1];
+    }
+}
+
+void ggml_cuda_op_ssm_conv_fold_seq(ggml_backend_cuda_context & ctx,
+        const ggml_tensor * concat, const ggml_tensor * ssm_conv,
+        const ggml_tensor * silu, const ggml_tensor * wb_cpy) {
+    constexpr int d_conv = 4;
+
+    const ggml_tensor * state = concat->src[0];
+    const ggml_tensor * x     = concat->src[1];
+    const ggml_tensor * w     = ssm_conv->src[1];
+    const ggml_tensor * wb    = wb_cpy->src[1];
+
+    const int nr  = (int) concat->ne[1];
+    const int n_t = (int) x->ne[0];
+    const int n_s = (int) concat->ne[2];
+
+    static const int split_n_t = [] {
+        const char * e = getenv("GGML_SSM_CONV_FOLD_SPLIT");
+        const int    v = e ? atoi(e) : 64;
+        return v > 0 ? v : 64;
+    }();
+
+    const int n_chunks = (n_t + split_n_t - 1) / split_n_t;
+
+    static const int block = [] {
+        const char * e = getenv("GGML_SSM_CONV_FOLD_BLOCK");
+        const int    v = e ? atoi(e) : 256;
+        return v > 0 ? v : 256;
+    }();
+    const int    gx     = (nr + block - 1) / block;
+    cudaStream_t stream = ctx.stream();
+
+    if (n_chunks == 1) {
+        // no staging buffer, no pool allocation, one kernel
+        const ggml_cuda_kernel_launch_params lp =
+            ggml_cuda_kernel_launch_params(dim3(gx, n_s, 1), dim3(block, 1, 1), 0, stream);
+        ggml_cuda_kernel_launch(ssm_conv_fold_seq1_f32<d_conv>, lp,
+            (const float *) state->data, (const float *) x->data, (const float *) w->data,
+            (float *) silu->data, (float *) wb->data,
+            nr, n_t, (int) state->nb[1], (int) state->nb[2],
+            (int) x->nb[0], (int) x->nb[1], (int) x->nb[2],
+            (int) silu->nb[1], (int) silu->nb[2], (int) w->nb[1], (int) wb->nb[1]);
+        ssm_conv_fold_dump(silu, stream);
+        ssm_conv_wb_dump_raw(wb->data, (d_conv - 1) * sizeof(float), (d_conv - 1) * sizeof(float),
+                             (d_conv - 1) * sizeof(float), (size_t) nr * n_s, stream);
+        return;
+    }
+
+    ggml_cuda_pool_alloc<float> pro(ctx.pool(), (size_t) n_s * (n_chunks + 1) * (d_conv - 1) * nr);
+
+    {
+        const ggml_cuda_kernel_launch_params lp =
+            ggml_cuda_kernel_launch_params(dim3(gx, n_chunks + 1, n_s), dim3(block, 1, 1), 0, stream);
+        ggml_cuda_kernel_launch(ssm_conv_fold_seq_pre_f32<d_conv>, lp,
+            (const float *) state->data, (const float *) x->data, pro.get(),
+            nr, n_t, n_chunks, split_n_t, (int) state->nb[1], (int) state->nb[2],
+            (int) x->nb[0], (int) x->nb[1], (int) x->nb[2]);
+    }
+    {
+        const ggml_cuda_kernel_launch_params lp =
+            ggml_cuda_kernel_launch_params(dim3(gx, n_chunks, n_s), dim3(block, 1, 1), 0, stream);
+        ggml_cuda_kernel_launch(ssm_conv_fold_seq_f32<d_conv>, lp,
+            (const float *) x->data, (const float *) w->data, (const float *) pro.get(), (float *) silu->data,
+            (float *) wb->data, n_chunks,
+            nr, n_t, split_n_t, (int) x->nb[0], (int) x->nb[1], (int) x->nb[2],
+            (int) silu->nb[1], (int) silu->nb[2], (int) w->nb[1], (int) wb->nb[1]);
+    }
+
+    ssm_conv_fold_dump(silu, stream);
+    ssm_conv_wb_dump_raw(wb->data, (d_conv - 1) * sizeof(float), (d_conv - 1) * sizeof(float),
+                         (d_conv - 1) * sizeof(float), (size_t) nr * n_s, stream);
+}
