---
 ggml/src/ggml-cuda/gated_delta_net.cu | 322 +++++++++++++++++++++++++-
 1 file changed, 320 insertions(+), 2 deletions(-)

diff --git a/ggml/src/ggml-cuda/gated_delta_net.cu b/ggml/src/ggml-cuda/gated_delta_net.cu
index cbea8d2db..f04fe060e 100644
--- a/ggml/src/ggml-cuda/gated_delta_net.cu
+++ b/ggml/src/ggml-cuda/gated_delta_net.cu
@@ -1,6 +1,8 @@
 #include "gated_delta_net.cuh"
 #include "ggml-cuda/common.cuh"
 
+#include <cstdlib>
+
 #if defined(GGML_USE_HIP) && (defined(__gfx1200__) || defined(__gfx1201__))
 // RDNA4 wave32: VALU-only butterfly reduction via DPP + permlanex16.
 // The generic warp_reduce_sum lowers __shfl_xor to ds_bpermute_b32, which round-trips
@@ -33,6 +35,277 @@ static __device__ __forceinline__ float gdn_warp_reduce_sum(float x) {
     return warp_reduce_sum<warp_size>(x);
 }
 
+// Reduce across each aligned group of NL lanes, in ascending lane-bit order. NL == 32
+// is gdn_warp_reduce_sum above, step for step; every smaller NL is a strict prefix of
+// that sequence, and each step only ever exchanges inside a group of NL lanes:
+// quad_perm ^1, quad_perm ^2, row_half_mirror (the other quad of an octet), row_mirror
+// (the other octet of a row of 16), permlanex16 (the other row of 16).
+template <int NL, int warp_size>
+static __device__ __forceinline__ float gdn_warp_reduce_sum_n(float x) {
+#ifdef GDN_DPP_REDUCE
+    if constexpr (warp_size == 32) {
+        union fi_t { float f; int i; };
+        fi_t a, b;
+        a.f = x;
+        if constexpr (NL >= 2) {
+            b.i  = __builtin_amdgcn_update_dpp(0, a.i, 0xB1, 0xF, 0xF, true);
+            a.f += b.f;
+        }
+        if constexpr (NL >= 4) {
+            b.i  = __builtin_amdgcn_update_dpp(0, a.i, 0x4E, 0xF, 0xF, true);
+            a.f += b.f;
+        }
+        if constexpr (NL >= 8) {
+            b.i  = __builtin_amdgcn_update_dpp(0, a.i, 0x141, 0xF, 0xF, true);
+            a.f += b.f;
+        }
+        if constexpr (NL >= 16) {
+            b.i  = __builtin_amdgcn_update_dpp(0, a.i, 0x140, 0xF, 0xF, true);
+            a.f += b.f;
+        }
+        if constexpr (NL >= 32) {
+            b.i  = __builtin_amdgcn_permlanex16(a.i, a.i, 0x76543210, 0xFEDCBA98, false, false);
+            a.f += b.f;
+        }
+        return a.f;
+    }
+#endif
+#pragma unroll
+    for (int offset = NL / 2; offset > 0; offset >>= 1) {
+        x += __shfl_xor_sync(0xffffffff, x, offset, warp_size);
+    }
+    return x;
+}
+
+// Balanced binary tree over N chunk accumulators, adjacent pairs first. This is the
+// in-register continuation of the very same tree the lane butterfly builds: when a
+// lane owns N four-row chunks, chunk j of lane m holds exactly what one-column lane
+// (m * N + j) held, so pairing adjacent chunks reproduces the low lane-index bits of
+// the stock reduction and gdn_warp_reduce_sum_n<32/N> supplies the high bits.
+template <int N>
+static __device__ __forceinline__ float gdn_tree_sum(const float (&a)[N]) {
+    if constexpr (N == 1) {
+        return a[0];
+    } else {
+        float t[N / 2];
+#pragma unroll
+        for (int i = 0; i < N / 2; i++) {
+            t[i] = a[2 * i] + a[2 * i + 1];
+        }
+        return gdn_tree_sum<N / 2>(t);
+    }
+}
+
+// Multi-column variant of the kernel below, for the prefill shape only.
+//
+// The stock kernel gives one column of the recurrent state to a whole wave: 32 lanes
+// hold 4 rows each and two 5-step butterflies per token turn the two row-sharded dot
+// products into scalars. At pp512 that is ~39 VALU ops per token per column, of which
+// 20 are the butterflies -- and the kernel is issue-bound (4096 waves over 128 SIMDs,
+// 65 cycles per token per wave against ~39 ops of arithmetic), so the butterflies are
+// half the cost.
+//
+// Here a wave carries CPW columns: it splits into CPW groups of 32/CPW lanes, each
+// group owning one column and a proportionally taller contiguous row shard. Per column
+// the arithmetic is unchanged; the reduction is (log2(32/CPW) butterfly steps) instead
+// of 5, with the remaining levels folded into the in-register chunk tree, which costs
+// nothing extra because those adds replace adds the stock lane already did.
+//
+// Bit-exact against the stock kernel at every CPW: the per-lane chains are still the
+// same four-row fma chains in the same order, and gdn_tree_sum + gdn_warp_reduce_sum_n
+// reassemble them in exactly the stock butterfly's order (see gdn_tree_sum).
+template <int S_v, bool KDA, bool keep_rs_t, int CPW>
+__global__ void __launch_bounds__((ggml_cuda_get_physical_warp_size() < S_v ? ggml_cuda_get_physical_warp_size() : S_v) * 4, CPW >= 8 ? 1 : 2)
+gated_delta_net_mc_cuda(const float * q,
+                                     const float * k,
+                                     const float * v,
+                                     const float * g,
+                                     const float * beta,
+                                     const float * curr_state,
+                                     float *       dst,
+                                     float *       state,
+                                     int64_t       H,
+                                     int64_t       n_tokens,
+                                     int64_t       n_seqs,
+                                     int64_t       sq1,
+                                     int64_t       sq2,
+                                     int64_t       sq3,
+                                     int64_t       sv1,
+                                     int64_t       sv2,
+                                     int64_t       sv3,
+                                     int64_t       sb1,
+                                     int64_t       sb2,
+                                     int64_t       sb3,
+                                     const uint3   neqk1_magic,
+                                     const uint3   rq3_magic,
+                                     float         scale,
+                                     int64_t       state_slot_stride,
+                                     int           K) {
+    const uint32_t h_idx    = blockIdx.x;
+    const uint32_t sequence = blockIdx.y;
+    const int      lane     = threadIdx.x;
+
+    constexpr int warp_size = ggml_cuda_get_physical_warp_size() < S_v ? ggml_cuda_get_physical_warp_size() : S_v;
+    static_assert(warp_size == 32, "the multi-column path is the RDNA wave32 vec4 layout");
+    static_assert(S_v == 4 * 32, "the multi-column path is the S_v == 128 vec4 layout");
+    static_assert(CPW >= 2 && CPW <= 8 && (CPW & (CPW - 1)) == 0, "CPW must be 2, 4 or 8");
+
+    constexpr int lanes_per_col = warp_size / CPW;      // lanes cooperating on one column
+    constexpr int rows_per_lane = S_v / lanes_per_col;  // contiguous rows owned by a lane
+    constexpr int nchunk        = rows_per_lane / 4;    // float4 chunks, one stock lane each
+
+    const int col_lane = lane & (lanes_per_col - 1);
+    const int col      = (blockIdx.z * blockDim.y + threadIdx.y) * CPW + lane / lanes_per_col;
+    const int row0     = col_lane * rows_per_lane;
+
+    const uint32_t iq1 = fastmodulo(h_idx, neqk1_magic);
+    const uint32_t iq3 = fastdiv(sequence, rq3_magic);
+
+    float * attn_data = dst;
+
+    const int64_t state_in_offset  = sequence * H * S_v * S_v + h_idx * S_v * S_v;
+    const int64_t state_out_offset = (sequence * H + h_idx) * S_v * S_v;
+    state += state_out_offset;
+    curr_state += state_in_offset + col * S_v;
+    attn_data += (sequence * n_tokens * H + h_idx) * S_v;
+
+    float s_shard[rows_per_lane];
+
+    ggml_cuda_pdl_sync();
+#pragma unroll
+    for (int ch = 0; ch < nchunk; ch++) {
+        const float4 s4 = *(const float4 *) (curr_state + row0 + ch * 4);
+        s_shard[ch * 4 + 0] = s4.x; s_shard[ch * 4 + 1] = s4.y;
+        s_shard[ch * 4 + 2] = s4.z; s_shard[ch * 4 + 3] = s4.w;
+    }
+
+    for (int t = 0; t < n_tokens; t++) {
+        const float * q_t = q + iq3 * sq3 + t * sq2 + iq1 * sq1;
+        const float * k_t = k + iq3 * sq3 + t * sq2 + iq1 * sq1;
+        const float * v_t = v + sequence * sv3 + t * sv2 + h_idx * sv1;
+
+        const int64_t gb_offset = sequence * sb3 + t * sb2 + h_idx * sb1;
+        const float * beta_t = beta + gb_offset;
+        const float * g_t    = g    + gb_offset * (KDA ? S_v : 1);
+
+        const float beta_val = *beta_t;
+
+        float k_reg[rows_per_lane];
+        float q_reg[rows_per_lane];
+#pragma unroll
+        for (int ch = 0; ch < nchunk; ch++) {
+            const float4 k4 = *(const float4 *) (k_t + row0 + ch * 4);
+            const float4 q4 = *(const float4 *) (q_t + row0 + ch * 4);
+            k_reg[ch * 4 + 0] = k4.x; k_reg[ch * 4 + 1] = k4.y;
+            k_reg[ch * 4 + 2] = k4.z; k_reg[ch * 4 + 3] = k4.w;
+            q_reg[ch * 4 + 0] = q4.x; q_reg[ch * 4 + 1] = q4.y;
+            q_reg[ch * 4 + 2] = q4.z; q_reg[ch * 4 + 3] = q4.w;
+        }
+
+        float acc[nchunk];
+
+        if constexpr (!KDA) {
+            const float g_val = expf(*g_t);
+
+            // kv[col] = (S^T @ k)[col] = sum_i S[i][col] * k[i]
+#pragma unroll
+            for (int ch = 0; ch < nchunk; ch++) {
+                float kv_shard = 0.0f;
+#pragma unroll
+                for (int r = 0; r < 4; r++) {
+                    kv_shard += s_shard[ch * 4 + r] * k_reg[ch * 4 + r];
+                }
+                acc[ch] = kv_shard;
+            }
+            const float kv_col = gdn_warp_reduce_sum_n<lanes_per_col, warp_size>(gdn_tree_sum<nchunk>(acc));
+
+            // delta[col] = (v[col] - g * kv[col]) * beta
+            const float delta_col = (v_t[col] - g_val * kv_col) * beta_val;
+
+            // fused: S[i][col] = g * S[i][col] + k[i] * delta[col]
+            // attn[col] = (S^T @ q)[col] = sum_i S[i][col] * q[i]
+#pragma unroll
+            for (int ch = 0; ch < nchunk; ch++) {
+                float attn_partial = 0.0f;
+#pragma unroll
+                for (int r = 0; r < 4; r++) {
+                    const int i   = ch * 4 + r;
+                    s_shard[i]    = g_val * s_shard[i] + k_reg[i] * delta_col;
+                    attn_partial += s_shard[i] * q_reg[i];
+                }
+                acc[ch] = attn_partial;
+            }
+            const float attn_col = gdn_warp_reduce_sum_n<lanes_per_col, warp_size>(gdn_tree_sum<nchunk>(acc));
+
+            if (col_lane == 0) {
+                attn_data[col] = attn_col * scale;
+            }
+        } else {
+            float g_reg[rows_per_lane];
+#pragma unroll
+            for (int ch = 0; ch < nchunk; ch++) {
+                const float4 g4 = *(const float4 *) (g_t + row0 + ch * 4);
+                g_reg[ch * 4 + 0] = g4.x; g_reg[ch * 4 + 1] = g4.y;
+                g_reg[ch * 4 + 2] = g4.z; g_reg[ch * 4 + 3] = g4.w;
+            }
+
+            // kv[col] = sum_i g[i] * S[i][col] * k[i]
+#pragma unroll
+            for (int ch = 0; ch < nchunk; ch++) {
+                float kv_shard = 0.0f;
+#pragma unroll
+                for (int r = 0; r < 4; r++) {
+                    const int i = ch * 4 + r;
+                    kv_shard += expf(g_reg[i]) * s_shard[i] * k_reg[i];
+                }
+                acc[ch] = kv_shard;
+            }
+            const float kv_col = gdn_warp_reduce_sum_n<lanes_per_col, warp_size>(gdn_tree_sum<nchunk>(acc));
+
+            const float delta_col = (v_t[col] - kv_col) * beta_val;
+
+#pragma unroll
+            for (int ch = 0; ch < nchunk; ch++) {
+                float attn_partial = 0.0f;
+#pragma unroll
+                for (int r = 0; r < 4; r++) {
+                    const int i   = ch * 4 + r;
+                    s_shard[i]    = expf(g_reg[i]) * s_shard[i] + k_reg[i] * delta_col;
+                    attn_partial += s_shard[i] * q_reg[i];
+                }
+                acc[ch] = attn_partial;
+            }
+            const float attn_col = gdn_warp_reduce_sum_n<lanes_per_col, warp_size>(gdn_tree_sum<nchunk>(acc));
+
+            if (col_lane == 0) {
+                attn_data[col] = attn_col * scale;
+            }
+        }
+
+        attn_data += S_v * H;
+
+        if constexpr (keep_rs_t) {
+            const int target_slot = (int) n_tokens - 1 - t;
+            if (target_slot >= 0 && target_slot < K) {
+                float * slot_state = state + target_slot * state_slot_stride;
+#pragma unroll
+                for (int ch = 0; ch < nchunk; ch++) {
+                    *(float4 *) (slot_state + col * S_v + row0 + ch * 4) =
+                        make_float4(s_shard[ch * 4 + 0], s_shard[ch * 4 + 1], s_shard[ch * 4 + 2], s_shard[ch * 4 + 3]);
+                }
+            }
+        }
+    }
+
+    if constexpr (!keep_rs_t) {
+#pragma unroll
+        for (int ch = 0; ch < nchunk; ch++) {
+            *(float4 *) (state + col * S_v + row0 + ch * 4) =
+                make_float4(s_shard[ch * 4 + 0], s_shard[ch * 4 + 1], s_shard[ch * 4 + 2], s_shard[ch * 4 + 3]);
+        }
+    }
+}
+
 template <int S_v, bool KDA, bool keep_rs_t, bool vec4>
 __global__ void __launch_bounds__((ggml_cuda_get_physical_warp_size() < S_v ? ggml_cuda_get_physical_warp_size() : S_v) * 4, 2)
 gated_delta_net_cuda(const float * q,
@@ -229,6 +502,19 @@ gated_delta_net_cuda(const float * q,
     }
 }
 
+// Columns per wave for the S_v == 128 vec4 prefill path. The recurrence is serial in
+// tokens, so at the decode shape the kernel is pure launch/latency and the stock
+// one-column mapping (maximum wave count, minimum registers) is the right one; the
+// multi-column kernel is never reached there, which keeps decode codegen untouched.
+static int gdn_cols_per_wave(int64_t n_tokens) {
+    static const int cpw_prefill = []() {
+        const char * s = getenv("GGML_GDN_COLS_PER_WAVE");
+        const int    v = s ? atoi(s) : 4;
+        return (v == 1 || v == 2 || v == 4 || v == 8) ? v : 4;
+    }();
+    return n_tokens > 1 ? cpw_prefill : 1;
+}
+
 template <bool KDA, bool keep_rs_t>
 static void launch_gated_delta_net(
         const float * q_d, const float * k_d, const float * v_d,
@@ -243,8 +529,6 @@ static void launch_gated_delta_net(
     //TODO: Add chunked kernel for even faster pre-fill
     const int warp_size = ggml_cuda_info().devices[ggml_cuda_get_device()].warp_size;
     const int num_warps = 4;
-    dim3      grid_dims(H, n_seqs, (S_v + num_warps - 1) / num_warps);
-    dim3      block_dims(warp_size <= S_v ? warp_size : S_v, num_warps, 1);
 
     const uint3 neqk1_magic = init_fastdiv_values(neqk1);
     const uint3 rq3_magic   = init_fastdiv_values(rq3);
@@ -255,7 +539,41 @@ static void launch_gated_delta_net(
         (sq1 % 4) == 0 && (sq2 % 4) == 0 && (sq3 % 4) == 0 &&
         (state_slot_stride % 4) == 0;
 
+    // multi-column waves: prefill only, vec4 layout only, and only when the columns
+    // tile the block exactly.
+    int cpw = vec4 ? gdn_cols_per_wave(n_tokens) : 1;
+    while (cpw > 1 && S_v % (int64_t) (num_warps * cpw) != 0) {
+        cpw /= 2;
+    }
+
+    dim3 grid_dims(H, n_seqs, (S_v + num_warps * cpw - 1) / (num_warps * cpw));
+    dim3 block_dims(warp_size <= S_v ? warp_size : S_v, num_warps, 1);
+
     const ggml_cuda_kernel_launch_params launch_params = ggml_cuda_kernel_launch_params(grid_dims, block_dims, 0, stream);
+
+    if (cpw > 1) {
+        switch (cpw) {
+            case 8:
+                ggml_cuda_kernel_launch(gated_delta_net_mc_cuda<128, KDA, keep_rs_t, 8>, launch_params,
+                    q_d, k_d, v_d, g_d, b_d, s_d, dst_d, state_d, H,
+                    n_tokens, n_seqs, sq1, sq2, sq3, sv1, sv2, sv3,
+                    sb1, sb2, sb3, neqk1_magic, rq3_magic, scale, state_slot_stride, K);
+                return;
+            case 4:
+                ggml_cuda_kernel_launch(gated_delta_net_mc_cuda<128, KDA, keep_rs_t, 4>, launch_params,
+                    q_d, k_d, v_d, g_d, b_d, s_d, dst_d, state_d, H,
+                    n_tokens, n_seqs, sq1, sq2, sq3, sv1, sv2, sv3,
+                    sb1, sb2, sb3, neqk1_magic, rq3_magic, scale, state_slot_stride, K);
+                return;
+            default:
+                ggml_cuda_kernel_launch(gated_delta_net_mc_cuda<128, KDA, keep_rs_t, 2>, launch_params,
+                    q_d, k_d, v_d, g_d, b_d, s_d, dst_d, state_d, H,
+                    n_tokens, n_seqs, sq1, sq2, sq3, sv1, sv2, sv3,
+                    sb1, sb2, sb3, neqk1_magic, rq3_magic, scale, state_slot_stride, K);
+                return;
+        }
+    }
+
     switch (S_v) {
         case 16:
             ggml_cuda_kernel_launch(gated_delta_net_cuda<16, KDA, keep_rs_t, false>, launch_params,
