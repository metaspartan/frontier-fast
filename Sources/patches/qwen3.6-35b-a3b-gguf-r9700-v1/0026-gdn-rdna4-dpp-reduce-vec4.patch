+#if defined(GGML_USE_HIP) && (defined(__gfx1200__) || defined(__gfx1201__))
+// RDNA4 wave32: VALU-only butterfly reduction via DPP + permlanex16.
+// The generic warp_reduce_sum lowers __shfl_xor to ds_bpermute_b32, which round-trips
+// through the LDS unit with a full s_wait_dscnt after every step (10 round-trips per
+// token for the two reductions in the delta-net recurrence). The DPP form issues on
+// the VALU with no LDS traffic and no data-counter waits.
+#define GDN_DPP_REDUCE 1
+#endif
+
+template <int warp_size>
+static __device__ __forceinline__ float gdn_warp_reduce_sum(float x) {
+#ifdef GDN_DPP_REDUCE
+    if constexpr (warp_size == 32) {
+        union fi_t { float f; int i; };
+        fi_t a, b;
+        a.f = x;
+        b.i  = __builtin_amdgcn_update_dpp(0, a.i, 0xB1, 0xF, 0xF, true);  // quad_perm [1,0,3,2]: + lane^1
+        a.f += b.f;
+        b.i  = __builtin_amdgcn_update_dpp(0, a.i, 0x4E, 0xF, 0xF, true);  // quad_perm [2,3,0,1]: + lane^2
+        a.f += b.f;
+        b.i  = __builtin_amdgcn_update_dpp(0, a.i, 0x141, 0xF, 0xF, true); // row_half_mirror: + other quad
+        a.f += b.f;
+        b.i  = __builtin_amdgcn_update_dpp(0, a.i, 0x140, 0xF, 0xF, true); // row_mirror: + other octet
+        a.f += b.f;
+        b.i  = __builtin_amdgcn_permlanex16(a.i, a.i, 0x76543210, 0xFEDCBA98, false, false); // + other row
+        a.f += b.f;
+        return a.f;
+    }
+#endif
+    return warp_reduce_sum<warp_size>(x);
+}
