index a6d1121cb..b8c0f08fa 100644
--- a/ggml/src/ggml-cuda/ggml-cuda.cu
+++ b/ggml/src/ggml-cuda/ggml-cuda.cu
@@ -3421,20 +3421,172 @@ static bool ggml_cuda_mmvf_can_group(const ggml_tensor * node, const int cc) {
 }
 
 
-// ----- sigmoid epilogue fusion for grouped mmvf -------------------------------
+// ----- epilogue fusion for grouped mmvf --------------------------------------
 //
-// beta = sigmoid(ssm_beta @ x) on the GDN layers and the shared-expert gate
-// sigmoid on every layer consume grouped-mmvf segment outputs and nothing
-// else. Applying the exact op_sigmoid expression in the segment epilogue
-// removes ~70 elementwise launches per decoded token; outputs are
-// byte-identical because the same accumulator value passes through the same
-// expression the separate kernel would apply. GGML_CUDA_DISABLE_MMVF_SIG_FUSE
-// disables.
-static void ggml_cuda_mmvf_collect_sigmoid_epilogues(
+// Two tiny per-layer chains hang directly off grouped-mmvf segment outputs and
+// nothing else:
+//
+//   beta  = sigmoid(ssm_beta @ x)                       (30 GDN layers)
+//   gate  = softplus(ssm_alpha @ x + ssm_dt) * ssm_a    (30 GDN layers)
+//   shexp = sigmoid(gate_shexp @ x)                     (every layer)
+//
+// Each link is an elementwise op over 32 (or 1) floats: a whole kernel launch
+// plus ~1.5us of graph-replay overhead for work a single lane already holds in
+// a register. Applying the same expressions in the segment epilogue removes
+// them. The value that enters the epilogue is exactly the float the matvec
+// would have stored, and every step below is the statement the stock kernel
+// evaluates, in the same order, so the stored result is unchanged.
+//
+// The alpha chain reaches its member through a ggml_reshape view, which the
+// original (identity-only) matcher could not see through - hence
+// ggml_cuda_mmvf_epi_member, which walks whole-tensor alias links and requires
+// a single consumer at every step so nobody can observe a value the epilogue
+// no longer materialises. GGML_CUDA_DISABLE_MMVF_SIG_FUSE disables.
+static bool ggml_cuda_mmvf_epi_debug() {
+    static const bool on = getenv("GGML_CUDA_MMVF_EPI_DEBUG") != nullptr &&
+                           std::atoi(getenv("GGML_CUDA_MMVF_EPI_DEBUG"));
+    return on;
+}
+
+#define EPI_DBG(...) do { if (ggml_cuda_mmvf_epi_debug()) { fprintf(stderr, "EPIDBG " __VA_ARGS__); } } while (0)
+
+static bool ggml_cuda_mmvf_epi_ext_disabled() {
+    static const bool disabled = getenv("GGML_CUDA_DISABLE_MMVF_EPI_EXT") != nullptr &&
+                                 std::atoi(getenv("GGML_CUDA_DISABLE_MMVF_EPI_EXT"));
+    return disabled;
+}
+
+static int ggml_cuda_mmvf_epi_member(const ggml_cgraph * cgraph, const int start, const int limit,
+        const ggml_tensor * t, ggml_tensor * const * members, const int n_members) {
+    const ggml_tensor * cur = t;
+    if (cur == nullptr) {
+        return -1;
+    }
+    const int max_depth = ggml_cuda_mmvf_epi_ext_disabled() ? 1 : 4;
+    for (int depth = 0; depth < max_depth; ++depth) {
+        for (int m = 0; m < n_members; ++m) {
+            if (cur != members[m]) {
+                continue;
+            }
+            for (int k = start; k < limit; ++k) {
+                if (cgraph->nodes[k] == cur) {
+                    return ggml_node_get_use_count(cgraph, k) == 1 ? m : -1;
+                }
+            }
+            return -1;
+        }
+        // not a member: peel one whole-tensor alias link
+        if (cur->view_src == nullptr || !ggml_cuda_is_view_or_noop(cur) ||
+                cur->type != GGML_TYPE_F32 || cur->view_offs != 0 ||
+                !ggml_is_contiguous(cur) ||
+                ggml_nelements(cur) != ggml_nelements(cur->view_src)) {
+            return -1;
+        }
+        bool found = false;
+        for (int k = start; k < limit && !found; ++k) {
+            if (cgraph->nodes[k] == cur) {
+                if (ggml_node_get_use_count(cgraph, k) != 1) {
+                    return -1;
+                }
+                found = true;
+            }
+        }
+        if (!found) {
+            return -1;
+        }
+        cur = cur->view_src;
+    }
+    return -1;
+}
+
+// Hoisting the epilogue write to group-launch time must not conflict with
+// anything the intermediate nodes read or write, and must not overlap another
+// segment destination. The nodes the fold removes (skip_a / skip_b) no longer
+// write anything, so they are exempt.
+static bool ggml_cuda_mmvf_epi_legal(const ggml_cgraph * cgraph, const int start, const int j,
+        const ggml_tensor * out, ggml_tensor * const * members, const int n_members,
+        const mmvf_epilogue * epi, const int own, const ggml_tensor * skip_a, const ggml_tensor * skip_b) {
+    for (int k = start + 1; k < j; ++k) {
+        const ggml_tensor * mid = cgraph->nodes[k];
+        if (ggml_cuda_is_view_or_noop(mid) || mid == skip_a || mid == skip_b) {
+            continue;
+        }
+        // A node that another accepted fold already absorbed is not an
+        // intermediate any more: its reads happen from registers inside the
+        // group kernel (dst_node) or do not happen at all (skip[]), and a
+        // dst_node's write is compared against ours in the member loop below.
+        // Without this the folds block each other - the allocator gives one
+        // chain's result the buffer the sibling chain used to read from.
+        bool absorbed = false;
+        for (int mm = 0; mm < n_members; ++mm) {
+            absorbed = absorbed || mid == epi[mm].dst_node ||
+                       mid == epi[mm].skip[0] || mid == epi[mm].skip[1];
+        }
+        // the hoisted write must not land on anything a live intermediate reads
+        for (int si = 0; si < GGML_MAX_SRC && !absorbed; ++si) {
+            if (mid->src[si] != nullptr && !ggml_cuda_mmvq_ranges_disjoint(out, mid->src[si])) {
+                EPI_DBG("mid-src out=%s(%p+%zu) mid=%s src%d=%s(%p+%zu)\n", out->name, out->data,
+                        ggml_nbytes(out), mid->name, si, mid->src[si]->name, mid->src[si]->data,
+                        ggml_nbytes(mid->src[si]));
+                return false;
+            }
+        }
+        // ... nor on anything an intermediate writes. Group members are the
+        // exception: they are already issued at the same instant as this write,
+        // and a member whose own chain is folded never materialises its matvec
+        // dst at all - the member loop below compares against the EFFECTIVE
+        // destinations instead. (The graph allocator routinely places a folded
+        // chain's result on a sibling's dead matvec buffer, and treating that as
+        // a conflict rejected most of the folds this pass exists for.)
+        bool is_member = false;
+        for (int mm = 0; mm < n_members; ++mm) {
+            is_member = is_member || (mid == members[mm]);
+        }
+        if (!is_member && !absorbed && !ggml_cuda_mmvq_ranges_disjoint(out, mid)) {
+            EPI_DBG("mid-dst out=%s(%p+%zu) mid=%s(%p+%zu) op=%d\n", out->name, out->data,
+                    ggml_nbytes(out), mid->name, mid->data, ggml_nbytes(mid), (int) mid->op);
+            return false;
+        }
+    }
+    for (int mm = 0; mm < n_members; ++mm) {
+        // the fold's own segment never materialises its matvec dst, so the
+        // epilogue destination is allowed to alias it (the allocator commonly
+        // places the elementwise result in place over it)
+        if (mm == own) {
+            continue;
+        }
+        const ggml_tensor * other = epi[mm].dst_node != nullptr ? epi[mm].dst_node : members[mm];
+        if (other == out) {
+            continue;
+        }
+        if (!ggml_cuda_mmvq_ranges_disjoint(out, other)) {
+            EPI_DBG("other out=%s(%p+%zu) other=%s(%p+%zu)\n", out->name, out->data, ggml_nbytes(out),
+                    other->name, other->data, ggml_nbytes(other));
+            return false;
+        }
+    }
+    return true;
+}
