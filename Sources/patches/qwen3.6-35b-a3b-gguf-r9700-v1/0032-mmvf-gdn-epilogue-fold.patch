+static bool ggml_cuda_mmvf_epi_shape_ok(const ggml_tensor * t, const ggml_tensor * ref) {
+    return t != nullptr && t->type == GGML_TYPE_F32 && ggml_is_contiguous(t) &&
+           ggml_nelements(t) == ggml_nelements(ref);
+}
+
+static int ggml_cuda_mmvf_next_compute(const ggml_cgraph * cgraph, const int from, const int end) {
+    for (int k = from; k < end; ++k) {
+        if (!ggml_cuda_is_view_or_noop(cgraph->nodes[k])) {
+            return k;
+        }
+    }
+    return -1;
+}
