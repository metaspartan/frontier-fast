 #include "common.cuh"
 #include "mmid.cuh"
 
+#if defined(GGML_USE_HIP) && (defined(__gfx1200__) || defined(__gfx1201__))
+// RDNA4 wave32: VALU-only warp reductions/scans via DPP + permlanex16.
+// The generic __shfl-based helpers lower to ds_bpermute_b32, which round-trips through
+// the LDS unit with a full s_wait_dscnt after every step. The templated token loop below
+// runs 7 such round-trips per 4-token iteration (any-reduce over 8 lanes, 3-step
+// shfl_up scan, final broadcast); at 512 tokens that is ~900 serialized LDS waits per
+// block. The DPP forms issue on the VALU with no LDS traffic (same medicine as the
+// gated-delta-net reduction patch).
+#define MMID_DPP_REDUCE 1
+#endif
