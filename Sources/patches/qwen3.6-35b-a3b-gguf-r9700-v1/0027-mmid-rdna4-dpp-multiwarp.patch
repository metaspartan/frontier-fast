+#ifdef MMID_DPP_REDUCE
+// OR-reduce over each group of 8 lanes (butterfly: xor1, xor2, xor4-within-8).
+static __device__ __forceinline__ int mmid_dpp_or8(int x) {
+    x |= __builtin_amdgcn_update_dpp(0, x, 0xB1, 0xF, 0xF, true);  // quad_perm [1,0,3,2]: | lane^1
+    x |= __builtin_amdgcn_update_dpp(0, x, 0x4E, 0xF, 0xF, true);  // quad_perm [2,3,0,1]: | lane^2
+    x |= __builtin_amdgcn_update_dpp(0, x, 0x141, 0xF, 0xF, true); // row_half_mirror: | other quad
+    return x;
+}
+
+// Full wave32 integer sum.
+static __device__ __forceinline__ int mmid_dpp_sum32(int x) {
+    x += __builtin_amdgcn_update_dpp(0, x, 0xB1, 0xF, 0xF, true);  // quad_perm [1,0,3,2]
+    x += __builtin_amdgcn_update_dpp(0, x, 0x4E, 0xF, 0xF, true);  // quad_perm [2,3,0,1]
+    x += __builtin_amdgcn_update_dpp(0, x, 0x141, 0xF, 0xF, true); // row_half_mirror
+    x += __builtin_amdgcn_update_dpp(0, x, 0x140, 0xF, 0xF, true); // row_mirror
+    x += __builtin_amdgcn_permlanex16(x, x, 0x76543210, 0xFEDCBA98, false, false); // other row
+    return x;
+}
+
+// s must be uniform within each group of 8 lanes (one value per token position).
+// Returns the exclusive prefix over the four 8-lane groups in `lower` and the
+// whole-wave total in `total`. Replaces the 3-step shfl_up scan + shfl broadcast.
+static __device__ __forceinline__ void mmid_dpp_scan8(const int s, const int lane, int & lower, int & total) {
+    const int shr8      = __builtin_amdgcn_update_dpp(0, s, 0x118, 0xF, 0xF, true); // row_shr:8 (0-fill)
+    const int shl8      = __builtin_amdgcn_update_dpp(0, s, 0x108, 0xF, 0xF, true); // row_shl:8 (0-fill)
+    const int row_total = s + shr8 + shl8; // uniform within each row of 16
+    const int other_row = __builtin_amdgcn_permlanex16(row_total, row_total, 0x76543210, 0xFEDCBA98, false, false);
+    lower = shr8 + ((lane & 16) ? other_row : 0);
+    total = row_total + other_row;
+}
+#endif // MMID_DPP_REDUCE
