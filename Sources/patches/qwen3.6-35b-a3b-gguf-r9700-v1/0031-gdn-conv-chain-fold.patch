+
+// GDN conv-chain fold: CONCAT(state_window, x_t) feeding SSM_CONV(+SILU) plus
+// the conv-state writeback CPY of the concat tail. Decode shape only
+// (n_t == 1, d_conv == 4, no conv bias, single writeback = no rollback
+// snapshots). Returns true and fills the member pointers when the whole
+// pattern is present and the concat has no other consumer in the layer
+// window; the fused kernel then computes conv+silu straight from the two
+// concat sources and performs the (register-buffered, alias-safe) state
+// writeback, eliminating the concat and cpy launches and their bytes.
+static bool ggml_cuda_ssm_conv_fold_detect(const ggml_cgraph * cgraph, const int i,
+        const ggml_tensor ** out_ssm_conv, const ggml_tensor ** out_silu, const ggml_tensor ** out_wb_cpy) {
+    const ggml_tensor * concat = cgraph->nodes[i];
+    if (concat->op != GGML_OP_CONCAT || concat->type != GGML_TYPE_F32) {
+        return false;
+    }
+    const ggml_tensor * state = concat->src[0];
+    const ggml_tensor * x     = concat->src[1];
+    if (state == nullptr || x == nullptr) {
+        return false;
+    }
+    // dim-0 concat of a [3, nr] window with a [1, nr] token column
+    if (ggml_get_op_params_i32(concat, 0) != 0) {
+        return false;
+    }
+    if (state->type != GGML_TYPE_F32 || x->type != GGML_TYPE_F32) {
+        return false;
+    }
+    if (state->ne[0] != 3 || x->ne[0] != 1 || concat->ne[0] != 4 ||
+            state->ne[1] != concat->ne[1] || x->ne[1] != concat->ne[1] ||
+            concat->ne[2] != 1 || concat->ne[3] != 1) {
+        return false;
+    }
+    if (!ggml_is_contiguous(state) || state->nb[0] != sizeof(float) || x->nb[0] == 0) {
+        return false;
+    }
+
+    const ggml_tensor * ssm_conv = nullptr;
+    const ggml_tensor * silu     = nullptr;
+    const ggml_tensor * wb_cpy   = nullptr;
+
+    const int window = std::min(i + 48, cgraph->n_nodes);
+    for (int j = i + 1; j < window; ++j) {
+        const ggml_tensor * cand = cgraph->nodes[j];
+        bool consumes = false;
+        for (int k = 0; k < GGML_MAX_SRC; ++k) {
+            const ggml_tensor * src = cand->src[k];
+            if (src == nullptr) {
+                continue;
+            }
+            if (src == concat || src->view_src == concat) {
+                consumes = true;
+                // pure view/metadata nodes over the concat are not consumers;
+                // their real consumers are caught through src->view_src below
+                if (cand->op == GGML_OP_VIEW || cand->op == GGML_OP_RESHAPE ||
+                        cand->op == GGML_OP_PERMUTE || cand->op == GGML_OP_TRANSPOSE ||
+                        cand->op == GGML_OP_NONE) {
+                    continue;
+                }
+                // classify
+                if (cand->op == GGML_OP_SSM_CONV && k == 0 && src == concat) {
+                    if (ssm_conv != nullptr) { return false; }
+                    ssm_conv = cand;
+                } else if (cand->op == GGML_OP_CPY && k == 0 && src->view_src == concat) {
+                    if (wb_cpy != nullptr) { return false; }
+                    // the tail view: positions [1, 3] of every channel
+                    if (src->ne[0] != 3 || src->ne[1] != concat->ne[1] ||
+                            (const char *) src->data != (const char *) concat->data + sizeof(float) ||
+                            src->nb[1] != concat->nb[1]) {
+                        return false;
+                    }
+                    // writeback target must be a contiguous f32 view
+                    const ggml_tensor * dst_v = cand->src[1];
+                    if (dst_v == nullptr || dst_v->type != GGML_TYPE_F32 ||
+                            dst_v->nb[0] != sizeof(float) || !ggml_is_contiguous(dst_v) ||
+                            ggml_nelements(dst_v) != 3 * concat->ne[1]) {
+                        return false;
+                    }
+                    wb_cpy = cand;
+                } else {
+                    return false; // unexpected consumer
+                }
+            }
+        }
+        GGML_UNUSED(consumes);
+    }
+    if (ssm_conv == nullptr || wb_cpy == nullptr) {
+        return false;
+    }
+    // conv weights: [4, nr] f32, no bias fusion (decline if an ADD consumes the conv)
+    const ggml_tensor * w = ssm_conv->src[1];
+    if (w == nullptr || w->type != GGML_TYPE_F32 || w->ne[0] != 4 || w->ne[1] != concat->ne[1] ||
+            w->nb[0] != sizeof(float)) {
+        return false;
+    }
+    // the conv output must be consumed by exactly one SILU (the stock fused shape here)
+    const int idx_conv = [&]() { for (int j = i + 1; j < window; ++j) { if (cgraph->nodes[j] == ssm_conv) return j; } return -1; }();
+    if (idx_conv < 0 || idx_conv + 1 >= cgraph->n_nodes) {
+        return false;
+    }
+    const ggml_tensor * cand_silu = cgraph->nodes[idx_conv + 1];
+    if (cand_silu->op != GGML_OP_UNARY || ggml_get_unary_op(cand_silu) != GGML_UNARY_OP_SILU ||
+            cand_silu->src[0] != ssm_conv || cand_silu->type != GGML_TYPE_F32 ||
+            !ggml_is_contiguous(cand_silu) || ggml_nelements(cand_silu) != concat->ne[1]) {
+        return false;
+    }
+    silu = cand_silu;
+
+    *out_ssm_conv = ssm_conv;
+    *out_silu     = silu;
+    *out_wb_cpy   = wb_cpy;
+    return true;
+}
