+
+// Decode-shape fold of the GDN conv chain: CONCAT(state_window, x_t) ->
+// SSM_CONV -> SILU plus the conv-state writeback CPY collapse into one
+// kernel. One thread owns one channel: the state window and x_t are read
+// into registers before the writeback stores, so the (aliasing) in-place
+// cache update is safe, and the accumulation loop matches the stock
+// ssm_conv_f32 order exactly (same expression, same contraction), so the
+// conv output is byte-identical. n_t == 1, d_conv == 4, no bias.
+static __global__ void ssm_conv_fold_f32(const float * __restrict__ state, const float * __restrict__ x,
+                                         const float * __restrict__ w_all, float * __restrict__ y,
+                                         float * __restrict__ wb, const int nr, const int state_nb1,
+                                         const int x_nb1, const int w_nb1) {
+    const int ch = blockIdx.x * blockDim.x + threadIdx.x;
+    if (ch >= nr) {
+        return;
+    }
+
+    const float * st = (const float *) ((const char *) state + ch * state_nb1);
+    const float * wc = (const float *) ((const char *) w_all + ch * w_nb1);
+    const float   xv = *(const float *) ((const char *) x + ch * x_nb1);
+
+    // mirror the stock ssm_conv_f32 register structure exactly (preloaded w[]
+    // and x[] arrays, same loop shape) so the compiler contracts the
+    // accumulation identically and the conv output stays byte-exact
+    float w[4];
+#pragma unroll
+    for (size_t j = 0; j < 4; j++) {
+        w[j] = wc[j];
+    }
+
+    float x_r[4];
+    x_r[0] = st[0];
+    x_r[1] = st[1];
+    x_r[2] = st[2];
+    x_r[3] = xv;
+
+    float sumf = 0.0f;
+#pragma unroll
+    for (size_t j = 0; j < 4; j++) {
+        sumf += x_r[(0 + j) % 4] * w[j];
+    }
+
+    y[ch] = ggml_cuda_op_silu_single(sumf);
+
+    float * wbc = wb + ch * 3;
+    wbc[0] = x_r[1];
+    wbc[1] = x_r[2];
+    wbc[2] = xv;
+}
+
+void ggml_cuda_op_ssm_conv_fold(ggml_backend_cuda_context & ctx,
+        const ggml_tensor * concat, const ggml_tensor * ssm_conv,
+        const ggml_tensor * silu, const ggml_tensor * wb_cpy) {
+    const ggml_tensor * state = concat->src[0];   // [d_conv-1, nr] (view of the cache or the get_rows copy)
+    const ggml_tensor * x     = concat->src[1];   // [1, nr] transposed view of the qkv projection
+    const ggml_tensor * w     = ssm_conv->src[1]; // [d_conv, nr]
+    const ggml_tensor * wb    = wb_cpy->src[1];   // [3*nr] contiguous view of the conv cache row
+
+    const int64_t nr = concat->ne[1];
+
+    const float * state_d = (const float *) state->data;
+    const float * x_d     = (const float *) x->data;
+    const float * w_d     = (const float *) w->data;
+    float       * y_d     = (float *) silu->data;
+    float       * wb_d    = (float *) wb->data;
+
+    const int block = 256;
+    const int grid  = (int) ((nr + block - 1) / block);
+    const ggml_cuda_kernel_launch_params launch_params = ggml_cuda_kernel_launch_params(dim3(grid, 1, 1), dim3(block, 1, 1), 0, ctx.stream());
+    ggml_cuda_kernel_launch(ssm_conv_fold_f32, launch_params,
+        state_d, x_d, w_d, y_d, wb_d, (int) nr, (int) state->nb[1], (int) x->nb[1], (int) w->nb[1]);
+}
