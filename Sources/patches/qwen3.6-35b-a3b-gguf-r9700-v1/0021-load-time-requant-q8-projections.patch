+//
+// Load-time requantization of the Q8_0 projection upcasts (qwen35moe / R9700).
+//
+// The unsloth UD-Q4_K_M export upcasts the whole GDN/attention projection
+// stack to Q8_0 - about 1.49 GB of weight reads per decoded token. The four
+// five families requantized here (attn_qkv, attn_gate, ssm_out, attn_q,
+// attn_output) cut ~300 MB of that per-token traffic at Q6_K while measuring
+// BELOW stock perplexity on the gate corpus (-0.04%). The shared-expert mats
+// are deliberately excluded: requantizing them costs +0.5% ppl AND slows
+// decode (Q6_K ALU overhead beats the bandwidth saving on tiny rows).
+// The perplexity gate measures the requantized model through the same
+// binary, so the equivalence bound still decides. GGML_LOAD_REQUANT=0
+// disables the transform and loads the file bytes untouched.
+//
+
+static ggml_type llama_load_requant_target(const char * name, ggml_type cur, int64_t ne0) {
+    static const bool enabled = [] {
+        const char * e = getenv("GGML_LOAD_REQUANT");
+        return e == nullptr || atoi(e) != 0;
+    }();
+    if (!enabled || cur != GGML_TYPE_Q8_0 || (ne0 % 256) != 0 || strncmp(name, "blk.", 4) != 0) {
+        return cur;
+    }
+    static const char * const fams[] = {
+        ".attn_qkv.weight", ".attn_gate.weight", ".ssm_out.weight",
+        ".attn_q.weight",   ".attn_output.weight",
+    };
+    const size_t len = strlen(name);
+    for (const char * fam : fams) {
+        const size_t fl = strlen(fam);
+        if (len > fl && strcmp(name + len - fl, fam) == 0) {
+            return GGML_TYPE_Q6_K;
+        }
+    }
+    return cur;
+}
+
+static void llama_load_requant_convert(
+        ggml_type dst_type,
+        const uint8_t * src, uint8_t * dst, int64_t nrows, int64_t ne0) {
+    const auto * q8_traits = ggml_get_type_traits(GGML_TYPE_Q8_0);
+    const size_t src_row = ggml_row_size(GGML_TYPE_Q8_0, ne0);
+    const size_t dst_row = ggml_row_size(dst_type, ne0);
+    static const int nth_env = [] {
+        const char * e = getenv("GGML_LOAD_REQUANT_NTHREAD");
+        return e != nullptr ? atoi(e) : 0;
+    }();
+    const int nth = nth_env > 0 ? nth_env : std::max(1, (int) std::thread::hardware_concurrency());
+    const int64_t chunk = 64;
+    std::atomic<int64_t> next(0);
+    std::vector<std::thread> workers;
+    workers.reserve(nth);
+    for (int t = 0; t < nth; ++t) {
+        workers.emplace_back([&]() {
+            std::vector<float> f32((size_t) chunk * ne0);
+            for (;;) {
+                const int64_t r0 = next.fetch_add(chunk);
+                if (r0 >= nrows) {
+                    break;
+                }
+                const int64_t rn = std::min<int64_t>(chunk, nrows - r0);
+                q8_traits->to_float(src + (size_t) r0*src_row, f32.data(), rn*ne0);
+                ggml_quantize_chunk(dst_type, f32.data(), dst + (size_t) r0*dst_row, 0, rn, ne0, nullptr);
+            }
+        });
+    }
+    for (auto & w : workers) {
+        w.join();
+    }
+    static const bool csum = getenv("GGML_LOAD_REQUANT_CSUM") != nullptr;
+    if (csum) {
+        uint64_t h = 1469598103934665603ull;
+        const size_t n = (size_t) nrows * dst_row;
+        for (size_t i = 0; i < n; ++i) {
+            h = (h ^ dst[i]) * 1099511628211ull;
+        }
+        fprintf(stderr, "REQUANT_CSUM rows=%lld ne0=%lld h=%016llx\n", (long long) nrows, (long long) ne0, (unsigned long long) h);
+    }
+}
