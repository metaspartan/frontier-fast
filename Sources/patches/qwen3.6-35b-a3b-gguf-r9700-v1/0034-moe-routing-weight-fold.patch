+// MoE routing-weight fold: MUL_MAT_ID(down_exps) -> MUL(result, weights).
+// The multiply is a [n_embd, n_expert_used] elementwise pass over data the
+// matvec has just produced, broadcasting ONE float per expert slot - 40
+// launches per token moving 128 KB each to apply eight scalars. The matvec
+// already holds the finished value in a register and already knows which
+// destination channel (expert slot) it is writing, so the factor is a single
+// scalar load per block and the store lands directly in the MUL's destination.
+// Bit-exact: the multiplicand is the same rounded f32 the stock kernel would
+// have written and re-read.
+static bool ggml_cuda_moe_weight_fuse_detect(const ggml_cgraph * cgraph, const int i,
+        const ggml_tensor ** out_mul, const ggml_tensor ** out_weights) {
+    const ggml_tensor * mm = cgraph->nodes[i];
+    if (mm->op != GGML_OP_MUL_MAT_ID || i + 1 >= cgraph->n_nodes) {
+        return false;
+    }
+    if (!ggml_can_fuse_subgraph(cgraph, i, { GGML_OP_MUL_MAT_ID, GGML_OP_MUL }, { i + 1 })) {
+        return false;
+    }
+    const ggml_tensor * mul = cgraph->nodes[i + 1];
+    const ggml_tensor * w   = mul->src[0] == mm ? mul->src[1] : mul->src[0];
+    if (mul->src[0] != mm && mul->src[1] != mm) {
+        return false;
+    }
+    // ncols_dst == 1 (one token) and one factor per expert slot, broadcast
+    // over the embedding dimension
+    if (mm->ne[2] != 1 || mm->ne[3] != 1 || mm->ne[1] < 1) {
+        return false;
+    }
+    if (w == nullptr || w->type != GGML_TYPE_F32 || !ggml_is_contiguous(w) ||
+            w->ne[0] != 1 || w->ne[1] != mm->ne[1] || w->ne[2] != 1 || w->ne[3] != 1) {
+        return false;
+    }
+    if (mul->type != GGML_TYPE_F32 || !ggml_are_same_shape(mul, mm) || !ggml_is_contiguous(mul) ||
+            mul->nb[0] != sizeof(float)) {
+        return false;
+    }
+    // the fused store writes the MUL's destination at the matvec's position;
+    // that is only legal if the two are laid out identically
+    if (mul->nb[1] != mm->nb[1] || mul->nb[2] != mm->nb[2]) {
+        return false;
+    }
+    if (!ggml_cuda_should_fuse_mul_mat_vec_q(mm)) {
+        return false;
+    }
+    *out_mul     = mul;
+    *out_weights = w;
+    return true;
+}
