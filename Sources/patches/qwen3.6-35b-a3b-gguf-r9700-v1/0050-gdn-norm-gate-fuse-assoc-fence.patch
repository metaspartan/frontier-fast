index 841576a55..5751b6ce7 100644
--- a/ggml/src/ggml-cuda/glu-quant-body.cuh
+++ b/ggml/src/ggml-cuda/glu-quant-body.cuh
@@ -12,21 +12,13 @@
 // dst whose length is a multiple of QK8_1, because the index is flat. The two
 // reductions below are then over exactly the same 32 values in the same lanes
 // as in the standalone kernel, so d, q and ds come out bit for bit the same.
-template <float (*op)(float)>
-static __device__ __forceinline__ void glu_quant_body(
-        const float * x, const float * g, float * dst,
-        const int64_t k, const int64_t n, const int64_t o0, const int64_t o1,
-        void * q8_1_dst, const int64_t i) {
-    if (i >= k) {
-        return;
-    }
-
-    const int64_t j0 = (i / n) * o0 + (i % n);
-    const int64_t j1 = o0 == o1 ? j0 : (i / n) * o1 + (i % n);
-
-    const float val = op(x[j0]) * g[j1];
-    dst[i] = val;
-
+// The q8_1 store half of the body, factored out so that a producer which
+// already holds the destination value in a register (0050: the fused GDN
+// rms_norm + z-gate) runs exactly these statements. `i` is the flat destination
+// element index; the caller guarantees each warp covers 32 consecutive,
+// 32-aligned elements.
+static __device__ __forceinline__ void glu_quant_store(
+        const float val, void * q8_1_dst, const int64_t i) {
     block_q8_1 * y = (block_q8_1 *) q8_1_dst;
 
     const int64_t ib  = i / QK8_1;
@@ -47,3 +39,21 @@ static __device__ __forceinline__ void glu_quant_body(
         y[ib].ds = make_half2(d, sum);
     }
 }
+
+template <float (*op)(float)>
+static __device__ __forceinline__ void glu_quant_body(
+        const float * x, const float * g, float * dst,
+        const int64_t k, const int64_t n, const int64_t o0, const int64_t o1,
+        void * q8_1_dst, const int64_t i) {
+    if (i >= k) {
+        return;
+    }
+
+    const int64_t j0 = (i / n) * o0 + (i % n);
+    const int64_t j1 = o0 == o1 ? j0 : (i / n) * o1 + (i % n);
+
+    const float val = op(x[j0]) * g[j1];
+    dst[i] = val;
+
+    glu_quant_store(val, q8_1_dst, i);
+}
diff --git a/ggml/src/ggml-cuda/unary.cu b/ggml/src/ggml-cuda/unary.cu
index b78e89b09..9de064294 100644
--- a/ggml/src/ggml-cuda/unary.cu
+++ b/ggml/src/ggml-cuda/unary.cu
@@ -306,6 +306,144 @@ static __global__ void unary_gated_op_quant_kernel(const float * x, const float
     GGML_UNUSED_VARS(j0, j1);
 }
 
+
+// Blocks floating-point reassociation across this value under
+// -funsafe-math-optimizations, so a value that stock materialises through
+// memory keeps the same expression structure when it is kept in a register.
+static __device__ __forceinline__ float ggml_cuda_assoc_fence(float v) {
+#if defined(__has_builtin)
+#  if __has_builtin(__builtin_arithmetic_fence)
+    return __builtin_arithmetic_fence(v);
+#  else
+    asm volatile("" : "+v"(v));
+    return v;
+#  endif
+#else
+    asm volatile("" : "+v"(v));
+    return v;
+#endif
+}
+
+// ---- 0050: the GDN gated norm as ONE kernel -------------------------------
+//
+// The gated-delta-net tail is four graph nodes that stock runs as two launches:
+//   RMS_NORM -> MUL(ssm_norm.weight)     -> rms_norm_f32<256,true,false>
+//   UNARY(SILU)(z) -> MUL                -> unary_gated_op_quant_kernel<silu>
+// The second reads nothing but the first's output and z, and the first already
+// owns one whole row per block - so the gate, the product and the q8_1 store
+// are an epilogue the norm kernel can run from registers. 30 launches per
+// decode token.
+//
+// Bit-identity, statement by statement:
+//   * the reduction is block_reduce<SUM, block_size> over the same partial sums
+//     in the same order, and mean/scale are the same two expressions;
+//   * `scale * x[col] * mul[col]` is the norm kernel's own store expression
+//     (with mul_ncols == ncols the fastmodulo in that kernel is the identity),
+//     and an f32 round-trip through memory is exact, so the value the gate
+//     multiplies is the value the separate launch would have loaded back;
+//   * `op(gate) * val` is the gated kernel's own expression, operands in its
+//     own order;
+//   * the q8_1 store is glu_quant_store, shared verbatim with the standalone
+//     kernel. Its only requirement is that each warp cover 32 consecutive,
+//     32-aligned flat destination elements: dst is contiguous with row stride
+//     ncols, the caller requires ncols % QK8_1 == 0, and lane L of warp w of
+//     this block holds col = 32w + L (+ block_size per extra iteration), so
+//     flat index row*ncols + col is 32-aligned per warp exactly as in the
+//     standalone launch. ncols % 32 == 0 also means a warp is entirely inside
+//     or entirely outside the column range, so no warp reduces over a partial
+//     set of lanes.
+template <int block_size, float (*op)(float), bool do_quant>
+static __global__ void rms_norm_gate_quant_f32(const float * x,
+                                               const float * mul,
+                                               const float * gate,
+                                               float *       dst,
+                                               const int     ncols,
+                                               const int64_t stride_row,
+                                               const int64_t gate_stride_row,
+                                               const float   eps,
+                                               void *        q8_1_dst) {
+    ggml_cuda_pdl_lc();
+
+    const int row = blockIdx.x;
+    const int tid = threadIdx.x;
+
+    x    += (int64_t) row * stride_row;
+    gate += (int64_t) row * gate_stride_row;
+    dst  += (int64_t) row * ncols;
+
+    float tmp = 0.0f; // partial sum for thread in warp
+
+    ggml_cuda_pdl_sync();
+    for (int col = tid; col < ncols; col += block_size) {
+        const float xi = x[col];
+        tmp += xi * xi;
+    }
+
+    extern __shared__ float s_sum[];
+    tmp = block_reduce<block_reduce_method::SUM, block_size>(tmp, s_sum);
+
+    const float mean  = tmp / ncols;
+    const float scale = rsqrtf(mean + eps);
+
+    for (int col = tid; col < ncols; col += block_size) {
+        // The backend is compiled with -funsafe-math-optimizations, so the
+        // compiler is free to REASSOCIATE a product. In the two separate
+        // launches the normalised value is stored and reloaded, and a load is
+        // an opaque value the gate multiply cannot be reassociated into; fusing
+        // the two expressions into one removes that barrier and the merged
+        // product reassociates, which is a real (measured: 0.6% perplexity)
+        // arithmetic change. The fence restores exactly the stock structure:
+        // an isolated `scale * x * w` tree, then `op(gate) * <opaque>`.
+        const float nv  = ggml_cuda_assoc_fence(scale * x[col] * mul[col]);
+        const float val = op(gate[col]) * nv;
+        dst[col] = val;
+        if constexpr (do_quant) {
+            glu_quant_store(val, q8_1_dst, (int64_t) row * ncols + col);
+        }
+    }
+}
+
+template <float (*op)(float)>
+static void rms_norm_gate_quant_cuda(const float * x, const float * mul, const float * gate, float * dst,
+                                     const int ncols, const int nrows,
+                                     const int64_t stride_row, const int64_t gate_stride_row,
+                                     const float eps, void * q8_1_dst, cudaStream_t stream) {
+    const dim3 blocks_num(nrows, 1, 1);
+    const dim3 block_dims(256, 1, 1);
+    const ggml_cuda_kernel_launch_params launch_params =
+        {blocks_num, block_dims, block_dims.x > WARP_SIZE ? 32 * sizeof(float) : 0, stream};
+    if (q8_1_dst != nullptr) {
+        ggml_cuda_kernel_launch(rms_norm_gate_quant_f32<256, op, true>, launch_params,
+                                x, mul, gate, dst, ncols, stride_row, gate_stride_row, eps, q8_1_dst);
+    } else {
+        ggml_cuda_kernel_launch(rms_norm_gate_quant_f32<256, op, false>, launch_params,
+                                x, mul, gate, dst, ncols, stride_row, gate_stride_row, eps, q8_1_dst);
+    }
+}
+
+void ggml_cuda_op_rms_norm_gate_quant(ggml_backend_cuda_context & ctx,
+                                      ggml_tensor * norm_node, ggml_tensor * mul_node,
+                                      ggml_tensor * unary_node, ggml_tensor * gate_mul_node,
+                                      char * q8_1_dst) {
+    const ggml_tensor * x_src    = norm_node->src[0];
+    const ggml_tensor * w_src    = (mul_node->src[0] == norm_node) ? mul_node->src[1] : mul_node->src[0];
+    const ggml_tensor * gate_src = unary_node->src[0];
+
+    float eps = 0.0f;
+    memcpy(&eps, norm_node->op_params, sizeof(float));
+
+    const int64_t ncols = x_src->ne[0];
+    const int64_t nrows = x_src->ne[1];
+
+    const int64_t stride_row      = x_src->nb[1]    / sizeof(float);
+    const int64_t gate_stride_row = gate_src->nb[1] / sizeof(float);
+
+    GGML_ASSERT(ggml_get_unary_op(unary_node) == GGML_UNARY_OP_SILU);
+    rms_norm_gate_quant_cuda<op_silu>((const float *) x_src->data, (const float *) w_src->data,
+                                      (const float *) gate_src->data, (float *) gate_mul_node->data,
+                                      ncols, nrows, stride_row, gate_stride_row, eps, q8_1_dst, ctx.stream());
+}
+
 template <float (*op)(float)>
 static void unary_gated_quant_cuda(const float * x, const float * g, float * dst, const int64_t k,
                                    const int64_t n, const int64_t o0, const int64_t o1,
