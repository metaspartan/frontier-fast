diff --git a/ggml/src/ggml-cuda/ggml-cuda.cu b/ggml/src/ggml-cuda/ggml-cuda.cu
index e834a4786..e6cfc230b 100644
--- a/ggml/src/ggml-cuda/ggml-cuda.cu
+++ b/ggml/src/ggml-cuda/ggml-cuda.cu
@@ -4152,6 +4152,155 @@ static int ggml_cuda_mmvf_collect_group(const ggml_cgraph * cgraph, const int st
     return n;
 }
 
+// ----- 0046: topk_moe co-launch guest ----------------------------------------
+//
+// The fused softmax/top-k/get_rows router selection runs as ONE workgroup, 40
+// times per decoded token: 2.9 us of kernel plus a ~1.3 us replay gap, and
+// almost all of it is launch latency rather than work. Its body is entirely
+// warp-local - no shared memory, no __syncthreads, only __shfl_xor over the 32
+// lanes of one warp - so it can run as warp 0 of one extra block of a grouped
+// mmvq launch and produce bit-identical ids and weights.
+//
+// The host is the shared-expert gate/up pair (Q8_0, 1024 blocks, 5.5 us), which
+// reads the same activation as the router and is independent of the whole
+// routed subgraph. Stock node order emits it AFTER the routed reduction, so the
+// graph half of this patch pins it between the router matvec and the top-k
+// chain; the guest then hides inside a host with 1024 times its block count.
+
+struct mmvq_topk_colaunch_info {
+    mmvq_topk_guest guest;
+    int first = -1;   // graph index of the fusion head (the SOFT_MAX)
+    int n_ops = 0;    // number of nodes the fusion consumes
+};
+
+static bool ggml_cuda_mmvq_topk_colaunch_enabled() {
+    static const bool e = []() -> bool {
+        const char * v = getenv("GGML_CUDA_MMVQ_TOPK_COLAUNCH");
+        return v == nullptr || std::atoi(v) != 0;
+    }();
+    return e;
+}
+
+static bool ggml_cuda_mmvq_colaunch_find_topk(
+        const ggml_cgraph * cgraph, const int start,
+        ggml_tensor * const * members, const int n_members,
+        mmvq_topk_colaunch_info * out) {
+    // the first real node after the group must be the fusion head
+    constexpr int scan_window = 8;
+    const int end_scan = std::min(cgraph->n_nodes, start + 1 + scan_window);
+    int j = -1;
+    for (int k = start + 1; k < end_scan; ++k) {
+        ggml_tensor * cand = cgraph->nodes[k];
+        if (ggml_cuda_is_view_or_noop(cand)) {
+            continue;
+        }
+        bool owned = false;
+        for (int m = 0; m < n_members; ++m) {
+            if (members[m] == cand) { owned = true; break; }
+        }
+        if (owned) {
+            continue;
+        }
+        j = k;
+        break;
+    }
+    if (j < 0) {
+        return false;
+    }
+
+    ggml_tensor * head = cgraph->nodes[j];
+    if (head->op != GGML_OP_SOFT_MAX) {
+        return false;
+    }
+    ggml_cuda_topk_moe_args args;
+    if (!ggml_cuda_topk_moe_fusion(cgraph, j, args)) {
+        return false;
+    }
+    // the guest instantiation is softmax gating, no bias, no delayed softmax
+    if (!args.softmax || args.delayed_softmax || args.prob_bias || args.sigmoid || args.sqrt_softplus) {
+        return false;
+    }
+
+    // rebuild exactly the op list the standalone fusion consumes
+    std::vector<ggml_op> ops = { GGML_OP_SOFT_MAX };
+    const int i_probs = j + (int) ops.size() - 1;
+    ops.insert(ops.end(), { GGML_OP_RESHAPE, GGML_OP_ARGSORT, GGML_OP_VIEW, GGML_OP_GET_ROWS });
+    int out_nodes[2];
+    out_nodes[0] = i_probs + 3;
+    if (out_nodes[0] >= cgraph->n_nodes) {
+        return false;
+    }
+    ggml_tensor * ids = cgraph->nodes[out_nodes[0]];
+    const ggml_tensor * clamp = nullptr;
+    const ggml_tensor * scale = nullptr;
+    if (args.norm) {
+        ops.insert(ops.end(), { GGML_OP_RESHAPE, GGML_OP_SUM_ROWS, GGML_OP_CLAMP, GGML_OP_DIV, GGML_OP_RESHAPE });
+        clamp = cgraph->nodes[j + (int) ops.size() - 3];
+    }
+    if (args.scale) {
+        ops.insert(ops.end(), { GGML_OP_SCALE });
+        scale = cgraph->nodes[j + (int) ops.size() - 1];
+    }
+    out_nodes[1] = j + (int) ops.size() - 1;
+    if (out_nodes[1] >= cgraph->n_nodes) {
+        return false;
+    }
+    ggml_tensor * weights = cgraph->nodes[out_nodes[1]];
+    const ggml_tensor * logits = head->src[0];
+
+    if (!ggml_can_fuse_subgraph(cgraph, j, ops.size(), ops.data(), out_nodes, 2) ||
+            !ggml_cuda_should_use_topk_moe(head, logits, weights, ids) ||
+            !ggml_cuda_check_fusion_memory_ranges(cgraph, j, ops.size(), out_nodes, 2, /*is_topk_moe=*/true)) {
+        return false;
+    }
+
+    // the single guest instantiation: 256 experts, one row, no bias
+    if (ids->nb[0] == 0 || (int) (ids->nb[1] / ids->nb[0]) != 256) {
+        return false;
+    }
+    if (logits->ne[1] != 1 || logits->ne[2] != 1 || logits->ne[3] != 1) {
+        return false;
+    }
+    if (weights->ne[1] < 1 || weights->ne[1] > 256) {
+        return false;
+    }
+    if (logits->type != GGML_TYPE_F32 || weights->type != GGML_TYPE_F32 || ids->type != GGML_TYPE_I32) {
+        return false;
+    }
+
+    // The guest and the host run in ONE kernel with no ordering between them,
+    // where the separate launches were ordered by the stream. Everything the
+    // guest writes (ids, weights) must be disjoint from every host write and
+    // host input, and the guest input (the logits) from every host write. The
+    // graph allocator layout is shape-dependent, so this is checked on actual
+    // data ranges, not on names - see 0045, where skipping the equivalent check
+    // shipped a race visible only at long context.
+    for (int m = 0; m < n_members; ++m) {
+        const ggml_tensor * w = members[m];
+        if (!ggml_cuda_mmvq_ranges_disjoint(w, ids) ||
+                !ggml_cuda_mmvq_ranges_disjoint(w, weights) ||
+                !ggml_cuda_mmvq_ranges_disjoint(w, logits) ||
+                !ggml_cuda_mmvq_ranges_disjoint(ids, w->src[0]) ||
+                !ggml_cuda_mmvq_ranges_disjoint(ids, w->src[1]) ||
+                !ggml_cuda_mmvq_ranges_disjoint(weights, w->src[0]) ||
+                !ggml_cuda_mmvq_ranges_disjoint(weights, w->src[1])) {
+            return false;
+        }
+    }
+
+    out->guest.logits        = (const float *) logits->data;
+    out->guest.weights       = (float *) weights->data;
+    out->guest.ids           = (int32_t *) ids->data;
+    out->guest.clamp_val     = clamp != nullptr ? ggml_get_op_params_f32(clamp, 0) : -INFINITY;
+    out->guest.scale_val     = scale != nullptr ? ggml_get_op_params_f32(scale, 0) : 1.0f;
+    out->guest.n_expert_used = (int) weights->ne[1];
+    out->guest.with_norm     = clamp != nullptr;
+    out->guest.active        = true;
+    out->first               = j;
+    out->n_ops               = (int) ops.size();
+    return true;
+}
+
 // ----- 0045: quantized/F32 matvec co-launch ----------------------------------
 //
 // Per-node HIP graph replay on gfx1201 costs ~1.3 us of exposed GPU time that no
@@ -4284,6 +4433,16 @@ static int ggml_cuda_mmvq_colaunch_find_q(
                 }
             }
         }
+        // 0046: if this quantized group can host the topk_moe guest instead,
+        // leave it alone. Merging it with the tiny F32 group removes the same
+        // one dispatch but measured flat (host/guest ratio 1.1); hosting the
+        // one-workgroup topk hides a whole 2.9 us launch in a 1024-block host.
+        if (ggml_cuda_mmvq_topk_colaunch_enabled() && q_members[0]->src[0]->type == GGML_TYPE_Q8_0) {
+            mmvq_topk_colaunch_info tk;
+            if (ggml_cuda_mmvq_colaunch_find_topk(cgraph, j, q_members, n_q, &tk)) {
+                return 0;
+            }
+        }
         return n_q;
     }
     return 0;
@@ -6529,7 +6688,18 @@ static void ggml_cuda_graph_evaluate_and_capture(ggml_backend_cuda_context * cud
                     ggml_tensor * members[MMVQ_MAX_GROUP_SIZE];
                     const int n_members = ggml_cuda_mmvq_collect_group(cgraph, i, members);
                     if (n_members >= 2) {
-                        ggml_cuda_mul_mat_vec_q_grouped(*cuda_ctx, members, n_members);
+                        // 0046: hide the one-workgroup topk_moe fusion in this launch
+                        mmvq_topk_colaunch_info tk;
+                        const bool have_tk = ggml_cuda_mmvq_topk_colaunch_enabled() &&
+                                             node->src[0]->type == GGML_TYPE_Q8_0 &&
+                                             ggml_cuda_mmvq_colaunch_find_topk(cgraph, i, members, n_members, &tk);
+                        ggml_cuda_mul_mat_vec_q_grouped(*cuda_ctx, members, n_members, nullptr, nullptr, 0,
+                                                        have_tk ? &tk.guest : nullptr);
+                        if (have_tk) {
+                            for (int k = 0; k < tk.n_ops; ++k) {
+                                mmvq_grouped_done.insert(cgraph->nodes[tk.first + k]);
+                            }
+                        }
                         for (int m = 1; m < n_members; ++m) {
                             mmvq_grouped_done.insert(members[m]);
                         }
