+// Prefill analogue of the fold above. At batch shapes MUL_MAT_ID leaves the
+// mmvq route and takes MMQ, so the routing-weight MUL survives as a full
+// elementwise pass over [n_embd, n_expert_used, n_tokens]: 87 us and 33 MB of
+// read-modify-write per layer at pp512, to apply one scalar per column. The MMQ
+// write_back holds the finished value in a register and already knows
+// ids_dst[j], the flat (token, slot) destination row - which is exactly the
+// flat index of the routing weight, so the fold needs no extra bookkeeping.
+static bool ggml_cuda_mul_mat_id_takes_mmq(const ggml_tensor * mm) {
+    const ggml_tensor * src0 = mm->src[0];
+    const ggml_tensor * src1 = mm->src[1];
+    const ggml_tensor * ids  = mm->src[2];
+    if (src0 == nullptr || src1 == nullptr || ids == nullptr) {
+        return false;
+    }
+    if (src1->type != GGML_TYPE_F32 || mm->type != GGML_TYPE_F32) {
+        return false;
+    }
+    if (!ggml_is_quantized(src0->type)) {
+        return false;
+    }
+    const int cc = ggml_cuda_info().devices[ggml_cuda_get_device()].cc;
+    if (mm->ne[2] <= MMVQ_MAX_BATCH_SIZE && mm->ne[2] <= get_mmvq_mmid_max_batch(src0->type, cc)) {
+        return false; // the mmvq route claims this shape first; that is the decode fold above
+    }
+    return ggml_cuda_should_use_mmq(src0->type, cc, src1->ne[2], src0->ne[2]);
+}
+
+static bool ggml_cuda_moe_weight_fuse_detect_q(const ggml_cgraph * cgraph, const int i,
+        const ggml_tensor ** out_mul, const ggml_tensor ** out_weights) {
+    const ggml_tensor * mm = cgraph->nodes[i];
+    if (mm->op != GGML_OP_MUL_MAT_ID || i + 1 >= cgraph->n_nodes) {
+        return false;
+    }
+    if (!ggml_can_fuse_subgraph(cgraph, i, { GGML_OP_MUL_MAT_ID, GGML_OP_MUL }, { i + 1 })) {
+        return false;
+    }
+    const ggml_tensor * mul = cgraph->nodes[i + 1];
+    if (mul->src[0] != mm && mul->src[1] != mm) {
+        return false;
+    }
+    const ggml_tensor * w = mul->src[0] == mm ? mul->src[1] : mul->src[0];
+    // one factor per (token, expert slot), broadcast over the embedding dimension
+    if (mm->ne[3] != 1 || mm->ne[1] < 1 || !ggml_is_contiguous(mm)) {
+        return false;
+    }
+    if (w == nullptr || w->type != GGML_TYPE_F32 || !ggml_is_contiguous(w) ||
+            w->ne[0] != 1 || w->ne[1] != mm->ne[1] || w->ne[2] != mm->ne[2] || w->ne[3] != 1) {
+        return false;
+    }
+    if (mul->type != GGML_TYPE_F32 || !ggml_are_same_shape(mul, mm) || !ggml_is_contiguous(mul) ||
+            mul->nb[0] != sizeof(float) || mul->nb[1] != mm->nb[1] || mul->nb[2] != mm->nb[2]) {
+        return false;
+    }
+    if (!ggml_cuda_mul_mat_id_takes_mmq(mm)) {
+        return false;
+    }
+    *out_mul     = mul;
+    *out_weights = w;
+    return true;
+}
