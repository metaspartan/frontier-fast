+        GGML_ASSERT(ggml_nelements(dst_scale) == ne1*ne2);
+        GGML_ASSERT(ggml_is_contiguous(dst));
+        GGML_ASSERT(ne1 == n_expert_used);
+        dst_scale_d = (const float *) dst_scale->data;
