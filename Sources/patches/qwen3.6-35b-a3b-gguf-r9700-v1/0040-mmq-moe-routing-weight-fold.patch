             static const bool disable_shexp_gate_fuse = getenv("GGML_CUDA_DISABLE_SHEXP_GATE_FUSE") != nullptr &&
@@ -5948,6 +6011,18 @@ static void ggml_cuda_graph_evaluate_and_capture(ggml_backend_cuda_context * cud
