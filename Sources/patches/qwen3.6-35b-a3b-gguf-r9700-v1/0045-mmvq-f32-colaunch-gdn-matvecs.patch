index 8899f7354..e834a4786 100644
--- a/ggml/src/ggml-cuda/ggml-cuda.cu
+++ b/ggml/src/ggml-cuda/ggml-cuda.cu
@@ -4152,6 +4152,143 @@ static int ggml_cuda_mmvf_collect_group(const ggml_cgraph * cgraph, const int st
