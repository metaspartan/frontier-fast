+            if (epi != nullptr && epi->dst_node != nullptr) {
+                GGML_ASSERT(epi->kind == 1 || epi->kind == 2);
+                GGML_ASSERT(ggml_nelements(epi->dst_node) == d->ne[0]);
+                args.f_dst[m]    = (float *) epi->dst_node->data;
+                args.f_postop[m] = epi->kind;
+                if (epi->kind == 2) {
+                    GGML_ASSERT(epi->bias != nullptr && epi->scale != nullptr);
+                    args.f_bias[m]  = (const float *) epi->bias->data;
+                    args.f_scale[m] = (const float *) epi->scale->data;
+                }
+            } else {
+                args.f_dst[m]    = (float *) d->data;
+                args.f_postop[m] = 0;
+            }
+            f_total += (uint32_t) s0->ne[1];
+            args.f_seg_end[m] = f_total;
+        }
+        for (int m = n_f32_nodes; m < MMVQ_F32_TAIL_MAX; ++m) {
+            args.f_seg_end[m] = f_total;
+        }
+        args.f_y          = (const float *) f_src1->data;
+        args.f_block0     = total_rows;
+        args.f_nrows      = f_total;
+        args.f_ncols2     = (uint32_t) (f_ne10 / 2);
+        args.f_stride_row = (uint32_t) f_stride_row;
+    }
+
     mul_mat_vec_q_grouped_switch_type(type, args, src1_q8_1, total_rows, (uint32_t) ne10, (uint32_t) stride_row_x, stream);
 }
