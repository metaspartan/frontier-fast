@@ -996,13 +1012,63 @@ static __global__ void mul_mat_vec_q_grouped(
 
     const int tid = warp_size*threadIdx.y + threadIdx.x;
 
+    // ---- 0045: F32 co-launch tail -------------------------------------------
+    // One warp per row, exactly as mul_mat_vec_f_grouped launches it: the same
+    // lane->column mapping (col = threadIdx.x + n*warp_size, ascending), the
+    // same two ggml_cuda_mad per float2, the same warp_reduce_sum and the same
+    // epilogue expressions. Bit-identical to the standalone grouped launch.
+    if (args.f_nrows != 0 && blockIdx.x < args.f_nrows) {
+        if (threadIdx.y != 0) {
+            return;
+        }
+        const uint32_t brow = blockIdx.x;
+        uint32_t fseg = 0, fstart = 0;
+#pragma unroll
+        for (int s = 0; s < MMVQ_F32_TAIL_MAX - 1; ++s) {
+            if (brow >= args.f_seg_end[s]) {
+                fseg   = s + 1;
+                fstart = args.f_seg_end[s];
+            }
+        }
+        const int frow = (int) (brow - fstart);
