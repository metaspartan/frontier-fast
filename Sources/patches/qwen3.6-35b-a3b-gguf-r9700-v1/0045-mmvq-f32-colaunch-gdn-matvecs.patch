+// ----- 0045: quantized/F32 matvec co-launch ----------------------------------
+//
+// Per-node HIP graph replay on gfx1201 costs ~1.3 us of exposed GPU time that no
+// runtime knob removes (measured: a 400-node serial graph of trivial kernels
+// replays at 2.4 us/node, and forking the capture onto a second stream is 5x
+// worse - see the round-30 notes). Every GDN layer emits the tiny F32 alpha/beta
+// matvec group immediately BEFORE the 35 us qkv+z grouped mmvq, and the two are
+// independent: they read the same activation and write disjoint destinations.
+// Running them as one launch removes a dispatch and hides the F32 group's
+// latency inside the quantized group's memory time. The F32 rows keep the
+// mul_mat_vec_f_grouped body verbatim (same lane->column mapping, same warp
+// reduction, same epilogue expressions), so the result is byte-identical.
+
+// hoist legality with a set of nodes the co-launch itself computes excluded
+static bool ggml_cuda_mmvq_hoist_legal_ex(const ggml_cgraph * cgraph, const int start, const int j,
+                                          const ggml_tensor * const * owned, const int n_owned) {
+    const ggml_tensor * cand = cgraph->nodes[j];
+    for (int k = start + 1; k < j; ++k) {
+        const ggml_tensor * mid = cgraph->nodes[k];
+        if (ggml_cuda_is_view_or_noop(mid)) {
+            continue;
+        }
+        bool skip = false;
+        for (int o = 0; o < n_owned; ++o) {
+            if (owned[o] == mid) { skip = true; break; }
+        }
+        if (skip) {
+            continue;
+        }
+        for (int si = 0; si < GGML_MAX_SRC; ++si) {
+            if (mid->src[si] != nullptr && !ggml_cuda_mmvq_ranges_disjoint(cand, mid->src[si])) {
+                return false;
+            }
+        }
+        if (!ggml_cuda_mmvq_ranges_disjoint(cand, mid)) {
+            return false;
+        }
+        if (!ggml_cuda_mmvq_ranges_disjoint(mid, cand->src[0]) ||
+                !ggml_cuda_mmvq_ranges_disjoint(mid, cand->src[1])) {
+            return false;
+        }
+    }
+    return true;
+}
+
+// From an F32 matvec group at `start`, find the quantized grouped-mmvq launch that
+// follows it with nothing but views and the F32 group's own folded epilogue in
+// between, and that is legal to hoist to `start`. Returns the member count.
+static int ggml_cuda_mmvq_colaunch_find_q(
+        const ggml_cgraph * cgraph, const int start,
+        ggml_tensor * const * f_members, const int n_f, const mmvf_epilogue * f_epi,
+        ggml_tensor ** q_members) {
+    const ggml_tensor * owned[MMVF_MAX_GROUP_SIZE * 4];
+    int n_owned = 0;
+    for (int m = 0; m < n_f; ++m) {
+        owned[n_owned++] = f_members[m];
+        if (f_epi[m].dst_node != nullptr) {
+            owned[n_owned++] = f_epi[m].dst_node;
+            for (int sk = 0; sk < 2; ++sk) {
+                if (f_epi[m].skip[sk] != nullptr) {
+                    owned[n_owned++] = f_epi[m].skip[sk];
+                }
+            }
+        }
+    }
+    constexpr int scan_window = 24;
+    const int end = std::min(cgraph->n_nodes, start + 1 + scan_window);
+    for (int j = start + 1; j < end; ++j) {
+        ggml_tensor * cand = cgraph->nodes[j];
+        if (ggml_cuda_is_view_or_noop(cand)) {
+            continue;
+        }
+        bool is_owned = false;
+        for (int o = 0; o < n_owned; ++o) {
+            if (owned[o] == cand) { is_owned = true; break; }
+        }
+        if (is_owned) {
+            continue;
+        }
+        // the first real op after the F32 group must be the quantized group itself
+        if (cand->op != GGML_OP_MUL_MAT || !ggml_cuda_mmvq_can_group(cand)) {
+            return 0;
+        }
+        const int n_q = ggml_cuda_mmvq_collect_group(cgraph, j, q_members);
+        if (n_q < 2) {
+            return 0;
+        }
+        for (int m = 0; m < n_q; ++m) {
+            int idx = -1;
+            for (int k = j; k < end + MMVQ_MAX_GROUP_SIZE + 48 && k < cgraph->n_nodes; ++k) {
+                if (cgraph->nodes[k] == q_members[m]) { idx = k; break; }
+            }
+            if (idx < 0 || !ggml_cuda_mmvq_hoist_legal_ex(cgraph, start, idx, owned, n_owned)) {
+                return 0;
+            }
+        }
+        // The hoist check above EXCLUDES the nodes this co-launch computes, so the
+        // two groups have not been checked against EACH OTHER - and inside one
+        // kernel they run with no ordering between them, where the separate
+        // launches were strictly ordered. Every quantized write must be disjoint
+        // from every F32 write and input, and vice versa. Skipping this check
+        // shipped a shape-dependent race that only showed up on a 1000-token
+        // prompt (5/6 server greedy) while short prompts and -c 512 perplexity
+        // stayed bit-identical.
+        for (int m = 0; m < n_q; ++m) {
+            const ggml_tensor * q = q_members[m];
+            for (int f = 0; f < n_f; ++f) {
+                const ggml_tensor * fw = f_members[f];
+                const ggml_tensor * fdst = f_epi[f].dst_node != nullptr ? f_epi[f].dst_node : fw;
+                if (!ggml_cuda_mmvq_ranges_disjoint(q, fw) ||
+                        !ggml_cuda_mmvq_ranges_disjoint(q, fdst) ||
+                        !ggml_cuda_mmvq_ranges_disjoint(q, fw->src[0]) ||
+                        !ggml_cuda_mmvq_ranges_disjoint(q, fw->src[1]) ||
+                        !ggml_cuda_mmvq_ranges_disjoint(fdst, q->src[0]) ||
+                        !ggml_cuda_mmvq_ranges_disjoint(fdst, q->src[1]) ||
+                        !ggml_cuda_mmvq_ranges_disjoint(fw, q->src[0]) ||
+                        !ggml_cuda_mmvq_ranges_disjoint(fw, q->src[1])) {
+                    return 0;
+                }
+                if (f_epi[f].bias != nullptr &&
+                        (!ggml_cuda_mmvq_ranges_disjoint(q, f_epi[f].bias) ||
+                         !ggml_cuda_mmvq_ranges_disjoint(q, f_epi[f].scale))) {
+                    return 0;
+                }
+                for (int sk = 0; sk < 2; ++sk) {
+                    if (f_epi[f].skip[sk] != nullptr &&
+                            !ggml_cuda_mmvq_ranges_disjoint(q, f_epi[f].skip[sk])) {
+                        return 0;
+                    }
+                }
+            }
+        }
+        return n_q;
+    }
+    return 0;
+}
+
 // ----- grouped l2_norm (GDN q/k conv-norm class) launch detection -------------
 //
 // A GDN layer L2-normalises q_conv and k_conv with two independent launches of
@@ -6106,6 +6243,12 @@ static void ggml_cuda_graph_evaluate_and_capture(ggml_backend_cuda_context * cud
             static const bool disable_shexp_gate_fuse = getenv("GGML_CUDA_DISABLE_SHEXP_GATE_FUSE") != nullptr &&
                                                    std::atoi(getenv("GGML_CUDA_DISABLE_SHEXP_GATE_FUSE"));
             const bool mmvq_group_enabled = !disable_mmvq_group && stream_ctx.concurrent_events.empty();
+            // 0045: F32 matvec co-launch inside the grouped mmvq launch. Default on;
+            // GGML_CUDA_MMVQ_F32_COLAUNCH=0 restores the separate grouped mmvf launch.
+            static const bool mmvq_f32_colaunch_enabled = []() -> bool {
+                const char * e = getenv("GGML_CUDA_MMVQ_F32_COLAUNCH");
+                return e == nullptr || std::atoi(e) != 0;
+            }();
             static const bool log_mmvq_group_stats = getenv("GGML_MMVQ_GROUP_STATS") != nullptr;
             int64_t mmvq_group_stats_buf[2] = {0, 0};
             int64_t * mmvq_group_stats = log_mmvq_group_stats ? mmvq_group_stats_buf : nullptr;
@@ -6422,7 +6565,20 @@ static void ggml_cuda_graph_evaluate_and_capture(ggml_backend_cuda_context * cud
                     if (n_members >= 2) {
                         mmvf_epilogue epi[MMVF_MAX_GROUP_SIZE];
                         ggml_cuda_mmvf_collect_epilogues(cgraph, i, members, n_members, epi);
-                        ggml_cuda_mul_mat_vec_f_grouped(*cuda_ctx, members, epi, n_members);
+                        // 0045: co-launch with the quantized group that follows
+                        ggml_tensor * q_members[MMVQ_MAX_GROUP_SIZE];
+                        int n_q = 0;
+                        if (mmvq_f32_colaunch_enabled && n_members <= MMVQ_F32_TAIL_MAX) {
+                            n_q = ggml_cuda_mmvq_colaunch_find_q(cgraph, i, members, n_members, epi, q_members);
+                        }
+                        if (n_q >= 2) {
+                            ggml_cuda_mul_mat_vec_q_grouped(*cuda_ctx, q_members, n_q, members, epi, n_members);
+                            for (int m = 0; m < n_q; ++m) {
+                                mmvq_grouped_done.insert(q_members[m]);
+                            }
+                        } else {
+                            ggml_cuda_mul_mat_vec_f_grouped(*cuda_ctx, members, epi, n_members);
+                        }
                         for (int m = 1; m < n_members; ++m) {
                             mmvq_grouped_done.insert(members[m]);
                         }
