+        ggml_cuda_pdl_sync();
+
+        const float2 * fx2 = (const float2 *) (args.f_vx[fseg] + (int64_t) frow * args.f_stride_row);
+        const float2 * fy2 = (const float2 *) args.f_y;
+        float fsumf = 0.0f;
+        for (int col2 = threadIdx.x; col2 < (int) args.f_ncols2; col2 += warp_size) {
+            const float2 tmpx = fx2[col2];
+            const float2 tmpy = fy2[col2];
+            ggml_cuda_mad(fsumf, tmpx.x, tmpy.x);
+            ggml_cuda_mad(fsumf, tmpx.y, tmpy.y);
+        }
