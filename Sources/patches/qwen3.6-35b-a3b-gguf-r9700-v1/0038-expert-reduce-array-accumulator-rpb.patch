From 252d73e1c64ac868e13ea166bb1a60ce35dc827b Mon Sep 17 00:00:00 2001
From: Claude Fable 5 <noreply@anthropic.com>
Date: Sat, 8 Aug 2026 14:58:11 +0000
Subject: [PATCH] cuda/hip: give the expert-reduce accumulator the stock array
 shape - the fold becomes byte-exact

0037 shipped as reassociation-class: its bisect mode proved the slot-order
reduction was exact and blamed the rewritten matvec body for a +0.17% shift on
the decode-path perplexity. It was not the body. It was the *declaration*.

Stock `mul_mat_vec_q` accumulates into `float tmp[ncols_dst][rows_per_cuda_block]`
and indexes it inside `#pragma unroll` loops. 0037 collapsed that to a scalar
`float tmp`, which is the same arithmetic - and the compiler contracts it
differently. Restoring the array shape (here `float tmp[rpb]`, written into by an
unrolled row loop exactly as stock's `i` loop does) restores stock codegen:

- decode-path perplexity (`-b 512 -ub 1 --chunks 8`, so the fold fires on every
  layer at every position): fold ON **3.9338**, fold-off control **3.9338** -
  identical, where 0037 read 3.9404 against the same control
- server greedy vs the fold-off control: **6/6 byte-exact** (0037: 2/6)
- no cost: toggle A/B 5 rounds, tg128 143.01-143.23 -> 145.16-145.41, median
  ratio **1.0152**, 5/5 disjoint (0037 measured 1.0157 - the same gain)

This contradicts 0031's note that mirroring the source structure does not help;
it does, but the thing that has to match is the accumulator's declared shape and
the loop nest that writes it, not the surrounding statements. Worth trying
before accepting a reassociation-class result on any future matvec rewrite.

The array shape arrives with the rows-per-block knob it was written for,
`GGML_MMVQ_EXPERT_REDUCE_RPB` (default 1 = shipped). Swept on gfx1201, paired and
interleaved:

| rpb | tg128 | note |
|---|---|---|
| 1 | 145.45-145.76 | shipped; byte-exact |
| 2 | 145.74-146.03 | +0.20%, 5/5 disjoint - but re-contracts, so not byte-exact |
| 4 | 138.27 | -4.8% |
| 8 | 144.42 | -0.6% |

rpb=2 is a real but tiny win that costs the bit-identity argument, so it is not
the default. Per-row, per-thread k-block assignment is unchanged at every rpb -
only the number of row reads a warp issues moves - so the knob is safe to
re-sweep on other hardware.

Official gate ppl unchanged: 3.9320/3.9284/3.9267 vs stock 3.9314. Prefill is
still structurally untouched. test-backend-ops MUL_MAT_ID / ADD / MUL OK.
---
 ggml/src/ggml-cuda/mmvq.cu | 80 +++++++++++++++++++++++++++++---------
 1 file changed, 61 insertions(+), 19 deletions(-)

diff --git a/ggml/src/ggml-cuda/mmvq.cu b/ggml/src/ggml-cuda/mmvq.cu
index 0df713326..0491be274 100644
--- a/ggml/src/ggml-cuda/mmvq.cu
+++ b/ggml/src/ggml-cuda/mmvq.cu
@@ -1587,7 +1587,7 @@ static void mul_mat_vec_q_switch_type(
 // warps contribute; the slot results are then summed in slot order 0..n-1 in a
 // single lane, which is the left-to-right fold launch_bin_bcast_pack applies to
 // the fused ADD chain it replaces.
-template <ggml_type type>
+template <ggml_type type, int rpb>
 __launch_bounds__(MMVQ_EXPERT_REDUCE_MAX_SLOTS*ggml_cuda_get_physical_warp_size(), 1)
 static __global__ void mul_mat_vec_q_expert_reduce(
         const void * vx_ptr, const void * vy_ptr, const int32_t * ids_ptr,
@@ -1613,7 +1613,7 @@ static __global__ void mul_mat_vec_q_expert_reduce(
     constexpr int blocks_per_iter = vdr * warp_size / qi;
 
     const uint32_t channel_dst      = threadIdx.y;
-    const int      row0             = blockIdx.x;
+    const int      row0             = rpb*blockIdx.x;
     dst += row0;
     const int      blocks_per_row_x = ncols_x / qk;
 
@@ -1623,7 +1623,12 @@ static __global__ void mul_mat_vec_q_expert_reduce(
 
     const float dst_scale_v = dst_scale[channel_dst];
 
-    float tmp = 0.0f;
+    // rpb consecutive rows per block. Per-row, per-thread k-block assignment is
+    // untouched (it is the same `i` loop the stock kernel runs over
+    // rows_per_cuda_block), so this only changes launch geometry: each warp
+    // issues rpb row reads instead of one, which is the whole point on a matvec
+    // that reads 352 bytes per row and measures 444 GB/s.
+    float tmp[rpb] = { 0.0f };
 
     const block_q8_1 * y = ((const block_q8_1 *) vy) + channel_y*stride_channel_y;
     const int kbx_offset = channel_x*stride_channel_x + row0*stride_row_x;
@@ -1631,7 +1636,10 @@ static __global__ void mul_mat_vec_q_expert_reduce(
     for (int kbx = threadIdx.x / (qi/vdr); kbx < blocks_per_row_x; kbx += blocks_per_iter) {
         const int kby = kbx * (qk/QK8_1); // y block index that aligns with kbx
         const int kqs = vdr * (threadIdx.x % (qi/vdr));
-        tmp += vec_dot_q_cuda(vx, &y[kby], kbx_offset + kbx, kqs);
+#pragma unroll
+        for (int r = 0; r < rpb; ++r) {
+            tmp[r] += vec_dot_q_cuda(vx, &y[kby], kbx_offset + r*stride_row_x + kbx, kqs);
+        }
     }
 
     // The launch this replaces runs one warp and adds the nwarps-1 trimmed
@@ -1639,36 +1647,57 @@ static __global__ void mul_mat_vec_q_expert_reduce(
     // -0.0f accumulator that addition is not the identity, and dropping it
     // would be the only place this kernel could differ from stock bit patterns.
 #pragma unroll
-    for (int l = 0; l < nwarps-1; ++l) {
-        tmp += 0.0f;
+    for (int r = 0; r < rpb; ++r) {
+#pragma unroll
+        for (int l = 0; l < nwarps-1; ++l) {
+            tmp[r] += 0.0f;
+        }
+        tmp[r] = warp_reduce_sum<warp_size>(tmp[r]);
     }
-    tmp = warp_reduce_sum<warp_size>(tmp);
 
     // Bisect mode (GGML_CUDA_MOE_REDUCE_PER_SLOT=1): store each slot where the
     // launch this replaces would, and leave the add chain in the graph. Isolates
     // the matvec restructure from the reduction.
     if (stride_channel_dst != 0) {
         if (threadIdx.x == 0) {
-            dst[channel_dst*stride_channel_dst] = tmp * dst_scale_v;
+#pragma unroll
+            for (int r = 0; r < rpb; ++r) {
+                dst[channel_dst*stride_channel_dst + r] = tmp[r] * dst_scale_v;
+            }
         }
         return;
     }
 
-    __shared__ float slot_sums[MMVQ_EXPERT_REDUCE_MAX_SLOTS];
+    __shared__ float slot_sums[rpb][MMVQ_EXPERT_REDUCE_MAX_SLOTS];
     if (threadIdx.x == 0) {
-        slot_sums[channel_dst] = tmp * dst_scale_v;
+#pragma unroll
+        for (int r = 0; r < rpb; ++r) {
+            slot_sums[r][channel_dst] = tmp[r] * dst_scale_v;
+        }
     }
     __syncthreads();
 
-    if (threadIdx.x == 0 && threadIdx.y == 0) {
-        float sum = slot_sums[0];
+    // one lane per row finishes the slot-order sum
+    if (threadIdx.y == 0 && threadIdx.x < uint32_t(rpb)) {
+        float sum = slot_sums[threadIdx.x][0];
         for (uint32_t s = 1; s < blockDim.y; ++s) {
-            sum += slot_sums[s];
+            sum += slot_sums[threadIdx.x][s];
         }
-        dst[0] = sum;
+        dst[threadIdx.x] = sum;
     }
 }
 
+// Rows per block for the expert-reduce launch. 1 is the geometry 0037 shipped;
+// the kernel is byte-identical at any value (per-row k-block assignment is
+// unchanged), only the number of row reads a warp issues moves.
+static int mmvq_expert_reduce_rpb() {
+    static const int v = []() -> int {
+        const char * e = getenv("GGML_MMVQ_EXPERT_REDUCE_RPB");
+        return e != nullptr ? std::atoi(e) : 1;
+    }();
+    return v;
+}
+
 // Returns false (having launched nothing) when this type/shape does not reduce
 // to the single-k-split-warp launch the kernel above is byte-exact against.
 template <ggml_type type>
@@ -1715,15 +1744,28 @@ static bool mul_mat_vec_q_expert_reduce_launch(
         return false;
     }
 
-    const dim3  block_nums(nrows_x, 1, 1);
+    int rpb = mmvq_expert_reduce_rpb();
+    if (rpb < 1 || rpb > 8 || nrows_x % rpb != 0) {
+        rpb = 1;
+    }
+
+    const dim3  block_nums(nrows_x / rpb, 1, 1);
     const dim3  block_dims(warp_size, n_slots, 1);
     const uint3 nchannels_y_fd = init_fastdiv_values(nchannels_y);
 
     const ggml_cuda_kernel_launch_params launch_params = ggml_cuda_kernel_launch_params(block_nums, block_dims, 0, stream);
-    ggml_cuda_kernel_launch(mul_mat_vec_q_expert_reduce<type>, launch_params,
-        vx, vy, ids, dst_scale, dst, (uint32_t) ncols_x, nchannels_y_fd,
-        (uint32_t) stride_row_x, (uint32_t) stride_channel_x, (uint32_t) stride_channel_y,
-        (uint32_t) stride_channel_dst);
+#define MMVQ_EXPERT_REDUCE_LAUNCH(R)                                                       \
+    ggml_cuda_kernel_launch((mul_mat_vec_q_expert_reduce<type, R>), launch_params,         \
+        vx, vy, ids, dst_scale, dst, (uint32_t) ncols_x, nchannels_y_fd,                   \
+        (uint32_t) stride_row_x, (uint32_t) stride_channel_x, (uint32_t) stride_channel_y, \
+        (uint32_t) stride_channel_dst)
+    switch (rpb) {
+        case 2:  MMVQ_EXPERT_REDUCE_LAUNCH(2); break;
+        case 4:  MMVQ_EXPERT_REDUCE_LAUNCH(4); break;
+        case 8:  MMVQ_EXPERT_REDUCE_LAUNCH(8); break;
+        default: MMVQ_EXPERT_REDUCE_LAUNCH(1); break;
+    }
+#undef MMVQ_EXPERT_REDUCE_LAUNCH
     return true;
 }
 
-- 
2.53.0

