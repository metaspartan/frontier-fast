diff --git a/ggml/src/ggml-cuda/ggml-cuda.cu b/ggml/src/ggml-cuda/ggml-cuda.cu
index 075ea889b..731bb2331 100644
--- a/ggml/src/ggml-cuda/ggml-cuda.cu
+++ b/ggml/src/ggml-cuda/ggml-cuda.cu
@@ -3377,6 +3377,81 @@ static bool ggml_cuda_mmvq_would_glu_fuse(const ggml_cgraph * cgraph, const int
 //
 // Returns the graph index of the shared-expert matvec that may be issued as an
 // extra channel of the routed launch, or -1.
+// MoE routing-weight fold: MUL_MAT_ID(down_exps) -> MUL(result, weights).
+//
+// The multiply is an elementwise pass over [n_embd, n_expert_used] applying ONE
+// scalar per expert slot - 39 launches per decoded token, each moving the whole
+// expert output through memory to apply eight floats. The matvec that produced
+// those bytes already holds the finished value in a register and already knows
+// which destination channel - i.e. which expert slot, i.e. which weight - it is
+// writing, so the factor costs one scalar load per block and the store lands
+// directly in the MUL's destination.
+//
+// Bit-exact: the multiplicand is the same rounded f32 the stock kernel would
+// have written and the MUL would have read back.
+static const ggml_tensor * ggml_cuda_moe_weight_fuse_detect(const ggml_cgraph * cgraph, const int i, int * out_mul_idx) {
+    const ggml_tensor * mm = cgraph->nodes[i];
+    if (mm->op != GGML_OP_MUL_MAT_ID || mm->src[2] == nullptr) {
+        return nullptr;
+    }
+    // decode shape only: one token, one destination column per expert slot.
+    // At prefill ne[2] is the token count and the node takes MMQ instead.
+    if (mm->ne[2] != 1 || mm->ne[3] != 1) {
+        return nullptr;
+    }
+    if (!ggml_cuda_should_fuse_mul_mat_vec_q(mm)) {
+        return nullptr;
+    }
+    // never steal the gate/up pair out of the gate+up+GLU fusion
+    if (ggml_cuda_mmvq_would_glu_fuse(cgraph, i)) {
+        return nullptr;
+    }
+
+    // The MUL is the next node, or the one after it when the shared expert down
+    // projection has been emitted adjacent (build_moe_ffn pins it there so the
+    // backend can issue both as one launch).
+    for (int span = 1; span <= 2; ++span) {
+        const int m = i + span;
+        if (m >= cgraph->n_nodes) {
+            break;
+        }
+        const ggml_tensor * mul = cgraph->nodes[m];
+        if (mul->op != GGML_OP_MUL) {
+            continue;
+        }
+        if (mul->src[0] != mm && mul->src[1] != mm) {
+            continue;
+        }
+        const ggml_tensor * w = mul->src[0] == mm ? mul->src[1] : mul->src[0];
+        // one contiguous f32 factor per expert slot, broadcast over the embedding
+        if (w == nullptr || w->type != GGML_TYPE_F32 || !ggml_is_contiguous(w) ||
+                w->ne[0] != 1 || w->ne[1] != mm->ne[1] || w->ne[2] != 1 || w->ne[3] != 1) {
+            return nullptr;
+        }
+        // the fused store writes the MUL destination at the matvec position,
+        // which is only legal if the two are laid out identically
+        if (mul->type != GGML_TYPE_F32 || !ggml_are_same_shape(mul, mm) || !ggml_is_contiguous(mul) ||
+                mul->nb[0] != sizeof(float) || mul->nb[1] != mm->nb[1] || mul->nb[2] != mm->nb[2]) {
+            return nullptr;
+        }
+        bool ok;
+        if (span == 1) {
+            ok = ggml_can_fuse_subgraph(cgraph, i, { GGML_OP_MUL_MAT_ID, GGML_OP_MUL }, { m });
+        } else {
+            // the intervening node is the shared expert down projection; its
+            // output is read by the later add, so it stays an output of the span
+            ok = cgraph->nodes[i + 1]->op == GGML_OP_MUL_MAT &&
+                 ggml_can_fuse_subgraph(cgraph, i, { GGML_OP_MUL_MAT_ID, GGML_OP_MUL_MAT, GGML_OP_MUL }, { i + 1, m });
+        }
+        if (!ok) {
+            return nullptr;
+        }
+        *out_mul_idx = m;
+        return w;
+    }
+    return nullptr;
+}
+
 static int ggml_cuda_moe_shexp_find_down(const ggml_cgraph * cgraph, const int i, const int cc) {
     const ggml_tensor * routed = cgraph->nodes[i];
     if (routed->op != GGML_OP_MUL_MAT_ID || routed->src[2] == nullptr) {
@@ -5317,6 +5392,9 @@ static void ggml_cuda_graph_evaluate_and_capture(ggml_backend_cuda_context * cud
                 return e != nullptr && atoi(e) == 0;
             }();
             const bool moe_shexp_fuse_enabled = !disable_moe_shexp_fuse && stream_ctx.concurrent_events.empty();
+            // Fold the MoE routing-weight multiply into the routed down projection.
+            static const bool disable_moe_weight_fuse = getenv("GGML_CUDA_DISABLE_MOE_WEIGHT_FUSE") != nullptr &&
+                                                   std::atoi(getenv("GGML_CUDA_DISABLE_MOE_WEIGHT_FUSE"));
             // Fold the shared expert's gate/up into the routed gate+up+GLU launch.
             // Separate toggle from the down fold so either can be A/B'd alone.
             static const bool disable_moe_shexp_gu_fuse = [] {
@@ -5586,17 +5664,44 @@ static void ggml_cuda_graph_evaluate_and_capture(ggml_backend_cuda_context * cud
                     continue;
                 }
 
-                if (moe_shexp_fuse_enabled && node->op == GGML_OP_MUL_MAT_ID) {
-                    const int j = ggml_cuda_moe_shexp_find_down(cgraph, i, cc_for_shexp);
-                    if (j > 0) {
-                        ggml_tensor * shexp_node = cgraph->nodes[j];
+                if (node->op == GGML_OP_MUL_MAT_ID) {
+                    const int j = moe_shexp_fuse_enabled ? ggml_cuda_moe_shexp_find_down(cgraph, i, cc_for_shexp) : -1;
+
+                    // The routing-weight fold composes with the shared-expert
+                    // pairing: the extra channel is not routed and keeps its
+                    // unscaled store, so both ride the same launch.
+                    int mul_idx = -1;
+                    const ggml_tensor * w = nullptr;
+                    if (!disable_moe_weight_fuse && stream_ctx.concurrent_events.empty()) {
+                        w = ggml_cuda_moe_weight_fuse_detect(cgraph, i, &mul_idx);
+                        if (w != nullptr && j > 0 && j >= mul_idx) {
+                            w = nullptr;  // pairing reaches past the fold; keep stock
+                        }
+                    }
+
+                    if (w != nullptr || j > 0) {
+                        ggml_cuda_mm_fusion_args_host fusion_data{};
+                        ggml_tensor * out = node;
+                        if (w != nullptr) {
+                            fusion_data.dst_scale = w;
+                            out = cgraph->nodes[mul_idx];
+                        }
                         ggml_cuda_mmvq_shexp shexp_args;
-                        shexp_args.src0 = shexp_node->src[0];
-                        shexp_args.src1 = shexp_node->src[1];
-                        shexp_args.dst  = shexp_node;
-                        ggml_cuda_mul_mat_vec_q(*cuda_ctx, node->src[0], node->src[1], node->src[2], node,
-                                                /*fusion=*/nullptr, &shexp_args);
-                        mmvq_grouped_done.insert(shexp_node);
+                        if (j > 0) {
+                            ggml_tensor * shexp_node = cgraph->nodes[j];
+                            shexp_args.src0 = shexp_node->src[0];
+                            shexp_args.src1 = shexp_node->src[1];
+                            shexp_args.dst  = shexp_node;
+                        }
+                        ggml_cuda_mul_mat_vec_q(*cuda_ctx, node->src[0], node->src[1], node->src[2], out,
+                                                w != nullptr ? &fusion_data : nullptr,
+                                                j > 0 ? &shexp_args : nullptr);
+                        if (j > 0) {
+                            mmvq_grouped_done.insert(cgraph->nodes[j]);
+                        }
+                        if (w != nullptr) {
+                            mmvq_grouped_done.insert(out);
+                        }
                         continue;
                     }
                 }
