-            quantize_row_q8_1_cuda((const float *) s1->data, nullptr, d_q8_1, shexp->src0->type,
-                s_ne10, s_s11, s_s12, s_s13, s_ne10_padded, s_ne11, s_ne12, s_ne13, stream);
+            quant_jobs[n_quant_jobs++] = quantize_q8_1_job{
+                (const float *) s1->data, d_q8_1, s_ne10, s_s11, s_s12, s_s13,
+                s_ne10_padded, s_ne11, s_ne12, s_ne13 };
             s_q8_1 = d_q8_1;
         }
 
@@ -1729,6 +1737,24 @@
         extra_p   = &extra;
     }
 
+    // One dispatch for every q8_1 buffer this matvec consumes. A MoE launch that
+    // carries the shared expert needs two and they are otherwise back-to-back
+    // dispatches over 512-element activations - pure launch overhead. With a
+    // single buffer the stock launcher runs, so the common path is untouched.
+    if (n_quant_jobs > 0) {
+        static const bool disable_quant_group = getenv("GGML_CUDA_DISABLE_QUANT_GROUP") != nullptr &&
+                                                std::atoi(getenv("GGML_CUDA_DISABLE_QUANT_GROUP"));
+        if (n_quant_jobs > 1 && !disable_quant_group) {
+            quantize_row_q8_1_grouped_cuda(quant_jobs, n_quant_jobs, stream);
+        } else {
+            for (int g = 0; g < n_quant_jobs; ++g) {
+                const quantize_q8_1_job & j = quant_jobs[g];
+                quantize_row_q8_1_cuda(j.x, nullptr, j.vy, src0->type,
+                    j.ne00, j.s01, j.s02, j.s03, j.ne0, j.ne1, j.ne2, j.ne3, stream);
+            }
+        }
+    }
+
     mul_mat_vec_q_switch_type(
         src0->data, src0->type, src1_q8_1, ids_d, fusion_local, dst_d, ne00,
         ne01,              ncols_dst,     s01, stride_col_y,     stride_col_dst,
