     const ggml_tensor * src1 = dst->src[1];
 
@@ -650,6 +654,18 @@ void ggml_cuda_op_mul_bcast0_quant(ggml_backend_cuda_context & ctx, ggml_tensor
     const int64_t num_blocks = (k + 255) / 256;
     const ggml_cuda_kernel_launch_params launch_params =
         ggml_cuda_kernel_launch_params((dim3) num_blocks, (dim3) 256, 0, ctx.stream());
-    ggml_cuda_kernel_launch(k_mul_bcast0_quant, launch_params,
+
+    if (softplus_src != nullptr) {
+        // src1 is the (contiguous, elementwise) softplus of softplus_src, so the
+        // element at flat index i1 of one is the softplus of the element at flat
+        // index i1 of the other: read the input and apply softplus in-kernel.
+        GGML_ASSERT(softplus_src->type == GGML_TYPE_F32);
+        GGML_ASSERT(ggml_is_contiguous(softplus_src));
+        ggml_cuda_kernel_launch(k_mul_bcast0_quant<true>, launch_params,
+            (const float *) src0->data, (const float *) softplus_src->data, (float *) dst->data, k, ne0, s11, q8_1_dst);
