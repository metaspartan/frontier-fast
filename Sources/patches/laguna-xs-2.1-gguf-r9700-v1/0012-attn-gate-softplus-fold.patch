                                           const float * __restrict__ src1,
                                           float * __restrict__ dst,
@@ -608,7 +610,8 @@ static __global__ void k_mul_bcast0_quant(const float * __restrict__ src0,
     const uint32_t i1 = fastdiv((uint32_t) i, ne0);
 
     ggml_cuda_pdl_sync();
-    const float val = src0[i] * src1[(int64_t) i1 * s11];
+    const float g = src1[(int64_t) i1 * s11];
+    const float val = src0[i] * (softplus ? ggml_cuda_softplus_f32(g) : g);
     dst[i] = val;
 
     block_q8_1 * y = (block_q8_1 *) q8_1_dst;
@@ -632,7 +635,8 @@ static __global__ void k_mul_bcast0_quant(const float * __restrict__ src0,
     }
 }
 
-void ggml_cuda_op_mul_bcast0_quant(ggml_backend_cuda_context & ctx, ggml_tensor * dst, char * q8_1_dst) {
+void ggml_cuda_op_mul_bcast0_quant(ggml_backend_cuda_context & ctx, ggml_tensor * dst, char * q8_1_dst,
+                                   const ggml_tensor * softplus_src) {
