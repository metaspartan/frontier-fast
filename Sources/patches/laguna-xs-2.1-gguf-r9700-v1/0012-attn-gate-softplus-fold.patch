@@ -591,6 +592,7 @@ void ggml_cuda_op_repeat_back(ggml_backend_cuda_context & ctx, ggml_tensor * dst
 //   * d = amax/127.0f, q = roundf(val/d) and the (d, sum) ds write are the
 //     stock quantize_q8_1 statements.
 
+template <bool softplus>
