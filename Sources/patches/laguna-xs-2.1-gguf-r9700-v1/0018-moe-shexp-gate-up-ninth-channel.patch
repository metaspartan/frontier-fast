     const void * vx  = nullptr; // weight base (2D slab, no id indirection)
     const void * vy  = nullptr; // q8_1 activation base
     float      * dst = nullptr; // output base
+    // Gate weight base, set only when the routed launch is llama.cpp's fused
+    // gate+up+GLU mmvq. The extra channel then computes the shared expert's own
+    // gate and up projections and applies the same GLU, so the shared expert's
+    // separate gate/up launch and its GLU both disappear.
+    const void * gate = nullptr;
 };
 
 // Shared-expert operands for ggml_cuda_mul_mat_vec_q. Shape/type/stride
@@ -48,6 +53,9 @@ struct ggml_cuda_mmvq_shexp {
     const ggml_tensor * src0 = nullptr;
     const ggml_tensor * src1 = nullptr;
