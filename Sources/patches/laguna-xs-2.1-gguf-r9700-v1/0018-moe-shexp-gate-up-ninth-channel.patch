         if (s_q8_1 == nullptr) {
             const size_t size_q8_1 = s_ne13*s_ne12 * s_ne11*s_ne10_padded * sizeof(block_q8_1)/QK8_1;
             char * d_q8_1 = ctx.quantized_src1_cache.insert(
@@ -1636,6 +1665,19 @@ void ggml_cuda_mul_mat_vec_q(
