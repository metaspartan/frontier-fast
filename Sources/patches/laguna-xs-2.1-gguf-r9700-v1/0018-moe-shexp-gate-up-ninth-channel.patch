+    // Shared-expert gate weight; required exactly when the routed op is fused
+    // with a gate, forbidden otherwise (asserted in ggml_cuda_mul_mat_vec_q).
+    const ggml_tensor * gate = nullptr;
 };
 
 void ggml_cuda_mul_mat_vec_q(ggml_backend_cuda_context & ctx,
