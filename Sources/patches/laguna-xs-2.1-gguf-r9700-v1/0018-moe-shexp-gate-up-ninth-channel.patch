+        // A gate is required exactly when the routed op carries one: the kernel
+        // applies the GLU to every channel of the grid, so an extra channel without
+        // its own gate weight would read the routed experts'.
+        if (shexp->gate != nullptr) {
+            GGML_ASSERT(fusion != nullptr && fusion->gate != nullptr);
+            GGML_ASSERT(shexp->gate->type == shexp->src0->type);
+            GGML_ASSERT(ggml_are_same_shape (shexp->gate, shexp->src0));
+            GGML_ASSERT(ggml_are_same_stride(shexp->gate, shexp->src0));
