+++ b/ggml/src/ggml-cuda/norm.cuh
@@ -13,8 +13,12 @@
 // the (x, mul, dst) base pointers and the local row index depend on the group
 // segment, and both are integer-only.
 // Maximum number of operands in an add chain that may be folded into the
-// following rms_norm (matches the upstream multi-add fusion limit).
-#define RMS_NORM_ADD_MAX_OPERANDS 8
+// following rms_norm. The upstream multi-add fusion caps at 8 because its
+// kernel carries ONE src1 stride for every fused operand; this kernel carries a
+// stride per operand, so it can also take the MoE routed-expert aggregation
+// (n_expert_used channel views of one mul_mat_id output) in the same chain.
+// 12 covers top-8 routing plus the shared-expert and residual adds.
+#define RMS_NORM_ADD_MAX_OPERANDS 12
 
 // Run an elementwise add chain and the rms_norm+mul that consumes its result in
 // ONE kernel. The chain result is still written to memory exactly as the
--- a/ggml/src/ggml-cuda/norm.cu
+++ b/ggml/src/ggml-cuda/norm.cu
@@ -889,6 +889,10 @@
         RMS_NORM_PRE_ADD_QUANT_CASE(6)
         RMS_NORM_PRE_ADD_QUANT_CASE(7)
         RMS_NORM_PRE_ADD_QUANT_CASE(8)
+        RMS_NORM_PRE_ADD_QUANT_CASE(9)
+        RMS_NORM_PRE_ADD_QUANT_CASE(10)
+        RMS_NORM_PRE_ADD_QUANT_CASE(11)
+        RMS_NORM_PRE_ADD_QUANT_CASE(12)
 #undef RMS_NORM_PRE_ADD_QUANT_CASE
         default: GGML_ABORT("fatal error");
     }
@@ -947,20 +951,21 @@
     const int64_t mul_stride_row = mul_src->nb[1] / sizeof(float);
 
     switch (n_op) {
-        case 2: rms_norm_pre_add_launch<2>(args, add_dst, add_stride_row, dst, (int) ncols, (int) nrows, eps,
-                    (const float *) mul_src->data, mul_stride_row, (uint32_t) mul_src->ne[0], (uint32_t) mul_src->ne[1], stream); break;
-        case 3: rms_norm_pre_add_launch<3>(args, add_dst, add_stride_row, dst, (int) ncols, (int) nrows, eps,
-                    (const float *) mul_src->data, mul_stride_row, (uint32_t) mul_src->ne[0], (uint32_t) mul_src->ne[1], stream); break;
-        case 4: rms_norm_pre_add_launch<4>(args, add_dst, add_stride_row, dst, (int) ncols, (int) nrows, eps,
-                    (const float *) mul_src->data, mul_stride_row, (uint32_t) mul_src->ne[0], (uint32_t) mul_src->ne[1], stream); break;
-        case 5: rms_norm_pre_add_launch<5>(args, add_dst, add_stride_row, dst, (int) ncols, (int) nrows, eps,
-                    (const float *) mul_src->data, mul_stride_row, (uint32_t) mul_src->ne[0], (uint32_t) mul_src->ne[1], stream); break;
-        case 6: rms_norm_pre_add_launch<6>(args, add_dst, add_stride_row, dst, (int) ncols, (int) nrows, eps,
-                    (const float *) mul_src->data, mul_stride_row, (uint32_t) mul_src->ne[0], (uint32_t) mul_src->ne[1], stream); break;
-        case 7: rms_norm_pre_add_launch<7>(args, add_dst, add_stride_row, dst, (int) ncols, (int) nrows, eps,
-                    (const float *) mul_src->data, mul_stride_row, (uint32_t) mul_src->ne[0], (uint32_t) mul_src->ne[1], stream); break;
-        case 8: rms_norm_pre_add_launch<8>(args, add_dst, add_stride_row, dst, (int) ncols, (int) nrows, eps,
+#define RMS_NORM_PRE_ADD_CASE(N) \
+        case N: rms_norm_pre_add_launch<N>(args, add_dst, add_stride_row, dst, (int) ncols, (int) nrows, eps, \
                     (const float *) mul_src->data, mul_stride_row, (uint32_t) mul_src->ne[0], (uint32_t) mul_src->ne[1], stream); break;
+        RMS_NORM_PRE_ADD_CASE(2)
+        RMS_NORM_PRE_ADD_CASE(3)
+        RMS_NORM_PRE_ADD_CASE(4)
+        RMS_NORM_PRE_ADD_CASE(5)
+        RMS_NORM_PRE_ADD_CASE(6)
+        RMS_NORM_PRE_ADD_CASE(7)
+        RMS_NORM_PRE_ADD_CASE(8)
+        RMS_NORM_PRE_ADD_CASE(9)
+        RMS_NORM_PRE_ADD_CASE(10)
+        RMS_NORM_PRE_ADD_CASE(11)
+        RMS_NORM_PRE_ADD_CASE(12)
+#undef RMS_NORM_PRE_ADD_CASE
         default: GGML_ABORT("fatal error");
