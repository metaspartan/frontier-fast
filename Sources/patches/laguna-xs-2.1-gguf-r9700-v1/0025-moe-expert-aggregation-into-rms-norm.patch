--- a/ggml/src/ggml-cuda/ggml-cuda.cu
+++ b/ggml/src/ggml-cuda/ggml-cuda.cu
@@ -3974,20 +3974,39 @@
 // destination - so the stored result is unchanged, and the norm then consumes
 // the same float values it would have read back from that store.
 
+// The MoE block ends in ONE long add chain: the n_expert_used routed-expert
+// results are summed, then the shared expert, then the attention residual, and
+// an rms_norm+mul consumes the total. The upstream multi-add fusion cannot take
+// it whole - its kernel applies a single src1 stride to every fused operand, and
+// the routed results are channel views of one mul_mat_id output (row stride
+// n_expert_used*n_embd) while the shared-expert and residual tensors are plain
+// contiguous rows. It therefore stops at that layout boundary and emits the
+// aggregation as its own k_bin_bcast dispatch.
+//
+// rms_norm_pre_add_f32 carries a stride PER operand, so the boundary is not
+// meaningful to it and the whole chain fits in one kernel. Accumulation stays
+// left-to-right from src0 of the first add, which is the order the split
+// k_bin_bcast + norm pair already produces, so every intermediate float is
+// unchanged.
 static int ggml_cuda_rms_norm_pre_add_chain_len(const ggml_cgraph * cgraph, const int i) {
-    // mirrors the multi-add fusion loop in ggml_cuda_try_fuse
+    static const bool wide = !(getenv("GGML_CUDA_DISABLE_WIDE_PRE_ADD") != nullptr &&
+                               std::atoi(getenv("GGML_CUDA_DISABLE_WIDE_PRE_ADD")));
+    // narrow: mirrors the multi-add fusion loop in ggml_cuda_try_fuse
+    const int max_fuse = wide ? RMS_NORM_ADD_MAX_OPERANDS - 2 : 6;
+
     int     n_fuse = 0;
-    ggml_op ops[8];
-    std::fill(ops, ops + 8, GGML_OP_ADD);
+    ggml_op ops[RMS_NORM_ADD_MAX_OPERANDS];
+    std::fill(ops, ops + RMS_NORM_ADD_MAX_OPERANDS, GGML_OP_ADD);
 
-    for (; n_fuse <= 6; ++n_fuse) {
+    for (; n_fuse <= max_fuse; ++n_fuse) {
         if (!ggml_can_fuse(cgraph, i + n_fuse, ops + n_fuse, 2)) {
             break;
         }
         if (cgraph->nodes[i + n_fuse] != cgraph->nodes[i + n_fuse + 1]->src[0]) {
             break;
         }
-        if (!ggml_are_same_layout(cgraph->nodes[i + n_fuse]->src[1], cgraph->nodes[i + n_fuse + 1]->src[1])) {
+        if (!wide &&
+                !ggml_are_same_layout(cgraph->nodes[i + n_fuse]->src[1], cgraph->nodes[i + n_fuse + 1]->src[1])) {
             break;
         }
     }
@@ -4070,6 +4089,23 @@
     if (!ggml_cuda_mmvq_ranges_disjoint(mul, add_last)) {
         return 0;
     }
+    // Pass 1 stores the chain result to add_last while reading every operand at
+    // the SAME element index, so an operand may share add_last base pointer -
+    // its value at that index is consumed before the store - but must not
+    // overlap it at a shift. This matters once the chain reaches back into the
+    // routed-expert aggregation: ggml-alloc can hand the chain result a block
+    // that the mul_mat_id output also occupies, and the channel views tile that
+    // output at exactly this tensor size, so the coincident view is base-equal
+    // and every other view is disjoint.
+    for (int k = 0; k <= n_adds; ++k) {
+        const ggml_tensor * operand = k == 0 ? cgraph->nodes[i]->src[0] : cgraph->nodes[i + k - 1]->src[1];
+        if (operand->data == add_last->data) {
+            continue;
+        }
+        if (!ggml_cuda_mmvq_ranges_disjoint(operand, add_last)) {
+            return 0;
+        }
+    }
     if (!ggml_is_contiguous(mul) || !ggml_are_same_shape(mul, add_last)) {
         return 0;
     }
