+// ----- grouped rms_norm+mul and the grouped rope that consumes it, in ONE -----
+//
+// A decoder layer normalises Q and K and then ropes Q and K. Both are already
+// grouped launches (rms_norm_f32_grouped, rope_neox_grouped) and both run one
+// block per row over the SAME row list: block r normalises row r and then row r
+// is roped, and no element of row r depends on any other row. So unlike the
+// KV-split reduction inside flash attention, this pair needs no device-wide
+// barrier to merge - the dependency is entirely inside one block.
+//
+// The kernel therefore runs the body of rms_norm_f32_grouped and then the body
+// of rope_neox_grouped, in the same order and with the same arithmetic. The
+// normalised row is still written to memory exactly as the norm would write it,
+// and the rope reads it from shared memory instead of reading back that store,
+// so every output float is byte-identical to the two launches it replaces.
+//
+// Requires the two groups to describe the same segments in the same order
+// (checked on the host) and the rope grid to be one block per row, i.e.
+// ne00 <= 2*CUDA_ROPE_BLOCK_SIZE, which the caller enforces.
+
+template <int block_size, bool forward, bool has_ff>
+static __global__ void rms_norm_rope_neox_grouped(const rms_norm_grouped_args nargs,
+                                                  const rope_grouped_args     rargs,
+                                                  const int                   ncols,
+                                                  const float                 eps,
+                                                  const int                   ne00,
+                                                  const int                   n_dims,
+                                                  const int32_t *             pos,
+                                                  const float                 freq_scale,
+                                                  const float                 ext_factor,
+                                                  const float                 attn_factor,
+                                                  const rope_corr_dims        corr_dims,
+                                                  const float                 theta_scale,
+                                                  const float *               freq_factors) {
+    ggml_cuda_pdl_lc();
+
+    // Segment routing, identical to both grouped launches: uniform across the
+    // block, integer-only. The two groups share a row list, so one scan serves
+    // both (nargs.seg_end == rargs.seg_end, asserted on the host).
+    uint32_t seg       = 0;
+    uint32_t seg_start = 0;
+#pragma unroll
+    for (int s = 0; s < RMS_NORM_MAX_GROUP_SIZE - 1; ++s) {
+        if (blockIdx.x >= nargs.seg_end[s]) {
+            seg       = s + 1;
+            seg_start = nargs.seg_end[s];
+        }
+    }
+
+    const int row = (int) (blockIdx.x - seg_start);
+    const int tid = threadIdx.x;
+
+    // ---- rms_norm_f32_grouped body ----
+    const float * x   = nargs.x[seg]   + (int64_t) row * nargs.stride_row[seg];
+    float *       dst = nargs.dst[seg] + (int64_t) row * ncols;
+
+    const uint32_t mul_row = fastmodulo((uint32_t) row, nargs.mul_nrows_packed[seg]);
+    const float *  mul     = nargs.mul[seg] + (int64_t) mul_row * nargs.mul_stride_row[seg];
+
+    // One row per block and one element per thread is the shape every grouped
+    // norm on this model runs at, so the row is held in a register across the
+    // reduction instead of being read twice. Same float, same order, so the
+    // stored result is unchanged.
+    const bool  one_per_thread = ncols <= block_size;
+    const float xi_reg         = one_per_thread && tid < ncols ? x[tid] : 0.0f;
+
+    float tmp = 0.0f;
+
+    ggml_cuda_pdl_sync();
+    if (one_per_thread) {
+        tmp = xi_reg * xi_reg;
+    } else {
+        for (int col = tid; col < ncols; col += block_size) {
+            const float xi = x[col];
+            tmp += xi * xi;
+        }
+    }
+
+    extern __shared__ float s_norm[];       // [32] reduction scratch, then [ncols] row
+    float * s_row = s_norm + 32;
+    tmp = block_reduce<block_reduce_method::SUM, block_size>(tmp, s_norm);
+
+    const float mean  = tmp / ncols;
+    const float scale = rsqrtf(mean + eps);
+
+    if (one_per_thread) {
+        if (tid < ncols) {
+            const int   mul_col = fastmodulo(tid, nargs.mul_ncols_packed[seg]);
+            const float val     = scale * xi_reg * mul[mul_col];
+            dst[tid]            = val;
+            s_row[tid]          = val;
+        }
+    } else {
+        for (int col = tid; col < ncols; col += block_size) {
+            const int   mul_col = fastmodulo(col, nargs.mul_ncols_packed[seg]);
+            const float val     = scale * x[col] * mul[mul_col];
+            dst[col]            = val;
+            s_row[col]          = val;
+        }
+    }
+
+    // ---- rope_neox_grouped body, reading the row from shared ----
+    __syncthreads();
+
+    float * GGML_CUDA_RESTRICT rdst = (float *) rargs.dst[seg];
+
+    const int i1   = row;
+    const int idst = (int) ((int64_t) i1 * rargs.s1[seg]);
+
+    for (int i0 = 2*tid; i0 < ne00; i0 += 2*block_size) {
+        if (i0 >= n_dims) {
+            rdst[idst + i0 / 2 + i0 / 2 + 0] = s_row[i0 / 2 + i0 / 2 + 0];
+            rdst[idst + i0 / 2 + i0 / 2 + 1] = s_row[i0 / 2 + i0 / 2 + 1];
+            continue;
+        }
+
+        const float theta_base = pos[0]*powf(theta_scale, i0/2.0f);
+
+        const float freq_factor = has_ff ? freq_factors[i0/2] : 1.0f;
+
+        float cos_theta;
+        float sin_theta;
+
+        rope_yarn<forward>(theta_base/freq_factor, freq_scale, corr_dims, i0, ext_factor, attn_factor, cos_theta, sin_theta);
+
+        const float x0 = s_row[i0 / 2 + 0];
+        const float x1 = s_row[i0 / 2 + n_dims/2];
+
+        rdst[idst + i0 / 2 + 0]            = x0 * cos_theta - x1 * sin_theta;
+        rdst[idst + i0 / 2 + n_dims / 2]   = x0 * sin_theta + x1 * cos_theta;
+    }
+}
+
+void ggml_cuda_op_rms_norm_rope_grouped(ggml_backend_cuda_context & ctx,
+                                        ggml_tensor * const * norms, ggml_tensor * const * muls,
+                                        ggml_tensor * const * ropes, int n_nodes) {
+    GGML_ASSERT(n_nodes >= 2 && n_nodes <= RMS_NORM_MAX_GROUP_SIZE);
+    GGML_ASSERT(n_nodes <= ROPE_MAX_GROUP_SIZE);
+
+    cudaStream_t stream = ctx.stream();
+
+    rms_norm_grouped_args nargs = {};
+    uint32_t total_rows = 0;
+    int64_t  ncols      = 0;
+    float    eps        = 0.0f;
+    ggml_cuda_rms_norm_grouped_build_args(norms, muls, n_nodes, nargs, total_rows, ncols, eps);
+
+    const ggml_tensor * first = ropes[0];
+    const ggml_tensor * src1f = first->src[1];
+    const ggml_tensor * src2f = first->src[2];
+
+    const int64_t ne00 = first->src[0]->ne[0];
+    GGML_ASSERT(ne00 == ncols);
+    GGML_ASSERT(ne00 <= 2*CUDA_ROPE_BLOCK_SIZE);
+
+    const int n_dims     = ((const int32_t *) first->op_params)[1];
+    const int n_ctx_orig = ((const int32_t *) first->op_params)[4];
+
+    float freq_base, freq_scale, ext_factor, attn_factor, beta_fast, beta_slow;
+    memcpy(&freq_base,   (const int32_t *) first->op_params +  5, sizeof(float));
+    memcpy(&freq_scale,  (const int32_t *) first->op_params +  6, sizeof(float));
+    memcpy(&ext_factor,  (const int32_t *) first->op_params +  7, sizeof(float));
+    memcpy(&attn_factor, (const int32_t *) first->op_params +  8, sizeof(float));
+    memcpy(&beta_fast,   (const int32_t *) first->op_params +  9, sizeof(float));
+    memcpy(&beta_slow,   (const int32_t *) first->op_params + 10, sizeof(float));
+
+    const int32_t * pos          = (const int32_t *) src1f->data;
+    const float *   freq_factors = src2f != nullptr ? (const float *) src2f->data : nullptr;
+
+    rope_corr_dims corr_dims;
+    ggml_rope_yarn_corr_dims(n_dims, n_ctx_orig, freq_base, beta_fast, beta_slow, corr_dims.v);
+
+    rope_grouped_args rargs = {};
+    uint32_t rope_rows = 0;
+    for (int m = 0; m < n_nodes; ++m) {
+        const ggml_tensor * dst  = ropes[m];
+        const ggml_tensor * src0 = dst->src[0];
+
+        GGML_ASSERT(dst->op == GGML_OP_ROPE);
+        GGML_ASSERT(src0 == muls[m]);
+        GGML_ASSERT(src0->type == GGML_TYPE_F32 && dst->type == GGML_TYPE_F32);
+        GGML_ASSERT(src0->ne[0] == ne00 && dst->ne[0] == ne00);
+        GGML_ASSERT(src0->ne[2] == 1 && src0->ne[3] == 1);
+        GGML_ASSERT(dst->ne[2] == 1 && dst->ne[3] == 1);
+        GGML_ASSERT(dst->src[1] == src1f && dst->src[2] == src2f);
+        GGML_ASSERT(memcmp(dst->op_params, first->op_params, GGML_MAX_OP_PARAMS) == 0);
+
+        rargs.x[m]       = src0->data;
+        rargs.dst[m]     = dst->data;
+        rargs.s01[m]     = (int) (src0->nb[1] / ggml_type_size(src0->type));
+        rargs.s1[m]      = (int) (dst->nb[1] / ggml_type_size(dst->type));
+        rope_rows       += (uint32_t) src0->ne[1];
+        rargs.seg_end[m] = rope_rows;
+        // the two groups must tile the same rows in the same order
+        GGML_ASSERT(rargs.seg_end[m] == nargs.seg_end[m]);
+    }
+    for (int m = n_nodes; m < ROPE_MAX_GROUP_SIZE; ++m) {
+        rargs.seg_end[m] = rope_rows;
+    }
+    GGML_ASSERT(rope_rows == total_rows);
+
+    // identical to the individual launches (shared freq_base and n_dims)
+    const float theta_scale = powf(freq_base, -2.0f / n_dims);
+
+    const dim3 blocks_num(total_rows, 1, 1);
+    const int  block_size = ncols < 1024 ? 256 : 1024;
+    const dim3 block_dims(block_size, 1, 1);
+    const size_t nbytes_shared = (32 + ncols)*sizeof(float);
+
+    const ggml_cuda_kernel_launch_params launch_params = { blocks_num, block_dims, nbytes_shared, stream };
+
+    if (block_size == 256) {
+        if (freq_factors == nullptr) {
+            ggml_cuda_kernel_launch(rms_norm_rope_neox_grouped<256, true, false>, launch_params,
+                nargs, rargs, (int) ncols, eps, (int) ne00, n_dims, pos, freq_scale, ext_factor, attn_factor,
+                corr_dims, theta_scale, freq_factors);
+        } else {
+            ggml_cuda_kernel_launch(rms_norm_rope_neox_grouped<256, true, true>, launch_params,
+                nargs, rargs, (int) ncols, eps, (int) ne00, n_dims, pos, freq_scale, ext_factor, attn_factor,
+                corr_dims, theta_scale, freq_factors);
+        }
+    } else {
+        if (freq_factors == nullptr) {
+            ggml_cuda_kernel_launch(rms_norm_rope_neox_grouped<1024, true, false>, launch_params,
+                nargs, rargs, (int) ncols, eps, (int) ne00, n_dims, pos, freq_scale, ext_factor, attn_factor,
+                corr_dims, theta_scale, freq_factors);
+        } else {
+            ggml_cuda_kernel_launch(rms_norm_rope_neox_grouped<1024, true, true>, launch_params,
+                nargs, rargs, (int) ncols, eps, (int) ne00, n_dims, pos, freq_scale, ext_factor, attn_factor,
+                corr_dims, theta_scale, freq_factors);
+        }
+    }
+}
+
