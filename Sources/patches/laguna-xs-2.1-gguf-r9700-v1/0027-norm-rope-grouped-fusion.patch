             static const bool disable_pre_add_norm = getenv("GGML_CUDA_DISABLE_PRE_ADD_NORM") != nullptr &&
                                                    std::atoi(getenv("GGML_CUDA_DISABLE_PRE_ADD_NORM"));
             static const bool disable_norm_quant = getenv("GGML_CUDA_DISABLE_NORM_QUANT") != nullptr &&
@@ -5550,6 +5702,22 @@ static void ggml_cuda_graph_evaluate_and_capture(ggml_backend_cuda_context * cud
                     ggml_tensor * muls [RMS_NORM_MAX_GROUP_SIZE];
                     const int n_members = ggml_cuda_rms_norm_collect_group(cgraph, i, norms, muls, grouped_done, mmvq_grouped_done);
                     if (n_members >= 2) {
+                        ggml_tensor * ropes[ROPE_MAX_GROUP_SIZE];
+                        const int n_ropes = disable_rope_group || disable_norm_rope_fuse ? 0 :
+                            ggml_cuda_rms_norm_rope_collect(cgraph, i, norms, muls, n_members, ropes,
