From: Claude Opus 5 <noreply@anthropic.com>
Subject: [PATCH 27/27] cuda/hip: run the grouped rms_norm and the grouped rope
 that consumes it as one kernel, and guard the pre-add cross-block hazard

A decoder layer normalises Q and K and then ropes Q and K. Both already run as
grouped launches (0005, 0006) and both issue ONE BLOCK PER ROW over the same
row list, so the rope of row r depends only on the norm of row r. The pair
therefore merges with no device-wide barrier and with the block count
unchanged, which is what separates it from the other adjacent pairs left on
this track.

Also carries the pre-add cross-block hazard guard diagnosed on the qwen3.6
r9700 track in round 51 (patch 0065, not this author's work). It declines zero
folds on Laguna-XS and is defence in depth here.
---
diff --git a/ggml/src/ggml-cuda/ggml-cuda.cu b/ggml/src/ggml-cuda/ggml-cuda.cu
index 09da584..4237172 100644
--- a/ggml/src/ggml-cuda/ggml-cuda.cu
+++ b/ggml/src/ggml-cuda/ggml-cuda.cu
@@ -3878,6 +3878,111 @@ static int ggml_cuda_rope_collect_group(const ggml_cgraph * cgraph, const int st
 }
 
 
+// ----- the grouped rope that consumes a grouped rms_norm ----------------------
+//
+// Both grouped launches run one block per row over the same row list, and the
+// rope of row r depends only on the norm of row r, so the pair merges with no
+// device-wide barrier and no loss of parallelism - the block count is unchanged.
+// This returns the rope group when it matches the norm group exactly: same
+// member count, same order, and ropes[m]->src[0] == muls[m], i.e. the rope of
+// member m reads precisely what the norm of member m writes.
+static int ggml_cuda_rms_norm_rope_collect(const ggml_cgraph * cgraph, const int start,
+                                           ggml_tensor * const * norms, ggml_tensor * const * muls,
+                                           const int n_members, ggml_tensor ** ropes,
+                                           const std::unordered_set<const ggml_tensor *> & done,
+                                           const std::unordered_set<const ggml_tensor *> & done2) {
+    if (n_members < 2 || n_members > ROPE_MAX_GROUP_SIZE) {
+        return 0;
+    }
+
+    // The norm group's own nodes run first inside the fused kernel, so for the
+    // hoist scan they count as already issued.
+    std::unordered_set<const ggml_tensor *> issued = done;
+    for (int m = 0; m < n_members; ++m) {
+        issued.insert(norms[m]);
+        issued.insert(muls[m]);
+    }
+
+    constexpr int scan_window = 24;
+    const int end = std::min(cgraph->n_nodes, start + 1 + scan_window);
+
+    const ggml_tensor * first = nullptr;
+
+    for (int m = 0; m < n_members; ++m) {
+        ggml_tensor * found = nullptr;
+
+        for (int j = start + 1; j < end; ++j) {
+            ggml_tensor * cand = cgraph->nodes[j];
+            if (cand->op != GGML_OP_ROPE || cand->src[0] != muls[m]) {
+                continue;
+            }
+            if (done.count(cand) != 0 || done2.count(cand) != 0) {
+                return 0;
+            }
+            if (!ggml_cuda_rope_groupable(cgraph, j)) {
+                return 0;
+            }
+            if (!ggml_cuda_rope_hoist_legal(cgraph, start, j, issued, done2)) {
+                return 0;
+            }
+            found = cand;
+            break;
+        }
+
+        if (found == nullptr) {
+            return 0;
+        }
+        if (first == nullptr) {
+            first = found;
+        } else {
+            // every rope parameter must be identical, so that every derived
+            // scalar is bit-identical to the individual launch
+            if (found->src[1] != first->src[1] || found->src[2] != first->src[2]) {
+                return 0;
+            }
+            if (memcmp(found->op_params, first->op_params, GGML_MAX_OP_PARAMS) != 0) {
+                return 0;
+            }
+            if (found->src[0]->ne[0] != first->src[0]->ne[0]) {
+                return 0;
+            }
+        }
+        ropes[m] = found;
+    }
+
+    // the norm's row is staged in shared memory, so the rope must be one block
+    // per row and the two must agree on the row length
+    if (first->src[0]->ne[0] != norms[0]->src[0]->ne[0]) {
+        return 0;
+    }
+    if (first->src[0]->ne[0] > 2*CUDA_ROPE_BLOCK_SIZE) {
+        return 0;
+    }
+    // members must write disjoint destinations, and no rope may write over a
+    // row another member still has to read
+    for (int m = 0; m < n_members; ++m) {
+        for (int k = 0; k < n_members; ++k) {
+            if (k != m && !ggml_cuda_mmvq_ranges_disjoint(ropes[m], ropes[k])) {
+                return 0;
+            }
+            if (k != m && !ggml_cuda_mmvq_ranges_disjoint(ropes[m], muls[k])) {
+                return 0;
+            }
+        }
+        // in-place (rope over the norm's own output) is the common case and is
+        // safe: the block reads its row from shared memory, not from muls[m]
+        if (ropes[m]->data != muls[m]->data &&
+                !ggml_cuda_mmvq_ranges_disjoint(ropes[m], muls[m])) {
+            return 0;
+        }
+        if (ropes[m]->src[0]->ne[1] != norms[m]->src[0]->ne[1]) {
+            return 0;
+        }
+    }
+    return n_members;
+}
