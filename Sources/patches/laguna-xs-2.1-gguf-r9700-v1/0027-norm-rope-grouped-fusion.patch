@@ -4109,6 +4245,20 @@ static int ggml_cuda_rms_norm_pre_add_detect(const ggml_cgraph * cgraph, const i
     if (!ggml_is_contiguous(mul) || !ggml_are_same_shape(mul, add_last)) {
         return 0;
     }
+    // Above one row the cross-block hazard is live.  add_last against the
+    // operands is tested just above; the missing edge is the loop-2 writer,
+    // mul, against the same read set.  At one row there is one block and the
+    // hazard cannot exist, so decode is untouched by construction.
+    static const bool pre_add_unsafe = getenv("GGML_CUDA_PRE_ADD_NORM_UNSAFE") != nullptr &&
+                                       std::atoi(getenv("GGML_CUDA_PRE_ADD_NORM_UNSAFE"));
+    if (!pre_add_unsafe && ggml_nrows(add_last) > 1) {
+        for (int k = 0; k <= n_adds; ++k) {
+            const ggml_tensor * operand = k == 0 ? cgraph->nodes[i]->src[0] : cgraph->nodes[i + k - 1]->src[1];
+            if (!ggml_cuda_pre_add_write_safe(mul, operand)) {
+                return 0;
+            }
+        }
+    }
     // and the intermediate norm result is never materialised, so nothing else
     // may read it (guaranteed by ggml_cuda_can_fuse's single-use check)
     return n_adds;
@@ -5412,6 +5562,8 @@ static void ggml_cuda_graph_evaluate_and_capture(ggml_backend_cuda_context * cud
                                                    std::atoi(getenv("GGML_CUDA_DISABLE_ROPE_GROUP"));
             static const bool disable_set_rows_group = getenv("GGML_CUDA_DISABLE_SET_ROWS_GROUP") != nullptr &&
                                                    std::atoi(getenv("GGML_CUDA_DISABLE_SET_ROWS_GROUP"));
+            static const bool disable_norm_rope_fuse = getenv("GGML_CUDA_DISABLE_NORM_ROPE_FUSE") != nullptr &&
