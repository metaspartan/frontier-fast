--- a/ggml/src/ggml-cuda/ggml-cuda.cu
+++ b/ggml/src/ggml-cuda/ggml-cuda.cu
@@ -3266,7 +3266,54 @@
 // two plain matvec launches in stock, and grouping those changes no arithmetic.
 // Anything whose result reaches a GLU through a shape not tested here (e.g.
 // the scale/bias fusion variants) is rejected conservatively.
+// A batch-1 dense gate/up pair is faster as the grouped mmvq launch than as the
+// gate+up+GLU fused mmvq on this device: grouping keeps one workgroup per output
+// row (1024 workgroups x 128 threads) while the fused form halves the workgroup
+// count and doubles the threads (512 x 256). These launches are memory LATENCY
+// bound, not bandwidth bound, so workgroup count is what covers the latency -
+// measured on gfx1201 for the 512-row shared expert: grouped 4.33 us vs fused
+// 11.49 us for the same 1.18 MB, a 2.65x difference.
+//
+// Used by BOTH the fusion decision and the grouping guard so the two agree; if
+// only one side changed, the pair would fall through to two separate launches.
+static bool ggml_cuda_prefer_group_over_glu_fuse(const ggml_cgraph * cgraph, const int i) {
+    if (i < 0 || i + 2 >= cgraph->n_nodes) {
+        return false;
+    }
+    const ggml_tensor * a = cgraph->nodes[i];
+    const ggml_tensor * b = cgraph->nodes[i + 1];
+    if (a->op != GGML_OP_MUL_MAT || b->op != GGML_OP_MUL_MAT) {
+        return false;
+    }
+    if (cgraph->nodes[i + 2]->op != GGML_OP_GLU) {
+        return false;
+    }
+    if (a->src[2] != nullptr || b->src[2] != nullptr) {
+        return false; // MUL_MAT_ID: the routed experts, leave them fused
+    }
+    if (a->src[1] == nullptr || a->src[1] != b->src[1]) {
+        return false; // the grouped launch requires a shared activation
+    }
+    if (a->ne[1] != 1 || b->ne[1] != 1) {
+        return false; // batch-1 decode only
+    }
+    const ggml_tensor * wa = a->src[0];
+    const ggml_tensor * wb = b->src[0];
+    if (wa == nullptr || wb == nullptr || !ggml_is_quantized(wa->type) || wa->type != wb->type) {
+        return false;
+    }
+    if (wa->ne[0] != wb->ne[0] || wa->nb[1] != wb->nb[1]) {
+        return false; // grouped launch needs matching K and row stride
+    }
+    return true;
+}
+
 static bool ggml_cuda_mmvq_would_glu_fuse(const ggml_cgraph * cgraph, const int j) {
+    // the pair will be grouped instead of fused, so it does not block grouping
+    if (ggml_cuda_prefer_group_over_glu_fuse(cgraph, j) ||
+            ggml_cuda_prefer_group_over_glu_fuse(cgraph, j - 1)) {
+        return false;
+    }
     const auto fires = [&](const int p, std::initializer_list<enum ggml_op> ops) {
         return p >= 0 && ggml_cuda_can_fuse(cgraph, p, ops, {});
     };
