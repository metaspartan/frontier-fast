     return false;
 }
 
+// ----- MoE shared expert folded into the routed-expert launch ----------------
+//
+// A MoE layer's routed down projection is MUL_MAT_ID(down_exps, h_routed, ids)
+// and the shared expert's is MUL_MAT(down_shexp, h_shexp) over an equally shaped,
+// equally quantized weight slab. src/models/laguna.cpp emits the shared expert's
+// gate/up/SwiGLU ahead of the routed experts precisely so h_shexp is ready here.
+//
+// Returns the graph index of the shared-expert matvec that may be issued as an
+// extra channel of the routed launch, or -1.
+static int ggml_cuda_moe_shexp_find_down(const ggml_cgraph * cgraph, const int i, const int cc) {
+    const ggml_tensor * routed = cgraph->nodes[i];
+    if (routed->op != GGML_OP_MUL_MAT_ID || routed->src[2] == nullptr) {
+        return -1;
+    }
+    const ggml_tensor * w = routed->src[0];
+    const ggml_tensor * a = routed->src[1];
+    if (!ggml_is_quantized(w->type) || w->ne[2] <= 1) {
+        return -1;
+    }
+    // must be the batch-1 mmvq route of ggml_cuda_mul_mat_id: one dst column per
+    // selected expert, ne2 within this type's MUL_MAT_ID mmvq batch limit
+    if (routed->ne[2] != 1 || a->type != GGML_TYPE_F32 || routed->type != GGML_TYPE_F32) {
+        return -1;
+    }
+    // same gate as ggml_cuda_mul_mat_id
+    if (routed->ne[2] > MMVQ_MAX_BATCH_SIZE || routed->ne[2] > get_mmvq_mmid_max_batch(w->type, cc)) {
+        return -1;
+    }
+    if (routed->ne[1] > MMVQ_MAX_BATCH_SIZE) {
+        return -1;
+    }
+    // Only the down projection. The gate and up matvecs of the same layer match
+    // structurally too, but they are the first two nodes of llama.cpp's
+    // gate+up+GLU fusion; pairing them would split that pattern and cost far more
+    // than the pairing saves (measured: tg4 91 -> 84 tok/s).
+    if (ggml_cuda_mmvq_would_glu_fuse(cgraph, i)) {
+        return -1;
+    }
+
+    constexpr int scan_window = 64;
+    const int end = std::min(cgraph->n_nodes, i + 1 + scan_window);
+    for (int j = i + 1; j < end; ++j) {
+        ggml_tensor * cand = cgraph->nodes[j];
+        if (ggml_cuda_is_view_or_noop(cand)) {
+            continue;
+        }
+        if (cand->op != GGML_OP_MUL_MAT || cand->src[2] != nullptr) {
+            continue;
+        }
+        if ((cand->flags & GGML_TENSOR_FLAG_COMPUTE) == 0) {
+            continue;
+        }
+        const ggml_tensor * sw = cand->src[0];
+        const ggml_tensor * sa = cand->src[1];
+        // same K, same row count, same type and row stride -> the extra channel
+        // gets exactly the geometry its own launch would have used
+        if (sw->type != w->type || sw->ne[0] != w->ne[0] || sw->ne[1] != w->ne[1] || sw->ne[2] != 1 || sw->ne[3] != 1) {
+            continue;
+        }
+        if (sw->nb[1] != w->nb[1] || sw->nb[0] != w->nb[0]) {
+            continue;
+        }
+        // single dense column, F32 operands, contiguous rows: the plain mmvq route
+        if (sa->type != GGML_TYPE_F32 || cand->type != GGML_TYPE_F32) {
+            continue;
+        }
+        if (cand->ne[1] != 1 || cand->ne[2] != 1 || cand->ne[3] != 1) {
+            continue;
+        }
+        if (sa->ne[1] != 1 || sa->ne[2] != 1 || sa->ne[3] != 1) {
+            continue;
+        }
+        if (sa->nb[0] != ggml_type_size(sa->type) || cand->nb[0] != ggml_type_size(cand->type)) {
+            continue;
+        }
+        if (ggml_get_op_params_i32(cand, 1) == GGML_HINT_SRC0_IS_HADAMARD) {
+            continue;
+        }
+        if (ggml_cuda_mmvq_would_glu_fuse(cgraph, j)) {
+            continue; // shared expert's own gate/up: leave its GLU fusion alone
+        }
+        if (ggml_backend_buffer_get_usage(sw->buffer) == GGML_BACKEND_BUFFER_USAGE_COMPUTE) {
+            continue; // padding-clear case, keep the stock route
+        }
+        // the shared-expert matvec is hoisted to the routed matvec's position:
+        // its write must not alias anything the skipped nodes touch, and they
+        // must not write its inputs
+        if (!ggml_cuda_mmvq_hoist_legal(cgraph, i, j)) {
+            continue;
+        }
+        return j;
+    }
+    return -1;
+}
