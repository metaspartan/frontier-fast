From ec526649e7f595ce227cd675dbd83b01b01d27fc Mon Sep 17 00:00:00 2001
From: Cybara <carsenk@gmail.com>
Date: Thu, 6 Aug 2026 06:34:40 +0000
Subject: [PATCH] CUDA/HIP: fold MoE down-epilogue (router-weight mul + expert
 adds) into one kernel

Decode per MoE layer emitted the routed down mmid, then a k_bin_bcast weight
mul and n_expert_used-1 adds (profile: 10,191 k_bin_bcast dispatches / 15.9ms
per window; ~158/token). Detect the mmid->mul(weights)->add-chain pattern in
try_fuse and replace it with one kernel that reads the [n_embd, n_expert_used]
slab, applies the per-expert router weight, and sums in fixed order.

ppl-equivalent: the same adds the graph already performed, reassociated.
Kill switch: GGML_CUDA_DISABLE_MOE_DOWN_EPILOGUE=1.
Measured on R9700: tg64 160.27 -> 162.84 (+1.60%), pp32 160.48 -> 163.00
(+1.57%), 5 interleaved pairs, all pairs cand>frontier.
---
 ggml/src/ggml-cuda/ggml-cuda.cu | 122 ++++++++++++++++++++++++++++++++
 1 file changed, 122 insertions(+)

diff --git a/ggml/src/ggml-cuda/ggml-cuda.cu b/ggml/src/ggml-cuda/ggml-cuda.cu
index 075ea88..39e6b85 100644
--- a/ggml/src/ggml-cuda/ggml-cuda.cu
+++ b/ggml/src/ggml-cuda/ggml-cuda.cu
@@ -3377,6 +3377,104 @@ static bool ggml_cuda_mmvq_would_glu_fuse(const ggml_cgraph * cgraph, const int
 //
 // Returns the graph index of the shared-expert matvec that may be issued as an
 // extra channel of the routed launch, or -1.
+
+// ----- fold the MoE down-epilogue (weights mul + expert-add chain) -----
+#define LAGUNA_MOE_MAX_EXPERTS 16
+
+static int ggml_cuda_moe_down_epilogue_count(const ggml_cgraph * cgraph, const int i) {
+    const ggml_tensor * mul = cgraph->nodes[i];
+    if (mul->op != GGML_OP_MUL) {
+        return -1;
+    }
+    const ggml_tensor * mmid = mul->src[0];
+    const ggml_tensor * w    = mul->src[1];
+    if (mmid == nullptr || w == nullptr) {
+        return -1;
+    }
+    if (mmid->op != GGML_OP_MUL_MAT_ID || mmid->src[2] == nullptr) {
+        return -1;
+    }
+    if (mmid->ne[2] != 1) {
+        return -1; // batch-1 decode only
+    }
+    const int n_expert_used = (int) mmid->ne[1];
+    if (n_expert_used < 2 || n_expert_used > LAGUNA_MOE_MAX_EXPERTS) {
+        return -1;
+    }
+    if (w->ne[0] != 1 || w->ne[1] != n_expert_used || w->ne[2] != 1) {
+        return -1;
+    }
+    if (w->type != GGML_TYPE_F32 || mmid->type != GGML_TYPE_F32 || mul->type != GGML_TYPE_F32) {
+        return -1;
+    }
+    if (!ggml_is_contiguous(mmid) || !ggml_is_contiguous(w)) {
+        return -1;
+    }
+    if ((mul->flags & GGML_TENSOR_FLAG_OUTPUT) != 0) {
+        return -1;
+    }
+    int j = i + 1;
+    int adds = 0;
+    ggml_tensor * acc = nullptr;
+    while (j < cgraph->n_nodes && adds < n_expert_used - 1) {
+        ggml_tensor * node = cgraph->nodes[j];
+        if (ggml_cuda_is_view_or_noop(node)) { ++j; continue; }
+        if (node->op != GGML_OP_ADD) {
+            return -1;
+        }
+        const ggml_tensor * a = node->src[0];
+        const ggml_tensor * b = node->src[1];
+        if (acc == nullptr) {
+            if ((a == mul || (a->view_src != nullptr && a->view_src == mul)) ||
+                (b == mul || (b->view_src != nullptr && b->view_src == mul))) {
+                acc = node;
+            } else {
+                return -1;
+            }
+        } else {
+            if ((a == acc || a->view_src == acc) || (b == acc || b->view_src == acc)) {
+                acc = node;
+            } else {
+                return -1;
+            }
+        }
+        ++adds;
+        ++j;
+    }
+    if (adds != n_expert_used - 1) {
+        return -1;
+    }
+    return adds;
+}
+
+__global__ void k_moe_down_epilogue_fused(
+        const float * __restrict__ experts, const float * __restrict__ weights,
+        float * __restrict__ dst, const int n_embd, const int n_expert_used) {
+    const int i = blockIdx.x * blockDim.x + threadIdx.x;
+    if (i >= n_embd) {
+        return;
+    }
+    float acc = 0.0f;
+    for (int e = 0; e < n_expert_used; ++e) {
+        acc += experts[(int64_t) e * n_embd + i] * weights[e];
+    }
+    dst[i] = acc;
+}
+
+void ggml_cuda_op_moe_down_epilogue(ggml_backend_cuda_context & ctx,
+                                    const ggml_tensor * mmid, const ggml_tensor * weights,
+                                    ggml_tensor * dst) {
+    const int n_embd = (int) mmid->ne[0];
+    const int n_expert_used = (int) mmid->ne[1];
+    cudaStream_t stream = ctx.stream();
+    const int threads = 256;
+    const int blocks = (n_embd + threads - 1) / threads;
+    ggml_cuda_kernel_launch(k_moe_down_epilogue_fused,
+        ggml_cuda_kernel_launch_params(dim3(blocks), dim3(threads), 0, stream),
+        (const float *) mmid->data, (const float *) weights->data, (float *) dst->data,
+        n_embd, n_expert_used);
+}
+
 static int ggml_cuda_moe_shexp_find_down(const ggml_cgraph * cgraph, const int i, const int cc) {
     const ggml_tensor * routed = cgraph->nodes[i];
     if (routed->op != GGML_OP_MUL_MAT_ID || routed->src[2] == nullptr) {
@@ -4622,6 +4720,28 @@ static int ggml_cuda_try_fuse(ggml_backend_cuda_context * cuda_ctx, ggml_cgraph
         }
     }
 
+    // MoE down-epilogue fold: mmid(down) -> mul(weights) -> add chain.
+    if (node->op == GGML_OP_MUL && (node->flags & GGML_TENSOR_FLAG_COMPUTE) != 0) {
+        const int n_chain = ggml_cuda_moe_down_epilogue_count(cgraph, i);
+        if (n_chain > 0) {
+            const ggml_tensor * mmid = node->src[0];
+            const ggml_tensor * w    = node->src[1];
+            int j = i + 1;
+            int seen = 0;
+            ggml_tensor * final_add = nullptr;
+            while (j < cgraph->n_nodes && seen < n_chain) {
+                ggml_tensor * n2 = cgraph->nodes[j];
+                if (ggml_cuda_is_view_or_noop(n2)) { ++j; continue; }
+                if (n2->op == GGML_OP_ADD) { final_add = n2; ++seen; }
+                ++j;
+            }
+            if (final_add != nullptr) {
+                ggml_cuda_op_moe_down_epilogue(*cuda_ctx, mmid, w, final_add);
+                return j - i;
+            }
+        }
+    }
+
     // multi-(add or mul)
     if (node->op == GGML_OP_ADD || node->op == GGML_OP_MUL) {
         int     n_fuse = 0;
@@ -5305,6 +5425,8 @@ static void ggml_cuda_graph_evaluate_and_capture(ggml_backend_cuda_context * cud
                                                    std::atoi(getenv("GGML_CUDA_DISABLE_PRE_ADD_NORM"));
             static const bool disable_norm_quant = getenv("GGML_CUDA_DISABLE_NORM_QUANT") != nullptr &&
                                                    std::atoi(getenv("GGML_CUDA_DISABLE_NORM_QUANT"));
+            static const bool disable_moe_down_epilogue = getenv("GGML_CUDA_DISABLE_MOE_DOWN_EPILOGUE") != nullptr &&
+                                                   std::atoi(getenv("GGML_CUDA_DISABLE_MOE_DOWN_EPILOGUE"));
             static const bool disable_mmvq_group = getenv("GGML_CUDA_DISABLE_MMVQ_GROUP") != nullptr &&
                                                    std::atoi(getenv("GGML_CUDA_DISABLE_MMVQ_GROUP"));
             static const bool disable_softplus_mul = getenv("GGML_CUDA_DISABLE_SOFTPLUS_MUL") != nullptr &&
