From 11bb31c280a06cb260928590818a837d5dba6318 Mon Sep 17 00:00:00 2001
From: Cybara <carsenk@gmail.com>
Date: Tue, 4 Aug 2026 23:35:10 -0600
Subject: [PATCH] CUDA/HIP: fold residual add + q8_1 quant into rms_norm (with
 kill switches)

Stack residual-pre-add fold and norm-side q8_1 quantize for dense hybrid
LFM2.5. Declares GGML_CUDA_DISABLE_PRE_ADD_NORM and
GGML_CUDA_DISABLE_NORM_QUANT in the eval loop (required for compile).

Bit-identical: stock add chain; stock quantize_q8_1 amax/sum/ds; cache miss
falls back. Removes one add + one quantize dispatch per activation.
---
 ggml/src/ggml-cuda/ggml-cuda.cu | 303 ++++++++++++++++++++++++++++
 ggml/src/ggml-cuda/norm.cu      | 342 ++++++++++++++++++++++++++++++++
 ggml/src/ggml-cuda/norm.cuh     |  21 ++
 3 files changed, 666 insertions(+)

diff --git a/ggml/src/ggml-cuda/ggml-cuda.cu b/ggml/src/ggml-cuda/ggml-cuda.cu
index b40fcc0..82a9cbd 100644
--- a/ggml/src/ggml-cuda/ggml-cuda.cu
+++ b/ggml/src/ggml-cuda/ggml-cuda.cu
@@ -3506,6 +3506,272 @@ static int ggml_cuda_rms_norm_collect_group(const ggml_cgraph * cgraph, const in
     return n;
 }
 
+
+// ----- add chain folded into the following rms_norm+mul ----------------------
+//
+// The residual add that feeds a pre-norm is a separate dispatch in stock even
+// though the rms_norm block already covers the whole row. This detects
+//   [ADD (chain)] -> RMS_NORM -> MUL
+// and runs it as one kernel. The add chain is exactly the one the upstream
+// multi-(add|mul) fusion would build - same operands, same order, same single
+// destination - so the stored result is unchanged, and the norm then consumes
+// the same float values it would have read back from that store.
+
+static int ggml_cuda_rms_norm_pre_add_chain_len(const ggml_cgraph * cgraph, const int i) {
+    // mirrors the multi-add fusion loop in ggml_cuda_try_fuse
+    int     n_fuse = 0;
+    ggml_op ops[8];
+    std::fill(ops, ops + 8, GGML_OP_ADD);
+
+    for (; n_fuse <= 6; ++n_fuse) {
+        if (!ggml_can_fuse(cgraph, i + n_fuse, ops + n_fuse, 2)) {
+            break;
+        }
+        if (cgraph->nodes[i + n_fuse] != cgraph->nodes[i + n_fuse + 1]->src[0]) {
+            break;
+        }
+        if (!ggml_are_same_layout(cgraph->nodes[i + n_fuse]->src[1], cgraph->nodes[i + n_fuse + 1]->src[1])) {
+            break;
+        }
+    }
+    return n_fuse + 1;
+}
+
+static bool ggml_cuda_rms_norm_pre_add_operand_ok(const ggml_tensor * t, const ggml_tensor * ref) {
+    return t != nullptr && t->type == GGML_TYPE_F32 && ggml_are_same_shape(t, ref) &&
+           ggml_is_contiguous(t) && t->nb[0] == ggml_type_size(t->type);
+}
+
+// returns the number of chained ADD nodes to fold, or 0
+static int ggml_cuda_rms_norm_pre_add_detect(const ggml_cgraph * cgraph, const int i) {
+    if (cgraph->nodes[i]->op != GGML_OP_ADD) {
+        return 0;
+    }
+
+    const int n_adds = ggml_cuda_rms_norm_pre_add_chain_len(cgraph, i);
+    const int inorm  = i + n_adds;
+    if (inorm + 1 >= cgraph->n_nodes) {
+        return 0;
+    }
+    if (n_adds < 1 || n_adds > RMS_NORM_ADD_MAX_OPERANDS - 1) {
+        return 0;
+    }
+
+    ggml_tensor * add_last = cgraph->nodes[inorm - 1];
+    ggml_tensor * norm     = cgraph->nodes[inorm];
+    ggml_tensor * mul      = cgraph->nodes[inorm + 1];
+
+    if (norm->op != GGML_OP_RMS_NORM || norm->src[0] != add_last) {
+        return 0;
+    }
+    // the norm+mul pair must be exactly what stock would fuse, and the +add
+    // variant is left alone
+    if (ggml_cuda_can_fuse(cgraph, inorm, { GGML_OP_RMS_NORM, GGML_OP_MUL, GGML_OP_ADD }, {})) {
+        return 0;
+    }
+    if (!ggml_cuda_can_fuse(cgraph, inorm, { GGML_OP_RMS_NORM, GGML_OP_MUL }, {})) {
+        return 0;
+    }
+
+    const ggml_tensor * mul_src = nullptr;
+    if (mul->src[0] == norm) {
+        mul_src = mul->src[1];
+    } else if (mul->src[1] == norm) {
+        mul_src = mul->src[0];
+    } else {
+        return 0;
+    }
+    if (mul_src == nullptr || mul_src->type != GGML_TYPE_F32 ||
+            mul_src->nb[0] != ggml_type_size(mul_src->type)) {
+        return 0;
+    }
+    if (mul_src->ne[2] != 1 || mul_src->ne[3] != 1) {
+        return 0;
+    }
+
+    // 2D, non-broadcast add operands only
+    if (add_last->type != GGML_TYPE_F32 || add_last->ne[2] != 1 || add_last->ne[3] != 1) {
+        return 0;
+    }
+    if (!ggml_is_contiguous(add_last) || add_last->nb[0] != ggml_type_size(add_last->type)) {
+        return 0;
+    }
+    if (!ggml_cuda_rms_norm_pre_add_operand_ok(cgraph->nodes[i]->src[0], add_last)) {
+        return 0;
+    }
+    for (int k = 0; k < n_adds; ++k) {
+        const ggml_tensor * a = cgraph->nodes[i + k];
+        if (a->op != GGML_OP_ADD || !ggml_are_same_shape(a, add_last)) {
+            return 0;
+        }
+        if (!ggml_cuda_rms_norm_pre_add_operand_ok(a->src[1], add_last)) {
+            return 0;
+        }
+    }
+    // the norm output must not alias the stored add result: the kernel reads the
+    // add result back after writing it
+    if (!ggml_cuda_mmvq_ranges_disjoint(mul, add_last)) {
+        return 0;
+    }
+    if (!ggml_is_contiguous(mul) || !ggml_are_same_shape(mul, add_last)) {
+        return 0;
+    }
+    // and the intermediate norm result is never materialised, so nothing else
+    // may read it (guaranteed by ggml_cuda_can_fuse's single-use check)
+    return n_adds;
+}
+
+
+// ----- folding the q8_1 quantization into the norm that produces it ----------
+//
+// The activation a decoder layer feeds to its projections is produced by an
+// rms_norm+mul and then quantized to q8_1 by the first mul_mat_vec_q that
+// consumes it (patch 0003 makes the later consumers reuse that result). The
+// norm kernel already has the value in a register the instant before the
+// quantize kernel would load it back, and its blocks already cover whole rows,
+// so the quantization can be produced by the norm itself - one dispatch fewer
+// per activation.
+//
+// The buffer is registered in the same per-graph cache the consumers look in,
+// under exactly the parameter tuple ggml_cuda_mul_mat_vec_q would use. A
+// mismatch can therefore only cost a cache miss (the consumer re-quantizes as
+// before), never a wrong result.
+
+// does `t` feed a mul_mat / mul_mat_id that routes through mul_mat_vec_q?
+static bool ggml_cuda_norm_quant_has_mmvq_consumer(const ggml_cgraph * cgraph, const int from, const ggml_tensor * t) {
+    const int cc  = ggml_cuda_info().devices[ggml_cuda_get_device()].cc;
+    // The consumer can sit well past the producer (the MoE router, top-k cluster
+    // and expert matvecs all run between the ffn norm and the shared-expert
+    // projections), so the window is generous. Distance is irrelevant to
+    // correctness: the cache entry describes the value written here, and the
+    // cache's own lifetime rules (patch 0003) govern when it may be reused.
+    const int end = std::min(cgraph->n_nodes, from + 64);
+
+    for (int j = from; j < end; ++j) {
+        const ggml_tensor * n = cgraph->nodes[j];
+        if (n->op != GGML_OP_MUL_MAT && n->op != GGML_OP_MUL_MAT_ID) {
+            continue;
+        }
+        // match the cache's identity rule: a reshape/view of the producer's
+        // result is the same data and hits the same entry
+        const ggml_tensor * s1 = n->src[1];
+        if (s1 == nullptr) {
+            continue;
+        }
+        const ggml_tensor * s1_origin = s1->view_src != nullptr ? s1->view_src : s1;
+        if (s1_origin != t || s1->data != t->data) {
+            continue;
+        }
+        if (s1->ne[0] != t->ne[0] || s1->nb[1] != t->nb[1] ||
+                s1->ne[1] != t->ne[1] || s1->ne[2] != t->ne[2] || s1->ne[3] != t->ne[3]) {
+            continue;
+        }
+        const ggml_tensor * w = n->src[0];
+        if (w == nullptr || !ggml_is_quantized(w->type)) {
+            continue;
+        }
+        if (t->type != GGML_TYPE_F32 || n->type != GGML_TYPE_F32) {
+            continue;
+        }
+        if (!ggml_cuda_should_use_mmvq(w->type, cc, s1->ne[1])) {
+            continue;
+        }
+        return true;
+    }
+    return false;
+}
+
+// Shape requirements of the folded epilogue: every warp of the norm block must
+// cover exactly one 32-element q8_1 block of one row, and the q8_1 row length
+// must equal the tensor row length (no padding tail to zero-fill).
+static bool ggml_cuda_norm_quant_shape_ok(const ggml_tensor * t) {
+    const int64_t ncols = t->ne[0];
+    if (ncols % QK8_1 != 0) {
+        return false;
+    }
+    if (GGML_PAD(ncols, MATRIX_ROW_PADDING) != ncols) {
+        return false;
+    }
+    const int block_size = ncols < 1024 ? 256 : 1024;
+    if (ncols % block_size != 0 || block_size % QK8_1 != 0) {
+        return false;
+    }
+    if (!ggml_is_contiguous(t)) {
+        return false;
+    }
+    if (t->ne[2] != 1 || t->ne[3] != 1) {
+        return false;
+    }
+    return true;
+}
+
+// Registers the q8_1 buffer for `t` in the per-graph cache and returns it, or
+// nullptr when the fold should not be done (already cached, wrong shape, no
+// consumer).
+static char * ggml_cuda_norm_quant_register(ggml_backend_cuda_context * ctx, const ggml_cgraph * cgraph,
+                                            const int from, ggml_tensor * t) {
+    if (!ggml_cuda_norm_quant_shape_ok(t)) {
+        return nullptr;
+    }
+    if (!ggml_cuda_norm_quant_has_mmvq_consumer(cgraph, from, t)) {
+        return nullptr;
+    }
+
+    cudaStream_t stream = ctx->stream();
+
+    const size_t  ts          = ggml_type_size(t->type);
+    const int64_t ne10        = t->ne[0];
+    const int64_t s11         = t->nb[1] / ts;
+    const int64_t s12         = t->nb[2] / ts;
+    const int64_t s13         = t->nb[3] / ts;
+    const int64_t ne10_padded = GGML_PAD(ne10, MATRIX_ROW_PADDING);
+
+    if (ctx->quantized_src1_cache.find(t, stream, ne10, s11, s12, s13,
+            ne10_padded, t->ne[1], t->ne[2], t->ne[3]) != nullptr) {
+        return nullptr; // already quantized in this evaluation
+    }
+
+    const size_t size_q8_1 = t->ne[3]*t->ne[2] * t->ne[1]*ne10_padded * sizeof(block_q8_1)/QK8_1;
+    return ctx->quantized_src1_cache.insert(ctx->pool(), t, stream, ne10, s11, s12, s13,
+        ne10_padded, t->ne[1], t->ne[2], t->ne[3], size_q8_1);
+}
+
+// A plain rms_norm+mul (no residual add to fold) that stock would run through
+// ggml_cuda_op_rms_norm_fused.
+static bool ggml_cuda_norm_quant_plain_ok(const ggml_cgraph * cgraph, const int i) {
+    if (cgraph->nodes[i]->op != GGML_OP_RMS_NORM) {
+        return false;
+    }
+    if (i + 1 >= cgraph->n_nodes) {
+        return false;
+    }
+    if (ggml_cuda_can_fuse(cgraph, i, { GGML_OP_RMS_NORM, GGML_OP_MUL, GGML_OP_ADD }, {})) {
+        return false;
+    }
+    if (!ggml_cuda_can_fuse(cgraph, i, { GGML_OP_RMS_NORM, GGML_OP_MUL }, {})) {
+        return false;
+    }
+
+    const ggml_tensor * norm = cgraph->nodes[i];
+    const ggml_tensor * mul  = cgraph->nodes[i + 1];
+    const ggml_tensor * x    = norm->src[0];
+
+    const ggml_tensor * mul_src = (mul->src[0] == norm) ? mul->src[1] : mul->src[0];
+    if (mul_src == nullptr || mul_src->type != GGML_TYPE_F32 ||
+            mul_src->nb[0] != ggml_type_size(mul_src->type) ||
+            mul_src->ne[2] != 1 || mul_src->ne[3] != 1) {
+        return false;
+    }
+    if (x->type != GGML_TYPE_F32 || x->ne[2] != 1 || x->ne[3] != 1 ||
+            x->nb[0] != ggml_type_size(x->type)) {
+        return false;
+    }
+    if (!ggml_is_contiguous(mul) || !ggml_are_same_shape(mul, x)) {
+        return false;
+    }
+    return true;
+}
+
 // try and fuse nodes and return the number of nodes to skip
 static int ggml_cuda_try_fuse(ggml_backend_cuda_context * cuda_ctx, ggml_cgraph * cgraph, int i) {
 
@@ -4336,6 +4602,10 @@ static void ggml_cuda_graph_evaluate_and_capture(ggml_backend_cuda_context * cud
             std::unordered_set<const ggml_tensor *> norm_grouped_done;
             static const bool disable_norm_group = getenv("GGML_CUDA_DISABLE_NORM_GROUP") != nullptr &&
                                                    std::atoi(getenv("GGML_CUDA_DISABLE_NORM_GROUP"));
+            static const bool disable_pre_add_norm = getenv("GGML_CUDA_DISABLE_PRE_ADD_NORM") != nullptr &&
+                                                   std::atoi(getenv("GGML_CUDA_DISABLE_PRE_ADD_NORM"));
+            static const bool disable_norm_quant = getenv("GGML_CUDA_DISABLE_NORM_QUANT") != nullptr &&
+                                                   std::atoi(getenv("GGML_CUDA_DISABLE_NORM_QUANT"));
             static const bool disable_mmvq_group = getenv("GGML_CUDA_DISABLE_MMVQ_GROUP") != nullptr &&
                                                    std::atoi(getenv("GGML_CUDA_DISABLE_MMVQ_GROUP"));
             const bool mmvq_group_enabled = !disable_mmvq_group && stream_ctx.concurrent_events.empty();
@@ -4416,6 +4686,39 @@ static void ggml_cuda_graph_evaluate_and_capture(ggml_backend_cuda_context * cud
                     }
                 }
 
+                if (!disable_norm_quant && stream_ctx.concurrent_events.empty() &&
+                        node->op == GGML_OP_RMS_NORM && ggml_cuda_norm_quant_plain_ok(cgraph, i)) {
+                    ggml_tensor * mul_node  = cgraph->nodes[i + 1];
+                    char *        q8_1_dst  = ggml_cuda_norm_quant_register(cuda_ctx, cgraph, i + 2, mul_node);
+                    if (q8_1_dst != nullptr) {
+                        ggml_cuda_op_rms_norm_fused_pre_add_quant(*cuda_ctx, nullptr, 0, node, mul_node, q8_1_dst);
+                        i += 1; // the rms_norm and its mul
+                        continue;
+                    }
+                }
+
+                if (!disable_pre_add_norm && stream_ctx.concurrent_events.empty() && node->op == GGML_OP_ADD) {
+                    const int n_adds = ggml_cuda_rms_norm_pre_add_detect(cgraph, i);
+                    if (n_adds > 0) {
+                        ggml_tensor * adds[RMS_NORM_ADD_MAX_OPERANDS];
+                        for (int k = 0; k < n_adds; ++k) {
+                            adds[k] = cgraph->nodes[i + k];
+                        }
+                        ggml_tensor * norm_node = cgraph->nodes[i + n_adds];
+                        ggml_tensor * mul_node   = cgraph->nodes[i + n_adds + 1];
+                        char * q8_1_dst = disable_norm_quant ? nullptr :
+                            ggml_cuda_norm_quant_register(cuda_ctx, cgraph, i + n_adds + 2, mul_node);
+                        if (q8_1_dst != nullptr) {
+                            ggml_cuda_op_rms_norm_fused_pre_add_quant(*cuda_ctx, adds, n_adds,
+                                norm_node, mul_node, q8_1_dst);
+                        } else {
+                            ggml_cuda_op_rms_norm_fused_pre_add(*cuda_ctx, adds, n_adds, norm_node, mul_node);
+                        }
+                        i += n_adds + 1; // the chain, the rms_norm and its mul
+                        continue;
+                    }
+                }
+
                 int nodes_to_skip = ggml_cuda_try_fuse(cuda_ctx, cgraph, i);
 
                 if (nodes_to_skip != 0) {
diff --git a/ggml/src/ggml-cuda/norm.cu b/ggml/src/ggml-cuda/norm.cu
index 5ca9606..fc0c65b 100644
--- a/ggml/src/ggml-cuda/norm.cu
+++ b/ggml/src/ggml-cuda/norm.cu
@@ -623,6 +623,348 @@ void ggml_cuda_op_rms_norm_grouped(ggml_backend_cuda_context & ctx,
     }
 }
 
+
+// ----- add-chain folded into the following rms_norm+mul ----------------------
+//
+// Every decoder layer feeds a residual add straight into the next rms_norm:
+//   ffn_inp = add(attn_out, inpSA);  cur = rms_norm(ffn_inp) * ffn_norm_w
+// and the layer output add feeds the next layer's attn_norm the same way. Stock
+// runs these as two dispatches - one k_bin_bcast (possibly an n-ary fused add)
+// and one rms_norm_f32<block_size, true>.
+//
+// Because the rms_norm block already covers a whole row, the same block can
+// produce that row's add result first and then normalise it. The add result is
+// still stored to the add's destination (other nodes consume it), and the norm
+// then reads back exactly the float values it would have read from memory, in
+// the same order, so results are byte-identical by construction:
+//
+//   - each operand is combined with a separate rounded float add, left to right
+//     in the same order as the k_bin_bcast fold (src0, then each add's src1);
+//   - the sum-of-squares loop, block_reduce, rsqrtf and output expression are
+//     the stock rms_norm_f32<block_size, true> ones, unchanged.
+
+struct rms_norm_pre_add_args {
+    const float * src[RMS_NORM_ADD_MAX_OPERANDS];
+    int64_t       stride_row[RMS_NORM_ADD_MAX_OPERANDS];
+};
+
+// When do_quant is set the kernel also writes the q8_1 quantization of its
+// output. That is bit-identical to the separate quantize_q8_1 launch it
+// replaces: the value quantized is the very float just stored to dst, each warp
+// covers exactly one 32-element q8_1 block (guaranteed by the caller's
+// ncols % block_size == 0 and block_size % 32 == 0 checks), and the amax/sum
+// warp reductions, d = amax/127.0f, q = roundf(xi/d) and the (d, sum) ds write
+// are the stock quantize_q8_1 ones.
+template <int block_size, int n_add, bool do_quant = false>
+static __global__ void rms_norm_pre_add_f32(const rms_norm_pre_add_args args,
+                                            float *        add_dst,
+                                            const int64_t  add_stride_row,
+                                            float *        dst,
+                                            const int      ncols,
+                                            const float    eps,
+                                            const float *  mul,
+                                            const int64_t  mul_stride_row,
+                                            const uint3    mul_ncols_packed,
+                                            const uint3    mul_nrows_packed,
+                                            void *         q8_1_dst = nullptr) {
+    ggml_cuda_pdl_lc();
+    const int row = blockIdx.x;
+    const int tid = threadIdx.x;
+
+    if constexpr (n_add > 1) {
+        add_dst += (int64_t) row * add_stride_row;
+    }
+    dst += (int64_t) row * ncols;
+
+    const uint32_t mul_row = fastmodulo((uint32_t) row, mul_nrows_packed);
+    mul += (int64_t) mul_row * mul_stride_row;
+
+    float tmp = 0.0f; // partial sum for thread in warp
+
+    ggml_cuda_pdl_sync();
+
+    // add chain: identical operand order and identical per-element rounding to
+    // the k_bin_bcast fold it replaces
+    for (int col = tid; col < ncols; col += block_size) {
+        float acc = args.src[0][(int64_t) row * args.stride_row[0] + col];
+#pragma unroll
+        for (int k = 1; k < n_add; ++k) {
+            acc = acc + args.src[k][(int64_t) row * args.stride_row[k] + col];
+        }
+        if constexpr (n_add > 1) {
+            add_dst[col] = acc;
+        }
+
+        const float xi = acc;
+        tmp += xi * xi;
+    }
+
+    // sum up partial sums
+    extern __shared__ float s_sum[];
+    tmp = block_reduce<block_reduce_method::SUM, block_size>(tmp, s_sum);
+
+    const float mean  = tmp / ncols;
+    const float scale = rsqrtf(mean + eps);
+
+    for (int col = tid; col < ncols; col += block_size) {
+        const int mul_col = fastmodulo(col, mul_ncols_packed);
+        const float x_col = (n_add > 1) ? add_dst[col]
+                                        : args.src[0][(int64_t) row * args.stride_row[0] + col];
+        const float val   = scale * x_col * mul[mul_col];
+        dst[col]          = val;
+
+        if constexpr (do_quant) {
+            // stock quantize_q8_1 body, on the value just written
+            block_q8_1 * y = (block_q8_1 *) q8_1_dst;
+
+            const int64_t i_cont = (int64_t) row * ncols + col;
+            const int64_t ib     = i_cont / QK8_1;
+            const int64_t iqs    = i_cont % QK8_1;
+
+            const float xq = val;
+            float amax = fabsf(xq);
+            float sum  = xq;
+
+            amax = warp_reduce_max<QK8_1>(amax);
+            sum  = warp_reduce_sum<QK8_1>(sum);
+
+            const float  d = amax / 127.0f;
+            const int8_t q = amax == 0.0f ? 0 : roundf(xq / d);
+
+            y[ib].qs[iqs] = q;
+
+            if (iqs == 0) {
+                y[ib].ds = make_half2(d, sum);
+            }
+        }
+    }
+}
+
+template <int n_add>
+static void rms_norm_pre_add_launch(const rms_norm_pre_add_args & args,
+                                    float * add_dst, int64_t add_stride_row,
+                                    float * dst, int ncols, int nrows, float eps,
+                                    const float * mul, int64_t mul_stride_row,
+                                    uint32_t mul_ncols, uint32_t mul_nrows,
+                                    cudaStream_t stream) {
+    const dim3 blocks_num(nrows, 1, 1);
+    const uint3 mul_ncols_packed = init_fastdiv_values(mul_ncols);
+    const uint3 mul_nrows_packed = init_fastdiv_values(mul_nrows);
+
+    if (ncols < 1024) {
+        const dim3 block_dims(256, 1, 1);
+        const ggml_cuda_kernel_launch_params launch_params =
+            ggml_cuda_kernel_launch_params{blocks_num, block_dims, block_dims.x > WARP_SIZE ? 32 * sizeof(float) : 0, stream};
+        ggml_cuda_kernel_launch(rms_norm_pre_add_f32<256, n_add, false>, launch_params,
+            args, add_dst, add_stride_row, dst, ncols, eps, mul, mul_stride_row, mul_ncols_packed, mul_nrows_packed,
+            (void *) nullptr);
+    } else {
+        const dim3 block_dims(1024, 1, 1);
+        const ggml_cuda_kernel_launch_params launch_params =
+            ggml_cuda_kernel_launch_params{blocks_num, block_dims, block_dims.x > WARP_SIZE ? 32 * sizeof(float) : 0, stream};
+        ggml_cuda_kernel_launch(rms_norm_pre_add_f32<1024, n_add, false>, launch_params,
+            args, add_dst, add_stride_row, dst, ncols, eps, mul, mul_stride_row, mul_ncols_packed, mul_nrows_packed,
+            (void *) nullptr);
+    }
+}
+
+template <int n_add>
+static void rms_norm_pre_add_quant_launch(const rms_norm_pre_add_args & args,
+                                          float * add_dst, int64_t add_stride_row,
+                                          float * dst, int ncols, int nrows, float eps,
+                                          const float * mul, int64_t mul_stride_row,
+                                          uint32_t mul_ncols, uint32_t mul_nrows,
+                                          void * q8_1_dst, cudaStream_t stream) {
+    const dim3 blocks_num(nrows, 1, 1);
+    const uint3 mul_ncols_packed = init_fastdiv_values(mul_ncols);
+    const uint3 mul_nrows_packed = init_fastdiv_values(mul_nrows);
+
+    if (ncols < 1024) {
+        const dim3 block_dims(256, 1, 1);
+        const ggml_cuda_kernel_launch_params launch_params =
+            ggml_cuda_kernel_launch_params{blocks_num, block_dims, block_dims.x > WARP_SIZE ? 32 * sizeof(float) : 0, stream};
+        ggml_cuda_kernel_launch(rms_norm_pre_add_f32<256, n_add, true>, launch_params,
+            args, add_dst, add_stride_row, dst, ncols, eps, mul, mul_stride_row,
+            mul_ncols_packed, mul_nrows_packed, q8_1_dst);
+    } else {
+        const dim3 block_dims(1024, 1, 1);
+        const ggml_cuda_kernel_launch_params launch_params =
+            ggml_cuda_kernel_launch_params{blocks_num, block_dims, block_dims.x > WARP_SIZE ? 32 * sizeof(float) : 0, stream};
+        ggml_cuda_kernel_launch(rms_norm_pre_add_f32<1024, n_add, true>, launch_params,
+            args, add_dst, add_stride_row, dst, ncols, eps, mul, mul_stride_row,
+            mul_ncols_packed, mul_nrows_packed, q8_1_dst);
+    }
+}
+
+// shared setup for the folded-add / folded-quantize rms_norm variants
+struct rms_norm_pre_add_setup {
+    rms_norm_pre_add_args args;
+    int      n_op;
+    int64_t  ncols;
+    int64_t  nrows;
+    float    eps;
+    float *  add_dst;
+    float *  dst;
+    int64_t  add_stride_row;
+    int64_t  mul_stride_row;
+    const float * mul_data;
+    uint32_t mul_ncols;
+    uint32_t mul_nrows;
+};
+
+static rms_norm_pre_add_setup rms_norm_pre_add_prepare(ggml_tensor * const * adds, int n_adds,
+                                                       ggml_tensor * norm, ggml_tensor * mul_tensor) {
+    rms_norm_pre_add_setup s = {};
+
+    const ggml_tensor * mul_src = nullptr;
+    if (mul_tensor->src[0] == norm) {
+        mul_src = mul_tensor->src[1];
+    } else if (mul_tensor->src[1] == norm) {
+        mul_src = mul_tensor->src[0];
+    } else {
+        GGML_ASSERT(false);
+    }
+
+    memcpy(&s.eps, norm->op_params, sizeof(float));
+    GGML_ASSERT(s.eps >= 0.0f);
+
+    int n_op = 0;
+    if (n_adds > 0) {
+        const ggml_tensor * s0 = adds[0]->src[0];
+        s.args.src[n_op]        = (const float *) s0->data;
+        s.args.stride_row[n_op] = s0->nb[1] / sizeof(float);
+        ++n_op;
+        for (int i = 0; i < n_adds; ++i) {
+            const ggml_tensor * s1 = adds[i]->src[1];
+            s.args.src[n_op]        = (const float *) s1->data;
+            s.args.stride_row[n_op] = s1->nb[1] / sizeof(float);
+            ++n_op;
+        }
+    } else {
+        const ggml_tensor * x = norm->src[0];
+        s.args.src[n_op]        = (const float *) x->data;
+        s.args.stride_row[n_op] = x->nb[1] / sizeof(float);
+        ++n_op;
+    }
+    for (int i = n_op; i < RMS_NORM_ADD_MAX_OPERANDS; ++i) {
+        s.args.src[i]        = s.args.src[0];
+        s.args.stride_row[i] = s.args.stride_row[0];
+    }
+
+    const ggml_tensor * ref = n_adds > 0 ? adds[n_adds - 1] : norm->src[0];
+
+    s.n_op           = n_op;
+    s.ncols          = ref->ne[0];
+    s.nrows          = ref->ne[1];
+    s.add_dst        = n_adds > 0 ? (float *) adds[n_adds - 1]->data : nullptr;
+    s.dst            = (float *) mul_tensor->data;
+    s.add_stride_row = n_adds > 0 ? (int64_t) (adds[n_adds - 1]->nb[1] / sizeof(float)) : 0;
+    s.mul_stride_row = mul_src->nb[1] / sizeof(float);
+    s.mul_data       = (const float *) mul_src->data;
+    s.mul_ncols      = (uint32_t) mul_src->ne[0];
+    s.mul_nrows      = (uint32_t) mul_src->ne[1];
+    return s;
+}
+
+void ggml_cuda_op_rms_norm_fused_pre_add_quant(ggml_backend_cuda_context & ctx,
+                                               ggml_tensor * const * adds, int n_adds,
+                                               ggml_tensor * norm, ggml_tensor * mul_tensor,
+                                               char * q8_1_dst) {
+    GGML_ASSERT(n_adds >= 0 && n_adds <= RMS_NORM_ADD_MAX_OPERANDS - 1);
+    GGML_ASSERT(q8_1_dst != nullptr);
+
+    cudaStream_t stream = ctx.stream();
+    rms_norm_pre_add_setup s = rms_norm_pre_add_prepare(adds, n_adds, norm, mul_tensor);
+
+    switch (s.n_op) {
+#define RMS_NORM_PRE_ADD_QUANT_CASE(N) \
+        case N: rms_norm_pre_add_quant_launch<N>(s.args, s.add_dst, s.add_stride_row, s.dst, \
+                    (int) s.ncols, (int) s.nrows, s.eps, s.mul_data, s.mul_stride_row, \
+                    s.mul_ncols, s.mul_nrows, q8_1_dst, stream); break;
+        RMS_NORM_PRE_ADD_QUANT_CASE(1)
+        RMS_NORM_PRE_ADD_QUANT_CASE(2)
+        RMS_NORM_PRE_ADD_QUANT_CASE(3)
+        RMS_NORM_PRE_ADD_QUANT_CASE(4)
+        RMS_NORM_PRE_ADD_QUANT_CASE(5)
+        RMS_NORM_PRE_ADD_QUANT_CASE(6)
+        RMS_NORM_PRE_ADD_QUANT_CASE(7)
+        RMS_NORM_PRE_ADD_QUANT_CASE(8)
+#undef RMS_NORM_PRE_ADD_QUANT_CASE
+        default: GGML_ABORT("fatal error");
+    }
+}
+
+void ggml_cuda_op_rms_norm_fused_pre_add(ggml_backend_cuda_context & ctx,
+                                         ggml_tensor * const * adds, int n_adds,
+                                         ggml_tensor * norm, ggml_tensor * mul_tensor) {
+    GGML_ASSERT(n_adds >= 1 && n_adds <= RMS_NORM_ADD_MAX_OPERANDS - 1);
+
+    cudaStream_t stream = ctx.stream();
+
+    ggml_tensor * add_last = adds[n_adds - 1];
+
+    const ggml_tensor * mul_src = nullptr;
+    if (mul_tensor->src[0] == norm) {
+        mul_src = mul_tensor->src[1];
+    } else if (mul_tensor->src[1] == norm) {
+        mul_src = mul_tensor->src[0];
+    } else {
+        GGML_ASSERT(false);
+    }
+
+    float eps = 0.0f;
+    memcpy(&eps, norm->op_params, sizeof(float));
+    GGML_ASSERT(eps >= 0.0f);
+
+    // operand order of the k_bin_bcast fold: src0 of the first add, then the
+    // right operand of each add in the chain
+    rms_norm_pre_add_args args = {};
+    int n_op = 0;
+    {
+        const ggml_tensor * s0 = adds[0]->src[0];
+        args.src[n_op]        = (const float *) s0->data;
+        args.stride_row[n_op] = s0->nb[1] / sizeof(float);
+        ++n_op;
+    }
+    for (int i = 0; i < n_adds; ++i) {
+        const ggml_tensor * s1 = adds[i]->src[1];
+        args.src[n_op]        = (const float *) s1->data;
+        args.stride_row[n_op] = s1->nb[1] / sizeof(float);
+        ++n_op;
+    }
+    for (int i = n_op; i < RMS_NORM_ADD_MAX_OPERANDS; ++i) {
+        args.src[i]        = args.src[0];
+        args.stride_row[i] = args.stride_row[0];
+    }
+
+    const int64_t ncols = add_last->ne[0];
+    const int64_t nrows = add_last->ne[1];
+
+    float * add_dst = (float *) add_last->data;
+    float * dst     = (float *) mul_tensor->data;
+
+    const int64_t add_stride_row = add_last->nb[1] / sizeof(float);
+    const int64_t mul_stride_row = mul_src->nb[1] / sizeof(float);
+
+    switch (n_op) {
+        case 2: rms_norm_pre_add_launch<2>(args, add_dst, add_stride_row, dst, (int) ncols, (int) nrows, eps,
+                    (const float *) mul_src->data, mul_stride_row, (uint32_t) mul_src->ne[0], (uint32_t) mul_src->ne[1], stream); break;
+        case 3: rms_norm_pre_add_launch<3>(args, add_dst, add_stride_row, dst, (int) ncols, (int) nrows, eps,
+                    (const float *) mul_src->data, mul_stride_row, (uint32_t) mul_src->ne[0], (uint32_t) mul_src->ne[1], stream); break;
+        case 4: rms_norm_pre_add_launch<4>(args, add_dst, add_stride_row, dst, (int) ncols, (int) nrows, eps,
+                    (const float *) mul_src->data, mul_stride_row, (uint32_t) mul_src->ne[0], (uint32_t) mul_src->ne[1], stream); break;
+        case 5: rms_norm_pre_add_launch<5>(args, add_dst, add_stride_row, dst, (int) ncols, (int) nrows, eps,
+                    (const float *) mul_src->data, mul_stride_row, (uint32_t) mul_src->ne[0], (uint32_t) mul_src->ne[1], stream); break;
+        case 6: rms_norm_pre_add_launch<6>(args, add_dst, add_stride_row, dst, (int) ncols, (int) nrows, eps,
+                    (const float *) mul_src->data, mul_stride_row, (uint32_t) mul_src->ne[0], (uint32_t) mul_src->ne[1], stream); break;
+        case 7: rms_norm_pre_add_launch<7>(args, add_dst, add_stride_row, dst, (int) ncols, (int) nrows, eps,
+                    (const float *) mul_src->data, mul_stride_row, (uint32_t) mul_src->ne[0], (uint32_t) mul_src->ne[1], stream); break;
+        case 8: rms_norm_pre_add_launch<8>(args, add_dst, add_stride_row, dst, (int) ncols, (int) nrows, eps,
+                    (const float *) mul_src->data, mul_stride_row, (uint32_t) mul_src->ne[0], (uint32_t) mul_src->ne[1], stream); break;
+        default: GGML_ABORT("fatal error");
+    }
+}
