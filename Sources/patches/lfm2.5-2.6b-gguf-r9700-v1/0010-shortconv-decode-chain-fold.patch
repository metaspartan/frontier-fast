+    int g_stride     = 0;
+    int state_stride = 0;
+    int w_stride     = 0;
+    int dst_stride   = 0;
+    int cache_stride = 0;
+
+    int n_ch = 0;
+    int nc   = 0;
+
+    ggml_tensor * folded[4] = { nullptr, nullptr, nullptr, nullptr };  // concat, cpy, conv, mul_gate
+};
