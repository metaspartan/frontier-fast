From 066268efe7d44e4cf5ccfa3aa8e740aded1e1c6f Mon Sep 17 00:00:00 2001
From: Cybara <carsenk@gmail.com>
Date: Wed, 5 Aug 2026 00:20:36 -0600
Subject: [PATCH] CUDA/HIP: fuse LFM shortconv ssm_conv with following
 elementwise mul

LFM shortconv is ssm_conv then mul(c, conv_out) with no silu. Stock only fuses
ssm_conv+silu (Mamba), so LFM paid a separate mul launch per shortconv layer
(~10 of 16 layers).

Fuse the gate mul into ssm_conv with gate strides (channel*nb0 + token*nb1 +
seq*nb2). can_fuse uses empty unary list. Kill switch: GGML_CUDA_DISABLE_SSM_MUL=1.
---
 ggml/src/ggml-cuda/ggml-cuda.cu | 31 ++++++++++++++
 ggml/src/ggml-cuda/ssm-conv.cu  | 75 +++++++++++++++++++++++++--------
 ggml/src/ggml-cuda/ssm-conv.cuh |  5 ++-
 3 files changed, 92 insertions(+), 19 deletions(-)

diff --git a/ggml/src/ggml-cuda/ggml-cuda.cu b/ggml/src/ggml-cuda/ggml-cuda.cu
index f41f276..eb501d2 100644
--- a/ggml/src/ggml-cuda/ggml-cuda.cu
+++ b/ggml/src/ggml-cuda/ggml-cuda.cu
@@ -3079,6 +3079,28 @@ static bool ggml_cuda_can_fuse(const struct ggml_cgraph *                cgraph,
         return true;
     }
 
+
+    // LFM shortconv: ssm_conv then elementwise mul by the c-gate (no silu).
+    if (ops.size() == 2 && ops.begin()[0] == GGML_OP_SSM_CONV && ops.begin()[1] == GGML_OP_MUL) {
+        const ggml_tensor * ssm_conv = cgraph->nodes[node_idx];
+        const ggml_tensor * mul      = cgraph->nodes[node_idx+1];
+
+        if (ssm_conv->type != GGML_TYPE_F32 || mul->type != GGML_TYPE_F32) {
+            return false;
+        }
+        if (!ggml_are_same_shape(ssm_conv, mul)) {
+            return false;
+        }
+        if (mul->src[0] != ssm_conv && mul->src[1] != ssm_conv) {
+            return false;
+        }
+        const ggml_tensor * gate = (mul->src[0] == ssm_conv) ? mul->src[1] : mul->src[0];
+        if (gate->type != GGML_TYPE_F32 || !ggml_are_same_shape(gate, mul)) {
+            return false;
+        }
+        return true;
+    }
+
     if (ops.size() == 2 && ops.begin()[0] == GGML_OP_UNARY && ops.begin()[1] == GGML_OP_MUL
      && unary_ops.size() == 1 && (unary_ops.begin()[0] == GGML_UNARY_OP_SILU || unary_ops.begin()[0] == GGML_UNARY_OP_SIGMOID || unary_ops.begin()[0] == GGML_UNARY_OP_SOFTPLUS)) {
         const ggml_tensor * unary = cgraph->nodes[node_idx];
@@ -4473,6 +4495,15 @@ static int ggml_cuda_try_fuse(ggml_backend_cuda_context * cuda_ctx, ggml_cgraph
         return 2;
     }
 
+    if (ggml_cuda_can_fuse(cgraph, i, { GGML_OP_SSM_CONV, GGML_OP_MUL }, {})) {
+        static const bool disable_ssm_mul = getenv("GGML_CUDA_DISABLE_SSM_MUL") != nullptr &&
+                                            std::atoi(getenv("GGML_CUDA_DISABLE_SSM_MUL"));
+        if (!disable_ssm_mul) {
+            ggml_cuda_op_ssm_conv(*cuda_ctx, node, /*bias_add_node=*/ nullptr, /*silu_dst=*/ nullptr, cgraph->nodes[i + 1]);
+            return 1;
+        }
+    }
+
     if (ggml_cuda_can_fuse(cgraph, i, { GGML_OP_SSM_CONV, GGML_OP_UNARY }, { GGML_UNARY_OP_SILU })) {
         ggml_cuda_op_ssm_conv(*cuda_ctx, node, /*bias_add_node=*/ nullptr, cgraph->nodes[i + 1]);
         return 1;
diff --git a/ggml/src/ggml-cuda/ssm-conv.cu b/ggml/src/ggml-cuda/ssm-conv.cu
index 1463169..549d99c 100644
--- a/ggml/src/ggml-cuda/ssm-conv.cu
+++ b/ggml/src/ggml-cuda/ssm-conv.cu
@@ -4,14 +4,16 @@
 
 template <bool apply_silu, size_t split_d_inner, size_t d_conv>
 static __global__ void ssm_conv_f32(const float * src0_ptr, const float * src1_ptr,
-                                    const float * bias_ptr,
+                                    const float * bias_ptr, const float * gate_ptr,
                                     const int src0_nb0, const int src0_nb1, const int src0_nb2, const int src1_nb1,
                                     float * dst_ptr, const int dst_nb0, const int dst_nb1, const int dst_nb2,
+                                    const int gate_nb0, const int gate_nb1, const int gate_nb2,
                                     const int64_t n_t) {
     ggml_cuda_pdl_lc();
     const float * GGML_CUDA_RESTRICT src0 = src0_ptr;
     const float * GGML_CUDA_RESTRICT src1 = src1_ptr;
     const float * GGML_CUDA_RESTRICT bias = bias_ptr;
+    const float * GGML_CUDA_RESTRICT gate = gate_ptr;
     float       * GGML_CUDA_RESTRICT dst  = dst_ptr;
     GGML_UNUSED(src0_nb0);
     const int tid  = threadIdx.x;
@@ -53,16 +55,27 @@ static __global__ void ssm_conv_f32(const float * src0_ptr, const float * src1_p
             sumf += x[(i + j) % d_conv] * w[j];
         }
         sumf += b;
-        y_block[i * stride_y + tid] = apply_silu ? ggml_cuda_op_silu_single(sumf) : sumf;
+        float outv = apply_silu ? ggml_cuda_op_silu_single(sumf) : sumf;
+        if (gate != nullptr) {
+            // gate element [tid_channel, token i, seq bidx] with gate's own strides
+            // ggml layout: offset = i0*nb0 + i1*nb1 + i2*nb2; i0=channel, i1=token, i2=seq
+            const int ch = bidy * (int) split_d_inner + tid;
+            const float * g_row = (const float *) ((const char *) gate
+                + ch * gate_nb0 + i * gate_nb1 + bidx * gate_nb2);
+            outv *= g_row[0];
+        }
+        y_block[i * stride_y + tid] = outv;
     }
 }
 
 template <bool apply_silu, size_t split_d_inner, size_t d_conv, int64_t split_n_t>
 static __global__ void ssm_conv_long_token_f32(const float * __restrict__ src0, const float * __restrict__ src1,
-                                               const float * __restrict__ bias,
+                                               const float * __restrict__ bias, const float * __restrict__ gate,
                                                const int src0_nb0, const int src0_nb1, const int src0_nb2,
                                                const int src1_nb1, float * __restrict__ dst, const int dst_nb0,
-                                               const int dst_nb1, const int dst_nb2, const int64_t n_t) {
+                                               const int dst_nb1, const int dst_nb2,
+                                               const int gate_nb0, const int gate_nb1, const int gate_nb2,
+                                               const int64_t n_t) {
     const int tid  = threadIdx.x;
     const int bidx = blockIdx.x;
     const int bidy = blockIdx.y;
@@ -119,14 +132,23 @@ static __global__ void ssm_conv_long_token_f32(const float * __restrict__ src0,
             sumf += smem[tid * n_cols + i + j] * w[j];
         }
         sumf += b;
-        y_block[i * stride_y + tid] = apply_silu ? ggml_cuda_op_silu_single(sumf) : sumf;
+        float outv = apply_silu ? ggml_cuda_op_silu_single(sumf) : sumf;
+        if (gate != nullptr) {
+            const int64_t tok = bidz * split_n_t + i;
+            const int ch = bidy * (int) split_d_inner + tid;
+            const float * g_row = (const float *) ((const char *) gate
+                + ch * gate_nb0 + tok * gate_nb1 + bidx * gate_nb2);
+            outv *= g_row[0];
+        }
+        y_block[i * stride_y + tid] = outv;
     }
 }
 
 template <bool apply_silu>
-static void ssm_conv_f32_cuda(const float * src0, const float * src1, const float * bias, const int src0_nb0, const int src0_nb1,
+static void ssm_conv_f32_cuda(const float * src0, const float * src1, const float * bias, const float * gate, const int src0_nb0, const int src0_nb1,
                               const int src0_nb2, const int src1_nb1, float * dst, const int dst_nb0, const int dst_nb1,
-                              const int dst_nb2, const int64_t nc, const int64_t nr, const int64_t n_t,
+                              const int dst_nb2, const int gate_nb0, const int gate_nb1, const int gate_nb2,
+                              const int64_t nc, const int64_t nr, const int64_t n_t,
                               const int64_t n_s, cudaStream_t stream) {
     const int threads = 128;
     GGML_ASSERT(nr % threads == 0);
@@ -136,14 +158,14 @@ static void ssm_conv_f32_cuda(const float * src0, const float * src1, const floa
         if (n_t <= 32) {
             const dim3 blocks(n_s, (nr + threads - 1) / threads, 1);
             const ggml_cuda_kernel_launch_params launch_params = ggml_cuda_kernel_launch_params(blocks, threads, 0, stream);
-            ggml_cuda_kernel_launch(ssm_conv_f32<apply_silu, threads, kNC>, launch_params, src0, src1, bias, src0_nb0, src0_nb1,
-                                                                        src0_nb2, src1_nb1, dst, dst_nb0, dst_nb1, dst_nb2, n_t);
+            ggml_cuda_kernel_launch(ssm_conv_f32<apply_silu, threads, kNC>, launch_params, src0, src1, bias, gate, src0_nb0, src0_nb1,
+                                                                        src0_nb2, src1_nb1, dst, dst_nb0, dst_nb1, dst_nb2, gate_nb0, gate_nb1, gate_nb2, n_t);
         } else {
             const int64_t split_n_t = 32;
             dim3          blocks(n_s, (nr + threads - 1) / threads, (n_t + split_n_t - 1) / split_n_t);
             const size_t  smem_size = threads * (kNC - 1 + split_n_t) * sizeof(float);
             ssm_conv_long_token_f32<apply_silu, threads, kNC, split_n_t><<<blocks, threads, smem_size, stream>>>(
-                src0, src1, bias, src0_nb0, src0_nb1, src0_nb2, src1_nb1, dst, dst_nb0, dst_nb1, dst_nb2, n_t);
+                src0, src1, bias, gate, src0_nb0, src0_nb1, src0_nb2, src1_nb1, dst, dst_nb0, dst_nb1, dst_nb2, gate_nb0, gate_nb1, gate_nb2, n_t);
         }
     };
 
@@ -157,20 +179,32 @@ static void ssm_conv_f32_cuda(const float * src0, const float * src1, const floa
     }
 }
 
-void ggml_cuda_op_ssm_conv(ggml_backend_cuda_context & ctx, ggml_tensor * dst, ggml_tensor * bias_add_node, ggml_tensor * silu_dst) {
+void ggml_cuda_op_ssm_conv(ggml_backend_cuda_context & ctx, ggml_tensor * dst, ggml_tensor * bias_add_node, ggml_tensor * silu_dst, ggml_tensor * mul_dst) {
     const struct ggml_tensor * src0 = dst->src[0];  // conv_x
     const struct ggml_tensor * src1 = dst->src[1];  // conv1d.weight
     const bool fuse_bias = bias_add_node != nullptr;
     const bool fuse_silu = silu_dst != nullptr;
+    const bool fuse_mul  = mul_dst != nullptr;
 
-    // bias always comes with silu.
+    // bias always comes with silu (Mamba path).
     GGML_ASSERT(!fuse_bias || fuse_silu);
+    // LFM shortconv fuses mul without silu; Mamba fuses silu without mul.
+    GGML_ASSERT(!(fuse_mul && fuse_silu));
 
     // The bias (when fused) is the non-conv operand of the ADD node.
     const struct ggml_tensor * bias = fuse_bias ? (bias_add_node->src[0] == dst ? bias_add_node->src[1] : bias_add_node->src[0]) : nullptr;
 
-    // When fusing, write to silu_dst (the node downstream references).
-    const struct ggml_tensor * out = fuse_silu ? silu_dst : dst;
+    // Gate for LFM shortconv: non-conv operand of MUL. May be a non-contiguous view.
+    const struct ggml_tensor * gate = nullptr;
+    if (fuse_mul) {
+        gate = (mul_dst->src[0] == dst) ? mul_dst->src[1] : mul_dst->src[0];
+        GGML_ASSERT(gate->type == GGML_TYPE_F32);
+        GGML_ASSERT(ggml_are_same_shape(gate, mul_dst));
+        GGML_ASSERT(ggml_are_same_shape(dst, mul_dst));
+    }
+
+    // When fusing, write to the downstream node consumers reference.
+    const struct ggml_tensor * out = fuse_mul ? mul_dst : (fuse_silu ? silu_dst : dst);
 
     const int64_t nc  = src1->ne[0];                // d_conv
     const int64_t nr  = src0->ne[1];                // d_inner
@@ -196,11 +230,16 @@ void ggml_cuda_op_ssm_conv(ggml_backend_cuda_context & ctx, ggml_tensor * dst, g
         GGML_ASSERT(ggml_nelements(bias) == nr);
     }
 
+    const float * gate_d = fuse_mul ? (const float *) gate->data : nullptr;
+    const int gate_nb0 = fuse_mul ? (int) gate->nb[0] : 0;
+    const int gate_nb1 = fuse_mul ? (int) gate->nb[1] : 0;
+    const int gate_nb2 = fuse_mul ? (int) gate->nb[2] : 0;
+
     if (fuse_silu) {
-        ssm_conv_f32_cuda<true>(src0_d, src1_d, bias_d, src0->nb[0], src0->nb[1], src0->nb[2], src1->nb[1], dst_d, out->nb[0], out->nb[1],
-                          out->nb[2], nc, nr, n_t, n_s, stream);
+        ssm_conv_f32_cuda<true>(src0_d, src1_d, bias_d, gate_d, src0->nb[0], src0->nb[1], src0->nb[2], src1->nb[1], dst_d, out->nb[0], out->nb[1],
+                          out->nb[2], gate_nb0, gate_nb1, gate_nb2, nc, nr, n_t, n_s, stream);
     } else {
-        ssm_conv_f32_cuda<false>(src0_d, src1_d, bias_d, src0->nb[0], src0->nb[1], src0->nb[2], src1->nb[1], dst_d, out->nb[0], out->nb[1],
-                          out->nb[2], nc, nr, n_t, n_s, stream);
+        ssm_conv_f32_cuda<false>(src0_d, src1_d, bias_d, gate_d, src0->nb[0], src0->nb[1], src0->nb[2], src1->nb[1], dst_d, out->nb[0], out->nb[1],
+                          out->nb[2], gate_nb0, gate_nb1, gate_nb2, nc, nr, n_t, n_s, stream);
     }
 }
diff --git a/ggml/src/ggml-cuda/ssm-conv.cuh b/ggml/src/ggml-cuda/ssm-conv.cuh
index 8514ca8..7d54915 100644
--- a/ggml/src/ggml-cuda/ssm-conv.cuh
+++ b/ggml/src/ggml-cuda/ssm-conv.cuh
@@ -1,3 +1,6 @@
 #include "common.cuh"
 
-void ggml_cuda_op_ssm_conv(ggml_backend_cuda_context & ctx, ggml_tensor * dst, ggml_tensor * bias_add_node = nullptr, ggml_tensor * silu_dst = nullptr);
+void ggml_cuda_op_ssm_conv(ggml_backend_cuda_context & ctx, ggml_tensor * dst,
+                           ggml_tensor * bias_add_node = nullptr,
+                           ggml_tensor * silu_dst = nullptr,
+                           ggml_tensor * mul_dst = nullptr);
-- 
