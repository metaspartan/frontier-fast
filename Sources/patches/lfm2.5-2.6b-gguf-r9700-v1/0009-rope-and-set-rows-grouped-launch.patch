--- a/ggml/src/ggml-cuda/set-rows.cu
+++ b/ggml/src/ggml-cuda/set-rows.cu
@@ -373,6 +373,98 @@ void set_rows_cuda<half, int64_t>(ggml_backend_cuda_context & ctx, const ggml_te
 }
 
 
+
+// ----- grouped set_rows launch: the K and V cache stores in one kernel -------
+//
+// A decode step stores one new K row and one new V row into the KV cache with
+// two separate set_rows launches over disjoint tensors. Each element of each op
+// is independent, so the element ranges of several such ops can be
+// concatenated into ONE grid: a thread first routes itself to its segment
+// (src / idx / dst base pointer and row stride - all integer work), then
+// performs exactly the read, cast and store of the individual
+// k_set_rows<float, int64_t, half> launch it replaces.
+//
+// Only the single-row case (ne01 == ne02 == ne03 == 1) is provided, which is
+// the shape the graph-side detector groups; there the stock index
+// decomposition reduces to i00 = i, i01 = i02 = i03 = 0, so the destination row
+// is src1[0] exactly as in stock.
+
+struct set_rows_grouped_args {
+    const float *   src0[SET_ROWS_MAX_GROUP_SIZE];
+    const int64_t * src1[SET_ROWS_MAX_GROUP_SIZE];
+    half *          dst[SET_ROWS_MAX_GROUP_SIZE];
+    int64_t         s1[SET_ROWS_MAX_GROUP_SIZE];
+    // exclusive prefix sums of per-segment element counts; entries past the
+    // actual group size are padded with the total so the scan ignores them
+    uint32_t        seg_end[SET_ROWS_MAX_GROUP_SIZE];
+};
+
+static __global__ void k_set_rows_grouped(const set_rows_grouped_args args, const int64_t ne_total) {
+    const int64_t i = int64_t(blockDim.x) * blockIdx.x + threadIdx.x;
+
+    if (i >= ne_total) {
+        return;
+    }
+
+    uint32_t seg       = 0;
+    uint32_t seg_start = 0;
+#pragma unroll
+    for (int s = 0; s < SET_ROWS_MAX_GROUP_SIZE - 1; ++s) {
+        if ((uint32_t) i >= args.seg_end[s]) {
+            seg       = s + 1;
+            seg_start = args.seg_end[s];
+        }
+    }
+
+    const int64_t i00 = i - (int64_t) seg_start;
+
+    ggml_cuda_pdl_sync();
+    const int64_t dst_row = args.src1[seg][0];
+    ggml_cuda_pdl_lc();
+
+    const float * src0_row    = args.src0[seg];
+    half *        dst_row_ptr = args.dst[seg] + dst_row * args.s1[seg];
+
+    dst_row_ptr[i00] = ggml_cuda_cast<half>(src0_row[i00]);
+}
+
+void ggml_cuda_op_set_rows_grouped(ggml_backend_cuda_context & ctx, ggml_tensor * const * nodes, int n_nodes) {
+    GGML_ASSERT(n_nodes >= 2 && n_nodes <= SET_ROWS_MAX_GROUP_SIZE);
+
+    cudaStream_t stream = ctx.stream();
+
+    set_rows_grouped_args args = {};
+    uint32_t total = 0;
+
+    for (int m = 0; m < n_nodes; ++m) {
+        const ggml_tensor * dst  = nodes[m];
+        const ggml_tensor * src0 = dst->src[0];
+        const ggml_tensor * src1 = dst->src[1];
+
+        GGML_ASSERT(dst->op == GGML_OP_SET_ROWS);
+        GGML_ASSERT(src0->type == GGML_TYPE_F32 && src1->type == GGML_TYPE_I64 && dst->type == GGML_TYPE_F16);
+        GGML_ASSERT(src0->ne[1] == 1 && src0->ne[2] == 1 && src0->ne[3] == 1);
+        GGML_ASSERT(src0->nb[0] == sizeof(float) && dst->nb[0] == sizeof(half));
+
+        args.src0[m]  = (const float *) src0->data;
+        args.src1[m]  = (const int64_t *) src1->data;
+        args.dst[m]   = (half *) dst->data;
+        args.s1[m]    = dst->nb[1] / sizeof(half);
+        total        += (uint32_t) src0->ne[0];
+        args.seg_end[m] = total;
+    }
+    for (int m = n_nodes; m < SET_ROWS_MAX_GROUP_SIZE; ++m) {
+        args.seg_end[m] = total; // padding: the segment scan never selects these
+    }
+
+    const int  num_blocks = ((int) total + CUDA_SET_ROWS_BLOCK_SIZE - 1) / CUDA_SET_ROWS_BLOCK_SIZE;
+    const dim3 block_size(CUDA_SET_ROWS_BLOCK_SIZE);
+    const dim3 grid_size(num_blocks);
+
+    const ggml_cuda_kernel_launch_params launch_params = ggml_cuda_kernel_launch_params(grid_size, block_size, 0, stream);
+    ggml_cuda_kernel_launch(k_set_rows_grouped, launch_params, args, (int64_t) total);
+}
