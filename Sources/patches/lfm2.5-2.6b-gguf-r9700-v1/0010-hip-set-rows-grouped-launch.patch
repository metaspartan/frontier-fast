diff --git a/ggml/src/ggml-cuda/set-rows.cu b/ggml/src/ggml-cuda/set-rows.cu
index 465997065..d2eb0ddbd 100644
--- a/ggml/src/ggml-cuda/set-rows.cu
+++ b/ggml/src/ggml-cuda/set-rows.cu
@@ -373,6 +373,53 @@ void set_rows_cuda<half, int64_t>(ggml_backend_cuda_context & ctx, const ggml_te
 }
 
 
+
+struct set_rows_grouped_args {
+    const float   * src0[SET_ROWS_MAX_GROUP_SIZE];
+    const int64_t * src1[SET_ROWS_MAX_GROUP_SIZE];
+    half          * dst[SET_ROWS_MAX_GROUP_SIZE];
+    int64_t         s1[SET_ROWS_MAX_GROUP_SIZE];
+    int64_t         ne00[SET_ROWS_MAX_GROUP_SIZE];
+    uint32_t        seg_end[SET_ROWS_MAX_GROUP_SIZE];
+};
+static __global__ void k_set_rows_grouped_f32_f16(const set_rows_grouped_args args, const int64_t ne_total) {
+    const int64_t i = int64_t(blockDim.x) * blockIdx.x + threadIdx.x;
+    if (i >= ne_total) { return; }
+    uint32_t seg = 0, seg_start = 0;
+    #pragma unroll
+    for (int s = 0; s < SET_ROWS_MAX_GROUP_SIZE - 1; ++s) {
+        if ((uint32_t) i >= args.seg_end[s]) { seg = s + 1; seg_start = args.seg_end[s]; }
+    }
+    const int64_t local = i - (int64_t) seg_start;
+    if (local >= args.ne00[seg]) { return; }
+    ggml_cuda_pdl_sync();
+    const int64_t dst_row = args.src1[seg][0];
+    ggml_cuda_pdl_lc();
+    args.dst[seg][dst_row * args.s1[seg] + local] = ggml_cuda_cast<half>(args.src0[seg][local]);
+}
+void ggml_cuda_op_set_rows_grouped(ggml_backend_cuda_context & ctx, ggml_tensor * const * nodes, int n_nodes) {
+    GGML_ASSERT(n_nodes >= 2 && n_nodes <= SET_ROWS_MAX_GROUP_SIZE);
+    set_rows_grouped_args args = {};
+    uint32_t total = 0;
+    for (int m = 0; m < n_nodes; ++m) {
+        const ggml_tensor * src0 = nodes[m]->src[0];
+        const ggml_tensor * src1 = nodes[m]->src[1];
+        GGML_ASSERT(src0->type == GGML_TYPE_F32 && src1->type == GGML_TYPE_I64 && nodes[m]->type == GGML_TYPE_F16);
+        GGML_ASSERT(src0->ne[1] == 1 && src0->ne[2] == 1 && src0->ne[3] == 1);
+        GGML_ASSERT(ggml_is_contiguous(src0));
+        args.src0[m] = (const float *) src0->data;
+        args.src1[m] = (const int64_t *) src1->data;
+        args.dst[m]  = (half *) nodes[m]->data;
+        args.s1[m]   = nodes[m]->nb[1] / sizeof(half);
+        args.ne00[m] = src0->ne[0];
+        total += (uint32_t) src0->ne[0];
+        args.seg_end[m] = total;
+    }
+    for (int m = n_nodes; m < SET_ROWS_MAX_GROUP_SIZE; ++m) { args.seg_end[m] = total; }
+    const int num_blocks = (int((total + CUDA_SET_ROWS_BLOCK_SIZE - 1) / CUDA_SET_ROWS_BLOCK_SIZE));
+    const ggml_cuda_kernel_launch_params launch_params(dim3(num_blocks), dim3(CUDA_SET_ROWS_BLOCK_SIZE), 0, ctx.stream());
+    ggml_cuda_kernel_launch(k_set_rows_grouped_f32_f16, launch_params, args, (int64_t) total);
+}
 void ggml_cuda_op_set_rows(ggml_backend_cuda_context & ctx, ggml_tensor * dst) {
     const ggml_tensor * src0 = dst->src[0];
     const ggml_tensor * src1 = dst->src[1];
