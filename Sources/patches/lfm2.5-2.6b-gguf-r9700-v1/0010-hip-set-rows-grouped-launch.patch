+            seg_start = args.seg_end[s];
+        }
+    }
+    const int64_t local = i - (int64_t) seg_start;
+    if (local >= args.ne00[seg]) {
+        return;
+    }
+    ggml_cuda_pdl_sync();
+    const int64_t dst_row = args.src1[seg][0];
+    ggml_cuda_pdl_lc();
+    args.dst[seg][dst_row * args.s1[seg] + local] = ggml_cuda_cast<half>(args.src0[seg][local]);
+}
+
+void ggml_cuda_op_set_rows_grouped(ggml_backend_cuda_context & ctx, ggml_tensor * const * nodes, int n_nodes) {
+    GGML_ASSERT(n_nodes >= 2 && n_nodes <= SET_ROWS_MAX_GROUP_SIZE);
+    set_rows_grouped_args args = {};
+    uint32_t total = 0;
+    for (int m = 0; m < n_nodes; ++m) {
+        const ggml_tensor * src0 = nodes[m]->src[0];
+        const ggml_tensor * src1 = nodes[m]->src[1];
+        GGML_ASSERT(src0->type == GGML_TYPE_F32 && src1->type == GGML_TYPE_I64 && nodes[m]->type == GGML_TYPE_F16);
+        GGML_ASSERT(src0->ne[1] == 1 && src0->ne[2] == 1 && src0->ne[3] == 1);
+        GGML_ASSERT(ggml_is_contiguous(src0));
+        args.src0[m] = (const float *) src0->data;
+        args.src1[m] = (const int64_t *) src1->data;
+        args.dst[m]  = (half *) nodes[m]->data;
+        args.s1[m]   = nodes[m]->nb[1] / sizeof(half);
+        args.ne00[m] = src0->ne[0];
+        total += (uint32_t) src0->ne[0];
+        args.seg_end[m] = total;
+    }
+    for (int m = n_nodes; m < SET_ROWS_MAX_GROUP_SIZE; ++m) {
+        args.seg_end[m] = total;
+    }
+    const int num_blocks = (int((total + CUDA_SET_ROWS_BLOCK_SIZE - 1) / CUDA_SET_ROWS_BLOCK_SIZE));
+    const ggml_cuda_kernel_launch_params launch_params(
+        dim3(num_blocks), dim3(CUDA_SET_ROWS_BLOCK_SIZE), 0, ctx.stream());
+    ggml_cuda_kernel_launch(k_set_rows_grouped_f32_f16, launch_params, args, (int64_t) total);
+}
