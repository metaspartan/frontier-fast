+// ----- grouped set_rows (KV-cache K/V store) launch detection -----------------
+static bool ggml_cuda_set_rows_groupable(const ggml_cgraph * cgraph, const int i) {
+    const ggml_tensor * node = cgraph->nodes[i];
+    if (node->op != GGML_OP_SET_ROWS) {
+        return false;
+    }
+    if (i >= 2 && ggml_cuda_can_fuse(cgraph, i - 2, { GGML_OP_ROPE, GGML_OP_VIEW, GGML_OP_SET_ROWS }, {})) {
+        return false;
+    }
+    const ggml_tensor * src0 = node->src[0];
+    const ggml_tensor * src1 = node->src[1];
+    if (src0 == nullptr || src1 == nullptr) { return false; }
+    if (src0->type != GGML_TYPE_F32 || src1->type != GGML_TYPE_I64 || node->type != GGML_TYPE_F16) { return false; }
+    if (src0->ne[1] != 1 || src0->ne[2] != 1 || src0->ne[3] != 1) { return false; }
+    if (src1->ne[0] < 1) { return false; }
+    if (src0->nb[0] != ggml_type_size(src0->type) || node->nb[0] != ggml_type_size(node->type)) { return false; }
+    if (!ggml_is_contiguous(src0)) { return false; }
+    return true;
+}
+
+static int ggml_cuda_set_rows_collect_group(const ggml_cgraph * cgraph, const int start, ggml_tensor ** members) {
+    members[0] = cgraph->nodes[start];
+    int n = 1;
+    constexpr int scan_window = 8;
+    const int end = std::min(cgraph->n_nodes, start + 1 + scan_window);
+    for (int j = start + 1; j < end && n < SET_ROWS_MAX_GROUP_SIZE; ++j) {
+        ggml_tensor * cand = cgraph->nodes[j];
+        if (ggml_cuda_is_view_or_noop(cand)) { continue; }
+        if (cand->op != GGML_OP_SET_ROWS) { break; }
+        if (!ggml_cuda_set_rows_groupable(cgraph, j)) { break; }
+        bool overlap = false;
+        for (int m = 0; m < n; ++m) {
+            if (!ggml_cuda_mmvq_ranges_disjoint(members[m], cand)) { overlap = true; break; }
+        }
+        if (overlap) { break; }
+        members[n++] = cand;
+    }
+    return n;
+}
