diff --git a/common/arg.cpp b/common/arg.cpp
index da4087474..390e38913 100644
--- a/common/arg.cpp
+++ b/common/arg.cpp
@@ -830,9 +830,19 @@ static bool common_params_parse_ex(int argc, char ** argv, common_params_context
     // parse all CLI args now, so that -hf is available below for remote preset resolution
     parse_cli_args();
 
+    // -t unset means "pick a default"; remember that before it is resolved.
+    const bool n_threads_explicit = params.cpuparams.n_threads > 0;
+
     postprocess_cpu_params(params.cpuparams,       nullptr);
     postprocess_cpu_params(params.cpuparams_batch, &params.cpuparams);
 
+    // The batch pool has already inherited the full math-core count above, so
+    // narrowing the generation pool here leaves prefill untouched. Only applies
+    // when the caller did not ask for a specific thread count.
+    if (!n_threads_explicit) {
+        params.cpuparams.n_threads = common_cpu_get_num_generate(params.cpuparams.n_threads);
