From: Claude Opus 5 <noreply@anthropic.com>
Subject: [PATCH] CUDA: guard the folded add chain against a cross-block overlap

This is a correctness guard, credited to the round-51 work on the sibling
track qwen3.6-35b-a3b-gguf-r9700-v1, where it was diagnosed and where it
changes behaviour. It carries no performance claim here and, as measured
below, declines nothing on this track. It ships with 0022 because it is not a
score-improving change on its own.

The hazard. 0006's rms_norm_pre_add issues one block per row. Block r writes
add_dst row r in loop 1 and dst row r in loop 2, with only the block-scope
__syncthreads() inside the reduction between them, and reads the add operand
rows in loop 1. Nothing orders one block's loop 2 against another block's loop
1. So a write range belonging to block r must not intersect a read range
belonging to a different block. The existing check only tests dst against the
stored add result; it does not test either writer against the add operands.

Because every writer and reader here is contiguous and the same shape, their
row grids are congruent, and an overlapping pair is safe only when the two
tensors start at exactly the same address - block r then writes precisely the
row block r reads, which is the in-place residual add the kernel already
assumes. An overlap at any other base, including one a whole number of rows
apart, puts block r's store on top of another block's load.
ggml_cuda_pre_add_write_safe tests exactly that, for each writer against each
reader, and only above one row: at one row there is a single block and the
window cannot open. On the sibling track this declines 9 of 79 folds per graph
and converts a 0.107% spread across six distinct perplexity values into a
single repeated value.

What it does on this track: nothing, at every shape measured.
GGML_RMS_PRE_ADD_AUDIT=1 dumps each candidate fold's write and read ranges and
the guard's verdict. Counting hazards over a full pass:

    -c 512  --chunks 8        79 folds at nrows 2, 632 at nrows 512    0 declined
    -c 2048 --chunks 2        79 folds at nrows 2, 632 at nrows 512    0 declined
    -c 16384 (long window)    79 folds at nrows 2, 2528 at nrows 512   0 declined
    -c 512 -b 512 -ub 1       828 folds at nrows 1                     0 declined

Consistent with that, the gate shape reads 3.9306 on five consecutive loads of
the guarded build and 3.9306 on five of the unguarded one - this track's
allocator does not produce the offset pair the sibling's does, so the fold is
correct here by accident of layout rather than by construction. The guard makes
it correct by construction, at zero declined folds and therefore zero cost.

GGML_CUDA_PRE_ADD_NORM_UNSAFE=1 drops the guard; GGML_RMS_PRE_ADD_AUDIT=1
dumps the ranges it tests.
---
diff --git a/ggml/src/ggml-cuda/ggml-cuda.cu b/ggml/src/ggml-cuda/ggml-cuda.cu
index 18a5761..f5c0636 100644
--- a/ggml/src/ggml-cuda/ggml-cuda.cu
+++ b/ggml/src/ggml-cuda/ggml-cuda.cu
@@ -3773,6 +3773,44 @@ static int ggml_cuda_set_rows_collect_group(const ggml_cgraph * cgraph, const in
 // destination - so the stored result is unchanged, and the norm then consumes
 // the same float values it would have read back from that store.
 
+// ---- cross-block write/read hazard on the folded add chain ----------------
+//
+// rms_norm_pre_add issues one block per row.  Block r writes add_dst row r in
+// loop 1 and dst row r in loop 2, with only the block-scope __syncthreads()
+// inside the reduction between them, and reads the add operand rows in loop 1.
+// Nothing orders one block's loop 2 against another block's loop 1, so a WRITE
+// range belonging to block r must never intersect a READ range belonging to
+// block r' != r.
+//
+// Every writer and reader here is contiguous and the same shape, so their row
+// grids are congruent.  An overlapping pair is therefore safe only when the two
+// tensors start at exactly the same address - block r then writes precisely the
+// row block r reads, which is the in-place residual add the kernel already
+// assumes.  Any other overlap, INCLUDING one that is a whole number of rows
+// apart, puts block r's store on top of block r+k's load.
+static bool ggml_cuda_pre_add_write_safe(const ggml_tensor * w, const ggml_tensor * r) {
+    if (r == nullptr || w->data == r->data) {
+        return true;
+    }
+    return ggml_cuda_mmvq_ranges_disjoint(w, r);
+}
+
+static void ggml_cuda_pre_add_audit(const ggml_cgraph * cgraph, int i, int n_adds,
+                                    const ggml_tensor * add_last, const ggml_tensor * mul,
+                                    int64_t nrows, bool hazard) {
+    static int calls = 0;
+    fprintf(stderr, "[PREADD] call=%d nrows=%lld n_adds=%d hazard=%d dst=%p+%zu add_dst=%p+%zu",
+            calls++, (long long) nrows, n_adds, (int) hazard,
+            mul->data, ggml_nbytes(mul), add_last->data, ggml_nbytes(add_last));
+    const ggml_tensor * r0 = cgraph->nodes[i]->src[0];
+    fprintf(stderr, " src0=%p+%zu", r0 ? r0->data : nullptr, r0 ? ggml_nbytes(r0) : 0);
+    for (int k = 0; k < n_adds; ++k) {
+        const ggml_tensor * rk = cgraph->nodes[i + k]->src[1];
+        fprintf(stderr, " src%d=%p+%zu", k + 1, rk ? rk->data : nullptr, rk ? ggml_nbytes(rk) : 0);
+    }
+    fprintf(stderr, "\n");
+}
+
 static int ggml_cuda_rms_norm_pre_add_chain_len(const ggml_cgraph * cgraph, const int i) {
     // mirrors the multi-add fusion loop in ggml_cuda_try_fuse
     int     n_fuse = 0;
@@ -3874,6 +3912,38 @@ static int ggml_cuda_rms_norm_pre_add_detect(const ggml_cgraph * cgraph, const i
     }
     // and the intermediate norm result is never materialised, so nothing else
     // may read it (guaranteed by ggml_cuda_can_fuse's single-use check)
+
+    // Above one row the cross-block hazard is live: audit the write set against
+    // the read set and decline any fold that is not provably per-row.  At one
+    // row there is exactly one block and the window cannot open.
+    static const bool pre_add_unsafe = getenv("GGML_CUDA_PRE_ADD_NORM_UNSAFE") != nullptr &&
+                                       std::atoi(getenv("GGML_CUDA_PRE_ADD_NORM_UNSAFE"));
+    static const bool pre_add_audit  = getenv("GGML_RMS_PRE_ADD_AUDIT") != nullptr &&
+                                       std::atoi(getenv("GGML_RMS_PRE_ADD_AUDIT"));
+    const int64_t pre_add_nrows = ggml_nrows(add_last);
+    bool pre_add_hazard = false;
+    if (pre_add_nrows > 1) {
+        const ggml_tensor * writers[2] = { mul, add_last };
+        for (int wi = 0; wi < 2 && !pre_add_hazard; ++wi) {
+            if (!ggml_cuda_pre_add_write_safe(writers[wi], cgraph->nodes[i]->src[0])) {
+                pre_add_hazard = true;
+                break;
+            }
+            for (int k = 0; k < n_adds; ++k) {
+                if (!ggml_cuda_pre_add_write_safe(writers[wi], cgraph->nodes[i + k]->src[1])) {
+                    pre_add_hazard = true;
+                    break;
+                }
+            }
+        }
+    }
+    if (pre_add_audit) {
+        ggml_cuda_pre_add_audit(cgraph, i, n_adds, add_last, mul, pre_add_nrows, pre_add_hazard);
+    }
+    if (pre_add_hazard && !pre_add_unsafe) {
+        return 0;
+    }
+
     return n_adds;
 }
 
