@@ -3978,6 +4168,15 @@ static void ggml_cuda_graph_evaluate_and_capture(ggml_backend_cuda_context * cud
                 stream_ctx.concurrent_events.clear();
             }
 
+            // Members of grouped mmvq launches already issued earlier in this pass.
+            std::unordered_set<const ggml_tensor *> mmvq_grouped_done;
+            static const bool disable_mmvq_group = getenv("GGML_CUDA_DISABLE_MMVQ_GROUP") != nullptr &&
+                                                   std::atoi(getenv("GGML_CUDA_DISABLE_MMVQ_GROUP"));
+            const bool mmvq_group_enabled = !disable_mmvq_group && stream_ctx.concurrent_events.empty();
+            static const bool log_mmvq_group_stats = getenv("GGML_MMVQ_GROUP_STATS") != nullptr;
+            int64_t mmvq_group_stats_buf[2] = {0, 0};
+            int64_t * mmvq_group_stats = log_mmvq_group_stats ? mmvq_group_stats_buf : nullptr;
+
             for (int i = 0; i < cgraph->n_nodes; i++) {
                 ggml_tensor * node = cgraph->nodes[i];
 
@@ -4027,6 +4226,10 @@ static void ggml_cuda_graph_evaluate_and_capture(ggml_backend_cuda_context * cud
                     continue;
                 }
 
+                if (mmvq_grouped_done.count(node) != 0) {
+                    continue; // already computed as part of a grouped mmvq launch
+                }
+
                 int nodes_to_skip = ggml_cuda_try_fuse(cuda_ctx, cgraph, i);
 
                 if (nodes_to_skip != 0) {
@@ -4049,6 +4252,22 @@ static void ggml_cuda_graph_evaluate_and_capture(ggml_backend_cuda_context * cud
                     i += nodes_to_skip;
                     continue;
                 }
+
+                if (mmvq_group_enabled && ggml_cuda_mmvq_can_group(node)) {
+                    ggml_tensor * members[MMVQ_MAX_GROUP_SIZE];
+                    const int n_members = ggml_cuda_mmvq_collect_group(cgraph, i, members);
+                    if (n_members >= 2) {
+                        ggml_cuda_mul_mat_vec_q_grouped(*cuda_ctx, members, n_members);
+                        for (int m = 1; m < n_members; ++m) {
+                            mmvq_grouped_done.insert(members[m]);
+                        }
+                        if (mmvq_group_stats != nullptr) {
+                            mmvq_group_stats[0] += 1;          // groups launched
+                            mmvq_group_stats[1] += n_members;  // members covered
+                        }
+                        continue;
+                    }
+                }
 #ifndef NDEBUG
                 assert(node->buffer->buft == ggml_backend_cuda_buffer_type(cuda_ctx->device));
                 for (int j = 0; j < GGML_MAX_SRC; j++) {
@@ -4072,6 +4291,15 @@ static void ggml_cuda_graph_evaluate_and_capture(ggml_backend_cuda_context * cud
                     try_launch_concurrent_event(node);
                }
             }
+
+            if (mmvq_group_stats != nullptr && mmvq_group_stats[0] > 0) {
+                static int stats_prints_left = 8;
+                if (stats_prints_left > 0) {
+                    stats_prints_left--;
+                    GGML_LOG_INFO("mmvq-group: %lld groups covering %lld matvecs in this pass (n_nodes=%d)\n",
+                        (long long) mmvq_group_stats[0], (long long) mmvq_group_stats[1], cgraph->n_nodes);
+                }
+            }
         }
 
