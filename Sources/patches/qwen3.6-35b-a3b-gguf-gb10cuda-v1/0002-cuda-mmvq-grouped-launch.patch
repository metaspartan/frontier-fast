diff --git a/ggml/src/ggml-cuda/mmvq.cu b/ggml/src/ggml-cuda/mmvq.cu
index 826d752..c3f95f9 100644
--- a/ggml/src/ggml-cuda/mmvq.cu
+++ b/ggml/src/ggml-cuda/mmvq.cu
@@ -782,6 +782,247 @@ static std::pair<dim3, dim3> calc_launch_params(
     return {block_nums, block_dims};
 }
 
+// ----- grouped launch: several single-column matvecs over one shared src1 -----
+//
+// Decode-time attention issues several quantized matvecs over the SAME
+// activation vector (Q/K/V projections, attention gate projections). Each is a
+// full kernel launch whose per-row work is independent of every other row. The
+// grouped kernel concatenates the row ranges of up to MMVQ_MAX_GROUP_SIZE such
+// ops into one grid: a block first routes itself to its segment (weight matrix
+// + dst pointer + local row index, all integer work), then performs exactly the
+// per-row thread geometry, k-loop and reduction sequence of the individual
+// mul_mat_vec_q<type, 1, false, false> launch it replaces, so the results are
+// byte-identical by construction.
+//
+// Only the ncols_dst == 1, no-ids, no-fusion, non-small_k specialization is
+// provided: that is the only shape the graph-side detector groups, and it is
+// the one where rows_per_cuda_block == 1 on every architecture table, which
+// makes the block index equal the row index.
+
+struct mmvq_grouped_args {
+    const void * vx[MMVQ_MAX_GROUP_SIZE];
+    float      * dst[MMVQ_MAX_GROUP_SIZE];
+    // exclusive prefix sums of segment row counts; entries past the actual
+    // group size are padded with the total so the segment scan ignores them
+    uint32_t     seg_end[MMVQ_MAX_GROUP_SIZE];
+};
+
+template <ggml_type type>
+__launch_bounds__(calc_nwarps(type, 1, get_device_table_id())*ggml_cuda_get_physical_warp_size(), 1)
+static __global__ void mul_mat_vec_q_grouped(
+        const mmvq_grouped_args args, const void * vy_ptr,
+        const uint32_t ncols_x, const uint32_t stride_row_x) {
+    constexpr int ncols_dst = 1;
+    constexpr int qk  = ggml_cuda_type_traits<type>::qk;
+    constexpr int qi  = ggml_cuda_type_traits<type>::qi;
+    constexpr int vdr = get_vdr_mmvq(type);
+    constexpr mmvq_parameter_table_id table_id = get_device_table_id();
+    constexpr int nwarps = calc_nwarps(type, ncols_dst, table_id);
+    constexpr int rows_per_cuda_block = calc_rows_per_block(ncols_dst, table_id, /*small_k=*/false, nwarps);
+    static_assert(rows_per_cuda_block == 1, "grouped mmvq requires the block index to be the row index");
+    constexpr int warp_size = ggml_cuda_get_physical_warp_size();
+
+    constexpr vec_dot_q_cuda_t vec_dot_q_cuda = get_vec_dot_q_cuda(type);
+
+    const int tid = warp_size*threadIdx.y + threadIdx.x;
+
+    // Segment routing: uniform across the block (it depends only on blockIdx.x),
+    // integer-only, and the sole difference from the individual launch.
+    uint32_t seg       = 0;
+    uint32_t seg_start = 0;
+#pragma unroll
+    for (int s = 0; s < MMVQ_MAX_GROUP_SIZE - 1; ++s) {
+        if (blockIdx.x >= args.seg_end[s]) {
+            seg       = s + 1;
+            seg_start = args.seg_end[s];
+        }
+    }
+    const void * GGML_CUDA_RESTRICT vx  = args.vx[seg];
+    float       * GGML_CUDA_RESTRICT dst = args.dst[seg];
+
+    // From here on this is the mul_mat_vec_q<type, 1, false, false> body with
+    // the dead channel/sample/batch indexing constant-folded away (the detector
+    // only groups 2D-weight x single-column ops, where channel_dst = sample_dst
+    // = 0 and every j index is 0).
+    const     int row0 = rows_per_cuda_block*(blockIdx.x - seg_start);
+    const     int blocks_per_row_x = ncols_x / qk;
+    constexpr int blocks_per_iter = vdr * nwarps*warp_size / qi;
+
+    ggml_cuda_pdl_sync();
+
+    // partial sum for each thread
+    float tmp[ncols_dst][rows_per_cuda_block] = {{0.0f}};
+
+    const block_q8_1 * y = (const block_q8_1 *) vy_ptr;
+    const int kbx_offset = row0*stride_row_x;
+
+    for (int kbx = tid / (qi/vdr); kbx < blocks_per_row_x; kbx += blocks_per_iter) {
+        const int kby = kbx * (qk/QK8_1); // y block index that aligns with kbx
+
+        // x block quant index when casting the quants to int
+        const int kqs = vdr * (tid % (qi/vdr));
+
+#pragma unroll
+        for (int j = 0; j < ncols_dst; ++j) {
+#pragma unroll
+            for (int i = 0; i < rows_per_cuda_block; ++i) {
+                tmp[j][i] += vec_dot_q_cuda(
+                    vx, &y[kby], kbx_offset + i*stride_row_x + kbx, kqs);
+            }
+        }
+    }
+
+    __shared__ float tmp_shared[nwarps-1 > 0 ? nwarps-1 : 1][ncols_dst][rows_per_cuda_block][warp_size];
+
+    if (threadIdx.y > 0) {
+#pragma unroll
+        for (int j = 0; j < ncols_dst; ++j) {
+#pragma unroll
+            for (int i = 0; i < rows_per_cuda_block; ++i) {
+                tmp_shared[threadIdx.y-1][j][i][threadIdx.x] = tmp[j][i];
+            }
+        }
+    }
+    __syncthreads();
+    if (threadIdx.y > 0) {
+        return;
+    }
+
+    dst += row0;
+
+    // sum up partial sums and write back result
+#pragma unroll
+    for (int j = 0; j < ncols_dst; ++j) {
+#pragma unroll
+        for (int i = 0; i < rows_per_cuda_block; ++i) {
+#pragma unroll
+            for (int l = 0; l < nwarps-1; ++l) {
+                tmp[j][i] += tmp_shared[l][j][i][threadIdx.x];
+            }
+            tmp[j][i] = warp_reduce_sum<warp_size>(tmp[j][i]);
+
+            if (threadIdx.x == i) { // rows_per_cuda_block == 1: no row bound check needed
+                dst[i] = tmp[j][i];
+            }
+        }
+    }
+}
+
+template <ggml_type type>
+static void mul_mat_vec_q_grouped_launch(
+        const mmvq_grouped_args & args, const void * vy, const uint32_t total_rows,
+        const uint32_t ncols_x, const uint32_t stride_row_x, cudaStream_t stream) {
+    const int device    = ggml_cuda_get_device();
+    const int cc        = ggml_cuda_info().devices[device].cc;
+    const int warp_size = ggml_cuda_info().devices[device].warp_size;
+    const mmvq_parameter_table_id table_id = get_device_table_id(cc);
+
+    const int nwarps = calc_nwarps(type, 1, table_id);
+    GGML_ASSERT(calc_rows_per_block(1, table_id, /*small_k=*/false, nwarps) == 1);
+
+    // Same block shape as each individual launch would use.
+    const dim3 block_nums(total_rows, 1, 1);
+    const dim3 block_dims(warp_size, nwarps, 1);
+
+    const ggml_cuda_kernel_launch_params launch_params = ggml_cuda_kernel_launch_params(block_nums, block_dims, 0, stream);
+    ggml_cuda_kernel_launch(mul_mat_vec_q_grouped<type>, launch_params, args, vy, ncols_x, stride_row_x);
+}
+
+// Grouping replaces individual mul_mat_vec_q<type, 1, has_fusion, small_k=false>
+// launches, whose block shape has rows_per_cuda_block == 1. On NVIDIA (and any
+// other table where should_use_small_k below can fire) an individual launch may
+// instead take the upstream small_k path, which sets rows_per_cuda_block =
+// nwarps and gives every row a different thread geometry. Those ops must not be
+// grouped. This mirrors the base condition of should_use_small_k in
+// mul_mat_vec_q_switch_ncols_dst; the type exclusion lists there can only turn
+// small_k OFF, so testing the base condition alone is conservative (it may
+// decline to group an op that would not actually use small_k, never the
+// reverse).
+template <ggml_type type>
+static bool mmvq_may_use_small_k(const int ncols_x, const mmvq_parameter_table_id table_id, const int warp_size) {
+    constexpr int qk  = ggml_cuda_type_traits<type>::qk;
+    constexpr int qi  = ggml_cuda_type_traits<type>::qi;
+    constexpr int vdr = get_vdr_mmvq(type);
+
+    const int blocks_per_row_x      = ncols_x / qk;
+    const int blocks_per_iter_1warp = vdr * warp_size / qi;
+    const int nwarps                = calc_nwarps(type, 1, table_id);
+
+    return nwarps > 1 && blocks_per_row_x < nwarps * blocks_per_iter_1warp;
+}
+
+bool ggml_cuda_mmvq_group_shape_matches(const ggml_type type, const int64_t ncols_x) {
+    const int device    = ggml_cuda_get_device();
+    const int cc        = ggml_cuda_info().devices[device].cc;
+    const int warp_size = ggml_cuda_info().devices[device].warp_size;
+    const mmvq_parameter_table_id table_id = get_device_table_id(cc);
+
+    switch (type) {
+#define MMVQ_SMALL_K_CASE(t)         case t:             return !mmvq_may_use_small_k<t>((int) ncols_x, table_id, warp_size) &&                    calc_rows_per_block(1, table_id, /*small_k=*/false, calc_nwarps(t, 1, table_id)) == 1;
+        MMVQ_SMALL_K_CASE(GGML_TYPE_Q1_0)
+        MMVQ_SMALL_K_CASE(GGML_TYPE_Q2_0)
+        MMVQ_SMALL_K_CASE(GGML_TYPE_Q4_0)
+        MMVQ_SMALL_K_CASE(GGML_TYPE_Q4_1)
+        MMVQ_SMALL_K_CASE(GGML_TYPE_Q5_0)
+        MMVQ_SMALL_K_CASE(GGML_TYPE_Q5_1)
+        MMVQ_SMALL_K_CASE(GGML_TYPE_Q8_0)
+        MMVQ_SMALL_K_CASE(GGML_TYPE_MXFP4)
+        MMVQ_SMALL_K_CASE(GGML_TYPE_NVFP4)
+        MMVQ_SMALL_K_CASE(GGML_TYPE_Q2_K)
+        MMVQ_SMALL_K_CASE(GGML_TYPE_Q3_K)
+        MMVQ_SMALL_K_CASE(GGML_TYPE_Q4_K)
+        MMVQ_SMALL_K_CASE(GGML_TYPE_Q5_K)
+        MMVQ_SMALL_K_CASE(GGML_TYPE_Q6_K)
+        MMVQ_SMALL_K_CASE(GGML_TYPE_IQ2_XXS)
+        MMVQ_SMALL_K_CASE(GGML_TYPE_IQ2_XS)
+        MMVQ_SMALL_K_CASE(GGML_TYPE_IQ2_S)
+        MMVQ_SMALL_K_CASE(GGML_TYPE_IQ3_XXS)
+        MMVQ_SMALL_K_CASE(GGML_TYPE_IQ1_S)
+        MMVQ_SMALL_K_CASE(GGML_TYPE_IQ1_M)
+        MMVQ_SMALL_K_CASE(GGML_TYPE_IQ4_NL)
+        MMVQ_SMALL_K_CASE(GGML_TYPE_IQ4_XS)
+        MMVQ_SMALL_K_CASE(GGML_TYPE_IQ3_S)
+#undef MMVQ_SMALL_K_CASE
+        default:
+            return false;
+    }
+}
+
+static void mul_mat_vec_q_grouped_switch_type(
+        const ggml_type type, const mmvq_grouped_args & args, const void * vy, const uint32_t total_rows,
+        const uint32_t ncols_x, const uint32_t stride_row_x, cudaStream_t stream) {
+    switch (type) {
+#define MMVQ_GROUPED_CASE(t) case t: mul_mat_vec_q_grouped_launch<t>(args, vy, total_rows, ncols_x, stride_row_x, stream); break;
+        MMVQ_GROUPED_CASE(GGML_TYPE_Q1_0)
+        MMVQ_GROUPED_CASE(GGML_TYPE_Q2_0)
+        MMVQ_GROUPED_CASE(GGML_TYPE_Q4_0)
+        MMVQ_GROUPED_CASE(GGML_TYPE_Q4_1)
+        MMVQ_GROUPED_CASE(GGML_TYPE_Q5_0)
+        MMVQ_GROUPED_CASE(GGML_TYPE_Q5_1)
+        MMVQ_GROUPED_CASE(GGML_TYPE_Q8_0)
+        MMVQ_GROUPED_CASE(GGML_TYPE_MXFP4)
+        MMVQ_GROUPED_CASE(GGML_TYPE_NVFP4)
+        MMVQ_GROUPED_CASE(GGML_TYPE_Q2_K)
+        MMVQ_GROUPED_CASE(GGML_TYPE_Q3_K)
+        MMVQ_GROUPED_CASE(GGML_TYPE_Q4_K)
+        MMVQ_GROUPED_CASE(GGML_TYPE_Q5_K)
+        MMVQ_GROUPED_CASE(GGML_TYPE_Q6_K)
+        MMVQ_GROUPED_CASE(GGML_TYPE_IQ2_XXS)
+        MMVQ_GROUPED_CASE(GGML_TYPE_IQ2_XS)
+        MMVQ_GROUPED_CASE(GGML_TYPE_IQ2_S)
+        MMVQ_GROUPED_CASE(GGML_TYPE_IQ3_XXS)
+        MMVQ_GROUPED_CASE(GGML_TYPE_IQ1_S)
+        MMVQ_GROUPED_CASE(GGML_TYPE_IQ1_M)
+        MMVQ_GROUPED_CASE(GGML_TYPE_IQ4_NL)
+        MMVQ_GROUPED_CASE(GGML_TYPE_IQ4_XS)
+        MMVQ_GROUPED_CASE(GGML_TYPE_IQ3_S)
+#undef MMVQ_GROUPED_CASE
+        default:
+            GGML_ABORT("fatal error");
+            break;
+    }
+}
