+++ b/ggml/src/ggml-cuda/set-rows.cuh
@@ -4,4 +4,14 @@
 
 #define CUDA_SET_ROWS_BLOCK_SIZE 256
 
+// Maximum number of independent single-row set_rows ops that may merge into a
+// single grouped launch.
+#define SET_ROWS_MAX_GROUP_SIZE 4
+
+// Launch several independent single-row F32 -> F16 set_rows ops (the KV-cache
+// K and V stores of one decode step) as ONE kernel. Each element keeps the
+// exact source value, cast and destination address it has in the individual
+// launch; only the segment routing is new, and it is integer-only.
+void ggml_cuda_op_set_rows_grouped(ggml_backend_cuda_context & ctx, ggml_tensor * const * nodes, int n_nodes);
+
 void ggml_cuda_op_set_rows(ggml_backend_cuda_context & ctx, ggml_tensor * dst);
