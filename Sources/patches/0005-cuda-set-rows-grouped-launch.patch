+
+// ----- grouped set_rows (KV-cache K/V store) launch detection -----------------
+//
+// A decode step stores the new K row and the new V row into the KV cache with
+// two independent set_rows launches. Merging them into one launch removes a
+// dispatch without touching any value: each element keeps its source, its cast
+// and its destination address (see k_set_rows_grouped in set-rows.cu).
+
+static bool ggml_cuda_set_rows_groupable(const ggml_cgraph * cgraph, const int i) {
+    const ggml_tensor * node = cgraph->nodes[i];
+
+    if (node->op != GGML_OP_SET_ROWS) {
+        return false;
+    }
+    // leave anything stock would run as part of a ROPE+VIEW+SET_ROWS fusion alone
+    if (i >= 2 && ggml_cuda_can_fuse(cgraph, i - 2, { GGML_OP_ROPE, GGML_OP_VIEW, GGML_OP_SET_ROWS }, {})) {
+        return false;
+    }
+
+    const ggml_tensor * src0 = node->src[0];
+    const ggml_tensor * src1 = node->src[1];
+    if (src0 == nullptr || src1 == nullptr) {
+        return false;
+    }
+    if (src0->type != GGML_TYPE_F32 || src1->type != GGML_TYPE_I64 || node->type != GGML_TYPE_F16) {
+        return false;
+    }
+    // single-row store only: the grouped kernel constant-folds the index
+    // decomposition to i00 = i, i01 = i02 = i03 = 0
+    if (src0->ne[1] != 1 || src0->ne[2] != 1 || src0->ne[3] != 1) {
+        return false;
+    }
+    if (src1->ne[0] < 1) {
+        return false;
+    }
+    if (src0->nb[0] != ggml_type_size(src0->type) || node->nb[0] != ggml_type_size(node->type)) {
+        return false;
+    }
+    if (!ggml_is_contiguous(src0)) {
+        return false;
+    }
+    return true;
+}
+
+static int ggml_cuda_set_rows_collect_group(const ggml_cgraph * cgraph, const int start, ggml_tensor ** members,
+                                            const std::unordered_set<const ggml_tensor *> & done,
+                                            const std::unordered_set<const ggml_tensor *> & done2) {
+    members[0] = cgraph->nodes[start];
+    int n = 1;
+
+    constexpr int scan_window = 8;
+    const int end = std::min(cgraph->n_nodes, start + 1 + scan_window);
+
+    for (int j = start + 1; j < end && n < SET_ROWS_MAX_GROUP_SIZE; ++j) {
+        ggml_tensor * cand = cgraph->nodes[j];
+        if (ggml_cuda_is_view_or_noop(cand) || done.count(cand) != 0 || done2.count(cand) != 0) {
+            continue;
+        }
+        if (cand->op != GGML_OP_SET_ROWS) {
+            continue;
+        }
+        if (!ggml_cuda_set_rows_groupable(cgraph, j)) {
+            continue;
+        }
+        // reuse the rope hoist scan: identical requirements (the hoisted write
+        // must not touch what a skipped-over node reads or writes, the hoisted
+        // inputs must not be written in between, and nothing in between may
+        // consume the hoisted result)
+        if (!ggml_cuda_rope_hoist_legal(cgraph, start, j, done, done2)) {
+            continue;
+        }
+        bool overlap = false;
+        for (int m = 0; m < n; ++m) {
+            if (!ggml_cuda_mmvq_ranges_disjoint(members[m], cand)) {
+                overlap = true;
+                break;
+            }
+        }
+        if (overlap) {
+            continue;
+        }
+        members[n++] = cand;
+    }
+    return n;
+}
