+def _ngram_spec(prompt, model, *, max_tokens=256, prompt_cache=None,
+                prefill_step_size=512, **kwargs):
+    """Self-contained n-gram speculative greedy decoder.
+
+    Builds a bigram table from the prompt, then uses it to predict
+    the next token. When a prediction exists, processes [current, predicted]
+    in a SINGLE batched forward pass (M=2). If accepted, we get 2 tokens
+    for ~1 forward pass. Falls back to regular single-token decode otherwise.
+
+    Output is identical to greedy decoding (verified via text match).
+    """
+    y = prompt.astype(mx.uint32)
+    if prompt_cache is None:
+        prompt_cache = cache.make_prompt_cache(model)
+
+    # Build bigram table from prompt tokens
+    prompt_list = y.tolist()
+    bigram = {}
+    for i in range(len(prompt_list) - 1):
+        bigram[(prompt_list[i],)] = prompt_list[i + 1]
+        if i < len(prompt_list) - 2:
+            bigram[(prompt_list[i], prompt_list[i + 1])] = prompt_list[i + 2]
+
+    generation_stream = mx.stream(gpu_stream())
+
+    # Prefill using regular generate_step
+    gen = generate_step(
+        y, model, max_tokens=max_tokens,
+        prompt_cache=prompt_cache, prefill_step_size=prefill_step_size,
+        **{k: v for k, v in kwargs.items() if k in ("sampler", "logits_processors")},
+    )
 
+    # Get first token
+    try:
+        first_token, first_lp = next(gen)
+    except StopIteration:
+        return
 
+    ft = int(first_token.item())
+    prev_prev = prompt_list[-1] if prompt_list else None
+    prev_token = ft
+    ntoks = 1
+    yield first_token, first_lp, False
+
+    while ntoks < max_tokens:
+        # Check for prediction
+        predicted = bigram.get((prev_prev, prev_token)) if prev_prev is not None else None
+
+        if predicted is not None and ntoks + 1 < max_tokens:
+            # SAVE cache state
+            saved = []
+            for c in prompt_cache:
+                if hasattr(c, 'keys'):
+                    saved.append(('kv', c.offset, c.keys, c.values))
+                else:
+                    saved.append(('arr', c[0]))
+
+            # Batch forward: [prev_token, predicted] in one pass
+            batch = mx.array([prev_token, predicted], dtype=mx.uint32)
+            with mx.stream(generation_stream):
+                logits = model(batch[None], cache=prompt_cache)
+            model_tokens = mx.argmax(logits[:, -2:, :], axis=-1)
+            mx.eval(model_tokens)
+            t0 = int(model_tokens[0].item())
+
+            if t0 == predicted:
+                # ACCEPT! Both tokens are valid
+                t1 = int(model_tokens[1].item())
+
+                # Update bigram table
+                if prev_prev is not None:
+                    bigram[(prev_prev, prev_token)] = t0
+                bigram[(prev_token, t0)] = t1
+
+                # Yield accepted token (from draft)
+                prev_prev = prev_token
+                prev_token = t0
+                ntoks += 1
+                yield mx.array([t0], dtype=mx.uint32), logits[:, -2, :].squeeze(0), True
+
+                if ntoks < max_tokens:
+                    prev_prev = prev_token
+                    prev_token = t1
+                    ntoks += 1
+                    yield mx.array([t1], dtype=mx.uint32), logits[:, -1, :].squeeze(0), True
+
+                # Skip gen's next token (it computed t0 in background)
+                try:
+                    next(gen)
+                except StopIteration:
+                    pass
+            else:
+                # REJECT. Restore cache and re-process [t0]
+                for i, s in enumerate(saved):
+                    if s[0] == 'kv':
+                        prompt_cache[i].offset = s[1]
+                        prompt_cache[i].keys = s[2]
+                        prompt_cache[i].values = s[3]
+                    else:
+                        prompt_cache[i][0] = s[1]
+
+                # Process [t0] to update cache
+                with mx.stream(generation_stream):
+                    logits_fix = model(
+                        mx.array([t0], dtype=mx.uint32)[None], cache=prompt_cache
+                    )
+                mx.eval(logits_fix)
+
+                # Update bigram
+                if prev_prev is not None:
+                    bigram[(prev_prev, prev_token)] = t0
+
+                prev_prev = prev_token
+                prev_token = t0
+                ntoks += 1
+                yield mx.array([t0], dtype=mx.uint32), logits_fix[:, -1, :].squeeze(0), False
+
+                # Skip gen's next token
+                try:
+                    next(gen)
+                except StopIteration:
+                    pass
+            continue
+
+        # No prediction: regular generation
+        try:
+            token, lp = next(gen)
+        except StopIteration:
+            break
+
+        t = int(token.item())
+        if prev_prev is not None:
+            bigram[(prev_prev, prev_token)] = t
+
+        prev_prev = prev_token
+        prev_token = t
+        ntoks += 1
+        yield token, lp, False
+
