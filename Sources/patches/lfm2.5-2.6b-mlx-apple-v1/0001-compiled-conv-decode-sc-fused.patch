+_FUSED_SC_KERNEL = mx.fast.metal_kernel(
+    name="lfm2_shortconv_decode_fused",
+    input_names=["BCx", "state", "conv_w"],
+    output_names=["y", "new_state"],
+    source=r"""
+        uint h = thread_position_in_grid.x;
+        uint b = thread_position_in_grid.y;
+        uint H = conv_w_shape[0];
+        uint Bsz = BCx_shape[0];
+        if (h >= H || b >= Bsz) return;
+        uint bcx_base = b * 3 * H;
+        T Bb = BCx[bcx_base + h];
+        T Cc = BCx[bcx_base + H + h];
+        T xx = BCx[bcx_base + 2*H + h];
+        T Bx = Bb * xx;
+        uint st_base = b * 2 * H;
+        T s0 = state[st_base + h];
+        T s1 = state[st_base + H + h];
+        T w0 = conv_w[h * 3 + 0];
+        T w1 = conv_w[h * 3 + 1];
+        T w2 = conv_w[h * 3 + 2];
+        y[b * H + h] = Cc * (w0 * s0 + w1 * s1 + w2 * Bx);
+        new_state[st_base + h] = s1;
+        new_state[st_base + H + h] = Bx;
+    """,
+)
+
+
+def _make_conv_layer_fn(layer):
+    """Build a compiled decode function for a conv layer (L=1).
+
+    Fuses operator_norm, ShortConv elementwise (Metal kernel), out_proj,
+    residual add, ffn_norm, MLP, and final residual add into one compiled
+    graph. The Metal kernel and QMV matmuls are opaque to compile and kept
+    as separate kernels, but all elementwise ops (norms, adds) are fused.
+    """
+    sc = layer.conv
+    ff = layer.feed_forward
+    op_norm = layer.operator_norm
+    fn_norm = layer.ffn_norm
+
+    @mx.compile
+    def _fn(x, conv_state):
+        normed = op_norm(x)
+        BCx = sc.in_proj(normed)
+        conv_w = sc.conv.weight
+        if conv_w.ndim == 3:
+            conv_w = conv_w.reshape(conv_w.shape[0], -1)
+        H = sc.args.hidden_size
+        y, new_state = _FUSED_SC_KERNEL(
+            inputs=[BCx, conv_state, conv_w],
+            template=[("T", x.dtype)],
+            grid=(H, x.shape[0], 1),
+            threadgroup=(256, 1, 1),
+            output_shapes=[(x.shape[0], 1, H), (x.shape[0], 2, H)],
+            output_dtypes=[x.dtype, x.dtype],
+        )
+        r = sc.out_proj(y)
+        h = x + r
+        normed2 = fn_norm(h)
+        return h + ff(normed2), new_state
 
+    return _fn
 
+
