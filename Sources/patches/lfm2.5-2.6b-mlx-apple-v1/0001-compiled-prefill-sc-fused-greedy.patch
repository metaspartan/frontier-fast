+            cache is not None
+            and input_embeddings is None
+            and inputs.shape[1] > 1
+            and self._cache_fresh(cache)
+        ):
+            try:
+                if not hasattr(self, "_prefill_fn"):
+                    self._prefill_fn = self._build_prefill()
+                h, states = self._prefill_fn(inputs)
+                self._write_cache(cache, states, inputs.shape[1])
+                return h
+            except Exception:
+                # Fall back to stock path permanently on any compile/runtime issue.
+                self._prefill_fn = None
+                self._prefill_disabled = True
+                pass
+        return self._stock_forward(inputs, cache, input_embeddings)
+
+    def _cache_fresh(self, cache):
+        if getattr(self, "_prefill_disabled", False):
+            return False
+        for c in cache:
+            if hasattr(c, "keys"):
+                if c.offset != 0:
+                    return False
+            elif c[0] is not None:
+                return False
+        return True
+
+    def _write_cache(self, cache, states, n_tokens):
+        idx = 0
+        for c in cache:
+            if hasattr(c, "keys"):
+                c.keys = states[idx]
+                c.values = states[idx + 1]
+                idx += 2
+                c.offset = n_tokens
+            else:
+                c[0] = states[idx]
+                idx += 1
+                if hasattr(c, "advance"):
+                    c.advance(n_tokens)
+
