+def _ngram_decode(prompt, model, *, max_tokens=256, prompt_cache=None,
+                  prefill_step_size=512, **kwargs):
+    """N-gram speculative greedy decoder with async pipelining."""
+    y = prompt.astype(mx.uint32)
+    if prompt_cache is None:
+        prompt_cache = cache.make_prompt_cache(model)
+
+    pl = y.tolist()
+    bigram = {}
+    for i in range(len(pl) - 2):
+        bigram[(pl[i], pl[i + 1])] = pl[i + 2]
+
+    gs = mx.new_thread_local_stream(mx.default_device())
+
+    with mx.stream(gs):
+        logits = model(y[None], cache=prompt_cache)[:, -1, :]
+        cur = mx.argmax(logits, axis=-1)
+    mx.async_eval(cur)
+
+    prev_prev = pl[-1] if pl else None
+    ntoks = 0
+    mx.eval(cur)
+    cur_int = int(cur.item())
+    prev_token = cur_int
+    ntoks = 1
+    yield cur_int, 0.0, False
+
+    with mx.stream(gs):
+        nxt = mx.argmax(model(cur[None], cache=prompt_cache)[:, -1, :], axis=-1)
+    mx.async_eval(nxt)
+
+    while ntoks < max_tokens:
+        predicted = bigram.get((prev_prev, prev_token))
+        if predicted is not None and ntoks + 1 < max_tokens:
+            saved = []
+            for c in prompt_cache:
+                if hasattr(c, 'keys'):
+                    saved.append((c.offset, c.keys, c.values))
+                else:
+                    saved.append(c[0])
+            batch = mx.array([prev_token, predicted], dtype=mx.uint32)
+            with mx.stream(gs):
+                blogits = model(batch[None], cache=prompt_cache)
+                btokens = mx.argmax(blogits[:, -2:, :], axis=-1)
+            mx.eval(btokens, nxt)
+            t0 = int(btokens[0, 0].item())
+            t1 = int(btokens[0, 1].item())
+            if t0 == predicted:
+                bigram[(prev_prev, prev_token)] = t0
+                bigram[(prev_token, t0)] = t1
+                prev_prev = prev_token; prev_token = t0; ntoks += 1
+                yield t0, 0.0, True
+                if ntoks < max_tokens:
+                    prev_prev = prev_token; prev_token = t1; ntoks += 1
+                    yield t1, 0.0, True
+                    with mx.stream(gs):
+                        nxt = mx.argmax(model(mx.array([t1], dtype=mx.uint32)[None], cache=prompt_cache)[:, -1, :], axis=-1)
+                    mx.async_eval(nxt)
+                continue
+            else:
+                for i, c in enumerate(prompt_cache):
+                    if hasattr(c, 'keys'):
+                        c.offset, c.keys, c.values = saved[i]
+                    else:
+                        c[0] = saved[i]
+                with mx.stream(gs):
+                    nxt = mx.argmax(model(mx.array([t0], dtype=mx.uint32)[None], cache=prompt_cache)[:, -1, :], axis=-1)
+                bigram[(prev_prev, prev_token)] = t0
+                prev_prev = prev_token; prev_token = t0; ntoks += 1
+                yield t0, 0.0, False
+                mx.async_eval(nxt)
+                continue
+        mx.eval(nxt)
+        t = int(nxt.item())
+        if prev_prev is not None:
+            bigram[(prev_prev, prev_token)] = t
+        prev_prev = prev_token; prev_token = t; ntoks += 1
+        yield t, 0.0, False
+        if ntoks < max_tokens:
+            with mx.stream(gs):
+                nxt = mx.argmax(model(mx.array([t], dtype=mx.uint32)[None], cache=prompt_cache)[:, -1, :], axis=-1)
+            mx.async_eval(nxt)
+
