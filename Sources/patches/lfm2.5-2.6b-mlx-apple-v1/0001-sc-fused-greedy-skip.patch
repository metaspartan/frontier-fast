+_FUSED_SC_KERNEL = mx.fast.metal_kernel(
+    name="lfm2_shortconv_decode_fused", input_names=["BCx", "state", "conv_w"],
+    output_names=["y", "new_state"],
+    source=r"""
+        uint h = thread_position_in_grid.x; uint b = thread_position_in_grid.y;
+        uint H = conv_w_shape[0]; uint Bsz = BCx_shape[0];
