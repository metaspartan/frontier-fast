         return sum(c.nbytes for c in self.cache if c is not None)
 
 
+
+class SpecConvCache(ArraysCache):
+    """ArraysCache for ShortConv layers with speculative partial-commit.
+
+    A verify step processes [certain, draft_1..draft_k] in one batched pass.
+    The conv state after accepting a of the k drafts is a pure slice of the
+    concatenated [prev_state || Bx] sequence the layer already computes
+    (columns a+1 : a+3 for a kernel-3 conv), so committing a partial prefix
+    needs no snapshot, no recompute and no rollback: the layer stashes the
+    concatenated Bx during spec steps and commit_spec(a) re-points the state
+    and rewinds the offset.
+    """
+
+    spec_mode = False
+    _spec_bx = None
+    _spec_t = 0
+
+    def __init__(self):
+        super().__init__(size=1)
+
+    def stash_spec(self, bx_cat, t):
+        self._spec_bx = bx_cat
+        self._spec_t = t
+
+    def commit_spec(self, a):
+        if self._spec_bx is None:
+            return
+        n_keep = self._spec_bx.shape[1] - self._spec_t
+        self[0] = self._spec_bx[:, a + 1 : a + 1 + n_keep, :]
+        self._spec_bx = None
+
+
 class ChunkedKVCache(_BaseCache):
     step = 256
 
