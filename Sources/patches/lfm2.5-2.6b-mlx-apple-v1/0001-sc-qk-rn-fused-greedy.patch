+_FUSED_SC_KERNEL = mx.fast.metal_kernel(
+    name="lfm2_shortconv_decode_fused", input_names=["BCx", "state", "conv_w"],
+    output_names=["y", "new_state"],
+    source=r"""
+        uint h = thread_position_in_grid.x; uint b = thread_position_in_grid.y;
+        uint H = conv_w_shape[0]; uint Bsz = BCx_shape[0];
+        if (h >= H || b >= Bsz) return;
+        uint bcx_base = b * 3 * H;
+        T Bb = BCx[bcx_base + h]; T Cc = BCx[bcx_base + H + h]; T xx = BCx[bcx_base + 2*H + h];
+        T Bx = Bb * xx; uint st_base = b * 2 * H;
+        T s0 = state[st_base + h]; T s1 = state[st_base + H + h];
+        T w0 = conv_w[h*3+0]; T w1 = conv_w[h*3+1]; T w2 = conv_w[h*3+2];
+        y[b*H+h] = Cc*(w0*s0+w1*s1+w2*Bx);
+        new_state[st_base+h] = s1; new_state[st_base+H+h] = Bx;
+    """,
+)
+
+_FUSED_QK_KERNEL = mx.fast.metal_kernel(
+    name="lfm2_fused_qk_norm_rope",
+    input_names=["q_raw", "k_raw", "qn_w", "kn_w", "offset"],
+    output_names=["q_out", "k_out"],
+    source=r"""
+        uint head = threadgroup_position_in_grid.x;
+        uint lid = thread_position_in_threadgroup.x;
+        constexpr uint D = 64;
+        constexpr uint NR = 4;
+        constexpr float EPS = 1e-5f;
+        constexpr float LOG2_BASE = 23.253496664211536f;
+        int pos = (int)offset[0];
+        const device T* in  = (head < 32) ? (q_raw + head * D + lid * NR)
+                                          : (k_raw + (head - 32) * D + lid * NR);
+        const device T* w = (head < 32) ? (qn_w + lid * NR) : (kn_w + lid * NR);
+        const bool safe = lid * NR + NR <= D;
+        const int n = (int)D - (int)(lid * NR);
+        float tx[NR] = {0};
+        if (safe) { for (uint i = 0; i < NR; i++) tx[i] = (float)in[i]; }
+        else { for (int i = 0; i < n; i++) tx[i] = (float)in[i]; }
+        float acc = 0;
+        for (uint i = 0; i < NR; i++) acc += tx[i] * tx[i];
+        acc = simd_sum(acc);
+        acc = metal::precise::rsqrt(acc / (float)D + EPS);
+        threadgroup float shared[D];
+        if (safe) { for (uint i = 0; i < NR; i++) { T nb = (T)(tx[i] * acc); shared[lid * NR + i] = (float)(w[i] * nb); } }
+        else { for (int i = 0; i < n; i++) { T nb = (T)(tx[i] * acc); shared[lid * NR + i] = (float)(w[i] * nb); } }
+        threadgroup_barrier(mem_flags::mem_threadgroup);
+        if (lid < D / 2) {
+            float d = (float)lid / (float)(D / 2);
+            float inv_freq = metal::exp2(-d * LOG2_BASE);
+            float theta = (float)pos * inv_freq;
+            float c = metal::fast::cos(theta);
+            float s = metal::fast::sin(theta);
+            float x0 = shared[lid];
+            float x1 = shared[lid + D / 2];
+            device T* out = (head < 32) ? (q_out + head * D) : (k_out + (head - 32) * D);
+            out[lid] = (T)(x0 * c - x1 * s);
+            out[lid + D / 2] = (T)(x0 * s + x1 * c);
+        }
+    """,
+)
+
+_FUSED_RN_KERNEL = mx.fast.metal_kernel(
+    name="lfm2_residual_rmsnorm_fused",
+    input_names=["r", "x", "w"],
+    output_names=["h", "normed"],
+    source=r"""
+        constexpr uint D = 2048;
+        constexpr uint NR = 4;
+        constexpr float EPS = 1e-5f;
+        uint lid = thread_position_in_threadgroup.x;
+        uint row = threadgroup_position_in_grid.x;
+        uint base = row * D;
+        const device T* rin = r + base + lid * NR;
+        const device T* xin = x + base + lid * NR;
+        const device T* w = w + lid * NR;
+        float tx[NR] = {0};
+        for (uint i = 0; i < NR; i++) {
+            tx[i] = (float)rin[i] + (float)xin[i];
+            h[base + lid * NR + i] = (T)tx[i];
+        }
+        float acc = 0;
+        for (uint i = 0; i < NR; i++) acc += tx[i] * tx[i];
+        threadgroup float gs[16];
+        acc = simd_sum(acc);
+        uint sg = lid / 32;
+        uint lane = lid % 32;
+        if (lane == 0) gs[sg] = acc;
+        threadgroup_barrier(mem_flags::mem_threadgroup);
+        float total = 0;
+        for (uint g = 0; g < 16; g++) total += gs[g];
+        float inv = metal::precise::rsqrt(total / (float)D + EPS);
+        for (uint i = 0; i < NR; i++) {
+            T nb = (T)(tx[i] * inv);
+            normed[base + lid * NR + i] = (T)(w[i] * nb);
+        }
+    """,
+)
+
+_RMSNORM_2048_KERNEL = mx.fast.metal_kernel(
+    name="lfm2_rmsnorm_2048",
+    input_names=["x", "w"],
+    output_names=["out"],
+    source=r"""
+        constexpr uint D = 2048;
+        constexpr uint NR = 4;
+        constexpr float EPS = 1e-5f;
+        uint lid = thread_position_in_threadgroup.x;
+        uint row = threadgroup_position_in_grid.x;
+        uint base = row * D;
+        const device T* xin = x + base + lid * NR;
+        const device T* w = w + lid * NR;
+        float tx[NR] = {0};
+        for (uint i = 0; i < NR; i++) tx[i] = (float)xin[i];
+        float acc = 0;
+        for (uint i = 0; i < NR; i++) acc += tx[i] * tx[i];
+        threadgroup float gs[16];
+        acc = simd_sum(acc);
+        uint sg = lid / 32;
+        uint lane = lid % 32;
+        if (lane == 0) gs[sg] = acc;
+        threadgroup_barrier(mem_flags::mem_threadgroup);
+        float total = 0;
+        for (uint g = 0; g < 16; g++) total += gs[g];
+        float inv = metal::precise::rsqrt(total / (float)D + EPS);
+        for (uint i = 0; i < NR; i++) {
+            T nb = (T)(tx[i] * inv);
+            out[base + lid * NR + i] = (T)(w[i] * nb);
+        }
+    """,
+)
+
+
+def _fused_rn(r, x, weight):
+    rows = x.size // 2048
+    return _FUSED_RN_KERNEL(
+        inputs=[r, x, weight], template=[("T", x.dtype)],
+        grid=(rows * 512, 1, 1), threadgroup=(512, 1, 1),
+        output_shapes=[(x.size,), (x.size,)],
+        output_dtypes=[x.dtype, x.dtype],
+    )
+
+
+def _fused_norm(x, weight):
+    rows = x.size // 2048
+    return _RMSNORM_2048_KERNEL(
+        inputs=[x, weight], template=[("T", x.dtype)],
+        grid=(rows * 512, 1, 1), threadgroup=(512, 1, 1),
+        output_shapes=[(x.size,)],
+        output_dtypes=[x.dtype],
+    )[0].reshape(x.shape)
+
 
 
