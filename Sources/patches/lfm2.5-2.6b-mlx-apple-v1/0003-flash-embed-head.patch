+    def _build_flash_embed(self):
+        import sys
+
+        embed = self.model.embed_tokens
+        try:
+            import mlx.nn as _nn
+
+            if not isinstance(embed, _nn.QuantizedEmbedding):
+                raise ValueError("embedding not quantized")
+            tok_specials = getattr(Model, "_flash_force_ids", [])
+            _FlashEmbedHead._force_ids = tok_specials
+            n_probes = int(os.environ.get("MLX_FLASH_EMBED_PROBES", "512"))
+            fh = _FlashEmbedHead(embed, n_probes)
+            print(
+                f"[lfm2] flash embed head: {fh.token_map.shape[0]} clusters, "
+                f"{fh.n_probes} probes, {len(tok_specials)} forced",
+                file=sys.stderr,
+            )
+            return fh
+        except Exception as e:
+            print(f"[lfm2] flash embed head disabled: {e}", file=sys.stderr)
+            return False
