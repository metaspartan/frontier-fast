--- a/mlx_lm/models/lfm2.py
+++ b/mlx_lm/models/lfm2.py
@@ -137,6 +137,40 @@
         mask: Optional[mx.array] = None,
         cache: Optional[Any] = None,
     ):
+        # Decode (L=1, L_cache=3): depthwise FIR as three FMAs in float32.
+        # Avoids the (B,3,H) concat + general grouped conv1d for the common
+        # single-token path (22 of 30 LFM2 layers). Prefill and lengths-based
+        # cache keep the stock path. Ranked gate is ppl (<=0.5%), not text.
+        if (
+            mask is None
+            and cache is not None
+            and x.shape[1] == 1
+            and self.L_cache == 3
+            and not self.bias
+            and getattr(cache, "lengths", None) is None
+        ):
+            state = cache[0]
+            if state is None:
+                state = mx.zeros(
+                    (x.shape[0], self.L_cache - 1, self.args.hidden_size),
+                    dtype=x.dtype,
+                )
+            BCx = self.in_proj(x)
+            B, C, xx = mx.split(BCx, 3, axis=-1)
+            Bx = B * xx
+            ww = self.conv.weight.reshape(self.args.hidden_size, self.L_cache)
+            s0 = state[:, 0:1, :]
+            s1 = state[:, 1:2, :]
+            conv = (
+                s0.astype(mx.float32) * ww[:, 0].astype(mx.float32)
+                + s1.astype(mx.float32) * ww[:, 1].astype(mx.float32)
+                + Bx.astype(mx.float32) * ww[:, 2].astype(mx.float32)
+            ).astype(Bx.dtype)
+            cache[0] = mx.concatenate([s1, Bx], axis=1)
+            if hasattr(cache, "advance"):
+                cache.advance(1)
+            return self.out_proj(C * conv)
+
         BCx = self.in_proj(x)
         B, C, x = mx.split(BCx, 3, axis=-1)
         Bx = B * x
