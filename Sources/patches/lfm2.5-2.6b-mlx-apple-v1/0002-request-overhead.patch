diff --git a/mlx_lm/tokenizer_utils.py b/mlx_lm/tokenizer_utils.py
index c7e50fb..df879d8 100644
--- a/mlx_lm/tokenizer_utils.py
+++ b/mlx_lm/tokenizer_utils.py
@@ -115,14 +115,26 @@ class SPMStreamingDetokenizer(StreamingDetokenizer):
         self.trim_space = trim_space
         self._sep = "\u2581".encode()
 
-        # Extract the tokens in a list from id to text
-        self.tokenmap = [""] * (max(tokenizer.vocab.values()) + 1)
-        for value, tokenid in tokenizer.vocab.items():
-            if value.startswith("<0x"):
-                # Replace bytes with their value
-                self.tokenmap[tokenid] = bytes([int(value[3:5], 16)])
-            else:
-                self.tokenmap[tokenid] = value.encode()
+        # Extract the tokens in a list from id to text. The map is immutable
+        # and identical for every detokenizer built from the same tokenizer,
+        # but `tokenizer.vocab` materializes a fresh vocab-size dict per
+        # access and the per-entry decode below runs tens of ms \u2014 paid on
+        # every stream_generate call. Build once, cache on the tokenizer.
+        tokenmap = getattr(tokenizer, "_spm_streaming_tokenmap", None)
+        if tokenmap is None:
+            vocab = tokenizer.vocab
+            tokenmap = [""] * (max(vocab.values()) + 1)
+            for value, tokenid in vocab.items():
+                if value.startswith("<0x"):
+                    # Replace bytes with their value
+                    tokenmap[tokenid] = bytes([int(value[3:5], 16)])
+                else:
+                    tokenmap[tokenid] = value.encode()
+            try:
+                tokenizer._spm_streaming_tokenmap = tokenmap
+            except AttributeError:
+                pass
+        self.tokenmap = tokenmap
 
         self.reset()
 
@@ -165,10 +177,20 @@ class BPEStreamingDetokenizer(StreamingDetokenizer):
     def __init__(self, tokenizer):
         self.clean_spaces = tokenizer.clean_up_tokenization_spaces
 
-        # Extract the tokens in a list from id to text
-        self.tokenmap = [None] * len(tokenizer.vocab)
-        for value, tokenid in tokenizer.vocab.items():
-            self.tokenmap[tokenid] = value
+        # Same one-time construction as the SPM detokenizer above: the map is
+        # immutable per tokenizer and `tokenizer.vocab` is a fresh dict per
+        # access, so rebuilding it per stream_generate call wastes tens of ms.
+        tokenmap = getattr(tokenizer, "_bpe_streaming_tokenmap", None)
+        if tokenmap is None:
+            vocab = tokenizer.vocab
+            tokenmap = [None] * len(vocab)
+            for value, tokenid in vocab.items():
+                tokenmap[tokenid] = value
+            try:
+                tokenizer._bpe_streaming_tokenmap = tokenmap
+            except AttributeError:
+                pass
+        self.tokenmap = tokenmap
 
         self.reset()
 
