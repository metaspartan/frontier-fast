diff --git a/mlx_lm/_gainz_request_overhead.py b/mlx_lm/_gainz_request_overhead.py
new file mode 100644
index 0000000..5249a0d
--- /dev/null
+++ b/mlx_lm/_gainz_request_overhead.py
@@ -0,0 +1,45 @@
+"""Request-path overhead fix: cache streaming-detokenizer construction.
+
+`TokenizerWrapper.detokenizer` builds a fresh detokenizer on every access,
+and every construction rebuilds an immutable tokenmap from a freshly
+materialized `tokenizer.vocab` dict — ~34-50 ms per `stream_generate` call
+for a 125k vocab, inside measured TTFT. The first construction per
+(tokenizer, class, args) is cached; later ones copy the cached attribute
+dict (sharing the immutable tokenmap) and re-run `reset()`, which
+reinitializes all mutable streaming state. Version-agnostic: no assumptions
+about which fields a given mlx-lm release stores.
+"""
+
+from . import tokenizer_utils as _tu
+
+
+def _wrap(cls):
+    orig = cls.__init__
+    if getattr(orig, "_gz_cached", False):
+        return
+
+    def __init__(self, tokenizer, *args, **kwargs):
+        key = (cls, args, tuple(sorted(kwargs.items())))
+        cache = getattr(tokenizer, "_gz_detok_cache", None)
+        if cache is not None and cache[0] == key:
+            self.__dict__.update(cache[1])
+            self.reset()
+            return
+        orig(self, tokenizer, *args, **kwargs)
+        try:
+            tokenizer._gz_detok_cache = (key, dict(self.__dict__))
+        except Exception:
+            pass
+
+    __init__._gz_cached = True
+    cls.__init__ = __init__
+
+
+for _name in dir(_tu):
+    _cls = getattr(_tu, _name)
+    if (
+        isinstance(_cls, type)
+        and _name.endswith("StreamingDetokenizer")
+        and _name != "StreamingDetokenizer"
+    ):
+        _wrap(_cls)
