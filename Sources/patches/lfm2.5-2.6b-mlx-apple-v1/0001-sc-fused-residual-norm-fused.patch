 from .cache import ArraysCache, KVCache
 
 
+_FUSED_SC_KERNEL = mx.fast.metal_kernel(
+    name="lfm2_shortconv_decode_fused",
+    input_names=["BCx", "state", "conv_w"],
+    output_names=["y", "new_state"],
+    source=r"""
+        uint h = thread_position_in_grid.x;
+        uint b = thread_position_in_grid.y;
+        uint H = conv_w_shape[0];
+        uint Bsz = BCx_shape[0];
+        if (h >= H || b >= Bsz) return;
+        uint bcx_base = b * 3 * H;
+        T Bb = BCx[bcx_base + h];
+        T Cc = BCx[bcx_base + H + h];
+        T xx = BCx[bcx_base + 2*H + h];
+        T Bx = Bb * xx;
+        uint st_base = b * 2 * H;
+        T s0 = state[st_base + h];
+        T s1 = state[st_base + H + h];
+        T w0 = conv_w[h * 3 + 0];
+        T w1 = conv_w[h * 3 + 1];
+        T w2 = conv_w[h * 3 + 2];
+        y[b * H + h] = Cc * (w0 * s0 + w1 * s1 + w2 * Bx);
+        new_state[st_base + h] = s1;
+        new_state[st_base + H + h] = Bx;
+    """,
+)
+
+_FUSED_RN_KERNEL = mx.fast.metal_kernel(
+    name="lfm2_residual_rmsnorm",
+    input_names=["r", "x", "weight"],
+    output_names=["h", "normed"],
+    source=r"""
+        constexpr uint D = 2048;
+        constexpr uint TG = 256;
+        constexpr float EPS = 1e-5f;
+        uint tid = thread_position_in_threadgroup.x;
+        uint row = threadgroup_position_in_grid.x;
+        uint nrows = r_shape[0] / D;
+        if (row >= nrows) return;
+        uint base = row * D;
+        threadgroup float buf[256];
+        float h_local[8];
+        float sumsq = 0.0f;
+        for (uint idx = 0; idx < 8; ++idx) {
+            uint j = tid + idx * TG;
+            if (j < D) {
+                float hv = (float)r[base + j] + (float)x[base + j];
+                h_local[idx] = hv;
+                h[base + j] = (T)hv;
+                sumsq += hv * hv;
+            }
+        }
+        buf[tid] = sumsq;
+        threadgroup_barrier(mem_flags::mem_threadgroup);
+        for (uint s = TG / 2; s > 0; s >>= 1) {
+            if (tid < s) buf[tid] += buf[tid + s];
+            threadgroup_barrier(mem_flags::mem_threadgroup);
+        }
+        float inv = metal::rsqrt(buf[0] / (float)D + EPS);
+        threadgroup_barrier(mem_flags::mem_threadgroup);
+        for (uint idx = 0; idx < 8; ++idx) {
+            uint j = tid + idx * TG;
+            if (j < D) {
+                normed[base + j] = (T)(h_local[idx] * inv * (float)weight[j]);
+            }
+        }
+    """,
+)
+
+
+def _fused_residual_norm(r, x, weight, eps=1e-5):
+    """Fused residual add + RMSNorm. Returns (h=x+r, normed=rmsnorm(h))."""
+    if x.shape[-1] != 2048:
+        h = x + r
+        return h, mx.fast.rms_norm(h, weight, eps)
+    rows = x.size // 2048
+    h, normed = _FUSED_RN_KERNEL(
+        inputs=[r.reshape(-1), x.reshape(-1), weight],
+        template=[("T", x.dtype)],
+        grid=(rows, 1, 1),
+        threadgroup=(256, 1, 1),
+        output_shapes=[(r.size,), (r.size,)],
+        output_dtypes=[x.dtype, x.dtype],
+    )
+    return h.reshape(x.shape), normed.reshape(x.shape)
+
+
+
