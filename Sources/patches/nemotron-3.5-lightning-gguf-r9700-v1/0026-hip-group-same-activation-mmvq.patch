+
+struct mmvq_grouped_args {
+    const void * vx[MMVQ_MAX_GROUP_SIZE];
+    float      * dst[MMVQ_MAX_GROUP_SIZE];
+    uint32_t     seg_end[MMVQ_MAX_GROUP_SIZE];
+};
+
+template <ggml_type type>
+__launch_bounds__(calc_nwarps(type, 1, get_device_table_id())*ggml_cuda_get_physical_warp_size(), 1)
+static __global__ void mul_mat_vec_q_grouped(
+        const mmvq_grouped_args args, const void * vy_ptr,
+        const uint32_t ncols_x, const uint32_t stride_row_x) {
+    constexpr int ncols_dst = 1;
+    constexpr int qk  = ggml_cuda_type_traits<type>::qk;
+    constexpr int qi  = ggml_cuda_type_traits<type>::qi;
+    constexpr int vdr = get_vdr_mmvq(type);
+    constexpr mmvq_parameter_table_id table_id = get_device_table_id();
+    constexpr int nwarps = calc_nwarps(type, ncols_dst, table_id);
+    constexpr int rows_per_cuda_block = calc_rows_per_block(ncols_dst, table_id, /*small_k=*/false, nwarps);
+    static_assert(rows_per_cuda_block == 1, "grouped mmvq requires the block index to be the row index");
+    constexpr int warp_size = ggml_cuda_get_physical_warp_size();
+    constexpr vec_dot_q_cuda_t vec_dot_q_cuda = get_vec_dot_q_cuda(type);
+    const uint32_t nwarps_launched = blockDim.y;
+    const int tid = warp_size*threadIdx.y + threadIdx.x;
+
+    uint32_t seg       = 0;
+    uint32_t seg_start = 0;
+#pragma unroll
+    for (int s = 0; s < MMVQ_MAX_GROUP_SIZE - 1; ++s) {
+        if (blockIdx.x >= args.seg_end[s]) {
+            seg       = s + 1;
+            seg_start = args.seg_end[s];
+        }
+    }
+    const void * GGML_CUDA_RESTRICT vx  = args.vx[seg];
+    float       * GGML_CUDA_RESTRICT dst = args.dst[seg];
+
+    const     int row0 = rows_per_cuda_block*(int)(blockIdx.x - seg_start);
+    const     int blocks_per_row_x = ncols_x / qk;
+    constexpr int blocks_per_iter = vdr * nwarps*warp_size / qi;
+
+    ggml_cuda_pdl_sync();
+
+    float tmp[ncols_dst][rows_per_cuda_block] = {{0.0f}};
+    const int kbx_offset = row0*stride_row_x;
+
+    for (int kbx = tid / (qi/vdr); kbx < blocks_per_row_x; kbx += blocks_per_iter) {
+        const int kby = kbx * (qk/QK8_1);
+        const int kqs = vdr * (tid % (qi/vdr));
+#pragma unroll
+        for (int j = 0; j < ncols_dst; ++j) {
+#pragma unroll
+            for (int i = 0; i < rows_per_cuda_block; ++i) {
+                tmp[j][i] += vec_dot_q_cuda(
+                    vx, &((const block_q8_1 *) vy_ptr)[kby],
+                    kbx_offset + i*stride_row_x + kbx, kqs);
+            }
+        }
+    }
+
+    __shared__ float tmp_shared[nwarps-1 > 0 ? nwarps-1 : 1][ncols_dst][rows_per_cuda_block][warp_size];
+    if (threadIdx.y == 0 && nwarps_launched < uint32_t(nwarps)) {
+        for (uint32_t l = nwarps_launched - 1; l < uint32_t(nwarps) - 1; ++l) {
+#pragma unroll
+            for (int j = 0; j < ncols_dst; ++j) {
+#pragma unroll
+                for (int i = 0; i < rows_per_cuda_block; ++i) {
+                    tmp_shared[l][j][i][threadIdx.x] = 0.0f;
+                }
+            }
+        }
+    }
+    if (threadIdx.y > 0) {
+#pragma unroll
+        for (int j = 0; j < ncols_dst; ++j) {
+#pragma unroll
+            for (int i = 0; i < rows_per_cuda_block; ++i) {
+                tmp_shared[threadIdx.y-1][j][i][threadIdx.x] = tmp[j][i];
+            }
+        }
+    }
+    __syncthreads();
+    if (threadIdx.y > 0) {
+        return;
+    }
+    dst += row0;
+#pragma unroll
+    for (int j = 0; j < ncols_dst; ++j) {
+#pragma unroll
+        for (int i = 0; i < rows_per_cuda_block; ++i) {
+#pragma unroll
+            for (int l = 0; l < nwarps-1; ++l) {
+                tmp[j][i] += tmp_shared[l][j][i][threadIdx.x];
+            }
+            tmp[j][i] = warp_reduce_sum<warp_size>(tmp[j][i]);
+            if (threadIdx.x == i) {
+                dst[i] = tmp[j][i];
+            }
+        }
+    }
+}
+
+template <ggml_type type>
+static void mul_mat_vec_q_grouped_launch(
+        const mmvq_grouped_args & args, const void * vy, const uint32_t total_rows,
+        const uint32_t ncols_x, const uint32_t stride_row_x, cudaStream_t stream) {
+    const int device    = ggml_cuda_get_device();
+    const int cc        = ggml_cuda_info().devices[device].cc;
+    const int warp_size = ggml_cuda_info().devices[device].warp_size;
+    const mmvq_parameter_table_id table_id = get_device_table_id(cc);
+    const int nwarps = calc_nwarps(type, 1, table_id);
+    GGML_ASSERT(calc_rows_per_block(1, table_id, /*small_k=*/false, nwarps) == 1);
+    const dim3 block_nums(total_rows, 1, 1);
+    const dim3 block_dims(warp_size, calc_nwarps_launched<type>(1, ncols_x, total_rows, nwarps, warp_size), 1);
+    const ggml_cuda_kernel_launch_params launch_params = ggml_cuda_kernel_launch_params(block_nums, block_dims, 0, stream);
+    ggml_cuda_kernel_launch(mul_mat_vec_q_grouped<type>, launch_params, args, vy, ncols_x, stride_row_x);
+}
+
+static void mul_mat_vec_q_grouped_switch_type(
+        const ggml_type type, const mmvq_grouped_args & args, const void * vy, const uint32_t total_rows,
+        const uint32_t ncols_x, const uint32_t stride_row_x, cudaStream_t stream) {
+    switch (type) {
+#define MMVQ_GROUPED_CASE(t) case t: mul_mat_vec_q_grouped_launch<t>(args, vy, total_rows, ncols_x, stride_row_x, stream); break;
+        MMVQ_GROUPED_CASE(GGML_TYPE_Q4_0)
+        MMVQ_GROUPED_CASE(GGML_TYPE_Q4_1)
+        MMVQ_GROUPED_CASE(GGML_TYPE_Q5_0)
+        MMVQ_GROUPED_CASE(GGML_TYPE_Q5_1)
+        MMVQ_GROUPED_CASE(GGML_TYPE_Q8_0)
+        MMVQ_GROUPED_CASE(GGML_TYPE_Q2_K)
+        MMVQ_GROUPED_CASE(GGML_TYPE_Q3_K)
+        MMVQ_GROUPED_CASE(GGML_TYPE_Q4_K)
+        MMVQ_GROUPED_CASE(GGML_TYPE_Q5_K)
+        MMVQ_GROUPED_CASE(GGML_TYPE_Q6_K)
+#undef MMVQ_GROUPED_CASE
+        default:
+            GGML_ABORT("fatal error");
+            break;
+    }
+}
+
 void ggml_cuda_mul_mat_vec_q(
         ggml_backend_cuda_context & ctx, const ggml_tensor * src0, const ggml_tensor * src1, const ggml_tensor * ids, ggml_tensor * dst,
         const ggml_cuda_mm_fusion_args_host * fusion,
@@ -1817,3 +1957,63 @@ void ggml_cuda_op_mul_mat_vec_q(
 
     GGML_UNUSED_VARS(src1, dst, src1_ddf_i, src1_ncols, src1_padded_row_size);
 }
+
+
+void ggml_cuda_mul_mat_vec_q_grouped(ggml_backend_cuda_context & ctx, ggml_tensor * const * nodes, int n_nodes) {
+    GGML_ASSERT(n_nodes >= 2 && n_nodes <= MMVQ_MAX_GROUP_SIZE);
+
+    const ggml_tensor * src1       = nodes[0]->src[1];
+    const ggml_tensor * src0_first = nodes[0]->src[0];
+    const ggml_type     type       = src0_first->type;
+
+    GGML_ASSERT(src1->type == GGML_TYPE_F32);
+    GGML_ASSERT(src1->ne[1] == 1 && src1->ne[2] == 1 && src1->ne[3] == 1);
+
+    cudaStream_t stream = ctx.stream();
+
+    const size_t  ts_src1     = ggml_type_size(src1->type);
+    const int64_t ne10        = src1->ne[0];
+    const int64_t ne10_padded = GGML_PAD(ne10, MATRIX_ROW_PADDING);
+
+    const char * src1_q8_1 = nullptr;
+    {
+        const int64_t s11 = src1->nb[1] / ts_src1;
+        const int64_t s12 = src1->nb[2] / ts_src1;
+        const int64_t s13 = src1->nb[3] / ts_src1;
+        src1_q8_1 = ctx.quantized_src1_cache.find(src1, stream, ne10, s11, s12, s13, ne10_padded, 1, 1, 1);
+        if (src1_q8_1 == nullptr) {
+            const size_t size_q8_1 = ne10_padded * sizeof(block_q8_1)/QK8_1;
+            char * dst_q8_1 = ctx.quantized_src1_cache.insert(
+                ctx.pool(), src1, stream, ne10, s11, s12, s13, ne10_padded, 1, 1, 1, size_q8_1);
+            quantize_row_q8_1_cuda((const float *) src1->data, nullptr, dst_q8_1, type,
+                ne10, s11, s12, s13, ne10_padded, 1, 1, 1, stream);
+            src1_q8_1 = dst_q8_1;
+        }
+    }
+
+    const size_t  ts_src0      = ggml_type_size(type);
+    const int64_t stride_row_x = src0_first->nb[1] / ts_src0;
+
+    mmvq_grouped_args args = {};
+    uint32_t total_rows = 0;
+    for (int m = 0; m < n_nodes; ++m) {
+        const ggml_tensor * src0 = nodes[m]->src[0];
+        const ggml_tensor * dst  = nodes[m];
+        GGML_ASSERT(dst->op == GGML_OP_MUL_MAT);
+        GGML_ASSERT(dst->src[1] == src1 && dst->src[2] == nullptr);
+        GGML_ASSERT(src0->type == type);
+        GGML_ASSERT(src0->ne[0] == ne10);
+        GGML_ASSERT((int64_t)(src0->nb[1]/ts_src0) == stride_row_x);
+        GGML_ASSERT(dst->type == GGML_TYPE_F32);
+        GGML_ASSERT(dst->ne[0] == src0->ne[1]);
+        args.vx[m]      = src0->data;
+        args.dst[m]     = (float *) dst->data;
+        total_rows     += (uint32_t) src0->ne[1];
+        args.seg_end[m] = total_rows;
+    }
+    for (int m = n_nodes; m < MMVQ_MAX_GROUP_SIZE; ++m) {
+        args.seg_end[m] = total_rows;
+    }
+
+    mul_mat_vec_q_grouped_switch_type(type, args, src1_q8_1, total_rows, (uint32_t) ne10, (uint32_t) stride_row_x, stream);
+}
