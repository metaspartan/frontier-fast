 #include <cstdint>
 
 template <int block_size>
@@ -439,6 +440,70 @@ void ggml_cuda_op_rms_norm_fused_pre_add(ggml_backend_cuda_context & ctx,
 #undef RMS_NORM_PRE_ADD_LAUNCH_CASE
 }
 
+// Decode-only Nemotron Mamba tail.  One block owns one complete 512-value
+// grouped-RMS row.  Keeping the SwiGLU result in volatile F32 shared memory
+// preserves the standalone GLU kernel's F32 store/load boundary before the
+// RMS reduction, while eliminating that launch and its global round trip.
+// The RMS and q8_1 statements below intentionally match
+// rms_norm_mul_quant_f32 exactly.
+static __global__ void nemo_mamba_swiglu_rms_norm_mul_quant_f32(
+        const float * x, const float * g, const float * mul, float * dst,
+        const float eps, void * q8_1_dst) {
+    constexpr int ncols = 512;
+    constexpr int block_size = 256;
+
+    ggml_cuda_pdl_lc();
+    const int row = blockIdx.x;
+    const int tid = threadIdx.x;
+
+    extern __shared__ float shared[];
+    volatile float * glu_round = shared;
+    float * s_sum = shared + ncols;
+
+    ggml_cuda_pdl_sync();
+    for (int col = tid; col < ncols; col += block_size) {
+        const int i = row*ncols + col;
+        glu_round[col] = ggml_cuda_op_silu_single(x[i]) * g[i];
+    }
+    __syncthreads();
+
+    float tmp = 0.0f;
+    for (int col = tid; col < ncols; col += block_size) {
+        const float xi = glu_round[col];
+        tmp += xi * xi;
+    }
+
+    tmp = block_reduce<block_reduce_method::SUM, block_size>(tmp, s_sum);
+
+    const float mean  = tmp / ncols;
+    const float scale = rsqrtf(mean + eps);
+    block_q8_1 * y = (block_q8_1 *) q8_1_dst;
+
+    for (int col = tid; col < ncols; col += block_size) {
+        const float val = scale * glu_round[col] * mul[row*ncols + col];
+        const int64_t i_cont = (int64_t) row*ncols + col;
+        const int64_t ib     = i_cont / QK8_1;
+        const int64_t iqs    = i_cont % QK8_1;
+
+        dst[i_cont] = val;
+
+        const float xq = val;
+        float amax = fabsf(xq);
+        float sum  = xq;
+
+        amax = warp_reduce_max<QK8_1>(amax);
+        sum  = warp_reduce_sum<QK8_1>(sum);
+
+        const float  d = amax / 127.0f;
+        const int8_t q = amax == 0.0f ? 0 : roundf(xq / d);
+
+        y[ib].qs[iqs] = q;
+        if (iqs == 0) {
+            y[ib].ds = make_half2(d, sum);
+        }
+    }
+}
+
 template <int block_size>
 static __global__ void rms_norm_back_f32(
         const float * grad, const float * xf, float * dst, const int ncols, const float eps) {
@@ -942,6 +1007,34 @@ void ggml_cuda_op_rms_norm_fused_quant(ggml_backend_cuda_context & ctx,
         eps, q8_1_dst, ctx.stream());
 }
 
+void ggml_cuda_op_nemo_mamba_swiglu_rms_norm_fused_quant(
+        ggml_backend_cuda_context & ctx, ggml_tensor * glu, ggml_tensor * rms_norm,
+        ggml_tensor * mul_tensor, char * q8_1_dst) {
+    const ggml_tensor * x = glu->src[0];
+    const ggml_tensor * g = glu->src[1];
+    const ggml_tensor * mul_src = mul_tensor->src[0] == rms_norm ?
+        mul_tensor->src[1] : mul_tensor->src[0];
+
+    float eps = 0.0f;
+    memcpy(&eps, rms_norm->op_params, sizeof(float));
+
+    GGML_ASSERT(x != nullptr && g != nullptr && mul_src != nullptr && q8_1_dst != nullptr);
+    GGML_ASSERT(x->type == GGML_TYPE_F32 && g->type == GGML_TYPE_F32);
+    GGML_ASSERT(glu->type == GGML_TYPE_F32 && rms_norm->type == GGML_TYPE_F32);
+    GGML_ASSERT(mul_src->type == GGML_TYPE_F32 && mul_tensor->type == GGML_TYPE_F32);
+    GGML_ASSERT(eps >= 0.0f);
+
+    const dim3 blocks_num(8, 1, 1);
+    const dim3 block_dims(256, 1, 1);
+    const size_t shared_bytes = (512 + 32)*sizeof(float);
+    const ggml_cuda_kernel_launch_params launch_params = {
+        blocks_num, block_dims, shared_bytes, ctx.stream()
+    };
+    ggml_cuda_kernel_launch(nemo_mamba_swiglu_rms_norm_mul_quant_f32, launch_params,
+        (const float *) x->data, (const float *) g->data, (const float *) mul_src->data,
+        (float *) mul_tensor->data, eps, q8_1_dst);
+}
+
 void ggml_cuda_op_rms_norm_fused_add(ggml_backend_cuda_context & ctx,
                                      ggml_tensor *               dst,
                                      ggml_tensor *               mul_tensor,
