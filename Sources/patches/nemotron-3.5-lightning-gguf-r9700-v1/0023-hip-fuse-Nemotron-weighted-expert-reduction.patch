diff --git a/ggml/src/ggml-cuda/binbcast.cu b/ggml/src/ggml-cuda/binbcast.cu
index 2e38077bf..c98f5e83d 100644
--- a/ggml/src/ggml-cuda/binbcast.cu
+++ b/ggml/src/ggml-cuda/binbcast.cu
@@ -542,6 +542,59 @@ void ggml_cuda_op_fused_mul(ggml_backend_cuda_context & ctx, ggml_tensor * dst,
     }
 }
 
+// Exact batch-one Nemotron routed-expert tail. Stock first materializes six
+// rounded F32 products, then reduces the six expert views left-to-right in a
+// second launch. Explicit RN operations and AMD optimizer barriers preserve
+// those arithmetic boundaries while the single kernel avoids the product
+// tensor write/read and one dispatch.
+static __global__ void k_nemo_moe_weighted_reduce_f32(
+        const float * routed, const float * weights, float * dst) {
+    constexpr int n_embd = 2688;
+    __shared__ float staged_weights[6];
+    if (threadIdx.x < 6) {
+        staged_weights[threadIdx.x] = weights[threadIdx.x];
+    }
+    __syncthreads();
+
+    // A single block makes the weight staging a grid-wide boundary. The graph
+    // allocator may reuse the tiny routing-weight allocation for dst; every
+    // thread has copied those six values before any destination store occurs.
+    for (int i = threadIdx.x; i < n_embd; i += blockDim.x) {
+        float p0 = __fmul_rn(routed[0*n_embd + i], staged_weights[0]);
+        float p1 = __fmul_rn(routed[1*n_embd + i], staged_weights[1]);
+        float p2 = __fmul_rn(routed[2*n_embd + i], staged_weights[2]);
+        float p3 = __fmul_rn(routed[3*n_embd + i], staged_weights[3]);
+        float p4 = __fmul_rn(routed[4*n_embd + i], staged_weights[4]);
+        float p5 = __fmul_rn(routed[5*n_embd + i], staged_weights[5]);
+#if defined(__HIP_PLATFORM_AMD__)
+        asm volatile("" : "+v"(p0), "+v"(p1), "+v"(p2), "+v"(p3), "+v"(p4), "+v"(p5));
+#endif
+        float sum = __fadd_rn(p0, p1);
+        sum = __fadd_rn(sum, p2);
+        sum = __fadd_rn(sum, p3);
+        sum = __fadd_rn(sum, p4);
+        sum = __fadd_rn(sum, p5);
+        dst[i] = sum;
+    }
+}
+
+void ggml_cuda_op_nemo_moe_weighted_reduce(
+        ggml_backend_cuda_context & ctx,
+        const ggml_tensor * routed,
+        const ggml_tensor * weights,
+        ggml_tensor * dst) {
+    GGML_ASSERT(routed->type == GGML_TYPE_F32 && weights->type == GGML_TYPE_F32 && dst->type == GGML_TYPE_F32);
+    GGML_ASSERT(routed->ne[0] == 2688 && routed->ne[1] == 6 && ggml_is_contiguous(routed));
+    GGML_ASSERT(weights->ne[0] == 1 && weights->ne[1] == 6 && ggml_is_contiguous(weights));
+    GGML_ASSERT(dst->ne[0] == 2688 && dst->ne[1] == 1 && ggml_is_contiguous(dst));
+
+    constexpr int block_size = 256;
+    const dim3 blocks(1, 1, 1);
+    const ggml_cuda_kernel_launch_params launch_params(blocks, block_size, 0, ctx.stream());
+    ggml_cuda_kernel_launch(k_nemo_moe_weighted_reduce_f32, launch_params,
+        (const float *) routed->data, (const float *) weights->data, (float *) dst->data);
+}
+
