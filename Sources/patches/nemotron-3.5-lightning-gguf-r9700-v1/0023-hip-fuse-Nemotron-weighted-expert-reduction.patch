--- a/ggml/src/ggml-cuda/ggml-cuda.cu
+++ b/ggml/src/ggml-cuda/ggml-cuda.cu
@@ -4249,6 +4249,99 @@ static bool ggml_cuda_nemo_mamba_ssm_out_ok(
         mm->ne[2] == 1 && mm->ne[3] == 1;
 }
 
+struct ggml_cuda_nemo_moe_weighted_reduce_tail {
+    const ggml_tensor * routed  = nullptr;
+    const ggml_tensor * weights = nullptr;
+    ggml_tensor * dst           = nullptr;
+};
+
+// Match MUL(routed[2688,6], weights[1,6]), six ordered views, and the five
+// left-associated ADDs emitted by build_moe_ffn. The routed MMID remains a
+// separate, fully completed launch; only the two elementwise launches become
+// one, avoiding the cross-block race of an MMVQ-epilogue implementation.
+static bool ggml_cuda_nemo_moe_weighted_reduce_detect(
+        const ggml_cgraph * cgraph, const int i,
+        ggml_cuda_nemo_moe_weighted_reduce_tail & tail) {
+    constexpr int n_experts = 6;
+    constexpr int n_nodes   = 1 + n_experts + (n_experts - 1);
+    if (i + n_nodes > cgraph->n_nodes) {
+        return false;
+    }
+
+    ggml_tensor * weighted = cgraph->nodes[i];
+    if (weighted->op != GGML_OP_MUL || weighted->type != GGML_TYPE_F32 ||
+            weighted->ne[0] != 2688 || weighted->ne[1] != n_experts ||
+            weighted->ne[2] != 1 || weighted->ne[3] != 1 || !ggml_is_contiguous(weighted)) {
+        return false;
+    }
+    const ggml_tensor * routed = weighted->src[0] != nullptr && weighted->src[0]->op == GGML_OP_MUL_MAT_ID ?
+        weighted->src[0] : weighted->src[1];
+    const ggml_tensor * weights = routed == weighted->src[0] ? weighted->src[1] : weighted->src[0];
+    if (routed == nullptr || weights == nullptr || routed->op != GGML_OP_MUL_MAT_ID ||
+            routed->type != GGML_TYPE_F32 || !ggml_are_same_shape(routed, weighted) ||
+            !ggml_is_contiguous(routed) || weights->type != GGML_TYPE_F32 ||
+            weights->ne[0] != 1 || weights->ne[1] != n_experts ||
+            weights->ne[2] != 1 || weights->ne[3] != 1 || !ggml_is_contiguous(weights)) {
+        return false;
+    }
+
+    ggml_tensor * views[n_experts];
+    for (int expert = 0; expert < n_experts; ++expert) {
+        views[expert] = cgraph->nodes[i + 1 + expert];
+        if (views[expert]->op != GGML_OP_VIEW || views[expert]->src[0] != weighted ||
+                views[expert]->type != GGML_TYPE_F32 || views[expert]->ne[0] != 2688 ||
+                views[expert]->ne[1] != 1 || views[expert]->ne[2] != 1 || views[expert]->ne[3] != 1 ||
+                views[expert]->data != (char *) weighted->data + expert*weighted->nb[1]) {
+            return false;
+        }
+    }
+
+    ggml_tensor * previous = nullptr;
+    for (int add = 0; add < n_experts - 1; ++add) {
+        ggml_tensor * current = cgraph->nodes[i + 1 + n_experts + add];
+        const ggml_tensor * lhs = add == 0 ? views[0] : previous;
+        const ggml_tensor * rhs = views[add + 1];
+        if (current->op != GGML_OP_ADD || current->src[0] != lhs || current->src[1] != rhs ||
+                current->type != GGML_TYPE_F32 || current->ne[0] != 2688 || current->ne[1] != 1 ||
+                current->ne[2] != 1 || current->ne[3] != 1 || !ggml_is_contiguous(current)) {
+            return false;
+        }
+        previous = current;
+    }
+
+    const ggml_op ops[n_nodes] = {
+        GGML_OP_MUL,
+        GGML_OP_VIEW, GGML_OP_VIEW, GGML_OP_VIEW, GGML_OP_VIEW, GGML_OP_VIEW, GGML_OP_VIEW,
+        GGML_OP_ADD, GGML_OP_ADD, GGML_OP_ADD, GGML_OP_ADD, GGML_OP_ADD,
+    };
+    const int out_nodes[] = { i + n_nodes - 1 };
+    if (!ggml_can_fuse_subgraph(cgraph, i, n_nodes, ops, out_nodes, 1)) {
+        return false;
+    }
+
+    const auto disjoint = [](const ggml_tensor * a, const ggml_tensor * b) {
+        if (a == nullptr || b == nullptr || a->buffer == nullptr || b->buffer == nullptr) {
+            return false;
+        }
+        const uintptr_t a0 = (uintptr_t) a->data;
+        const uintptr_t b0 = (uintptr_t) b->data;
+        const uintptr_t a1 = a0 + ggml_backend_buft_get_alloc_size(a->buffer->buft, a);
+        const uintptr_t b1 = b0 + ggml_backend_buft_get_alloc_size(b->buffer->buft, b);
+        return a1 <= b0 || b1 <= a0;
+    };
+    // dst must not overwrite routed expert values. An overlap with the six
+    // routing weights is allowed: the specialized single-block kernel stages
+    // all of them before its first destination store.
+    if (!disjoint(previous, routed)) {
+        return false;
+    }
+
+    tail.routed  = routed;
+    tail.weights = weights;
+    tail.dst     = previous;
+    return true;
+}
+
 // try and fuse nodes and return the number of nodes to skip
 static int ggml_cuda_try_fuse(ggml_backend_cuda_context * cuda_ctx, ggml_cgraph * cgraph, int i) {
 
@@ -4259,6 +4352,27 @@ static int ggml_cuda_try_fuse(ggml_backend_cuda_context * cuda_ctx, ggml_cgraph
 
     ggml_tensor * node = cgraph->nodes[i];
 
+    static const bool disable_nemo_moe_weighted_reduce = [] {
+        const char * value = std::getenv("GGML_CUDA_DISABLE_NEMO_MOE_WEIGHTED_REDUCE");
+        return value != nullptr && std::atoi(value) != 0;
+    }();
+    if (!disable_nemo_moe_weighted_reduce && node->op == GGML_OP_MUL) {
+        ggml_cuda_nemo_moe_weighted_reduce_tail tail;
+        if (ggml_cuda_nemo_moe_weighted_reduce_detect(cgraph, i, tail)) {
+            ggml_cuda_op_nemo_moe_weighted_reduce(*cuda_ctx, tail.routed, tail.weights, tail.dst);
+            static const bool print_stats = [] {
+                const char * value = std::getenv("GGML_CUDA_NEMO_MOE_WEIGHTED_REDUCE_STATS");
+                return value != nullptr && std::atoi(value) != 0;
+            }();
+            static std::atomic<uint64_t> n_fused{0};
+            const uint64_t count = n_fused.fetch_add(1, std::memory_order_relaxed) + 1;
+            if (print_stats && (count <= 23 || count % 23 == 0)) {
+                GGML_LOG_INFO("%s: Nemotron weighted expert reduction fire=%" PRIu64 "\n", __func__, count);
+            }
+            return 11;
+        }
+    }
+
     // Mamba2 SSM_SCAN -> CPY: write the final recurrent state directly to the
     // identity-mapped single cache row. This has its own toggle so the same
     // binary can provide a strict A/B control while retaining other fusions.
