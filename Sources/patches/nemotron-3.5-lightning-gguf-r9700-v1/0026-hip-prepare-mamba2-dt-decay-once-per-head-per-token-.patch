From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Claude Code <noreply@anthropic.com>
Date: Thu, 13 Aug 2026 21:00:00 +0000
Subject: [PATCH] hip: prepare Mamba2 dt decay once per head per prompt token

---
 ggml/src/ggml-cuda/ssm-scan.cu | 61 +++++++++++++++++++++++++++++++++-
 1 file changed, 60 insertions(+), 1 deletion(-)

diff --git a/ggml/src/ggml-cuda/ssm-scan.cu b/ggml/src/ggml-cuda/ssm-scan.cu
index 4c071daeb..f60533c2b 100644
--- a/ggml/src/ggml-cuda/ssm-scan.cu
+++ b/ggml/src/ggml-cuda/ssm-scan.cu
@@ -163,6 +163,42 @@ static __global__ void ssm_dt_prepare_f32(
     dA[head]          = expf(dt_sp * A[head]);
 }
 
+// Prefill counterpart of ssm_dt_prepare_f32.  softplus(dt) and exp(softplus(dt)*A)
+// depend only on (head, token), but the scan evaluates both inside its token loop
+// in every one of the d_head warps that share a head -- 64 warps per head on
+// Nemotron, so 64x the transcendental work at every prompt position.  Evaluate the
+// pair once per (head, token) here and let the scan read it.
+//
+// The expressions, their operand order and their inputs are the ones the scan
+// itself would have used, so the values it consumes are bit-identical; only the
+// number of times they are computed changes.  dt already carries its bias by the
+// time it reaches SSM_SCAN in the prefill graph, so there is no ADD boundary to
+// preserve the way the decode path has to.
+static __global__ void ssm_dt_prepare_batch_f32(
+        const char * __restrict__ dt_base, const int dt_nb1, const int dt_nb2,
+        const float * __restrict__ A, const int A_nb1,
+        float * __restrict__ dt_softplus, float * __restrict__ dA,
+        const int n_head, const int n_tok) {
+    const int idx = blockIdx.x * blockDim.x + threadIdx.x;
+    if (idx >= n_head * n_tok) {
+        return;
+    }
+
+    const int head = idx % n_head;
+    const int tok  = idx / n_head;
+    const int seq  = blockIdx.y;
+
+    const float dt  = *(const float *) (dt_base + (size_t) seq * dt_nb2 + (size_t) tok * dt_nb1
+                                        + (size_t) head * sizeof(float));
+    const float A_h = *(const float *) ((const char *) A + (size_t) head * A_nb1);
+
+    const float dt_sp = dt <= 20.0f ? log1pf(expf(dt)) : dt;
+
+    const int off = seq * n_head * n_tok + idx;
+    dt_softplus[off] = dt_sp;
+    dA[off]          = expf(dt_sp * A_h);
+}
+
 // assumes as many threads as d_state
 template <int c_factor, int d_state, bool use_prepared_dt>
 __global__ void __launch_bounds__(d_state, 1)
@@ -873,6 +909,8 @@ void ggml_cuda_op_ssm_scan(ggml_backend_cuda_context & ctx, ggml_tensor * dst,
 
     ggml_cuda_pool_alloc<float> dt_prepared(ctx.pool());
     const float * prepared_dA_d = nullptr;
+    int src2_nb1_eff = (int) src2->nb[1];
+    int src2_nb2_eff = (int) src2->nb[2];
     if (dt_fusion != nullptr) {
         GGML_ASSERT(dt_fusion->dt_raw != nullptr && dt_fusion->dt_bias != nullptr);
         GGML_ASSERT(n_t == 1 && n_s == 1 && src3->nb[1] == sizeof(float));
@@ -888,6 +926,27 @@ void ggml_cuda_op_ssm_scan(ggml_backend_cuda_context & ctx, ggml_tensor * dst,
         prepared_dA_d = prepared + nh;
     }
 
+    // Same idea for the prompt graph, where there is no dt ADD to fuse but the
+    // per-warp repetition is the same and runs at every prompt position.
+    static const bool ssm_dt_prefill_off = std::getenv("GGML_CUDA_NO_SSM_DT_PREFILL") != nullptr;
+    if (prepared_dA_d == nullptr && !ssm_dt_prefill_off && n_t > 1 && src3->nb[1] == sizeof(float)
+            && (nc == 128 || nc == 256) && src2->nb[0] == sizeof(float) && nh > 0 && n_s > 0) {
+        const int64_t n_val = nh * n_t * n_s;
+        float * prepared = dt_prepared.alloc(2 * n_val);
+
+        constexpr int threads = 256;
+        const dim3 blocks((nh * n_t + threads - 1) / threads, n_s, 1);
+        ssm_dt_prepare_batch_f32<<<blocks, threads, 0, stream>>>(
+            (const char *) src2_d, (int) src2->nb[1], (int) src2->nb[2],
+            src3_d, (int) src3->nb[1],
+            prepared, prepared + n_val, (int) nh, (int) n_t);
+
+        src2_d        = prepared;
+        prepared_dA_d = prepared + n_val;
+        src2_nb1_eff  = (int) (nh * sizeof(float));
+        src2_nb2_eff  = (int) (nh * n_t * sizeof(float));
+    }
+
     GGML_ASSERT(src0->type == GGML_TYPE_F32);
     GGML_ASSERT(src6->type == GGML_TYPE_I32);
     GGML_ASSERT(dst->type == GGML_TYPE_F32);
@@ -939,7 +998,7 @@ void ggml_cuda_op_ssm_scan(ggml_backend_cuda_context & ctx, ggml_tensor * dst,
 #endif
     ssm_scan_f32_cuda(src0_d, src1_d, src2_d, src3_d, src4_d, src5_d, src6_d, dst_d,
                       state_dst_d, output_d_d, output_d_dst_d, prepared_dA_d,
-                      src0->nb[2], src0->nb[3], src1->nb[2], src1->nb[3], src2->nb[1], src2->nb[2],
+                      src0->nb[2], src0->nb[3], src1->nb[2], src1->nb[3], src2_nb1_eff, src2_nb2_eff,
                       src3->nb[1], src4->nb[2], src4->nb[3], src5->nb[2], src5->nb[3],
                       s_off, nc, nr, nh, ng, n_t, n_s, stream);
 }
