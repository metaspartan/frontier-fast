@@ -501,6 +502,11 @@ static __global__ void mul_mat_vec_q(
 
     constexpr vec_dot_q_cuda_t vec_dot_q_cuda = get_vec_dot_q_cuda(type);
 
+    // The host can omit only trailing warps whose k-loop has no work. The kernel's
+    // compile-time nwarps remains unchanged, preserving every active thread's k-block
+    // assignment and the stock reduction order.
+    const uint32_t nwarps_launched = blockDim.y;
+
     const     int tid = warp_size*threadIdx.y + threadIdx.x;
     const     int row0 = rows_per_cuda_block*blockIdx.x;
     const     int blocks_per_row_x = ncols_x / qk;
@@ -616,6 +622,25 @@ static __global__ void mul_mat_vec_q(
     __shared__ float tmp_shared[nwarps-1 > 0 ? nwarps-1 : 1][ncols_dst][rows_per_cuda_block][warp_size];
     [[maybe_unused]] __shared__ float tmp_shared_gate[(has_fusion && (nwarps-1 > 0)) ? nwarps-1 : 1][ncols_dst][rows_per_cuda_block][warp_size];
 
+    // A trimmed warp would have stored +0.0f because its k-loop is empty. Fill its
+    // reduction slot from warp 0 so the stock summation structure is unchanged.
+    if (threadIdx.y == 0 && nwarps_launched < uint32_t(nwarps)) {
+        for (uint32_t l = nwarps_launched - 1; l < uint32_t(nwarps) - 1; ++l) {
+#pragma unroll
+            for (int j = 0; j < ncols_dst; ++j) {
+#pragma unroll
+                for (int i = 0; i < rows_per_cuda_block; ++i) {
+                    tmp_shared[l][j][i][threadIdx.x] = 0.0f;
+                    if constexpr (has_fusion) {
+                        if (use_gate) {
+                            tmp_shared_gate[l][j][i][threadIdx.x] = 0.0f;
+                        }
+                    }
+                }
+            }
+        }
+    }
+
     if (threadIdx.y > 0) {
 #pragma unroll
         for (int j = 0; j < ncols_dst; ++j) {
@@ -770,15 +795,60 @@ static __global__ void mul_mat_vec_q_moe(
     }
 }
 
+// Return the number of leading warps whose stock k-loop has actual work. Omitting
+// trailing empty warps is bit-exact because blocks_per_iter remains based on the
+// full compile-time block width. The environment switch provides same-binary A/B.
+template<ggml_type type>
+static __host__ int calc_nwarps_launched(
+        const int ncols_dst, const int ncols_x, const int nrows_x, const int nwarps, const int warp_size) {
+    static const bool trim_disabled = [] {
+        const char * value = std::getenv("GGML_CUDA_MMVQ_NO_TRIM");
+        return value != nullptr && std::atoi(value) != 0;
+    }();
+    static const int min_trim_rows = [] {
+        const char * value = std::getenv("GGML_CUDA_MMVQ_MIN_TRIM_ROWS");
+        return value == nullptr ? 0 : std::atoi(value);
+    }();
+    static const int min_launched_warps = [] {
+        const char * value = std::getenv("GGML_CUDA_MMVQ_MIN_WARPS");
+        return value == nullptr ? 1 : std::atoi(value);
+    }();
+    if (trim_disabled || ncols_dst != 1 || nrows_x < min_trim_rows) {
+        return nwarps;
+    }
+
+    constexpr int qk  = ggml_cuda_type_traits<type>::qk;
+    constexpr int qi  = ggml_cuda_type_traits<type>::qi;
+    constexpr int vdr = get_vdr_mmvq(type);
+
+    if (nwarps <= 1 || vdr <= 0 || qi % vdr != 0) {
+        return nwarps;
+    }
+    const int threads_per_kblock = qi / vdr;
+    if (threads_per_kblock <= 0 || (vdr * nwarps * warp_size) % qi != 0) {
+        return nwarps;
+    }
+    const int blocks_per_row_x = ncols_x / qk;
+    const int blocks_per_iter  = vdr * nwarps * warp_size / qi;
+    if (blocks_per_iter <= 0 || blocks_per_row_x > blocks_per_iter) {
+        return nwarps;
+    }
+    const int threads_needed = blocks_per_row_x * threads_per_kblock;
+    int nwarps_launched = (threads_needed + warp_size - 1) / warp_size;
+    nwarps_launched = nwarps_launched < min_launched_warps ? min_launched_warps : nwarps_launched;
+    return nwarps_launched < 1 ? 1 : (nwarps_launched > nwarps ? nwarps : nwarps_launched);
+}
+
 template<ggml_type type>
 static std::pair<dim3, dim3> calc_launch_params(
-        const int ncols_dst, const int nrows_x, const int nchannels_dst, const int nsamples_or_ntokens,
+        const int ncols_dst, const int ncols_x, const int nrows_x, const int nchannels_dst, const int nsamples_or_ntokens,
         const int warp_size, const mmvq_parameter_table_id table_id, const bool small_k = false) {
     const int nwarps = calc_nwarps(type, ncols_dst, table_id);
     const int rpb = calc_rows_per_block(ncols_dst, table_id, small_k, nwarps);
     const int64_t nblocks = (nrows_x + rpb - 1) / rpb;
     const dim3 block_nums(nblocks, nchannels_dst, nsamples_or_ntokens);
-    const dim3 block_dims(warp_size, nwarps, 1);
+    const dim3 block_dims(
+        warp_size, calc_nwarps_launched<type>(ncols_dst, ncols_x, nrows_x, nwarps, warp_size), 1);
     return {block_nums, block_dims};
 }
 
