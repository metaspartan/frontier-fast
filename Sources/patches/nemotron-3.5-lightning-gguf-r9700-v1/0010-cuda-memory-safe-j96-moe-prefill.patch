From 818af9b530a864abce62979366641f136e76dc3c Mon Sep 17 00:00:00 2001
From: Codex Scratch <noreply@openai.com>
Date: Wed, 12 Aug 2026 05:07:25 -0600
Subject: [PATCH] cuda: use memory-safe J96 for large MoE prompts

Pad and mask the compact MoE activation tails before selecting the
shape-preserving J96 tile on RDNA4. GGML_CUDA_DISABLE_MMQ_MOE_J96=1
restores the stock J128 selection.

diff --git a/ggml/src/ggml-cuda/mmq.cu b/ggml/src/ggml-cuda/mmq.cu
index 707437ea3..117375fd7 100644
--- a/ggml/src/ggml-cuda/mmq.cu
+++ b/ggml/src/ggml-cuda/mmq.cu
@@ -202,8 +202,15 @@ void ggml_cuda_mul_mat_q(
         CUDA_CHECK(cudaGetLastError());
     }
 
+    // mul_mat_id flattens the n_expert_used slots of all ne12 tokens and then
+    // groups those rows by expert. MMQ always loads a complete J-row tile,
+    // including the masked lanes of the final expert. Size the guard region
+    // from the same logical column bound used by mmq_args::ncols_max below.
+    // Using ne11 here is wrong for MoE: it is normally 1 (broadcast gate/up)
+    // or n_expert_used and rounds to a zero J_max, leaving the last tile to
+    // read beyond the pool allocation.
     const size_t nbytes_src1_q8_1 = ne12*n_expert_used*ne10_padded * y_block_size/y_values_per_block +
-        ggml_cuda_mmq_get_J_max(src0->type, fallback, cc, ne11) * sizeof(block_q8_1_mmq);
+        ggml_cuda_mmq_get_J_max(src0->type, fallback, cc, ne12) * sizeof(block_q8_1_mmq);
     ggml_cuda_pool_alloc<char> src1_q8_1(ctx.pool(), nbytes_src1_q8_1);
     ggml_cuda_pool_alloc<float> src1_scale(ctx.pool());
     if (src0->type == GGML_TYPE_NVFP4 && use_native_fp4) {
diff --git a/ggml/src/ggml-cuda/mmq.cuh b/ggml/src/ggml-cuda/mmq.cuh
index 2eb15fdfa..ac2da151e 100644
--- a/ggml/src/ggml-cuda/mmq.cuh
+++ b/ggml/src/ggml-cuda/mmq.cuh
@@ -1027,7 +1027,8 @@ static __global__ void mul_mat_q(
                     break;
                 }
 
-                ids_dst_shared[j] = ids_dst[col_low + jt*J + j];
+                const int segment_j = jt*J + j;
+                ids_dst_shared[j] = segment_j < col_diff ? ids_dst[col_low + segment_j] : 0;
             }
             __syncthreads();
         }
@@ -1121,7 +1122,8 @@ static __global__ void mul_mat_q(
                     break;
                 }
 
-                ids_dst_shared[j] = ids_dst[col_low + jt*J + j];
+                const int segment_j = jt*J + j;
+                ids_dst_shared[j] = segment_j < col_diff ? ids_dst[col_low + segment_j] : 0;
             }
             __syncthreads();
         }
@@ -1343,7 +1345,8 @@ static __global__ void mul_mat_q_stream_k_fixup(
     const int col_diff = col_high - col_low;
 
     for (int j = threadIdx.y*warp_size + threadIdx.x; j < J; j += nwarps*warp_size) {
-        ids_dst_shared[j] = ids_dst[col_low + jt*J + j];
+        const int segment_j = jt*J + j;
+        ids_dst_shared[j] = segment_j < col_diff ? ids_dst[col_low + segment_j] : 0;
     }
     __syncthreads();
 
@@ -1493,6 +1496,27 @@ void mul_mat_q_switch_J(ggml_backend_cuda_context & ctx, const mmq_args & args,
         }
     }
 
+    // Large MoE prompts usually leave each expert with far fewer rows than
+    // args.ncols_max. J=96 is the smallest RDNA4 WMMA tile below stock J=128
+    // that preserves the 256-thread/I=128 reduction shape and is a multiple
+    // of the 32-column (ntx*tile_C::J) loop quantum. J=80 and J=112 are not:
+    // their final unrolled WMMA iteration reaches 16 rows beyond the exact-J
+    // local/shared arrays.
+    if (args.ids_dst != nullptr && args.nchannels_y > 1 && J_best > 96 &&
+        getenv("GGML_CUDA_DISABLE_MMQ_MOE_J96") == nullptr) {
+        const int64_t cols_per_expert = (args.ncols_dst + args.nchannels_y - 1) / args.nchannels_y;
+        if (cols_per_expert >= 8) {
+            const ggml_cuda_mmq_config stock = ggml_cuda_mmq_get_config(type, J_best, fallback, cc);
+            const ggml_cuda_mmq_config j96   = ggml_cuda_mmq_get_config(type, 96, fallback, cc);
+            if (j96.type != GGML_TYPE_COUNT && mmq_get_nbytes_shared(j96, cc) <= smpbo &&
+                j96.nthreads == stock.nthreads && j96.I == stock.I &&
+                j96.sram_layout == stock.sram_layout && j96.K_vram == stock.K_vram &&
+                j96.stream_k == stock.stream_k) {
+                J_best = 96;
+            }
+        }
+    }
+
     switch (J_best) {
         case   8:
             launch_mul_mat_q<type,   8, fallback>(ctx, args, stream);
-- 
2.49.0.windows.1

