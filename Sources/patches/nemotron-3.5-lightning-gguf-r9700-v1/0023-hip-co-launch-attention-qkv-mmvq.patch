+// Decode-shaped Nemotron attention uses three independent projections of the
+// same 2688-element activation: Q5_0 Q [4096], Q5_0 K [256], and Q5_0/Q8_0 V
+// [256].  The six trunk attention layers use this exact shape (the separate
+// NextN/MTP head is not part of this graph path). Concatenating their row grids
+// removes two dispatches without changing a single lane's K traversal or
+// reduction order.
+template <ggml_type type>
+static __device__ __forceinline__ float mul_mat_vec_q_nemo_qkv_partial(
+        const void * vx, const block_q8_1 * vy, const uint32_t row,
+        const uint32_t ncols_x, const uint32_t stride_row_x, const int local_warp) {
+    constexpr int qk       = ggml_cuda_type_traits<type>::qk;
+    constexpr int qi       = ggml_cuda_type_traits<type>::qi;
+    constexpr int vdr      = get_vdr_mmvq(type);
+    constexpr int nwarps   = 8;
+    constexpr int warp_size = ggml_cuda_get_physical_warp_size();
+    constexpr vec_dot_q_cuda_t vec_dot_q_cuda = get_vec_dot_q_cuda(type);
+
+    const int tid = warp_size * local_warp + threadIdx.x;
+    const int blocks_per_row_x = ncols_x / qk;
+    constexpr int blocks_per_iter = vdr * nwarps * warp_size / qi;
+    const uint32_t row_offset = row * stride_row_x;
+    float tmp = 0.0f;
+    for (int kbx = tid / (qi/vdr); kbx < blocks_per_row_x; kbx += blocks_per_iter) {
+        const int kby = kbx * (qk/QK8_1);
+        const int kqs = vdr * (tid % (qi/vdr));
+        tmp += vec_dot_q_cuda(vx, &vy[kby], row_offset + kbx, kqs);
+    }
+    return tmp;
+}
+
+template <ggml_type v_type>
+__launch_bounds__((v_type == GGML_TYPE_Q5_0 ? 6 : 12)*ggml_cuda_get_physical_warp_size(), 1)
+static __global__ void mul_mat_vec_q_nemo_qkv(
+        const void * qx, const void * kx, const void * vx,
+        const block_q8_1 * y, float * qdst, float * kdst, float * vdst,
+        const uint32_t ncols_x,
+        const uint32_t q_rows, const uint32_t k_rows, const uint32_t v_rows,
+        const uint32_t q_stride, const uint32_t k_stride, const uint32_t v_stride) {
+    constexpr int warp_size = ggml_cuda_get_physical_warp_size();
+    static_assert(v_type == GGML_TYPE_Q5_0 || v_type == GGML_TYPE_Q8_0, "unsupported Nemotron V type");
+
+    constexpr int q_warps = 6;
+    constexpr int v_warps = v_type == GGML_TYPE_Q5_0 ? 6 : 8;
+    // Six waves are exact for Q5_0 at K=2688. When V is Q8_0, twelve
+    // launch waves pack two Q5_0 rows; V consumes its exact eight waves and
+    // leaves four idle waves only in the much smaller V grid.
+    constexpr int launch_warps = v_type == GGML_TYPE_Q5_0 ? 6 : 12;
+    constexpr int q_rows_per_block = launch_warps / q_warps;
+    constexpr int v_rows_per_block = launch_warps / v_warps;
+    const uint32_t q_blocks = (q_rows + q_rows_per_block - 1) / q_rows_per_block;
+    const uint32_t k_blocks = (k_rows + q_rows_per_block - 1) / q_rows_per_block;
+    const uint32_t block = blockIdx.x;
+    const bool is_q = block < q_blocks;
+    const bool is_k = !is_q && block < q_blocks + k_blocks;
+    const int local_warps = is_q || is_k ? q_warps : v_warps;
+    const int rows_per_block = is_q || is_k ? q_rows_per_block : v_rows_per_block;
+    const int row_in_block = threadIdx.y / local_warps;
+    const int local_warp = threadIdx.y - row_in_block * local_warps;
+    const uint32_t matrix_block = is_q ? block : (is_k ? block - q_blocks : block - q_blocks - k_blocks);
+    const uint32_t row = rows_per_block * matrix_block + row_in_block;
+    const uint32_t matrix_rows = is_q ? q_rows : (is_k ? k_rows : v_rows);
+    const bool row_valid = row < matrix_rows;
+
+    ggml_cuda_pdl_sync();
+    float tmp = 0.0f;
+    if (row_valid) {
+        if (is_q) {
+            tmp = mul_mat_vec_q_nemo_qkv_partial<GGML_TYPE_Q5_0>(qx, y, row, ncols_x, q_stride, local_warp);
+        } else if (is_k) {
+            tmp = mul_mat_vec_q_nemo_qkv_partial<GGML_TYPE_Q5_0>(kx, y, row, ncols_x, k_stride, local_warp);
+        } else {
+            tmp = mul_mat_vec_q_nemo_qkv_partial<v_type>(vx, y, row, ncols_x, v_stride, local_warp);
+        }
+    }
+
+    // Q5_0 needs six live wavefronts for K=2688 after 0001's trailing-warp
+    // trim; Q8_0 needs all eight. Pack two Q5_0 rows into one twelve-wavefront
+    // block only for a Q8_0 V projection, so Q and K retain exactly their
+    // standalone live-wavefront count.
+    // The group leader fills the remaining slots with +0.0f, matching the
+    // standalone eight-wavefront reduction structure byte for byte.
+    __shared__ float tmp_shared[2][7][warp_size];
+    if (local_warp == 0) {
+        for (int l = local_warps - 1; l < 7; ++l) {
+            tmp_shared[row_in_block][l][threadIdx.x] = 0.0f;
+        }
+    } else {
+        tmp_shared[row_in_block][local_warp - 1][threadIdx.x] = tmp;
+    }
+    __syncthreads();
+    if (local_warp > 0 || !row_valid) {
+        return;
+    }
+#pragma unroll
+    for (int l = 0; l < 7; ++l) {
+        tmp += tmp_shared[row_in_block][l][threadIdx.x];
+    }
+    tmp = warp_reduce_sum<warp_size>(tmp);
+    if (threadIdx.x == 0) {
+        if (is_q) {
+            qdst[row] = tmp;
+        } else if (is_k) {
+            kdst[row] = tmp;
+        } else {
+            vdst[row] = tmp;
+        }
+    }
+}
+
+template <ggml_type v_type>
+static bool mul_mat_vec_q_nemo_qkv_colaunch(
+        const void * qx, const void * kx, const void * vx, const void * y,
+        float * qdst, float * kdst, float * vdst,
+        const int ncols_x, const int q_rows, const int k_rows, const int v_rows,
+        const int q_stride, const int k_stride, const int v_stride,
+        const int warp_size, const mmvq_parameter_table_id table_id, cudaStream_t stream) {
+    if (table_id != MMVQ_PARAMETERS_RDNA4 || warp_size != 32) {
+        return false;
+    }
+    const auto q_dims = calc_launch_params<GGML_TYPE_Q5_0>(1, ncols_x, q_rows, 1, 1, warp_size, table_id);
+    const auto k_dims = calc_launch_params<GGML_TYPE_Q5_0>(1, ncols_x, k_rows, 1, 1, warp_size, table_id);
+    const auto v_dims = calc_launch_params<v_type>(1, ncols_x, v_rows, 1, 1, warp_size, table_id);
+    if (q_dims.first.y != 1 || q_dims.first.z != 1 ||
+            k_dims.first.y != 1 || k_dims.first.z != 1 ||
+            v_dims.first.y != 1 || v_dims.first.z != 1 ||
+            q_dims.first.x != (uint32_t) q_rows || k_dims.first.x != (uint32_t) k_rows ||
+            v_dims.first.x != (uint32_t) v_rows ||
+            q_dims.second.x != 32 || k_dims.second.x != 32 || v_dims.second.x != 32 ||
+            q_dims.second.y != 6 || k_dims.second.y != 6 ||
+            v_dims.second.y != (v_type == GGML_TYPE_Q5_0 ? 6u : 8u) ||
+            q_dims.second.z != 1 || k_dims.second.z != 1 || v_dims.second.z != 1) {
+        return false;
+    }
+
+    constexpr int launch_warps = v_type == GGML_TYPE_Q5_0 ? 6 : 12;
+    constexpr int q_rows_per_block = launch_warps / 6;
+    constexpr int v_rows_per_block = launch_warps / (v_type == GGML_TYPE_Q5_0 ? 6 : 8);
+    const int q_blocks = (q_rows + q_rows_per_block - 1) / q_rows_per_block;
+    const int k_blocks = (k_rows + q_rows_per_block - 1) / q_rows_per_block;
+    const int v_blocks = (v_rows + v_rows_per_block - 1) / v_rows_per_block;
+    const dim3 merged_grid(q_blocks + k_blocks + v_blocks, 1, 1);
+    const dim3 merged_block(warp_size, launch_warps, 1);
+    const ggml_cuda_kernel_launch_params launch_params(merged_grid, merged_block, 0, stream);
+    ggml_cuda_kernel_launch((mul_mat_vec_q_nemo_qkv<v_type>), launch_params,
+        qx, kx, vx, (const block_q8_1 *) y, qdst, kdst, vdst,
+        (uint32_t) ncols_x, (uint32_t) q_rows, (uint32_t) k_rows, (uint32_t) v_rows,
+        (uint32_t) q_stride, (uint32_t) k_stride, (uint32_t) v_stride);
+    return true;
+}
