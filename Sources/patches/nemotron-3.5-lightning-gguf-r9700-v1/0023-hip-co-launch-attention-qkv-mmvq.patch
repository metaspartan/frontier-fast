+            kw->type == GGML_TYPE_Q5_0 && (vw->type == GGML_TYPE_Q5_0 || vw->type == GGML_TYPE_Q8_0) &&
+            kd->type == GGML_TYPE_F32 && vd->type == GGML_TYPE_F32 &&
+            src0->ne[0] == 2688 && src0->ne[1] == 4096 && src0->ne[2] == 1 && src0->ne[3] == 1 &&
+            kw->ne[0] == 2688 && kw->ne[1] == 256 && kw->ne[2] == 1 && kw->ne[3] == 1 &&
+            vw->ne[0] == 2688 && vw->ne[1] == 256 && vw->ne[2] == 1 && vw->ne[3] == 1 &&
+            src1->ne[0] == 2688 && src1->ne[1] == 1 && src1->ne[2] == 1 && src1->ne[3] == 1 &&
+            dst->ne[0] == 4096 && dst->ne[1] == 1 && dst->ne[2] == 1 && dst->ne[3] == 1 &&
+            kd->ne[0] == 256 && kd->ne[1] == 1 && kd->ne[2] == 1 && kd->ne[3] == 1 &&
+            vd->ne[0] == 256 && vd->ne[1] == 1 && vd->ne[2] == 1 && vd->ne[3] == 1 &&
+            ggml_is_contiguous(src0) && ggml_is_contiguous(kw) && ggml_is_contiguous(vw) &&
+            ggml_is_contiguous(dst) && ggml_is_contiguous(kd) && ggml_is_contiguous(vd);
+
