 #define CUDA_ROPE_BLOCK_SIZE 256
 
+// Maximum number of independent rope ops that may merge into a single grouped
+// launch.
+#define ROPE_MAX_GROUP_SIZE 4
+
+// Launch several independent NeoX rope ops that share every rope parameter
+// (same op_params, same pos, same freq_factors, same ne00) as ONE kernel.
+// Per-element arithmetic is identical to the individual launches: only the
+// (src, dst) base pointers, row strides and the local row index depend on the
+// group segment, and all of those are integer-only.
+void ggml_cuda_op_rope_grouped(ggml_backend_cuda_context & ctx, ggml_tensor * const * nodes, int n_nodes);
