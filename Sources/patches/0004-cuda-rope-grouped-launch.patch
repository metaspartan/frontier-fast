+
+// ----- grouped rope launch: several independent NeoX ropes in one kernel -----
+//
+// A decoder layer ropes Q and K with two separate launches that share every
+// rope parameter (identical op_params, the same position tensor and the same
+// freq_factors) and differ only in the tensor they read and write. Every
+// (row, dim-pair) is independent of every other, so the row ranges of several
+// such ops can be concatenated into ONE grid: a block first routes itself to
+// its segment (src/dst base pointer, row strides, local row index - all
+// integer work), then performs exactly the per-element sequence of the
+// individual rope_neox<forward, has_ff, T, D> launch it replaces, so results
+// are byte-identical by construction.
+//
+// Only the 2D case (ne02 == ne03 == 1) without the ROPE+VIEW+SET_ROWS fusion
+// is provided: that is the shape the graph-side detector groups, and there the
+// stock row decomposition reduces to i1 = row_dst, i2 = i3 = 0.
+
+struct rope_grouped_args {
+    const void * x[ROPE_MAX_GROUP_SIZE];
+    void *       dst[ROPE_MAX_GROUP_SIZE];
+    int          s01[ROPE_MAX_GROUP_SIZE];
+    int          s1[ROPE_MAX_GROUP_SIZE];
+    // exclusive prefix sums of segment row counts; entries past the actual
+    // group size are padded with the total so the segment scan ignores them
+    uint32_t     seg_end[ROPE_MAX_GROUP_SIZE];
+};
+
+template <bool forward, bool has_ff, typename T, typename D>
+static __global__ void rope_neox_grouped(const rope_grouped_args args,
+                                         const int               ne00,
+                                         const int               n_dims,
+                                         const int32_t *         pos,
+                                         const float             freq_scale,
+                                         const float             ext_factor,
+                                         const float             attn_factor,
+                                         const rope_corr_dims    corr_dims,
+                                         const float             theta_scale,
+                                         const float *           freq_factors) {
+    ggml_cuda_pdl_lc();
+    const int i0 = 2*(blockDim.y*blockIdx.y + threadIdx.y);
+
+    if (i0 >= ne00) {
+        return;
+    }
+
+    // Segment routing: uniform across the block (depends only on blockIdx.x),
+    // integer-only, and the sole difference from the individual launch.
+    uint32_t seg       = 0;
+    uint32_t seg_start = 0;
+#pragma unroll
+    for (int s = 0; s < ROPE_MAX_GROUP_SIZE - 1; ++s) {
+        if (blockIdx.x >= args.seg_end[s]) {
+            seg       = s + 1;
+            seg_start = args.seg_end[s];
+        }
+    }
+
+    const T * GGML_CUDA_RESTRICT x   = (const T *) args.x[seg];
+    D * GGML_CUDA_RESTRICT       dst = (D *) args.dst[seg];
+
+    // ne02 == ne03 == 1 for every member, so the stock decomposition
+    //   i3 = row_dst/(ne01*ne02), i2 = ..., i1 = ...
+    // reduces to i1 = row_dst, i2 = i3 = 0.
+    const int i1 = (int) (blockIdx.x - seg_start);
+
+    const int idst = i0 / 2 + i1 * args.s1[seg];
+    const int ix   = i0 / 2 + i1 * args.s01[seg];
+    ggml_cuda_pdl_sync();
+
+    if (i0 >= n_dims) {
+        dst[idst + i0 / 2 + 0] = ggml_cuda_cast<D>(x[ix + i0 / 2 + 0]);
+        dst[idst + i0 / 2 + 1] = ggml_cuda_cast<D>(x[ix + i0 / 2 + 1]);
+
+        return;
+    }
+
+    const float theta_base = pos[0]*powf(theta_scale, i0/2.0f);
+
+    const float freq_factor = has_ff ? freq_factors[i0/2] : 1.0f;
+
+    float cos_theta;
+    float sin_theta;
+
+    rope_yarn<forward>(theta_base/freq_factor, freq_scale, corr_dims, i0, ext_factor, attn_factor, cos_theta, sin_theta);
+
+    const float x0 = x[ix + 0];
+    const float x1 = x[ix + n_dims/2];
+
+    dst[idst + 0]          = ggml_cuda_cast<D>(x0 * cos_theta - x1 * sin_theta);
+    dst[idst + n_dims / 2] = ggml_cuda_cast<D>(x0 * sin_theta + x1 * cos_theta);
+}
+
+template <bool forward, typename T, typename D>
+static void rope_neox_grouped_cuda(const rope_grouped_args & args,
+                                   const int                 total_rows,
+                                   const int                 ne00,
+                                   const int                 n_dims,
+                                   const int32_t *           pos,
+                                   const float               freq_scale,
+                                   const float               freq_base,
+                                   const float               ext_factor,
+                                   const float               attn_factor,
+                                   const rope_corr_dims      corr_dims,
+                                   const float *             freq_factors,
+                                   cudaStream_t              stream) {
+    GGML_ASSERT(ne00 % 2 == 0);
+    const dim3 block_dims(1, CUDA_ROPE_BLOCK_SIZE, 1);
+    const int  n_blocks_x = (ne00 + 2 * CUDA_ROPE_BLOCK_SIZE - 1) / (2 * CUDA_ROPE_BLOCK_SIZE);
+    const dim3 block_nums(total_rows, n_blocks_x, 1);
+
+    // identical to the individual launches (shared freq_base and n_dims)
+    const float theta_scale = powf(freq_base, -2.0f / n_dims);
+    const ggml_cuda_kernel_launch_params launch_params = {block_nums, block_dims, 0, stream};
+
+    if (freq_factors == nullptr) {
+        ggml_cuda_kernel_launch(rope_neox_grouped<forward, false, T, D>, launch_params,
+            args, ne00, n_dims, pos, freq_scale, ext_factor, attn_factor, corr_dims, theta_scale, freq_factors);
+    } else {
+        ggml_cuda_kernel_launch(rope_neox_grouped<forward, true, T, D>, launch_params,
+            args, ne00, n_dims, pos, freq_scale, ext_factor, attn_factor, corr_dims, theta_scale, freq_factors);
+    }
+}
+
+void ggml_cuda_op_rope_grouped(ggml_backend_cuda_context & ctx, ggml_tensor * const * nodes, int n_nodes) {
+    GGML_ASSERT(n_nodes >= 2 && n_nodes <= ROPE_MAX_GROUP_SIZE);
+
+    cudaStream_t stream = ctx.stream();
+
+    const ggml_tensor * first = nodes[0];
+    const ggml_tensor * src0f = first->src[0];
+    const ggml_tensor * src1f = first->src[1];
+    const ggml_tensor * src2f = first->src[2];
+
+    const int64_t ne00 = src0f->ne[0];
+
+    const int n_dims     = ((const int32_t *) first->op_params)[1];
+    const int n_ctx_orig = ((const int32_t *) first->op_params)[4];
+
+    float freq_base, freq_scale, ext_factor, attn_factor, beta_fast, beta_slow;
+    memcpy(&freq_base,   (const int32_t *) first->op_params +  5, sizeof(float));
+    memcpy(&freq_scale,  (const int32_t *) first->op_params +  6, sizeof(float));
+    memcpy(&ext_factor,  (const int32_t *) first->op_params +  7, sizeof(float));
+    memcpy(&attn_factor, (const int32_t *) first->op_params +  8, sizeof(float));
+    memcpy(&beta_fast,   (const int32_t *) first->op_params +  9, sizeof(float));
+    memcpy(&beta_slow,   (const int32_t *) first->op_params + 10, sizeof(float));
+
+    const int32_t * pos          = (const int32_t *) src1f->data;
+    const float *   freq_factors = src2f != nullptr ? (const float *) src2f->data : nullptr;
+
+    rope_corr_dims corr_dims;
+    ggml_rope_yarn_corr_dims(n_dims, n_ctx_orig, freq_base, beta_fast, beta_slow, corr_dims.v);
+
+    rope_grouped_args args = {};
+    uint32_t total_rows = 0;
+
+    for (int m = 0; m < n_nodes; ++m) {
+        const ggml_tensor * dst  = nodes[m];
+        const ggml_tensor * src0 = dst->src[0];
+
+        GGML_ASSERT(dst->op == GGML_OP_ROPE);
+        GGML_ASSERT(src0->type == GGML_TYPE_F32 && dst->type == GGML_TYPE_F32);
+        GGML_ASSERT(src0->ne[0] == ne00 && dst->ne[0] == ne00);
+        GGML_ASSERT(src0->ne[2] == 1 && src0->ne[3] == 1);
+        GGML_ASSERT(dst->ne[2] == 1 && dst->ne[3] == 1);
+        GGML_ASSERT(dst->src[1] == src1f && dst->src[2] == src2f);
+        GGML_ASSERT(memcmp(dst->op_params, first->op_params, GGML_MAX_OP_PARAMS) == 0);
+
+        args.x[m]       = src0->data;
+        args.dst[m]     = dst->data;
+        args.s01[m]     = (int) (src0->nb[1] / ggml_type_size(src0->type));
+        args.s1[m]      = (int) (dst->nb[1] / ggml_type_size(dst->type));
+        total_rows     += (uint32_t) src0->ne[1];
+        args.seg_end[m] = total_rows;
+    }
+    for (int m = n_nodes; m < ROPE_MAX_GROUP_SIZE; ++m) {
+        args.seg_end[m] = total_rows; // padding: the segment scan never selects these
+    }
+
+    rope_neox_grouped_cuda<true, float, float>(args, (int) total_rows, (int) ne00, n_dims, pos, freq_scale,
+        freq_base, ext_factor, attn_factor, corr_dims, freq_factors, stream);
+}
+
