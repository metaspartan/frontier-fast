index e20a5cb..1ded56e 100644
--- a/ggml/src/ggml-cuda/rope.cu
+++ b/ggml/src/ggml-cuda/rope.cu
@@ -503,6 +503,188 @@ static void rope_vision_cuda(const T *            x,
