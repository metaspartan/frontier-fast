+
+// ----- grouped rope (Q/K pair) launch detection --------------------------------
+//
+// A decoder layer ropes Q and K with two independent launches that share every
+// rope parameter and differ only in the tensor they read and write. Merging
+// them into one launch removes a dispatch without touching arithmetic: the
+// grouped kernel gives every element exactly the sequence of the individual
+// launch (see rope_neox_grouped in rope.cu), so the outputs are byte-identical
+// by construction.
+//
+// K's rope sits behind K's projection and K's norm in graph order, but by the
+// time Q's rope is issued both have already run - the projection as a member of
+// a grouped mmvq launch, the norm as a member of a grouped rms_norm launch - so
+// the hoist scan skips them and the remaining legality check is against the few
+// nodes that really do execute in between.
+
+static bool ggml_cuda_rope_groupable(const ggml_cgraph * cgraph, const int i) {
+    const ggml_tensor * node = cgraph->nodes[i];
+
+    if (node->op != GGML_OP_ROPE) {
+        return false;
+    }
+    // leave anything stock would fuse with VIEW+SET_ROWS alone
+    if (ggml_cuda_can_fuse(cgraph, i, { GGML_OP_ROPE, GGML_OP_VIEW, GGML_OP_SET_ROWS }, {})) {
+        return false;
+    }
+
+    const ggml_tensor * src0 = node->src[0];
+    const ggml_tensor * src1 = node->src[1];
+    if (src0 == nullptr || src1 == nullptr) {
+        return false;
+    }
+    if (src0->type != GGML_TYPE_F32 || node->type != GGML_TYPE_F32) {
+        return false;
+    }
+
+    const int mode = ((const int32_t *) node->op_params)[2];
+    // plain NeoX only: no mrope/imrope/vision section handling in the grouped kernel
+    if (!(mode & GGML_ROPE_TYPE_NEOX) || (mode & GGML_ROPE_TYPE_MROPE) ||
+            mode == GGML_ROPE_TYPE_IMROPE || mode == GGML_ROPE_TYPE_VISION) {
+        return false;
+    }
+    if (src0->ne[0] % 2 != 0) {
+        return false;
+    }
+    // 2D only: the grouped kernel constant-folds the row decomposition
+    if (src0->ne[2] != 1 || src0->ne[3] != 1 || node->ne[2] != 1 || node->ne[3] != 1) {
+        return false;
+    }
+    if (!ggml_are_same_shape(src0, node)) {
+        return false;
+    }
+    if (src0->nb[0] != ggml_type_size(src0->type) || node->nb[0] != ggml_type_size(node->type)) {
+        return false;
+    }
+    return true;
+}
+
+static bool ggml_cuda_rope_hoist_legal(const ggml_cgraph * cgraph, const int start, const int j,
+                                       const std::unordered_set<const ggml_tensor *> & done,
+                                       const std::unordered_set<const ggml_tensor *> & done2) {
+    const ggml_tensor * cand = cgraph->nodes[j];
+
+    for (int k = start + 1; k < j; ++k) {
+        const ggml_tensor * mid = cgraph->nodes[k];
+        // Nodes already issued earlier in this pass have finished before this
+        // launch point, so neither their reads nor their writes can race the
+        // hoisted write.
+        if (ggml_cuda_is_view_or_noop(mid) || done.count(mid) != 0 || done2.count(mid) != 0) {
+            continue;
+        }
+        for (int si = 0; si < GGML_MAX_SRC; ++si) {
+            if (mid->src[si] != nullptr && !ggml_cuda_mmvq_ranges_disjoint(cand, mid->src[si])) {
+                return false;
+            }
+            // a skipped-over node must not depend on the hoisted result either
+            if (mid->src[si] == cand) {
+                return false;
+            }
+        }
+        if (!ggml_cuda_mmvq_ranges_disjoint(cand, mid)) {
+            return false;
+        }
+        for (int si = 0; si < GGML_MAX_SRC; ++si) {
+            if (cand->src[si] != nullptr && !ggml_cuda_mmvq_ranges_disjoint(mid, cand->src[si])) {
+                return false;
+            }
+        }
+    }
+    return true;
+}
+
+static int ggml_cuda_rope_collect_group(const ggml_cgraph * cgraph, const int start, ggml_tensor ** members,
+                                        const std::unordered_set<const ggml_tensor *> & done,
+                                        const std::unordered_set<const ggml_tensor *> & done2) {
+    ggml_tensor * first = cgraph->nodes[start];
+    members[0] = first;
+    int n = 1;
+
+    constexpr int scan_window = 16;
+    const int end = std::min(cgraph->n_nodes, start + 1 + scan_window);
+
+    for (int j = start + 1; j < end && n < ROPE_MAX_GROUP_SIZE; ++j) {
+        ggml_tensor * cand = cgraph->nodes[j];
+        if (ggml_cuda_is_view_or_noop(cand) || done.count(cand) != 0 || done2.count(cand) != 0) {
+            continue;
+        }
+        if (cand->op != GGML_OP_ROPE) {
+            continue;
+        }
+        // every rope parameter must be identical, so that every derived scalar
+        // (theta_scale, corr_dims, ...) is bit-identical to the individual launch
+        if (cand->src[1] != first->src[1] || cand->src[2] != first->src[2]) {
+            continue;
+        }
+        if (memcmp(cand->op_params, first->op_params, GGML_MAX_OP_PARAMS) != 0) {
+            continue;
+        }
+        if (cand->src[0]->ne[0] != first->src[0]->ne[0]) {
+            continue;
+        }
+        if (!ggml_cuda_rope_groupable(cgraph, j)) {
+            continue;
+        }
+        if (!ggml_cuda_rope_hoist_legal(cgraph, start, j, done, done2)) {
+            continue;
+        }
+        // members must write disjoint destinations
+        bool overlap = false;
+        for (int m = 0; m < n; ++m) {
+            if (!ggml_cuda_mmvq_ranges_disjoint(members[m], cand)) {
+                overlap = true;
+                break;
+            }
+        }
+        if (overlap) {
+            continue;
+        }
+        members[n++] = cand;
+    }
+    return n;
+}
