+template <ggml_type type>
+static bool mul_mat_vec_q_nemo_up_colaunch(
+        const void * vx, const void * vy, float * dst,
+        const int ncols_x, const int nrows_x,
+        const int stride_row_x, const int stride_col_y, const int stride_col_dst,
+        const int stride_channel_x, const int stride_channel_y, const int stride_channel_dst,
+        const int stride_sample_x, const int stride_sample_y, const int stride_sample_dst,
+        mmvq_nemo_up_guest_args guest,
+        const int warp_size, const mmvq_parameter_table_id table_id, cudaStream_t stream) {
+    constexpr int c_ncols_dst = 1;
+    const auto host_dims = calc_launch_params<type>(
+        c_ncols_dst, ncols_x, nrows_x, 1, 1, warp_size, table_id);
+    const auto guest_dims = calc_launch_params<type>(
+        c_ncols_dst, guest.ncols_x, guest.nrows, guest.nchannels, 1, warp_size, table_id);
+
+    // Both standalone UP projections must use one row per block and the same
+    // trimmed block dimensions. This is true for Nemotron's Q5_0 K=2688 path;
+    // declining anything else keeps the ordinary two-launch path.
+    if (host_dims.first.y != 1 || host_dims.first.z != 1 || guest_dims.first.z != 1 ||
+            host_dims.first.x != (uint32_t) nrows_x || guest_dims.first.x != guest.nrows ||
+            host_dims.second.x != guest_dims.second.x ||
+            host_dims.second.y != guest_dims.second.y ||
+            host_dims.second.z != guest_dims.second.z) {
+        return false;
+    }
+    guest.nblocks_per_channel = guest.nrows;
+    guest.nblocks = guest.nblocks_per_channel * guest.nchannels;
+
+    const dim3 merged_grid(guest.nblocks + host_dims.first.x, 1, 1);
+    const uint3 nchannels_y_fd = make_uint3(0, 0, 0);
+    const uint3 channel_ratio_fd = init_fastdiv_values(1);
+    const uint3 sample_ratio_fd = init_fastdiv_values(1);
+    const ggml_cuda_mm_fusion_args_device fusion{};
+    const ggml_cuda_kernel_launch_params launch_params = ggml_cuda_kernel_launch_params(
+        merged_grid, host_dims.second, 0, stream);
+    ggml_cuda_kernel_launch((mul_mat_vec_q<type, 1, false, false, false, 1, true>), launch_params,
+        vx, vy, nullptr, fusion, dst, (uint32_t) ncols_x, nchannels_y_fd,
+        (uint32_t) stride_row_x, (uint32_t) stride_col_y, (uint32_t) stride_col_dst,
+        channel_ratio_fd, (uint32_t) stride_channel_x, (uint32_t) stride_channel_y,
+        (uint32_t) stride_channel_dst, sample_ratio_fd,
+        (uint32_t) stride_sample_x, (uint32_t) stride_sample_y, (uint32_t) stride_sample_dst,
+        0, mmvq_nemo_down_guest_args(), guest);
+    return true;
+}
