From: Claude Code (Opus 5) <noreply@anthropic.com>
Date: Fri, 14 Aug 2026 03:30:00 -0600
Subject: [PATCH 16/26] cuda: co-launch the Nemotron shared and routed up projections

Ported from the Nemotron R9700 HIP series to the GB10 CUDA track. Both tracks
pin llama.cpp 0b1bad14ff20 and llama.cpp's HIP backend is the CUDA backend
source-translated, so the diff applies to ggml/src/ggml-cuda unchanged.

Shared-up and routed-up consume the exact same F32 activation and the same
Q5_0 K=2688 weights. With the graph relay making them adjacent, one
flattened MMVQ grid carries both while each side retains its standalone
row/K mapping.

GB10 leave-one-out: GGML_CUDA_NEMO_SHEXP_UP_COLAUNCH=0 costs 0.44%.
---
diff --git a/ggml/src/ggml-cuda/ggml-cuda.cu b/ggml/src/ggml-cuda/ggml-cuda.cu
index 7cc1071cc..191ae28cc 100644
--- a/ggml/src/ggml-cuda/ggml-cuda.cu
+++ b/ggml/src/ggml-cuda/ggml-cuda.cu
@@ -4207,6 +4207,75 @@ static int ggml_cuda_try_fuse(ggml_backend_cuda_context * cuda_ctx, ggml_cgraph
         }
     }
 
+    // Nemotron decode: shared-up and routed-up consume the exact same F32
+    // activation and use Q5_0 K=2688 weights. The graph relay makes them
+    // adjacent so one flattened MMVQ grid can retain both standalone row/K
+    // mappings while removing one dispatch per MoE layer. Setting =0 also
+    // restores the pre-existing early shared-up graph order.
+    static const bool nemo_shexp_up_colaunch = [] {
+        const char * value = std::getenv("GGML_CUDA_NEMO_SHEXP_UP_COLAUNCH");
+        return value == nullptr || std::atoi(value) != 0;
+    }();
+    if (nemo_shexp_up_colaunch && i + 1 < cgraph->n_nodes &&
+            node->op == GGML_OP_MUL_MAT && cgraph->nodes[i + 1]->op == GGML_OP_MUL_MAT_ID) {
+        ggml_tensor * shared = node;
+        ggml_tensor * routed = cgraph->nodes[i + 1];
+        const ggml_tensor * sw = shared->src[0];
+        const ggml_tensor * rw = routed->src[0];
+        const ggml_op ops[] = { GGML_OP_MUL_MAT, GGML_OP_MUL_MAT_ID };
+        const int out_nodes[] = { i, i + 1 };
+
+        const bool shape_ok = sw != nullptr && rw != nullptr && shared->src[1] != nullptr &&
+            routed->src[1] == shared->src[1] && routed->src[2] != nullptr &&
+            sw->type == GGML_TYPE_Q5_0 && rw->type == GGML_TYPE_Q5_0 &&
+            sw->ne[0] == 2688 && sw->ne[1] == 3712 && sw->ne[2] == 1 && sw->ne[3] == 1 &&
+            shared->src[1]->type == GGML_TYPE_F32 &&
+            shared->src[1]->ne[0] == 2688 && shared->src[1]->ne[1] == 1 &&
+            shared->src[1]->ne[2] == 1 && shared->src[1]->ne[3] == 1 &&
+            shared->ne[0] == 3712 && shared->ne[1] == 1 && shared->ne[2] == 1 && shared->ne[3] == 1 &&
+            rw->ne[0] == 2688 && rw->ne[1] == 1856 && rw->ne[2] == 128 && rw->ne[3] == 1 &&
+            routed->ne[0] == 1856 && routed->ne[1] == 6 && routed->ne[2] == 1 && routed->ne[3] == 1 &&
+            routed->src[2]->type == GGML_TYPE_I32 && routed->src[2]->ne[0] == 6 &&
+            ggml_is_contiguous_1(shared->src[1]) && ggml_is_contiguous_1(shared) &&
+            ggml_is_contiguous_1(routed);
+
+        const auto disjoint = [](const ggml_tensor * a, const ggml_tensor * b) {
+            const uintptr_t a0 = (uintptr_t) a->data;
+            const uintptr_t b0 = (uintptr_t) b->data;
+            const uintptr_t a1 = a0 + ggml_backend_buft_get_alloc_size(a->buffer->buft, a);
+            const uintptr_t b1 = b0 + ggml_backend_buft_get_alloc_size(b->buffer->buft, b);
+            return a1 <= b0 || b1 <= a0;
+        };
+
+        if (shape_ok && ggml_cuda_should_fuse_mul_mat_vec_q(shared) &&
+                ggml_cuda_should_fuse_mul_mat_vec_q(routed) && disjoint(shared, routed) &&
+                ggml_can_fuse_subgraph(cgraph, i, 2, ops, out_nodes, 2) &&
+                ggml_cuda_check_fusion_memory_ranges(cgraph, i, 2, out_nodes, 2)) {
+            mmvq_nemo_routed_up_guest guest;
+            guest.src0 = routed->src[0];
+            guest.src1 = routed->src[1];
+            guest.ids  = routed->src[2];
+            guest.dst  = routed;
+            bool guest_launched = false;
+            ggml_cuda_mul_mat_vec_q(*cuda_ctx, shared->src[0], shared->src[1], nullptr, shared,
+                                    nullptr, nullptr, nullptr, &guest, &guest_launched);
+            if (!guest_launched) {
+                // The host has already run; execute only the declined guest.
+                ggml_cuda_mul_mat_vec_q(*cuda_ctx, routed->src[0], routed->src[1], routed->src[2], routed);
+            } else {
+                static const bool print_stats = std::getenv("GGML_CUDA_NEMO_SHEXP_UP_STATS") != nullptr &&
+                                                std::atoi(std::getenv("GGML_CUDA_NEMO_SHEXP_UP_STATS")) != 0;
+                static std::atomic<uint64_t> n_fused{0};
+                const uint64_t count = n_fused.fetch_add(1, std::memory_order_relaxed) + 1;
+                if (print_stats && (count <= 23 || count % 23 == 0)) {
+                    GGML_LOG_INFO("%s: Nemotron shared/routed up co-launch fire=%" PRIu64 "\n",
+                                  __func__, count);
+                }
+            }
+            return 1;
+        }
+    }
