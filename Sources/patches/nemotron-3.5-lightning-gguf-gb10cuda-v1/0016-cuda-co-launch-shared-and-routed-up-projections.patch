@@ -526,6 +543,57 @@ static __global__ void mul_mat_vec_q(
     // assignment and the stock reduction order.
     const uint32_t nwarps_launched = blockDim.y;
 
+    // Routed-up guest blocks occupy the front of a flattened grid.  Unlike the
+    // down guest, this path deliberately does not repack rows: Q5_0 K=2688 has
+    // six launched wavefronts but the stock kernel's compile-time eight-wave
+    // K stride and seven-add reduction skeleton. Keeping those two details
+    // unchanged makes every output row bit-identical to its standalone launch.
+    if constexpr (has_nemo_up_guest) {
+        if (blockIdx.x < nemo_up_guest.nblocks) {
+            const uint32_t channel = blockIdx.x / nemo_up_guest.nblocks_per_channel;
+            const uint32_t grow = blockIdx.x - channel * nemo_up_guest.nblocks_per_channel;
+            const int tid = warp_size * threadIdx.y + threadIdx.x;
+            const int blocks_per_row_g = nemo_up_guest.ncols_x / qk;
+            constexpr int blocks_per_iter_g = vdr * nwarps * warp_size / qi;
+
+            ggml_cuda_pdl_sync();
+            const uint32_t expert = nemo_up_guest.ids[channel];
+            const int g_offset = expert * nemo_up_guest.stride_channel_x + grow * nemo_up_guest.stride_row_x;
+            float gtmp = 0.0f;
+            for (int kbx = tid / (qi/vdr); kbx < blocks_per_row_g; kbx += blocks_per_iter_g) {
+                const int kby = kbx * (qk/QK8_1);
+                const int kqs = vdr * (tid % (qi/vdr));
+                gtmp += vec_dot_q_cuda(nemo_up_guest.vx, &((const block_q8_1 *) nemo_up_guest.vy)[kby],
+                                       g_offset + kbx, kqs);
+            }
+
+            __shared__ float up_guest_shared[nwarps - 1 > 0 ? nwarps - 1 : 1][warp_size];
+            // Mirror the stock trimmed-launch zero fill exactly. The missing
+            // wavefronts have empty K loops in the ordinary kernel.
+            if (threadIdx.y == 0 && nwarps_launched < uint32_t(nwarps)) {
+                for (uint32_t l = nwarps_launched - 1; l < uint32_t(nwarps) - 1; ++l) {
+                    up_guest_shared[l][threadIdx.x] = 0.0f;
+                }
+            }
+            if (threadIdx.y > 0) {
+                up_guest_shared[threadIdx.y - 1][threadIdx.x] = gtmp;
+            }
+            __syncthreads();
+            if (threadIdx.y > 0) {
+                return;
+            }
+#pragma unroll
+            for (int l = 0; l < nwarps - 1; ++l) {
+                gtmp += up_guest_shared[l][threadIdx.x];
+            }
+            gtmp = warp_reduce_sum<warp_size>(gtmp);
+            if (threadIdx.x == 0) {
+                nemo_up_guest.dst[channel * nemo_up_guest.stride_channel_dst + grow] = gtmp;
+            }
+            return;
+        }
