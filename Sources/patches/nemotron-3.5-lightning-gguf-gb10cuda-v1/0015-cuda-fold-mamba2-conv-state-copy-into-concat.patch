From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Claude Code (Opus 5) <noreply@anthropic.com>
Date: Fri, 14 Aug 2026 03:30:00 -0600
Subject: [PATCH 15/27] cuda: fold the Mamba2 conv state copy into the concat

Ported from the Nemotron R9700 HIP series to the GB10 CUDA track. Both tracks
pin llama.cpp 0b1bad14ff20 and llama.cpp's HIP backend is the CUDA backend
source-translated, so the diff applies to ggml/src/ggml-cuda unchanged.

The conv state copy is a read and write of the whole conv state that the
following CONCAT immediately re-reads. Emit it from the concat.

GB10 leave-one-out:
GGML_CUDA_DISABLE_MAMBA_CONV_STATE_CONCAT_FUSION=1 costs 0.46% of decode.
---
diff --git a/ggml/src/ggml-cuda/concat.cu b/ggml/src/ggml-cuda/concat.cu
index 6df89013c..003a187e6 100644
--- a/ggml/src/ggml-cuda/concat.cu
+++ b/ggml/src/ggml-cuda/concat.cu
@@ -240,3 +240,59 @@ void ggml_cuda_op_concat(ggml_backend_cuda_context & ctx, ggml_tensor * dst) {
         }
     }
 }
+
+// One thread owns a complete channel.  Loading all four source words before
+// touching the identity-mapped state makes the in-place shift race-free, while
+// uint32_t copies preserve every F32 bit exactly (including signed zero/NaNs).
+static __global__ void mamba_concat_state_f32_bits(
+        const char * state_ptr, const char * x_ptr, uint32_t * dst_ptr, uint32_t * cache_ptr,
+        const int64_t state_nb1, const int64_t x_nb1, const int64_t n_channels) {
+    ggml_cuda_pdl_lc();
+    const int64_t ch = (int64_t) blockIdx.x * blockDim.x + threadIdx.x;
+    ggml_cuda_pdl_sync();
+    if (ch >= n_channels) {
+        return;
+    }
+
+    const uint32_t * state = (const uint32_t *) (state_ptr + ch*state_nb1);
+    const uint32_t * x     = (const uint32_t *) (x_ptr     + ch*x_nb1);
+
+    // Complete every read from the aliased old state before its three writes.
+    const uint32_t s0 = state[0];
+    const uint32_t s1 = state[1];
+    const uint32_t s2 = state[2];
+    const uint32_t xv = x[0];
+
+    uint32_t * out = dst_ptr + 4*ch;
+    out[0] = s0;
+    out[1] = s1;
+    out[2] = s2;
+    out[3] = xv;
+
+    uint32_t * cache = cache_ptr + 3*ch;
+    cache[0] = s1;
+    cache[1] = s2;
+    cache[2] = xv;
+}
+
+void ggml_cuda_op_concat_fused_mamba_state(
+        ggml_backend_cuda_context & ctx, ggml_tensor * dst, ggml_tensor * cache) {
+    const ggml_tensor * state = dst->src[0];
+    const ggml_tensor * x     = dst->src[1];
+
+    GGML_ASSERT(state != nullptr && x != nullptr && cache != nullptr);
+    GGML_ASSERT(state->type == GGML_TYPE_F32 && x->type == GGML_TYPE_F32 &&
+                dst->type == GGML_TYPE_F32 && cache->type == GGML_TYPE_F32);
+    GGML_ASSERT(state->ne[0] == 3 && x->ne[0] == 1 && dst->ne[0] == 4);
+    GGML_ASSERT(state->ne[1] == x->ne[1] && x->ne[1] == dst->ne[1]);
+    GGML_ASSERT(cache->data == state->data && ggml_nelements(cache) == 3*state->ne[1]);
+
+    constexpr int threads = CUDA_CONCAT_BLOCK_SIZE;
+    const int64_t n_channels = state->ne[1];
+    const dim3 blocks((n_channels + threads - 1) / threads, 1, 1);
+    const ggml_cuda_kernel_launch_params launch_params(blocks, threads, 0, ctx.stream());
+    ggml_cuda_kernel_launch(mamba_concat_state_f32_bits, launch_params,
+        (const char *) state->data, (const char *) x->data,
+        (uint32_t *) dst->data, (uint32_t *) cache->data,
+        (int64_t) state->nb[1], (int64_t) x->nb[1], n_channels);
+}
diff --git a/ggml/src/ggml-cuda/concat.cuh b/ggml/src/ggml-cuda/concat.cuh
index aa506a05f..962b551f7 100644
--- a/ggml/src/ggml-cuda/concat.cuh
+++ b/ggml/src/ggml-cuda/concat.cuh
@@ -3,3 +3,9 @@
 #define CUDA_CONCAT_BLOCK_SIZE 256
 
 void ggml_cuda_op_concat(ggml_backend_cuda_context & ctx, ggml_tensor * dst);
+
+// Exact decode-shaped Mamba2 state concat.  In addition to materializing
+// [state0,state1,state2,x] for the stock convolution, write the identical
+// [state1,state2,x] bit pattern to the identity-mapped recurrent cache.
+void ggml_cuda_op_concat_fused_mamba_state(
+        ggml_backend_cuda_context & ctx, ggml_tensor * dst, ggml_tensor * cache);
diff --git a/ggml/src/ggml-cuda/ggml-cuda.cu b/ggml/src/ggml-cuda/ggml-cuda.cu
index bd28db251..7cc1071cc 100644
--- a/ggml/src/ggml-cuda/ggml-cuda.cu
+++ b/ggml/src/ggml-cuda/ggml-cuda.cu
@@ -87,6 +87,7 @@
 #include <cstdio>
 #include <cstdlib>
 #include <string>
+#include <unordered_set>
 #include <vector>
 
 static_assert(sizeof(half) == sizeof(ggml_fp16_t), "wrong fp16 size");
@@ -3835,6 +3836,230 @@ static int ggml_cuda_nemo_pre_add_norm_detect(const ggml_cgraph * cgraph, const
     return n_adds;
 }
 
+static const ggml_tensor * ggml_cuda_view_root(const ggml_tensor * t) {
+    while (t != nullptr && t->view_src != nullptr) {
+        t = t->view_src;
+    }
+    return t;
+}
+
+static bool ggml_cuda_byte_ranges_disjoint(
+        const void * a, const size_t a_size, const void * b, const size_t b_size) {
+    if (a == nullptr || b == nullptr || a_size == 0 || b_size == 0) {
+        return false;
+    }
+    const uintptr_t a0 = (uintptr_t) a;
+    const uintptr_t b0 = (uintptr_t) b;
+    if (a0 > UINTPTR_MAX - a_size || b0 > UINTPTR_MAX - b_size) {
+        return false;
+    }
+    return a0 + a_size <= b0 || b0 + b_size <= a0;
+}
+
+// Fold only the identity-state writeback of Nemotron's batch-one Mamba2
+// convolution prefix:
+//
+//   CONCAT([3,6144] state, [1,6144] x) -> CPY(last 3 columns, same state)
+//                                      -> stock SSM_CONV + bias + SiLU
+//
+// The fused CONCAT remains a pure bit copy and the existing SSM_CONV kernel is
+// left completely untouched, including its F32 materialization and reduction.
+struct ggml_cuda_mamba_conv_state_concat_plan {
+    ggml_tensor * cpy   = nullptr;
+    ggml_tensor * cache = nullptr;
+    int conv_index = -1;
+    int add_index  = -1;
+    int silu_index = -1;
+    int cpy_index  = -1;
+};
+
+// Graph expansion places the stock SSM_CONV/bias/SiLU nodes before the state
+// CPY on this model.  Detect by dataflow rather than requiring CPY to be the
+// first real node, then suppress only that CPY in the evaluator's done set.
+static bool ggml_cuda_mamba_conv_state_concat_detect(
+        ggml_backend_cuda_context * ctx, const ggml_cgraph * cgraph, const int i,
+        ggml_cuda_mamba_conv_state_concat_plan & plan, const bool diagnostics) {
+    ggml_tensor * concat = cgraph->nodes[i];
+    plan = {};
+    if (concat->op != GGML_OP_CONCAT || concat->type != GGML_TYPE_F32 ||
+            (concat->flags & GGML_TENSOR_FLAG_OUTPUT) || ggml_get_op_params_i32(concat, 0) != 0) {
+        return false;
+    }
+
+    const ggml_tensor * state = concat->src[0];
+    const ggml_tensor * x     = concat->src[1];
+    constexpr int64_t n_channels = 6144;
+    if (state == nullptr || x == nullptr || state->type != GGML_TYPE_F32 || x->type != GGML_TYPE_F32 ||
+            state->ne[0] != 3 || x->ne[0] != 1 || concat->ne[0] != 4) {
+        return false;
+    }
+
+    const auto reject = [&](const char * reason) {
+        static std::atomic<uint64_t> n_rejected{0};
+        const uint64_t count = n_rejected.fetch_add(1, std::memory_order_relaxed) + 1;
+        if (diagnostics && (count <= 23 || count % 23 == 0)) {
+            GGML_LOG_INFO("%s: Mamba2 conv state concat reject=%s count=%" PRIu64
+                          ", state=[%" PRId64 ",%" PRId64 "] x=[%" PRId64 ",%" PRId64
+                          "] concat=[%" PRId64 ",%" PRId64 "] node=%s\n",
+                          __func__, reason, count, state->ne[0], state->ne[1], x->ne[0], x->ne[1],
+                          concat->ne[0], concat->ne[1], concat->name);
+        }
+        return false;
+    };
+
+    if (state->ne[1] != n_channels || state->ne[2] != 1 || state->ne[3] != 1 ||
+            x->ne[0] != 1 || x->ne[1] != n_channels || x->ne[2] != 1 || x->ne[3] != 1 ||
+            concat->ne[0] != 4 || concat->ne[1] != n_channels ||
+            concat->ne[2] != 1 || concat->ne[3] != 1 ||
+            state->nb[0] != sizeof(float) || state->nb[1] != 3*sizeof(float) ||
+            x->nb[1] != sizeof(float) || !ggml_is_contiguous(state) || !ggml_is_contiguous(concat)) {
+        return reject("shape-or-layout");
+    }
+
+    ggml_tensor * cpy  = nullptr;
+    ggml_tensor * conv = nullptr;
+    ggml_tensor * add  = nullptr;
+    ggml_tensor * silu = nullptr;
+    int cpy_idx = -1;
+    int conv_idx = -1;
+    int add_idx = -1;
+    int silu_idx = -1;
+
+    const int window = std::min(cgraph->n_nodes, i + 48);
+    for (int j = i + 1; j < window; ++j) {
+        ggml_tensor * cand = cgraph->nodes[j];
+        if (ggml_cuda_is_view_or_noop(cand)) {
+            continue;
+        }
+        for (int k = 0; k < GGML_MAX_SRC; ++k) {
+            const ggml_tensor * src = cand->src[k];
+            const ggml_tensor * root = ggml_cuda_view_root(src);
+            if (root == concat) {
+                if (cand->op == GGML_OP_SSM_CONV && k == 0 && src == concat && conv == nullptr) {
+                    conv = cand;
+                    conv_idx = j;
+                } else if (cand->op == GGML_OP_CPY && k == 0 && cpy == nullptr) {
+                    cpy = cand;
+                    cpy_idx = j;
+                } else {
+                    return reject("unexpected-concat-consumer");
+                }
+            }
+            if (conv != nullptr && root == conv) {
+                if (cand->op == GGML_OP_ADD && add == nullptr) {
+                    add = cand;
+                    add_idx = j;
+                } else {
+                    return reject("unexpected-conv-consumer");
+                }
+            }
+            if (add != nullptr && root == add) {
+                if (cand->op == GGML_OP_UNARY && ggml_get_unary_op(cand) == GGML_UNARY_OP_SILU && silu == nullptr) {
+                    silu = cand;
+                    silu_idx = j;
+                } else {
+                    return reject("unexpected-add-consumer");
+                }
+            }
+        }
+    }
+    if (cpy == nullptr || conv == nullptr || add == nullptr || silu == nullptr) {
+        return reject("missing-chain-member");
+    }
+    if ((cpy->flags & GGML_TENSOR_FLAG_OUTPUT) || (conv->flags & GGML_TENSOR_FLAG_OUTPUT) ||
+            (add->flags & GGML_TENSOR_FLAG_OUTPUT) || (silu->flags & GGML_TENSOR_FLAG_OUTPUT)) {
+        return reject("output-flag");
+    }
+
+    const ggml_tensor * cpy_src = cpy->src[0];
+    ggml_tensor * cache = cpy->src[1];
+    const ggml_tensor * w = conv->src[1];
+    const ggml_tensor * bias = add->src[0] == conv ? add->src[1] :
+                               add->src[1] == conv ? add->src[0] : nullptr;
+    if (cpy_src == nullptr || cache == nullptr || w == nullptr || bias == nullptr ||
+            ggml_cuda_view_root(cpy_src) != concat ||
+            (const char *) cpy_src->data != (const char *) concat->data + sizeof(float) ||
+            cpy_src->type != GGML_TYPE_F32 || cpy_src->ne[0] != 3 ||
+            cpy_src->ne[1] != n_channels || cpy_src->ne[2] != 1 || cpy_src->ne[3] != 1 ||
+            cpy_src->nb[0] != sizeof(float) || cpy_src->nb[1] != 4*sizeof(float) ||
+            cache->type != GGML_TYPE_F32 || !ggml_is_contiguous(cache) ||
+            ggml_nelements(cache) != 3*n_channels || cache->data != state->data || cpy->data != cache->data ||
+            conv->src[0] != concat || w->type != GGML_TYPE_F32 ||
+            w->ne[0] != 4 || w->ne[1] != n_channels || w->ne[2] != 1 || w->ne[3] != 1 ||
+            w->nb[0] != sizeof(float) ||
+            conv->type != GGML_TYPE_F32 || conv->ne[0] != n_channels || conv->ne[1] != 1 ||
+            conv->ne[2] != 1 || conv->ne[3] != 1 ||
+            bias->type != GGML_TYPE_F32 || !ggml_is_contiguous(bias) || ggml_nelements(bias) != n_channels ||
+            add->type != GGML_TYPE_F32 || silu->type != GGML_TYPE_F32 || silu->src[0] != add ||
+            !ggml_are_same_shape(conv, add) || !ggml_are_same_shape(add, silu) || !ggml_is_contiguous(silu)) {
+        return reject("chain-detail");
+    }
+
+    const size_t state_bytes = 3*n_channels*sizeof(float);
+    const size_t x_bytes     = n_channels*sizeof(float);
+    const size_t concat_bytes = 4*n_channels*sizeof(float);
+    if (!ggml_cuda_byte_ranges_disjoint(state->data, state_bytes, x->data, x_bytes) ||
+            !ggml_cuda_byte_ranges_disjoint(concat->data, concat_bytes, state->data, state_bytes) ||
+            !ggml_cuda_byte_ranges_disjoint(concat->data, concat_bytes, x->data, x_bytes)) {
+        return reject("allocation-alias");
+    }
+
+    // The only real readers of CONCAT must be this writeback and stock conv;
+    // the ADD and SiLU must likewise retain their ordinary single-consumer chain.
+    for (int j = i + 1; j < cgraph->n_nodes; ++j) {
+        const ggml_tensor * n = cgraph->nodes[j];
+        if (ggml_cuda_is_view_or_noop(n)) {
+            continue;
+        }
+        for (int k = 0; k < GGML_MAX_SRC; ++k) {
+            const ggml_tensor * src = n->src[k];
+            const ggml_tensor * root = ggml_cuda_view_root(src);
+            if (root == concat && n != cpy && n != conv) {
+                return reject("hidden-concat-user");
+            }
+            if (root == conv && n != add) {
+                return reject("hidden-conv-user");
+            }
+            if (root == add && n != silu) {
+                return reject("hidden-add-user");
+            }
+        }
+    }
+
+    // Moving the cache write to CONCAT may cross only the known stock conv
+    // chain, never an unrelated compute that could observe the old state.
+    for (int j = i + 1; j <= cpy_idx; ++j) {
+        const ggml_tensor * n = cgraph->nodes[j];
+        if (!ggml_cuda_is_view_or_noop(n) && n != conv && n != add && n != silu && n != cpy) {
+            return reject("intervening-compute");
+        }
+    }
+
+    // Hoisting the CPY write may not cross a concurrent-region boundary; the
+    // original CPY and fused CONCAT must have the same stream mapping.
+    for (const auto & [fork_node, event] : ctx->stream_context().concurrent_events) {
+        if (fork_node == concat || fork_node == cpy || event.join_node == concat || event.join_node == cpy) {
+            return reject("fork-or-join-boundary");
+        }
+        const auto concat_it = event.stream_mapping.find(concat);
+        const auto cpy_it    = event.stream_mapping.find(cpy);
+        if ((concat_it == event.stream_mapping.end()) != (cpy_it == event.stream_mapping.end())) {
+            return reject("cross-stream-membership");
+        }
+        if (concat_it != event.stream_mapping.end() && concat_it->second != cpy_it->second) {
+            return reject("cross-stream-number");
+        }
+    }
+
+    plan.cpy   = cpy;
+    plan.cache = cache;
+    plan.conv_index = conv_idx;
+    plan.add_index  = add_idx;
+    plan.silu_index = silu_idx;
+    plan.cpy_index  = cpy_idx;
+    return true;
+}
+
 // Match only the batch-one Nemotron-3.5 Mamba tail:
 //   SwiGLU {64,64} -> reshape {512,8} -> RMS norm -> per-group scale
 //   -> reshape {4096,1} -> quantized ssm_out {4096,2688} MMVQ.
@@ -5026,6 +5251,19 @@ static void ggml_cuda_graph_evaluate_and_capture(ggml_backend_cuda_context * cud
                 stream_ctx.concurrent_events.clear();
             }
 
+            // A dataflow match may place the conv-state CPY after the stock
+            // SSM_CONV/bias/SiLU nodes.  Track that one consumed node directly
+            // instead of skipping a raw graph range (which would skip compute).
+            std::unordered_set<const ggml_tensor *> mamba_conv_state_concat_done;
+            static const bool disable_mamba_conv_state_concat = [] {
+                const char * value = std::getenv("GGML_CUDA_DISABLE_MAMBA_CONV_STATE_CONCAT_FUSION");
+                return value != nullptr && std::atoi(value) != 0;
+            }();
+            static const bool print_mamba_conv_state_concat = [] {
+                const char * value = std::getenv("GGML_CUDA_MAMBA_CONV_STATE_CONCAT_STATS");
+                return value != nullptr && std::atoi(value) != 0;
+            }();
+
             for (int i = 0; i < cgraph->n_nodes; i++) {
                 ggml_tensor * node = cgraph->nodes[i];
 
@@ -5075,6 +5313,34 @@ static void ggml_cuda_graph_evaluate_and_capture(ggml_backend_cuda_context * cud
                     continue;
                 }
 
+                if (mamba_conv_state_concat_done.count(node) != 0) {
+                    continue;
+                }
+
+                // Preserve the stock convolution kernel/arithmetic and fold
+                // only its identity-state CONCAT+CPY prefix into one exact
+                // bit-copy launch.  CPY is suppressed wherever graph expansion
+                // placed it; SSM_CONV/bias/SiLU retain their ordinary execution.
+                if (!disable_mamba_conv_state_concat && node->op == GGML_OP_CONCAT) {
+                    ggml_cuda_mamba_conv_state_concat_plan plan;
+                    if (ggml_cuda_mamba_conv_state_concat_detect(
+                            cuda_ctx, cgraph, i, plan, print_mamba_conv_state_concat)) {
+                        ggml_cuda_op_concat_fused_mamba_state(*cuda_ctx, node, plan.cache);
+                        cuda_ctx->quantized_src1_cache.invalidate_views_of(plan.cpy);
+                        mamba_conv_state_concat_done.insert(plan.cpy);
+
+                        static std::atomic<uint64_t> n_fused{0};
+                        const uint64_t count = n_fused.fetch_add(1, std::memory_order_relaxed) + 1;
+                        if (print_mamba_conv_state_concat && (count <= 23 || count % 23 == 0)) {
+                            GGML_LOG_INFO("%s: Mamba2 conv state concat fire=%" PRIu64
+                                          ", channels=%" PRId64 ", order=%d/%d/%d/%d/%d, cpy=%s, node=%s\n",
+                                          __func__, count, node->ne[1], i, plan.conv_index, plan.add_index,
+                                          plan.silu_index, plan.cpy_index, plan.cpy->name, node->name);
+                        }
+                        continue;
+                    }
+                }
+
                 int nodes_to_skip = ggml_cuda_try_fuse(cuda_ctx, cgraph, i);
 
                 if (nodes_to_skip != 0) {
