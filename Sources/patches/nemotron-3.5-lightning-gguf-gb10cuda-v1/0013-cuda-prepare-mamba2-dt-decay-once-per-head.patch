From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Claude Code (Opus 5) <noreply@anthropic.com>
Date: Fri, 14 Aug 2026 03:30:00 -0600
Subject: [PATCH 13/27] cuda: prepare the Mamba2 dt decay once per head

Ported from the Nemotron R9700 HIP series to the GB10 CUDA track. Both tracks
pin llama.cpp 0b1bad14ff20 and llama.cpp's HIP backend is the CUDA backend
source-translated, so the diff applies to ggml/src/ggml-cuda unchanged.

softplus(dt) and exp(softplus(dt)*A) depend only on the head, but the scan
recomputes both in every warp that shares that head. Compute them once in a
small preparation kernel that also absorbs the dt bias ADD.

This patch is architecture-gated in the source it was ported from; see patch
0026, which opens the gate for sm_121. GB10 leave-one-out with the gate open:
GGML_CUDA_DISABLE_SSM_DT_PREP_FUSION=1 costs 0.32% of decode.
---
diff --git a/ggml/src/ggml-cuda/ggml-cuda.cu b/ggml/src/ggml-cuda/ggml-cuda.cu
index dd1233a5d..2afa35d74 100644
--- a/ggml/src/ggml-cuda/ggml-cuda.cu
+++ b/ggml/src/ggml-cuda/ggml-cuda.cu
@@ -3006,6 +3006,116 @@ static int ggml_cuda_try_ssm_state_writeback_fusion(
     return fused_skip;
 }
 
+// Replace Nemotron's decode-shaped dt+bias ADD with a head-wise preparation
+// launch, then let the scan consume rounded F32 softplus(dt) and dA values.
+// The scan recurrence and reduction are untouched. This matcher deliberately
+// composes with the existing direct-state/output-D fusion so no intermediate
+// ADD destination or scan tail remains live after the skipped range.
+static int ggml_cuda_try_ssm_dt_prep_fusion(
+        ggml_backend_cuda_context * cuda_ctx,
+        const ggml_cgraph * cgraph, int node_idx, bool fuse_output_d,
+        ggml_tensor * & scan_out,
+        ggml_cuda_ssm_scan_fused_cache & fused_cache,
+        ggml_cuda_ssm_scan_fused_dt & fused_dt) {
+    ggml_tensor * add = cgraph->nodes[node_idx];
+    if (add->op != GGML_OP_ADD || add->type != GGML_TYPE_F32 ||
+        (add->flags & GGML_TENSOR_FLAG_OUTPUT)) {
+        return 0;
+    }
+
+    const int cc = ggml_cuda_info().devices[cuda_ctx->device].cc;
+    if (!GGML_CUDA_CC_IS_RDNA4(cc)) {
+        return 0;
+    }
+
+    const ggml_tensor * dt_raw  = add->src[0];
+    const ggml_tensor * dt_bias = add->src[1];
+    if (dt_raw == nullptr || dt_bias == nullptr ||
+        dt_raw->type != GGML_TYPE_F32 || dt_bias->type != GGML_TYPE_F32 ||
+        !ggml_is_contiguous(dt_raw) || !ggml_is_contiguous(dt_bias) || !ggml_is_contiguous(add) ||
+        add->ne[0] != 64 || add->ne[1] != 1 || add->ne[2] != 1 || add->ne[3] != 1 ||
+        !ggml_are_same_shape(dt_raw, add) || ggml_nelements(dt_bias) != 64) {
+        return 0;
+    }
+
+    // Views/reshapes carry no work. Any real node between this ADD and its
+    // scan makes the fusion unsafe because the loop will skip the full range.
+    int scan_idx = -1;
+    ggml_tensor * scan = nullptr;
+    for (int j = node_idx + 1; j < cgraph->n_nodes; ++j) {
+        ggml_tensor * n = cgraph->nodes[j];
+        if (ggml_cuda_is_view_or_noop(n)) {
+            continue;
+        }
+        if (n->op != GGML_OP_SSM_SCAN) {
+            return 0;
+        }
+        scan_idx = j;
+        scan = n;
+        break;
+    }
+    if (scan == nullptr || scan->src[2] != add || scan->type != GGML_TYPE_F32) {
+        return 0;
+    }
+
+    const ggml_tensor * state = scan->src[0];
+    const ggml_tensor * x     = scan->src[1];
+    const ggml_tensor * A     = scan->src[3];
+    const ggml_tensor * B     = scan->src[4];
+    const ggml_tensor * C     = scan->src[5];
+    if (state == nullptr || x == nullptr || A == nullptr || B == nullptr || C == nullptr ||
+        state->ne[0] != 128 || x->ne[0] != 64 || x->ne[1] != 64 || x->ne[2] != 1 || x->ne[3] != 1 ||
+        A->ne[0] != 1 || A->ne[1] != 64 ||
+        B->ne[0] != 128 || B->ne[1] != 8 || C->ne[0] != 128 || C->ne[1] != 8) {
+        return 0;
+    }
+
+    // The skipped ADD result must have exactly one reader: this scan.
+    int add_users = 0;
+    for (int j = node_idx + 1; j < cgraph->n_nodes; ++j) {
+        for (int k = 0; k < GGML_MAX_SRC; ++k) {
+            if (cgraph->nodes[j]->src[k] == add) {
+                ++add_users;
+            }
+        }
+    }
+    if (add_users != 1) {
+        return 0;
+    }
+
+    const int scan_skip = ggml_cuda_try_ssm_state_writeback_fusion(
+        cuda_ctx, cgraph, scan_idx, fuse_output_d, fused_cache);
+    if (scan_skip <= 0) {
+        return 0;
+    }
+
+    // The existing scan matcher proves the scan-through-output range stays on
+    // one concurrent stream. Extend that proof backward over ADD and no-ops.
+    for (const auto & [fork_node, event] : cuda_ctx->stream_context().concurrent_events) {
+        const auto scan_it = event.stream_mapping.find(scan);
+        const bool scan_mapped = scan_it != event.stream_mapping.end();
+        for (int j = node_idx; j < scan_idx; ++j) {
+            const ggml_tensor * n = cgraph->nodes[j];
+            if (fork_node == n || event.join_node == n) {
+                return 0;
+            }
+            const auto it = event.stream_mapping.find(n);
+            if (scan_mapped) {
+                if (it == event.stream_mapping.end() || it->second != scan_it->second) {
+                    return 0;
+                }
+            } else if (it != event.stream_mapping.end()) {
+                return 0;
+            }
+        }
+    }
+
+    scan_out        = scan;
+    fused_dt.dt_raw = (const float *) dt_raw->data;
+    fused_dt.dt_bias = (const float *) dt_bias->data;
+    return (scan_idx - node_idx) + scan_skip;
+}
