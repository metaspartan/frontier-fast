+// Preserve the stock ADD-kernel rounding point, then evaluate the two
+// head-shared transcendental values once.  Nemotron decode has one value per
+// head, while the scan otherwise repeats this chain in all d_head warps.
+static __global__ void ssm_dt_prepare_f32(
+        const float * dt_raw, const float * dt_bias, const float * A,
+        float * dt_softplus, float * dA, const int64_t n_head) {
+    const int64_t head = blockIdx.x * blockDim.x + threadIdx.x;
+    if (head >= n_head) {
+        return;
+    }
+
+    float dt = __fadd_rn(dt_raw[head], dt_bias[head]);
+#if defined(__HIP_PLATFORM_AMD__)
+    // The ordinary ADD is a separate kernel.  Keep the rounded sum from being
+    // reassociated into the softplus chain under hipcc's unsafe-math flags.
+    asm volatile("" : "+v"(dt));
+#endif
+    const float dt_sp = dt <= 20.0f ? log1pf(expf(dt)) : dt;
+    dt_softplus[head] = dt_sp;
+    dA[head]          = expf(dt_sp * A[head]);
+}
