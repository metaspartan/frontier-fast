+            cuda_ctx, cgraph, i, !disable_ssm_output_d, scan, fused_cache, fused_dt);
+        if (nodes_to_skip > 0) {
+            static const bool print_stats = getenv("GGML_CUDA_SSM_DT_PREP_STATS") != nullptr &&
+                                            std::atoi(getenv("GGML_CUDA_SSM_DT_PREP_STATS"));
+            static std::atomic<uint64_t> n_fused{0};
+            const uint64_t count = n_fused.fetch_add(1, std::memory_order_relaxed) + 1;
+            if (print_stats && (count <= 23 || count % 23 == 0)) {
+                GGML_LOG_INFO("%s: Mamba2 dt preparation fire=%" PRIu64
+                              ", heads=%" PRId64 ", skipped=%d, scan=%s\n",
+                              __func__, count, scan->src[1]->ne[1], nodes_to_skip, scan->name);
+            }
+            ggml_cuda_op_ssm_scan(*cuda_ctx, scan, &fused_cache, &fused_dt);
+            return nodes_to_skip;
+        }
+    }
     if (node->op == GGML_OP_SSM_SCAN && !disable_ssm_state_writeback) {
         ggml_cuda_ssm_scan_fused_cache fused_cache;
         const int nodes_to_skip = ggml_cuda_try_ssm_state_writeback_fusion(
