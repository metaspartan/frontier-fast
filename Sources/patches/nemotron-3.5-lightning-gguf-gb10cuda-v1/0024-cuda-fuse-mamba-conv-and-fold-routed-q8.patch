diff --git a/ggml/src/ggml-cuda/ssm-conv.cu b/ggml/src/ggml-cuda/ssm-conv.cu
index 1463169cf..3e9836965 100644
--- a/ggml/src/ggml-cuda/ssm-conv.cu
+++ b/ggml/src/ggml-cuda/ssm-conv.cu
@@ -57,6 +57,75 @@ static __global__ void ssm_conv_f32(const float * src0_ptr, const float * src1_p
     }
 }
 
+// This is deliberately the same four-tap F32 reduction as ssm_conv_f32 above.
+// The only additional work is the exact uint32_t materialization of CONCAT and
+// its identity-mapped recurrent cache.  One thread owns a complete channel, so
+// all old-state words are loaded before any aliased cache word is overwritten.
+static __global__ void nemo_mamba_concat_ssm_conv_f32_bits(
+        const char * state_ptr, const char * x_ptr, const float * weight_ptr, const float * bias_ptr,
+        uint32_t * concat_ptr, uint32_t * cache_ptr, float * dst_ptr,
+        const int64_t state_nb1, const int64_t x_nb1, const int64_t weight_nb1,
+        const int64_t dst_nb0, const int64_t n_channels) {
+    ggml_cuda_pdl_lc();
+    constexpr int d_conv = 4;
+    constexpr int split_d_inner = 128;
+
+    const int tid  = threadIdx.x;
+    const int bidy = blockIdx.y;
+    const int64_t ch = (int64_t) bidy * split_d_inner + tid;
+
+    ggml_cuda_pdl_sync();
+    if (ch >= n_channels) {
+        return;
+    }
+
+    const uint32_t * state = (const uint32_t *) (state_ptr + ch*state_nb1);
+    const uint32_t * x_in  = (const uint32_t *) (x_ptr     + ch*x_nb1);
+
+    const uint32_t s0_bits = state[0];
+    const uint32_t s1_bits = state[1];
+    const uint32_t s2_bits = state[2];
+    const uint32_t x_bits  = x_in[0];
+
+    uint32_t * concat = concat_ptr + d_conv*ch;
+    concat[0] = s0_bits;
+    concat[1] = s1_bits;
+    concat[2] = s2_bits;
+    concat[3] = x_bits;
+
+    uint32_t * cache = cache_ptr + 3*ch;
+    cache[0] = s1_bits;
+    cache[1] = s2_bits;
+    cache[2] = x_bits;
+
+    const float * w_block = (const float *) ((const char *) weight_ptr +
+                                             bidy * split_d_inner * weight_nb1);
+    float w[d_conv] = { 0.0f };
+#pragma unroll
+    for (int j = 0; j < d_conv; ++j) {
+        w[j] = w_block[tid * (weight_nb1 / (int) sizeof(float)) + j];
+    }
+
+    // Bitcasts preserve the exact F32 values written by stock CONCAT.  Keep the
+    // stock loop and accumulation expression unchanged so HIP emits the same
+    // ordered sequence of round-to-nearest multiply-adds.
+    float conv_x[d_conv] = {
+        __uint_as_float(s0_bits),
+        __uint_as_float(s1_bits),
+        __uint_as_float(s2_bits),
+        __uint_as_float(x_bits),
+    };
+    float sumf = 0.0f;
+#pragma unroll
+    for (int j = 0; j < d_conv; ++j) {
+        sumf += conv_x[j] * w[j];
+    }
+    sumf += bias_ptr[ch];
+
+    float * y = (float *) ((char *) dst_ptr + ch*dst_nb0);
+    *y = ggml_cuda_op_silu_single(sumf);
+}
+
 template <bool apply_silu, size_t split_d_inner, size_t d_conv, int64_t split_n_t>
 static __global__ void ssm_conv_long_token_f32(const float * __restrict__ src0, const float * __restrict__ src1,
                                                const float * __restrict__ bias,
@@ -204,3 +273,23 @@ void ggml_cuda_op_ssm_conv(ggml_backend_cuda_context & ctx, ggml_tensor * dst, g
                           out->nb[2], nc, nr, n_t, n_s, stream);
     }
 }
+
+void ggml_cuda_op_ssm_conv_fused_mamba_concat_state(
+        ggml_backend_cuda_context & ctx, ggml_tensor * concat, ggml_tensor * conv,
+        ggml_tensor * bias_add_node, ggml_tensor * silu_dst, ggml_tensor * cache) {
+    const ggml_tensor * state  = concat->src[0];
+    const ggml_tensor * x      = concat->src[1];
+    const ggml_tensor * weight = conv->src[1];
+    const ggml_tensor * bias   = bias_add_node->src[0] == conv ? bias_add_node->src[1] : bias_add_node->src[0];
+
+    constexpr int threads = 128;
+    const int64_t n_channels = state->ne[1];
+    const dim3 blocks(1, n_channels / threads, 1);
+    const ggml_cuda_kernel_launch_params launch_params(blocks, threads, 0, ctx.stream());
+    ggml_cuda_kernel_launch(nemo_mamba_concat_ssm_conv_f32_bits, launch_params,
+        (const char *) state->data, (const char *) x->data,
+        (const float *) weight->data, (const float *) bias->data,
+        (uint32_t *) concat->data, (uint32_t *) cache->data, (float *) silu_dst->data,
+        (int64_t) state->nb[1], (int64_t) x->nb[1], (int64_t) weight->nb[1],
+        (int64_t) silu_dst->nb[0], n_channels);
+}
