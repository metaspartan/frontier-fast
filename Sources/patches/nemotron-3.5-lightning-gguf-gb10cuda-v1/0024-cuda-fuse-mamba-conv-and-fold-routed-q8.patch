 //   SwiGLU {64,64} -> reshape {512,8} -> RMS norm -> per-group scale
 //   -> reshape {4096,1} -> quantized ssm_out {4096,2688} MMVQ.
@@ -4743,6 +4865,10 @@ static int ggml_cuda_try_fuse(ggml_backend_cuda_context * cuda_ctx, ggml_cgraph
         const char * value = std::getenv("GGML_CUDA_DISABLE_RMS_NORM_Q8_FUSION");
         return value != nullptr && std::atoi(value) != 0;
     }();
+    static const bool nemo_routed_q8_fold = [] {
+        const char * value = std::getenv("GGML_CUDA_NEMO_ROUTED_Q8_FOLD");
+        return value == nullptr || std::atoi(value) != 0;
+    }();
     if (nemo_shexp_act_colaunch && !q8_1_cache_disabled && i + 3 < cgraph->n_nodes &&
             node->op == GGML_OP_UNARY && ggml_get_unary_op(node) == GGML_UNARY_OP_RELU) {
         ggml_tensor * shared_relu = node;
@@ -4792,11 +4918,37 @@ static int ggml_cuda_try_fuse(ggml_backend_cuda_context * cuda_ctx, ggml_cgraph
             const int64_t s12 = shared_sqr->nb[2] / ggml_type_size(shared_sqr->type);
             const int64_t s13 = shared_sqr->nb[3] / ggml_type_size(shared_sqr->type);
             const size_t size_q8_1 = ne10_padded * sizeof(block_q8_1) / QK8_1;
-            char * q8_1_dst = cuda_ctx->quantized_src1_cache.insert(
+            char * shared_q8_dst = cuda_ctx->quantized_src1_cache.insert(
                 cuda_ctx->pool(), shared_sqr, stream,
                 ne10, s11, s12, s13, ne10_padded, 1, 1, 1, size_q8_1);
+
+            const int64_t routed_ne10 = routed_sqr->ne[0];
+            const int64_t routed_ne10_padded = GGML_PAD(routed_ne10, MATRIX_ROW_PADDING);
+            const int64_t routed_s11 = routed_sqr->nb[1] / ggml_type_size(routed_sqr->type);
+            const int64_t routed_s12 = routed_sqr->nb[2] / ggml_type_size(routed_sqr->type);
+            const int64_t routed_s13 = routed_sqr->nb[3] / ggml_type_size(routed_sqr->type);
+            char * routed_q8_dst = nullptr;
+            if (nemo_routed_q8_fold) {
+                const size_t routed_size_q8_1 = routed_sqr->ne[3] * routed_sqr->ne[2] * routed_sqr->ne[1] *
+                    routed_ne10_padded * sizeof(block_q8_1) / QK8_1;
+                routed_q8_dst = cuda_ctx->quantized_src1_cache.insert(
+                    cuda_ctx->pool(), routed_sqr, stream,
+                    routed_ne10, routed_s11, routed_s12, routed_s13, routed_ne10_padded,
+                    routed_sqr->ne[1], routed_sqr->ne[2], routed_sqr->ne[3], routed_size_q8_1);
+
+                static const bool print_stats = [] {
+                    const char * value = std::getenv("GGML_CUDA_NEMO_ROUTED_Q8_STATS");
+                    return value != nullptr && std::atoi(value) != 0;
+                }();
+                static std::atomic<uint64_t> n_folded{0};
+                const uint64_t count = n_folded.fetch_add(1, std::memory_order_relaxed) + 1;
+                if (print_stats && (count <= 23 || count % 23 == 0)) {
+                    GGML_LOG_INFO("%s: Nemotron routed q8 activation fold fire=%" PRIu64 "\n", __func__, count);
+                }
+            }
             ggml_cuda_op_relu_sqr_pair_quant(*cuda_ctx,
-                shared_relu, shared_sqr, routed_relu, routed_sqr, q8_1_dst, ne10_padded);
+                shared_relu, shared_sqr, routed_relu, routed_sqr,
+                shared_q8_dst, ne10_padded, routed_q8_dst, routed_ne10_padded);
             return 3;
         }
     }
@@ -5824,6 +5976,14 @@ static void ggml_cuda_graph_evaluate_and_capture(ggml_backend_cuda_context * cud
                 const char * value = std::getenv("GGML_CUDA_MAMBA_CONV_STATE_CONCAT_STATS");
                 return value != nullptr && std::atoi(value) != 0;
             }();
+            static const bool disable_mamba_conv_concat = [] {
+                const char * value = std::getenv("GGML_CUDA_DISABLE_MAMBA_CONV_CONCAT_FUSION");
+                return value != nullptr && std::atoi(value) != 0;
+            }();
+            static const bool print_mamba_conv_concat = [] {
+                const char * value = std::getenv("GGML_CUDA_MAMBA_CONV_CONCAT_STATS");
+                return value != nullptr && std::atoi(value) != 0;
+            }();
 
             for (int i = 0; i < cgraph->n_nodes; i++) {
                 ggml_tensor * node = cgraph->nodes[i];
@@ -5878,6 +6038,35 @@ static void ggml_cuda_graph_evaluate_and_capture(ggml_backend_cuda_context * cud
                     continue;
                 }
 
+                // Merge the remaining CONCAT launch into the already-fused
+                // decode-shaped SSM_CONV+bias+SiLU launch.  The kernel still
+                // materializes all four CONCAT words bit-for-bit, writes the
+                // recurrent state, and uses the stock four-tap F32 reduction.
+                if (!disable_mamba_conv_concat && !disable_mamba_conv_state_concat && node->op == GGML_OP_CONCAT) {
+                    ggml_cuda_mamba_conv_state_concat_plan plan;
+                    if (ggml_cuda_mamba_conv_state_concat_detect(
+                            cuda_ctx, cgraph, i, plan, print_mamba_conv_concat) &&
+                            ggml_cuda_mamba_conv_concat_safe(cuda_ctx, plan, print_mamba_conv_concat)) {
+                        ggml_cuda_op_ssm_conv_fused_mamba_concat_state(
+                            *cuda_ctx, node, plan.conv, plan.add, plan.silu, plan.cache);
+                        cuda_ctx->quantized_src1_cache.invalidate_views_of(plan.cpy);
+                        mamba_conv_state_concat_done.insert(plan.conv);
+                        mamba_conv_state_concat_done.insert(plan.add);
+                        mamba_conv_state_concat_done.insert(plan.silu);
+                        mamba_conv_state_concat_done.insert(plan.cpy);
+
+                        static std::atomic<uint64_t> n_fused{0};
+                        const uint64_t count = n_fused.fetch_add(1, std::memory_order_relaxed) + 1;
+                        if (print_mamba_conv_concat && (count <= 23 || count % 23 == 0)) {
+                            GGML_LOG_INFO("%s: Mamba2 CONCAT+state+conv+bias+SiLU fire=%" PRIu64
+                                          ", channels=%" PRId64 ", order=%d/%d/%d/%d/%d, node=%s\n",
+                                          __func__, count, node->ne[1], i, plan.conv_index, plan.add_index,
+                                          plan.silu_index, plan.cpy_index, node->name);
+                        }
+                        continue;
+                    }
+                }
