index fa77245cb..aece1b622 100644
--- a/ggml/src/ggml-cuda/ggml-cuda.cu
+++ b/ggml/src/ggml-cuda/ggml-cuda.cu
@@ -4020,6 +4020,9 @@ static bool ggml_cuda_byte_ranges_disjoint(
 // The fused CONCAT remains a pure bit copy and the existing SSM_CONV kernel is
 // left completely untouched, including its F32 materialization and reduction.
 struct ggml_cuda_mamba_conv_state_concat_plan {
+    ggml_tensor * conv  = nullptr;
+    ggml_tensor * add   = nullptr;
+    ggml_tensor * silu  = nullptr;
     ggml_tensor * cpy   = nullptr;
     ggml_tensor * cache = nullptr;
     int conv_index = -1;
@@ -4206,6 +4209,9 @@ static bool ggml_cuda_mamba_conv_state_concat_detect(
         }
     }
 
+    plan.conv  = conv;
+    plan.add   = add;
+    plan.silu  = silu;
     plan.cpy   = cpy;
     plan.cache = cache;
     plan.conv_index = conv_idx;
@@ -4215,6 +4221,122 @@ static bool ggml_cuda_mamba_conv_state_concat_detect(
     return true;
 }
 
+// Additional requirements used only by the full CONCAT+conv fusion.  Keeping
+// these separate leaves GGML_CUDA_DISABLE_MAMBA_CONV_CONCAT_FUSION as a true
+// same-binary control for the already-verified CONCAT+state path above.
+static bool ggml_cuda_mamba_conv_concat_safe(
+        ggml_backend_cuda_context * ctx, const ggml_cuda_mamba_conv_state_concat_plan & plan,
+        const bool diagnostics) {
+    const ggml_tensor * concat = plan.conv->src[0];
+    const ggml_tensor * state  = concat->src[0];
+    const ggml_tensor * x      = concat->src[1];
+    const ggml_tensor * w      = plan.conv->src[1];
+    const ggml_tensor * bias   = plan.add->src[0] == plan.conv ? plan.add->src[1] : plan.add->src[0];
+    constexpr int64_t n_channels = 6144;
+
+    const auto reject = [&](const char * reason) {
+        static std::atomic<uint64_t> n_rejected{0};
+        const uint64_t count = n_rejected.fetch_add(1, std::memory_order_relaxed) + 1;
+        if (diagnostics && (count <= 23 || count % 23 == 0)) {
+            GGML_LOG_INFO("%s: Mamba2 CONCAT+conv reject=%s count=%" PRIu64
+                          ", state_nb=%zu/%zu x_nb=%zu/%zu concat_nb=%zu/%zu"
+                          " weight_nb=%zu/%zu bias_nb=%zu/%zu out_nb=%zu/%zu"
+                          " cache_nb=%zu/%zu node=%s\n",
+                          __func__, reason, count,
+                          state->nb[0], state->nb[1], x->nb[0], x->nb[1],
+                          concat->nb[0], concat->nb[1], w->nb[0], w->nb[1],
+                          bias->nb[0], bias->nb[1], plan.silu->nb[0], plan.silu->nb[1],
+                          plan.cache->nb[0], plan.cache->nb[1], concat->name);
+        }
+        return false;
+    };
+
+    if (state->type != GGML_TYPE_F32 || x->type != GGML_TYPE_F32 ||
+            concat->type != GGML_TYPE_F32 || w->type != GGML_TYPE_F32 ||
+            bias->type != GGML_TYPE_F32 || plan.silu->type != GGML_TYPE_F32 ||
+            plan.cache->type != GGML_TYPE_F32) {
+        return reject("tensor-type");
+    }
+    if (state->ne[0] != 3 || state->ne[1] != n_channels || state->ne[2] != 1 || state->ne[3] != 1 ||
+            x->ne[0] != 1 || x->ne[1] != n_channels || x->ne[2] != 1 || x->ne[3] != 1 ||
+            concat->ne[0] != 4 || concat->ne[1] != n_channels || concat->ne[2] != 1 || concat->ne[3] != 1 ||
+            w->ne[0] != 4 || w->ne[1] != n_channels || w->ne[2] != 1 || w->ne[3] != 1 ||
+            plan.silu->ne[0] != n_channels || plan.silu->ne[1] != 1 ||
+            plan.silu->ne[2] != 1 || plan.silu->ne[3] != 1 ||
+            ggml_nelements(bias) != n_channels || ggml_nelements(plan.cache) != 3*n_channels) {
+        return reject("tensor-shape");
+    }
+    if (state->nb[0] != sizeof(float) || state->nb[1] != 3*sizeof(float) || !ggml_is_contiguous(state)) {
+        return reject("state-stride");
+    }
+    // x->ne[0] is one, so nb[0] is semantically unused.  The verified stock
+    // CONCAT path addresses channels by nb[1], and the fused kernel does too.
+    if (x->nb[1] != sizeof(float) || ((uintptr_t) x->data % alignof(float)) != 0) {
+        return reject("x-channel-stride");
+    }
+    if (concat->nb[0] != sizeof(float) || concat->nb[1] != 4*sizeof(float) || !ggml_is_contiguous(concat)) {
+        return reject("concat-stride");
+    }
+    if (w->nb[0] != sizeof(float) || w->nb[1] != 4*sizeof(float) || !ggml_is_contiguous(w)) {
+        return reject("weight-stride");
+    }
+    if (bias->nb[0] != sizeof(float) || !ggml_is_contiguous(bias)) {
+        return reject("bias-stride");
+    }
+    // Honor a strided channel destination explicitly; require only aligned,
+    // non-overlapping F32 elements and an address span representable in size_t.
+    if (plan.silu->nb[0] < sizeof(float) || plan.silu->nb[0] % alignof(float) != 0 ||
+            ((uintptr_t) plan.silu->data % alignof(float)) != 0 ||
+            plan.silu->nb[0] > (SIZE_MAX - sizeof(float)) / (n_channels - 1)) {
+        return reject("output-channel-stride");
+    }
+    if (plan.cache->data != state->data || plan.cache->nb[0] != sizeof(float) ||
+            !ggml_is_contiguous(plan.cache)) {
+        return reject("cache-stride-or-alias");
+    }
+
+    const size_t state_bytes  = 3*n_channels*sizeof(float);
+    const size_t x_bytes      = n_channels*sizeof(float);
+    const size_t concat_bytes = 4*n_channels*sizeof(float);
+    const size_t weight_bytes = 4*n_channels*sizeof(float);
+    const size_t vector_bytes = n_channels*sizeof(float);
+    const size_t output_span  = (n_channels - 1)*plan.silu->nb[0] + sizeof(float);
+    if (!ggml_cuda_byte_ranges_disjoint(plan.silu->data, output_span, concat->data, concat_bytes) ||
+            !ggml_cuda_byte_ranges_disjoint(plan.silu->data, output_span, state->data, state_bytes) ||
+            !ggml_cuda_byte_ranges_disjoint(plan.silu->data, output_span, x->data, x_bytes) ||
+            !ggml_cuda_byte_ranges_disjoint(plan.silu->data, output_span, w->data, weight_bytes) ||
+            !ggml_cuda_byte_ranges_disjoint(plan.silu->data, output_span, bias->data, vector_bytes) ||
+            !ggml_cuda_byte_ranges_disjoint(concat->data, concat_bytes, w->data, weight_bytes) ||
+            !ggml_cuda_byte_ranges_disjoint(concat->data, concat_bytes, bias->data, vector_bytes) ||
+            !ggml_cuda_byte_ranges_disjoint(state->data, state_bytes, w->data, weight_bytes) ||
+            !ggml_cuda_byte_ranges_disjoint(state->data, state_bytes, bias->data, vector_bytes) ||
+            !ggml_cuda_byte_ranges_disjoint(x->data, x_bytes, w->data, weight_bytes) ||
+            !ggml_cuda_byte_ranges_disjoint(x->data, x_bytes, bias->data, vector_bytes)) {
+        return reject("allocation-alias");
+    }
+
+    for (const auto & [fork_node, event] : ctx->stream_context().concurrent_events) {
+        const ggml_tensor * moved[] = { concat, plan.conv, plan.add, plan.silu, plan.cpy };
+        const auto concat_it = event.stream_mapping.find(concat);
+        const bool concat_mapped = concat_it != event.stream_mapping.end();
+        const int concat_stream = concat_mapped ? concat_it->second : -1;
+        for (const ggml_tensor * moved_node : moved) {
+            if (fork_node == moved_node || event.join_node == moved_node) {
+                return reject("fork-or-join-boundary");
+            }
+            const auto moved_it = event.stream_mapping.find(moved_node);
+            const bool moved_mapped = moved_it != event.stream_mapping.end();
+            if (moved_mapped != concat_mapped) {
+                return reject("cross-stream-membership");
+            }
+            if (moved_mapped && moved_it->second != concat_stream) {
+                return reject("cross-stream-number");
+            }
+        }
+    }
+    return true;
+}
