From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Claude Code (Opus 5) <noreply@anthropic.com>
Date: Fri, 14 Aug 2026 03:30:00 -0600
Subject: [PATCH 26/26] cuda: give the q8_1 reuse cache a pool it can free in LIFO order

Patch 0004's cache holds pool suballocations across many graph nodes and
releases them from the middle of the vector: the oldest entry on capacity
eviction, and arbitrary matches on view invalidation. ggml_cuda_pool_vmm,
which CUDA selects whenever VMM is available and GB10 does, asserts that
every free is the top of its suballocation stack:

  GGML_ASSERT(ptr == (void *) ((char *)(pool_addr) + pool_used)) failed
  ggml_cuda_pool_vmm::free -> ggml_cuda_quantized_src1_cache::insert

The HIP build never reached this because it does not take the VMM pool, and
the leg pool tolerates out-of-order frees. The full series aborts on the
first decode step on CUDA without this patch.

Two changes, both structural rather than tuning. Give the cache its own pool
so it never interleaves with dispatch scratch, and make every removal path
release back to front: capacity eviction drops the whole cache, and view
invalidation drops the oldest affected entry together with everything
allocated after it. Dropping a still-valid suffix only costs a re-quantize.
---
diff --git a/ggml/src/ggml-cuda/common.cuh b/ggml/src/ggml-cuda/common.cuh
index 407399b1..2be5e0cf 100644
--- a/ggml/src/ggml-cuda/common.cuh
+++ b/ggml/src/ggml-cuda/common.cuh
@@ -1262,8 +1262,14 @@ struct ggml_cuda_quantized_src1_cache {
 
     std::vector<std::unique_ptr<ggml_cuda_quantized_src1_entry>> entries;
 
+    // Buffers come from a dedicated pool (ggml_backend_cuda_context::q8_1_pool).
+    // ggml_cuda_pool_vmm, which CUDA uses whenever VMM is available, asserts
+    // that every free is the top of its suballocation stack, so every removal
+    // path here has to release in reverse allocation order.
     void clear() {
-        entries.clear();
+        while (!entries.empty()) {
+            entries.pop_back();
+        }
     }
 
     // Drop entries whose source contents may be modified by `node`, an op that
@@ -1275,9 +1281,18 @@ struct ggml_cuda_quantized_src1_cache {
         }
         // view_src always points at the root of the chain, flatten defensively anyway:
         const ggml_tensor * origin = node->view_src->view_src != nullptr ? node->view_src->view_src : node->view_src;
-        entries.erase(std::remove_if(entries.begin(), entries.end(),
-            [origin](const std::unique_ptr<ggml_cuda_quantized_src1_entry> & e) { return e->origin == origin; }),
-            entries.end());
+        // Drop the oldest invalidated entry and everything allocated after it.
+        // Erasing only the matches would free below live suballocations.
+        size_t first = entries.size();
+        for (size_t i = 0; i < entries.size(); ++i) {
+            if (entries[i]->origin == origin) {
+                first = i;
+                break;
+            }
+        }
+        while (entries.size() > first) {
+            entries.pop_back();
+        }
     }
 
     const char * find(const ggml_tensor * src1, cudaStream_t stream,
@@ -1298,7 +1313,7 @@ struct ggml_cuda_quantized_src1_cache {
             const int64_t ne00, const int64_t s01, const int64_t s02, const int64_t s03,
             const int64_t ne0, const int64_t ne1, const int64_t ne2, const int64_t ne3, const size_t size) {
         if (entries.size() >= max_entries) {
-            entries.erase(entries.begin());
+            clear();
         }
         auto e = std::make_unique<ggml_cuda_quantized_src1_entry>(pool, size);
         e->origin = src1->view_src != nullptr ? src1->view_src : src1;
@@ -1633,6 +1648,20 @@ struct ggml_backend_cuda_context {
     ggml_cuda_pool & pool() {
         return pool(device);
     }
+
+    // Dedicated pool for the q8_1 reuse cache.  Cache buffers outlive the
+    // dispatch that allocates them, so mixing them into the general pool
+    // interleaves long-lived and scratch suballocations and breaks the LIFO
+    // discipline ggml_cuda_pool_vmm enforces.  A separate pool holds nothing
+    // but cache entries, so releasing them back-to-front is always legal.
+    std::unique_ptr<ggml_cuda_pool> q8_1_pools[GGML_CUDA_MAX_DEVICES][GGML_CUDA_MAX_STREAMS];
+
+    ggml_cuda_pool & q8_1_pool() {
+        if (q8_1_pools[device][curr_stream_no] == nullptr) {
+            q8_1_pools[device][curr_stream_no] = new_pool_for_device(device, curr_stream_no);
+        }
+        return *q8_1_pools[device][curr_stream_no];
+    }
 };
 
