From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Claude Code (Opus 5) <noreply@anthropic.com>
Date: Fri, 14 Aug 2026 03:30:00 -0600
Subject: [PATCH 18/27] cuda: materialize the routed-up inputs before the shared-up pin

Ported from the Nemotron R9700 HIP series to the GB10 CUDA track. Both tracks
pin llama.cpp 0b1bad14ff20 and llama.cpp's HIP backend is the CUDA backend
source-translated, so the diff applies to ggml/src/ggml-cuda unchanged.
---
diff --git a/ggml/src/ggml-cuda/ggml-cuda.cu b/ggml/src/ggml-cuda/ggml-cuda.cu
index e3cc3aa6f..0a260a05c 100644
--- a/ggml/src/ggml-cuda/ggml-cuda.cu
+++ b/ggml/src/ggml-cuda/ggml-cuda.cu
@@ -78,6 +78,7 @@
 #include <cstddef>
 #include <cstdint>
 #include <cfloat>
+#include <cstring>
 #include <initializer_list>
 #include <limits>
 #include <map>
@@ -4216,13 +4217,18 @@ static int ggml_cuda_try_fuse(ggml_backend_cuda_context * cuda_ctx, ggml_cgraph
         const char * value = std::getenv("GGML_CUDA_NEMO_SHEXP_UP_COLAUNCH");
         return value == nullptr || std::atoi(value) != 0;
     }();
+    const auto nemo_name_prefix = [](const ggml_tensor * t, const char * prefix) {
+        return t != nullptr && std::strncmp(t->name, prefix, std::strlen(prefix)) == 0;
+    };
+    const bool is_shared_up = nemo_name_prefix(node, "ffn_up-");
     static const bool nemo_shexp_up_diag = [] {
         const char * value = std::getenv("GGML_CUDA_NEMO_SHEXP_UP_DIAG");
         return value != nullptr && std::atoi(value) != 0;
     }();
     // Report graph-order misses too; the full matcher below cannot diagnose a
     // routed node that was separated by an unexpanded dependency.
-    if (nemo_shexp_up_colaunch && nemo_shexp_up_diag && node->op == GGML_OP_MUL_MAT &&
+    if (nemo_shexp_up_colaunch && nemo_shexp_up_diag && is_shared_up &&
+            node->op == GGML_OP_MUL_MAT &&
             node->src[0] != nullptr && node->src[0]->type == GGML_TYPE_Q5_0 &&
             node->src[0]->ne[0] == 2688 && node->src[0]->ne[1] == 3712 &&
             node->ne[0] == 3712 && node->ne[1] == 1 &&
@@ -4235,8 +4241,9 @@ static int ggml_cuda_try_fuse(ggml_backend_cuda_context * cuda_ctx, ggml_cgraph
                           i + 1 < cgraph->n_nodes ? cgraph->nodes[i + 1]->name : "<end>");
         }
     }
-    if (nemo_shexp_up_colaunch && i + 1 < cgraph->n_nodes &&
-            node->op == GGML_OP_MUL_MAT && cgraph->nodes[i + 1]->op == GGML_OP_MUL_MAT_ID) {
+    if (nemo_shexp_up_colaunch && is_shared_up && i + 1 < cgraph->n_nodes &&
+            node->op == GGML_OP_MUL_MAT && cgraph->nodes[i + 1]->op == GGML_OP_MUL_MAT_ID &&
+            nemo_name_prefix(cgraph->nodes[i + 1], "ffn_moe_up-")) {
         ggml_tensor * shared = node;
         ggml_tensor * routed = cgraph->nodes[i + 1];
         const ggml_tensor * sw = shared->src[0];
diff --git a/src/llama-graph.cpp b/src/llama-graph.cpp
index 47f0dabee..55ff73842 100644
--- a/src/llama-graph.cpp
+++ b/src/llama-graph.cpp
@@ -2151,12 +2151,14 @@ ggml_tensor * llm_graph_context::build_moe_ffn(
     // routed-up.  Both consume the same activation, so this dependency-neutral
     // order lets the backend concatenate their MMVQ grids.
     if (pin_pre_up != nullptr) {
-        // MUL_MAT_ID recursively owns the selected-expert/top-k branch. Emit
-        // that dependency first; otherwise it lands between shared-up and
-        // routed-up and defeats the adjacent backend matcher.
+        // MUL_MAT_ID recursively owns both the selected-expert branch and the
+        // reshape of its activation to [n_embd, 1, n_tokens]. Emit those
+        // dependencies first; otherwise that metadata node lands between the
+        // shared and routed projections and defeats the adjacent matcher.
         ggml_build_forward_expand(gf, selected_experts);
+        ggml_build_forward_expand(gf, up->src[1]);
         ggml_build_forward_expand(gf, pin_pre_up);
-        ggml_build_forward_expand(gf, cur);
+        ggml_build_forward_expand(gf, up);
     }
 
     // The already-independent shared-expert activation follows routed-up.
-- 
