-        const uint32_t ids_stride) {
+        const uint32_t ids_stride, const mmvq_nemo_down_guest_args nemo_guest = mmvq_nemo_down_guest_args()) {
     const void    * GGML_CUDA_RESTRICT vx  = vx_ptr;
     const void    * GGML_CUDA_RESTRICT vy  = vy_ptr;
     const int32_t * GGML_CUDA_RESTRICT ids = ids_ptr;
@@ -507,8 +526,65 @@ static __global__ void mul_mat_vec_q(
     // assignment and the stock reduction order.
     const uint32_t nwarps_launched = blockDim.y;
 
+    // Routed-down guest blocks occupy the FRONT of a flattened grid.  A Q5_0
+    // routed row launches four of the compile-time eight warps, so an eight-warp
+    // host block carries two guest rows; Q8_0 uses all eight and carries one.
+    // Each row retains the standalone thread->K-block map and reduction order.
+    if constexpr (has_nemo_down_guest && nemo_guest_warps >= 1 &&
+                  nemo_guest_warps <= nwarps && nwarps % nemo_guest_warps == 0) {
+        if (blockIdx.x < nemo_guest.nblocks) {
+            constexpr int rows_per_guest_block = nwarps / nemo_guest_warps;
+            const uint32_t channel = blockIdx.x / nemo_guest.nblocks_per_channel;
+            const uint32_t row_block = blockIdx.x - channel * nemo_guest.nblocks_per_channel;
+            const int wr = threadIdx.y / nemo_guest_warps;
+            const int wl = threadIdx.y - wr * nemo_guest_warps;
+            const int grow = rows_per_guest_block * row_block + wr;
+            const int ltid = warp_size * wl + threadIdx.x;
+            const int blocks_per_row_g = nemo_guest.ncols_x / qk;
+            // Each packed row must retain the standalone guest kernel's K
+            // stride.  In particular Q5_0 packs two four-warp rows into the
+            // host's eight-warp block; using nwarps here would skip every
+            // other four-warp band of the routed matrix.
+            constexpr int blocks_per_iter_g = vdr * nemo_guest_warps * warp_size / qi;
+
+            ggml_cuda_pdl_sync();
+            const uint32_t expert = nemo_guest.ids[channel];
+            const block_q8_1 * gy = (const block_q8_1 *) nemo_guest.vy + channel * nemo_guest.stride_channel_y;
+            const int g_offset = expert * nemo_guest.stride_channel_x + grow * nemo_guest.stride_row_x;
+            float gtmp = 0.0f;
+            for (int kbx = ltid / (qi/vdr); kbx < blocks_per_row_g; kbx += blocks_per_iter_g) {
+                const int kby = kbx * (qk/QK8_1);
+                const int kqs = vdr * (ltid % (qi/vdr));
+                gtmp += vec_dot_q_cuda(nemo_guest.vx, &gy[kby], g_offset + kbx, kqs);
+            }
+
+            __shared__ float guest_shared[rows_per_guest_block]
+                                               [nemo_guest_warps > 1 ? nemo_guest_warps - 1 : 1]
+                                               [warp_size];
+            if constexpr (nemo_guest_warps > 1) {
+                if (wl > 0) {
+                    guest_shared[wr][wl - 1][threadIdx.x] = gtmp;
+                }
+                __syncthreads();
+                if (wl > 0) {
+                    return;
+                }
+            }
+#pragma unroll
+            for (int l = 0; l < nemo_guest_warps - 1; ++l) {
+                gtmp += guest_shared[wr][l][threadIdx.x];
+            }
+            gtmp = warp_reduce_sum<warp_size>(gtmp);
+            if (threadIdx.x == 0 && grow < (int) nemo_guest.nrows) {
+                nemo_guest.dst[channel * nemo_guest.stride_channel_dst + grow] = gtmp;
+            }
+            return;
+        }
+    }
