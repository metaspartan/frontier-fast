+static __global__ void relu_sqr_pair_quant_kernel(
+        const float * shared_x, float * shared_dst, const int64_t shared_n,
+        const int64_t shared_padded, block_q8_1 * shared_q8,
+        const float * routed_x, float * routed_dst, const int64_t routed_n,
+        const int shared_blocks) {
+    ggml_cuda_pdl_lc();
+
+    const int64_t local = (int64_t) blockDim.x *
+        (blockIdx.x < (uint32_t) shared_blocks ? blockIdx.x : blockIdx.x - shared_blocks) + threadIdx.x;
+
+    if (blockIdx.x < (uint32_t) shared_blocks) {
+        // shared_padded is a multiple of the block size, so every launched
+        // lane belongs to a complete q8_1 group.  Padding is quantized as +0,
+        // exactly as quantize_q8_1 does for i0 >= ne00.
+        if (local >= shared_padded) {
+            return;
+        }
+        ggml_cuda_pdl_sync();
+        const float val = local < shared_n ? op_relu_sqr(shared_x[local]) : 0.0f;
+        if (local < shared_n) {
+            shared_dst[local] = val;
