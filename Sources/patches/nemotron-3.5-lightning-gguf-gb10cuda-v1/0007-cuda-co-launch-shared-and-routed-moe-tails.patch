From: Claude Code (Opus 5) <noreply@anthropic.com>
Date: Fri, 14 Aug 2026 03:30:00 -0600
Subject: [PATCH 07/27] cuda: co-launch the Nemotron shared and routed MoE tails

Ported from the Nemotron R9700 HIP series to the GB10 CUDA track. Both tracks
pin llama.cpp 0b1bad14ff20 and llama.cpp's HIP backend is the CUDA backend
source-translated, so the diff applies to ggml/src/ggml-cuda unchanged.

The shared expert and the routed experts consume the same activation and the
same weight quantization. Relay the graph so the two chains are adjacent and
evaluate both in one dispatch, each side keeping its own row/K mapping, and
write the shared activation's q8_1 cache bytes in the same pass.

GB10 leave-one-out on the graph relay (GGML_NEMO_SHEXP_PIN=0, which also
disables patch 0016's up co-launch): 1.25% of decode. The activation
co-launch alone (GGML_CUDA_NEMO_SHEXP_ACT_COLAUNCH=0) is 0.47%, the down
co-launch alone (GGML_CUDA_NEMO_SHEXP_DOWN_COLAUNCH=0) is 0.57%.
---
diff --git a/ggml/src/ggml-cuda/ggml-cuda.cu b/ggml/src/ggml-cuda/ggml-cuda.cu
index d91df9f16..f3b8b004b 100644
--- a/ggml/src/ggml-cuda/ggml-cuda.cu
+++ b/ggml/src/ggml-cuda/ggml-cuda.cu
@@ -3425,6 +3425,110 @@ static int ggml_cuda_try_fuse(ggml_backend_cuda_context * cuda_ctx, ggml_cgraph
         }
     }
 
+    // Nemotron decode: the graph relay in nemotron-h.cpp places the independent
+    // shared and routed ReLU^2 chains next to one another. Evaluate both in a
+    // single dispatch and write the shared activation's q8_1 cache bytes in the
+    // same pass. Setting either toggle to 0 gives a same-binary stock path.
+    static const bool nemo_shexp_act_colaunch = [] {
+        const char * value = std::getenv("GGML_CUDA_NEMO_SHEXP_ACT_COLAUNCH");
+        return value == nullptr || std::atoi(value) != 0;
+    }();
+    static const bool q8_1_cache_disabled = std::getenv("GGML_CUDA_MMVQ_NO_Q8_1_CACHE") != nullptr;
+    if (nemo_shexp_act_colaunch && !q8_1_cache_disabled && i + 3 < cgraph->n_nodes &&
+            node->op == GGML_OP_UNARY && ggml_get_unary_op(node) == GGML_UNARY_OP_RELU) {
+        ggml_tensor * shared_relu = node;
+        ggml_tensor * shared_sqr  = cgraph->nodes[i + 1];
+        ggml_tensor * routed_relu = cgraph->nodes[i + 2];
+        ggml_tensor * routed_sqr  = cgraph->nodes[i + 3];
+        const ggml_op ops[] = { GGML_OP_UNARY, GGML_OP_SQR, GGML_OP_UNARY, GGML_OP_SQR };
+        const int out_nodes[] = { i + 1, i + 3 };
+
+        const bool chain_ok = shared_sqr->src[0] == shared_relu &&
+            routed_relu->op == GGML_OP_UNARY && ggml_get_unary_op(routed_relu) == GGML_UNARY_OP_RELU &&
+            routed_sqr->src[0] == routed_relu &&
+            shared_relu->src[0] != routed_relu->src[0];
+        const bool shape_ok = shared_relu->src[0]->type == GGML_TYPE_F32 && shared_sqr->type == GGML_TYPE_F32 &&
+            routed_relu->src[0]->type == GGML_TYPE_F32 && routed_sqr->type == GGML_TYPE_F32 &&
+            shared_sqr->ne[0] == 3712 && shared_sqr->ne[1] == 1 && shared_sqr->ne[2] == 1 && shared_sqr->ne[3] == 1 &&
+            routed_sqr->ne[0] == 1856 && routed_sqr->ne[1] == 6 && routed_sqr->ne[2] == 1 && routed_sqr->ne[3] == 1 &&
+            ggml_is_contiguous(shared_relu->src[0]) && ggml_is_contiguous(shared_sqr) &&
+            ggml_is_contiguous(routed_relu->src[0]) && ggml_is_contiguous(routed_sqr);
+
+        if (chain_ok && shape_ok &&
+                ggml_can_fuse_subgraph(cgraph, i, 4, ops, out_nodes, 2) &&
+                ggml_cuda_check_fusion_memory_ranges(cgraph, i, 4, out_nodes, 2)) {
+            cudaStream_t stream = cuda_ctx->stream();
+            const int64_t ne10 = shared_sqr->ne[0];
+            const int64_t ne10_padded = GGML_PAD(ne10, MATRIX_ROW_PADDING);
+            const int64_t s11 = shared_sqr->nb[1] / ggml_type_size(shared_sqr->type);
+            const int64_t s12 = shared_sqr->nb[2] / ggml_type_size(shared_sqr->type);
+            const int64_t s13 = shared_sqr->nb[3] / ggml_type_size(shared_sqr->type);
+            const size_t size_q8_1 = ne10_padded * sizeof(block_q8_1) / QK8_1;
+            char * q8_1_dst = cuda_ctx->quantized_src1_cache.insert(
+                cuda_ctx->pool(), shared_sqr, stream,
+                ne10, s11, s12, s13, ne10_padded, 1, 1, 1, size_q8_1);
+            ggml_cuda_op_relu_sqr_pair_quant(*cuda_ctx,
+                shared_relu, shared_sqr, routed_relu, routed_sqr, q8_1_dst, ne10_padded);
+            return 3;
+        }
+    }
+
+    // The same graph relay puts the plain shared-down MUL_MAT directly before
+    // the routed-down MUL_MAT_ID. Both have output width 2688 and the same
+    // per-layer quant type, so their channel grids concatenate while each side
+    // retains its own K, activation, ids and destination.
+    static const bool nemo_shexp_down_colaunch = [] {
+        const char * value = std::getenv("GGML_CUDA_NEMO_SHEXP_DOWN_COLAUNCH");
+        return value == nullptr || std::atoi(value) != 0;
+    }();
+    if (nemo_shexp_down_colaunch && i + 1 < cgraph->n_nodes &&
+            node->op == GGML_OP_MUL_MAT && cgraph->nodes[i + 1]->op == GGML_OP_MUL_MAT_ID) {
+        ggml_tensor * shared = node;
+        ggml_tensor * routed = cgraph->nodes[i + 1];
+        const ggml_tensor * sw = shared->src[0];
+        const ggml_tensor * rw = routed->src[0];
+        const ggml_op ops[] = { GGML_OP_MUL_MAT, GGML_OP_MUL_MAT_ID };
+        const int out_nodes[] = { i, i + 1 };
+
+        const bool shape_ok = sw != nullptr && rw != nullptr && routed->src[2] != nullptr &&
+            sw->type == rw->type && (sw->type == GGML_TYPE_Q5_0 || sw->type == GGML_TYPE_Q8_0) &&
+            sw->ne[0] == 3712 && sw->ne[1] == 2688 && sw->ne[2] == 1 && sw->ne[3] == 1 &&
+            shared->src[1]->ne[0] == 3712 && shared->src[1]->ne[1] == 1 &&
+            shared->ne[0] == 2688 && shared->ne[1] == 1 && shared->ne[2] == 1 && shared->ne[3] == 1 &&
+            rw->ne[0] == 1856 && rw->ne[1] == 2688 && rw->ne[2] == 128 && rw->ne[3] == 1 &&
+            routed->src[1]->ne[0] == 1856 && routed->src[1]->ne[1] == 6 &&
+            routed->ne[0] == 2688 && routed->ne[1] == 6 && routed->ne[2] == 1 && routed->ne[3] == 1 &&
+            routed->src[2]->type == GGML_TYPE_I32 && routed->src[2]->ne[0] == 6;
+
+        const auto disjoint = [](const ggml_tensor * a, const ggml_tensor * b) {
+            const uintptr_t a0 = (uintptr_t) a->data;
+            const uintptr_t b0 = (uintptr_t) b->data;
+            const uintptr_t a1 = a0 + ggml_backend_buft_get_alloc_size(a->buffer->buft, a);
+            const uintptr_t b1 = b0 + ggml_backend_buft_get_alloc_size(b->buffer->buft, b);
+            return a1 <= b0 || b1 <= a0;
+        };
+
+        if (shape_ok && ggml_cuda_should_fuse_mul_mat_vec_q(shared) &&
+                ggml_cuda_should_fuse_mul_mat_vec_q(routed) && disjoint(shared, routed) &&
+                ggml_can_fuse_subgraph(cgraph, i, 2, ops, out_nodes, 2) &&
+                ggml_cuda_check_fusion_memory_ranges(cgraph, i, 2, out_nodes, 2)) {
+            mmvq_nemo_routed_down_guest guest;
+            guest.src0 = routed->src[0];
+            guest.src1 = routed->src[1];
+            guest.ids  = routed->src[2];
+            guest.dst  = routed;
+            bool guest_launched = false;
+            ggml_cuda_mul_mat_vec_q(*cuda_ctx, shared->src[0], shared->src[1], nullptr, shared,
+                                    nullptr, &guest, &guest_launched);
+            if (!guest_launched) {
+                // Geometry or a debug cache mode declined the merged grid. The
+                // host has already run, so execute only the routed fallback.
+                ggml_cuda_mul_mat_vec_q(*cuda_ctx, routed->src[0], routed->src[1], routed->src[2], routed);
+            }
+            return 1;
+        }
+    }
+
     // gated_delta_net -> cpy: scatter recurrent-state snapshots into the cache
     if (node->op == GGML_OP_GATED_DELTA_NET) {
         ggml_cuda_gated_delta_net_fused_cache fused_state_cpy;
