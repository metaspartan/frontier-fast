+        ggml_tensor * mul_tensor, char * q8_1_dst,
+        const ggml_tensor * swiglu_x_override) {
+    const ggml_tensor * x = swiglu_x_override != nullptr ? swiglu_x_override : glu->src[0];
     const ggml_tensor * g = glu->src[1];
     const ggml_tensor * mul_src = mul_tensor->src[0] == rms_norm ?
         mul_tensor->src[1] : mul_tensor->src[0];
diff --git a/ggml/src/ggml-cuda/norm.cuh b/ggml/src/ggml-cuda/norm.cuh
index f2c1db6f5..de4edb05d 100644
--- a/ggml/src/ggml-cuda/norm.cuh
+++ b/ggml/src/ggml-cuda/norm.cuh
@@ -28,7 +28,8 @@ void ggml_cuda_op_rms_norm_fused_pre_add(ggml_backend_cuda_context & ctx,
 // Exact decode-shaped Nemotron Mamba SwiGLU + grouped RMS norm + scale + q8_1.
 void ggml_cuda_op_nemo_mamba_swiglu_rms_norm_fused_quant(
         ggml_backend_cuda_context & ctx, ggml_tensor * glu, ggml_tensor * rms_norm,
