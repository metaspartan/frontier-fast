+        ggml_cuda_set_device(device);
+        CUDA_CHECK(cudaMalloc((void **) &nemo_router_topk_completion,
+                              GGML_CUDA_MAX_STREAMS * sizeof(uint32_t)));
+        CUDA_CHECK(cudaMemset(nemo_router_topk_completion, 0,
+                             GGML_CUDA_MAX_STREAMS * sizeof(uint32_t)));
     }
 
     ggml_cuda_stream_context concurrent_stream_context;
