--- /dev/null
+++ b/ggml/src/ggml-cuda/nemo-router-topk.cuh
@@ -0,0 +1,131 @@
+#pragma once
+
+#include "ggml-cuda/common.cuh"
+
+#include <cmath>
+
+struct mmvf_nemo_router_topk {
+    const float * bias       = nullptr;
+    float *       weights    = nullptr;
+    int32_t *     ids        = nullptr;
+    uint32_t *    completion = nullptr;
+    float         clamp_val  = -INFINITY;
+    float         scale_val  = 1.0f;
+    bool          with_norm  = false;
+};
+
+// Exact one-row specialization of topk_moe_cuda<128, true> for Nemotron-H.
+// This is mechanically the stock iterative top-6 body.  The router producer
+// stores all 128 F32 logits before the standard last-block fence publishes
+// completion, so the separate-kernel F32 materialization boundary remains.
+static __device__ __forceinline__ void nemo_router_topk_128_sigmoid_bias(
+        const float * logits,
+        const mmvf_nemo_router_topk & guest) {
+    constexpr int n_experts          = 128;
+    constexpr int n_expert_used      = 6;
+    constexpr int experts_per_thread = n_experts / WARP_SIZE;
+
+    float wt[experts_per_thread];
+
+#pragma unroll
+    for (int i = 0; i < experts_per_thread; ++i) {
+        wt[i] = -INFINITY;
+    }
+
+    ggml_cuda_pdl_sync();
+#pragma unroll
+    for (int i = 0; i < n_experts; i += WARP_SIZE) {
+        const int expert = i + threadIdx.x;
+        wt[i / WARP_SIZE] = logits[expert];
+    }
+
+#pragma unroll
+    for (int i = 0; i < experts_per_thread; ++i) {
+        wt[i] = 1.f / (1.f + expf(-wt[i]));
+    }
+
+#pragma unroll
+    for (int i = 0; i < experts_per_thread; ++i) {
+        if (__isnanf(wt[i])) {
+            wt[i] = -FLT_MAX;
+        }
+    }
+
+    float selection_wt[experts_per_thread];
+#pragma unroll
+    for (int i = 0; i < experts_per_thread; ++i) {
+        selection_wt[i] = -INFINITY;
+    }
+#pragma unroll
+    for (int i = 0; i < n_experts; i += WARP_SIZE) {
+        const int expert = i + threadIdx.x;
+        selection_wt[i / WARP_SIZE] = wt[i / WARP_SIZE] + guest.bias[expert];
+    }
+
+    float wt_sum = 0.f;
+    float output_weights[experts_per_thread];
+#pragma unroll
+    for (int i = 0; i < experts_per_thread; ++i) {
+        output_weights[i] = 0.f;
+    }
+
+    ggml_cuda_pdl_lc();
+    for (int k = 0; k < n_expert_used; ++k) {
+        float max_val   = wt[0];
+        float max_val_s = selection_wt[0];
+        int max_expert  = threadIdx.x;
+
+#pragma unroll
+        for (int i = 1; i < experts_per_thread; ++i) {
+            const int expert = threadIdx.x + i * WARP_SIZE;
+            if (selection_wt[i] > max_val_s) {
+                max_val    = wt[i];
+                max_val_s  = selection_wt[i];
+                max_expert = expert;
+            }
+        }
+
+#pragma unroll
+        for (int mask = WARP_SIZE / 2; mask > 0; mask /= 2) {
+            const float val    = __shfl_xor_sync(0xFFFFFFFF, max_val, mask, WARP_SIZE);
+            const float val_s  = __shfl_xor_sync(0xFFFFFFFF, max_val_s, mask, WARP_SIZE);
+            const int   expert = __shfl_xor_sync(0xFFFFFFFF, max_expert, mask, WARP_SIZE);
+            if (val_s > max_val_s || (val_s == max_val_s && expert < max_expert)) {
+                max_val    = val;
+                max_val_s  = val_s;
+                max_expert = expert;
+            }
+        }
+
+        if ((max_expert & (WARP_SIZE - 1)) == (int) threadIdx.x) {
+            selection_wt[max_expert / WARP_SIZE] = -INFINITY;
+        }
+        if ((k & (WARP_SIZE - 1)) == (int) threadIdx.x) {
+            output_weights[k / WARP_SIZE] = max_val;
+        }
+        if ((max_expert & (WARP_SIZE - 1)) == (int) threadIdx.x) {
+            guest.ids[k] = max_expert;
+            if (guest.with_norm) {
+                wt_sum += max_val;
+            }
+        }
+    }
+
+    if (guest.with_norm) {
+        wt_sum = warp_reduce_sum(wt_sum);
+        wt_sum = max(wt_sum, guest.clamp_val);
+        const float inv_sum = 1.0f / wt_sum;
+#pragma unroll
+        for (int i = 0; i < experts_per_thread; ++i) {
+            output_weights[i] *= inv_sum;
+        }
+    }
+
+#pragma unroll
+    for (int i = 0; i < experts_per_thread; ++i) {
+        const int idx = i * WARP_SIZE + threadIdx.x;
+        if (idx < n_expert_used) {
+            guest.weights[idx] = output_weights[i] * guest.scale_val;
+        }
+    }
+}
