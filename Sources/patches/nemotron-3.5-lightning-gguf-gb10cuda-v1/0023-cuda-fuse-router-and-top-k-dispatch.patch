+    // Exact Nemotron decode router: retain the stock 224-thread F32 MMVF
+    // reduction and its global logits materialization, then let the last
+    // producer block execute the mechanically identical stock top-6 warp.
+    // This removes only the dependent top-k dispatch; it does not reorder the
+    // graph or rely on unsynchronized cross-block reads.
+    static const bool nemo_router_topk_enabled = [] {
+        const char * value = std::getenv("GGML_CUDA_NEMO_ROUTER_TOPK_FUSION");
+        const char * disable = std::getenv("GGML_CUDA_DISABLE_NEMO_ROUTER_TOPK_FUSION");
+        return (value == nullptr || std::atoi(value) != 0) &&
+               (disable == nullptr || std::atoi(disable) == 0);
+    }();
+    static const bool print_nemo_router_topk_stats = [] {
+        const char * value = std::getenv("GGML_CUDA_NEMO_ROUTER_TOPK_STATS");
+        return value != nullptr && std::atoi(value) != 0;
+    }();
+    if (nemo_router_topk_enabled && i + 1 < cgraph->n_nodes && node->op == GGML_OP_MUL_MAT &&
+            node->src[0] != nullptr && node->src[1] != nullptr &&
+            node->src[0]->type == GGML_TYPE_F32 && node->src[1]->type == GGML_TYPE_F32 &&
+            node->type == GGML_TYPE_F32 &&
+            node->src[0]->ne[0] == 2688 && node->src[0]->ne[1] == 128 &&
+            node->src[0]->ne[2] == 1 && node->src[0]->ne[3] == 1 &&
+            node->src[1]->ne[0] == 2688 && node->src[1]->ne[1] == 1 &&
+            node->src[1]->ne[2] == 1 && node->src[1]->ne[3] == 1 &&
+            node->ne[0] == 128 && node->ne[1] == 1 && node->ne[2] == 1 && node->ne[3] == 1) {
+        ggml_cuda_nemo_router_topk_info info;
+        if (ggml_cuda_find_nemo_router_topk(cuda_ctx, cgraph, i + 1, node, info)) {
+            const auto disjoint = [](const ggml_tensor * a, const ggml_tensor * b) {
+                const uintptr_t a0 = (uintptr_t) a->data;
+                const uintptr_t b0 = (uintptr_t) b->data;
+                const uintptr_t a1 = a0 + ggml_backend_buft_get_alloc_size(a->buffer->buft, a);
+                const uintptr_t b1 = b0 + ggml_backend_buft_get_alloc_size(b->buffer->buft, b);
+                return a1 <= b0 || b1 <= a0;
+            };
+            const bool alias_ok = disjoint(node, info.weights) && disjoint(node, info.ids) &&
+                disjoint(node->src[0], info.weights) && disjoint(node->src[0], info.ids) &&
+                disjoint(node->src[1], info.weights) && disjoint(node->src[1], info.ids) &&
+                disjoint(info.bias, info.weights) && disjoint(info.bias, info.ids) &&
+                disjoint(info.weights, info.ids);
+            const int cc = ggml_cuda_info().devices[ggml_cuda_get_device()].cc;
+            if (alias_ok && ggml_cuda_should_use_mmvf(
+                    node->src[0]->type, cc, node->src[0]->ne, node->src[0]->nb, node->src[1]->ne[1]) &&
+                    ggml_cuda_mul_mat_vec_f_nemo_router_topk(
+                        *cuda_ctx, node->src[0], node->src[1], node,
+                        info.bias, info.clamp, info.scale, info.weights, info.ids)) {
+                static std::atomic<uint64_t> n_fired{0};
+                const uint64_t count = n_fired.fetch_add(1, std::memory_order_relaxed) + 1;
+                if (print_nemo_router_topk_stats && (count <= 23 || count % 23 == 0)) {
+                    GGML_LOG_INFO("%s: Nemotron exact router+top-k fire=%" PRIu64
+                                  ", index=%d, skipped=%d, router=%s\n",
+                                  __func__, count, i, info.n_ops, node->name);
+                }
+                return info.n_ops;
+            }
+        }
+    }
