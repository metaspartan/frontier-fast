     return true;
 }
 
+static bool ggml_cuda_check_fusion_memory_ranges(
+    const ggml_cgraph * cgraph, int node_idx, int node_count,
+    const int * out_nodes, int out_count, bool is_topk_moe);
+static cudaStream_t ggml_cuda_norm_quant_node_stream(
+    ggml_backend_cuda_context * ctx, const ggml_tensor * node);
+
+struct ggml_cuda_nemo_router_topk_info {
+    ggml_cuda_topk_moe_args args;
+    const ggml_tensor * bias    = nullptr;
+    const ggml_tensor * clamp   = nullptr;
+    const ggml_tensor * scale   = nullptr;
+    ggml_tensor *       weights = nullptr;
+    ggml_tensor *       ids     = nullptr;
+    int n_ops = 0;
+};
+
+// Match only the exact one-token Nemotron sigmoid+bias+top-6 chain following
+// its 2688x128 F32 router.  The generic standalone top-k fusion remains the
+// fallback for all other graphs.
+static bool ggml_cuda_find_nemo_router_topk(
+        ggml_backend_cuda_context * ctx, const ggml_cgraph * cgraph,
+        const int first, const ggml_tensor * router,
+        ggml_cuda_nemo_router_topk_info & out) {
+    if (first >= cgraph->n_nodes || cgraph->nodes[first]->op != GGML_OP_UNARY ||
+            ggml_get_unary_op(cgraph->nodes[first]) != GGML_UNARY_OP_SIGMOID ||
+            cgraph->nodes[first]->src[0] != router ||
+            !ggml_cuda_topk_moe_fusion(cgraph, first, out.args) ||
+            !out.args.sigmoid || !out.args.prob_bias || out.args.softmax ||
+            out.args.sqrt_softplus || out.args.delayed_softmax) {
+        return false;
+    }
+
+    std::vector<ggml_op> ops = { GGML_OP_UNARY };
+    const int i_probs = first;
+    out.bias = cgraph->nodes[i_probs + 2]->src[1];
+    ops.insert(ops.end(), { GGML_OP_RESHAPE, GGML_OP_ADD, GGML_OP_ARGSORT,
+                            GGML_OP_VIEW, GGML_OP_GET_ROWS });
+    int out_nodes[2] = { i_probs + 4, -1 };
+    out.ids = cgraph->nodes[out_nodes[0]];
+
+    if (out.args.norm) {
+        ops.insert(ops.end(), { GGML_OP_RESHAPE, GGML_OP_SUM_ROWS, GGML_OP_CLAMP,
+                                GGML_OP_DIV, GGML_OP_RESHAPE });
+        out.clamp = cgraph->nodes[first + (int) ops.size() - 3];
+    }
+    if (out.args.scale) {
+        ops.push_back(GGML_OP_SCALE);
+        out.scale = cgraph->nodes[first + (int) ops.size() - 1];
+    }
+    out_nodes[1] = first + (int) ops.size() - 1;
+    if (out_nodes[1] >= cgraph->n_nodes) {
+        return false;
+    }
+    out.weights = cgraph->nodes[out_nodes[1]];
+    out.n_ops = (int) ops.size();
+
+    if (!ggml_can_fuse_subgraph(cgraph, first, ops.size(), ops.data(), out_nodes, 2) ||
+            !ggml_cuda_should_use_topk_moe(cgraph->nodes[first], out.weights, router, out.ids)) {
+        return false;
+    }
+
+    const bool exact_shape = out.bias != nullptr &&
+        router->type == GGML_TYPE_F32 && out.bias->type == GGML_TYPE_F32 &&
+        out.weights->type == GGML_TYPE_F32 && out.ids->type == GGML_TYPE_I32 &&
+        router->ne[0] == 128 && router->ne[1] == 1 && router->ne[2] == 1 && router->ne[3] == 1 &&
+        out.bias->ne[0] == 128 && ggml_nelements(out.bias) == 128 && ggml_is_contiguous(out.bias) &&
+        out.weights->ne[0] == 1 && out.weights->ne[1] == 6 &&
+        out.weights->ne[2] == 1 && out.weights->ne[3] == 1 &&
+        out.ids->ne[0] == 6 && out.ids->ne[1] == 1 && out.ids->ne[2] == 1 && out.ids->ne[3] == 1 &&
+        out.ids->nb[0] != 0 && out.ids->nb[1] / out.ids->nb[0] == 128;
+    if (!exact_shape) {
+        return false;
+    }
+
+    // Skipping a node on another stream, or a fork/join boundary, would bypass
+    // scheduler event handling.  Require the entire router/selection group on
+    // the current stream.
+    const cudaStream_t stream = ctx->stream();
+    for (int j = first - 1; j < first + out.n_ops; ++j) {
+        if (ggml_cuda_norm_quant_node_stream(ctx, cgraph->nodes[j]) != stream) {
+            return false;
+        }
+    }
+    for (const auto & [fork_node, event] : ctx->stream_context().concurrent_events) {
+        for (int j = first - 1; j < first + out.n_ops; ++j) {
+            const ggml_tensor * member = cgraph->nodes[j];
+            if (member == fork_node || member == event.join_node) {
+                return false;
+            }
+        }
+    }
+
+    return ggml_cuda_check_fusion_memory_ranges(
+        cgraph, first, out.n_ops, out_nodes, 2, /*is_topk_moe=*/true);
+}
