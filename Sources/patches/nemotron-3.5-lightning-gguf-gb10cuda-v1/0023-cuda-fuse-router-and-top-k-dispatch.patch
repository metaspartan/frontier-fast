+bool ggml_cuda_mul_mat_vec_f_nemo_router_topk(
+        ggml_backend_cuda_context & ctx,
+        const ggml_tensor * src0, const ggml_tensor * src1, ggml_tensor * logits,
+        const ggml_tensor * bias, const ggml_tensor * clamp, const ggml_tensor * scale,
+        ggml_tensor * weights, ggml_tensor * ids) {
+    if (src0 == nullptr || src1 == nullptr || logits == nullptr || bias == nullptr ||
+            weights == nullptr || ids == nullptr ||
+            src0->type != GGML_TYPE_F32 || src1->type != GGML_TYPE_F32 ||
+            logits->type != GGML_TYPE_F32 || bias->type != GGML_TYPE_F32 ||
+            weights->type != GGML_TYPE_F32 || ids->type != GGML_TYPE_I32 ||
+            src0->ne[0] != 2688 || src0->ne[1] != 128 || src0->ne[2] != 1 || src0->ne[3] != 1 ||
+            src1->ne[0] != 2688 || src1->ne[1] != 1 || src1->ne[2] != 1 || src1->ne[3] != 1 ||
+            logits->ne[0] != 128 || logits->ne[1] != 1 || logits->ne[2] != 1 || logits->ne[3] != 1 ||
+            bias->ne[0] != 128 || ggml_nelements(bias) != 128 ||
+            weights->ne[0] != 1 || weights->ne[1] != 6 || weights->ne[2] != 1 || weights->ne[3] != 1 ||
+            ids->ne[0] != 6 || ids->ne[1] != 1 || ids->ne[2] != 1 || ids->ne[3] != 1 ||
+            ids->nb[1] / ggml_type_size(ids->type) != 128 ||
+            !ggml_is_contiguous(src0) || !ggml_is_contiguous(src1) ||
+            !ggml_is_contiguous(logits) || !ggml_is_contiguous(bias) || !ggml_is_contiguous(weights)) {
+        return false;
+    }
+
+    mmvf_nemo_router_topk guest;
+    guest.bias       = (const float *) bias->data;
+    guest.weights    = (float *) weights->data;
+    guest.ids        = (int32_t *) ids->data;
+    guest.completion = ctx.nemo_router_topk_completion + ctx.curr_stream_no;
+    guest.clamp_val  = clamp != nullptr ? ggml_get_op_params_f32(clamp, 0) : -INFINITY;
+    guest.scale_val  = scale != nullptr ? ggml_get_op_params_f32(scale, 0) : 1.0f;
+    guest.with_norm  = clamp != nullptr;
+
+    constexpr int ncols2    = 2688 / 2;
+    constexpr int nrows     = 128;
+    constexpr int block_size = 224;
+    const int warp_size = ggml_cuda_info().devices[ggml_cuda_get_device()].warp_size;
+    if (warp_size != WARP_SIZE) {
+        return false;
+    }
+
+    ggml_cuda_mm_fusion_args_device empty{};
+    const uint3 one_fd  = init_fastdiv_values(1);
+    const uint3 zero_fd = make_uint3(0, 0, 0);
+    const dim3 block_nums(nrows, 1, 1);
+    const dim3 block_dims(block_size, 1, 1);
+    const ggml_cuda_kernel_launch_params launch_params(
+        block_nums, block_dims, warp_size * sizeof(float), ctx.stream());
+
+    ggml_cuda_kernel_launch(
+        (mul_mat_vec_f<float, float, 1, block_size, false, false, true>), launch_params,
+        (const float *) src0->data, (const float *) src1->data, (const int32_t *) nullptr,
+        empty, (float *) logits->data, ncols2, zero_fd,
+        (int) (src0->nb[1] / sizeof(float)), (int) (src1->nb[1] / sizeof(float) / 2),
+        (int) (logits->nb[1] / sizeof(float)), one_fd,
+        (int) (src0->nb[2] / sizeof(float)), (int) (src1->nb[2] / sizeof(float)),
+        (int) (logits->nb[2] / sizeof(float)), one_fd,
+        (int) (src0->nb[3] / sizeof(float)), (int) (src1->nb[3] / sizeof(float)),
+        (int) (logits->nb[3] / sizeof(float)), 0, guest);
+    return true;
+}
+
