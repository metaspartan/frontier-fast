From: Claude Code (Opus 5) <noreply@anthropic.com>
Date: Fri, 14 Aug 2026 03:30:00 -0600
Subject: [PATCH 06/27] cuda: write the Mamba2 recurrent state straight into the cache

Ported from the Nemotron R9700 HIP series to the GB10 CUDA track. Both tracks
pin llama.cpp 0b1bad14ff20 and llama.cpp's HIP backend is the CUDA backend
source-translated, so the diff applies to ggml/src/ggml-cuda unchanged.

The scan writes its updated state to a scratch tensor which a following CPY
then moves into the recurrent cache. Point the scan's state output at the
cache rows and skip the copy. This removes a full read and write of the
recurrent state per layer per token, which is real memory traffic rather
than launch count -- the reason it is the largest single item in this series
on a box where a dispatch is only 0.88 us.

GB10 leave-one-out: GGML_CUDA_DISABLE_SSM_STATE_WRITEBACK_FUSION=1 costs
2.88% of decode, the biggest contribution in the series.
---
diff --git a/ggml/src/ggml-cuda/ggml-cuda.cu b/ggml/src/ggml-cuda/ggml-cuda.cu
index c421d9ca7..d91df9f16 100644
--- a/ggml/src/ggml-cuda/ggml-cuda.cu
+++ b/ggml/src/ggml-cuda/ggml-cuda.cu
@@ -2801,6 +2801,127 @@ static int ggml_cuda_try_gdn_cache_fusion(
     return skip;
 }
 
+// Match a decode-shaped Mamba2 scan followed by the copy of its final-state
+// tail back to the single recurrent-cache row. The scan kernel can write that
+// tail to the cache itself, preserving the token-output prefix byte-for-byte
+// while removing a large D2D copy and its launch.
+static int ggml_cuda_try_ssm_state_writeback_fusion(
+        ggml_backend_cuda_context * cuda_ctx,
+        const ggml_cgraph * cgraph, int node_idx, ggml_cuda_ssm_scan_fused_cache & fused_cache) {
+    const ggml_tensor * scan = cgraph->nodes[node_idx];
+
+    if (scan->op != GGML_OP_SSM_SCAN || scan->type != GGML_TYPE_F32 ||
+        (scan->flags & GGML_TENSOR_FLAG_OUTPUT)) {
+        return 0;
+    }
+
+    const ggml_tensor * state = scan->src[0];
+    const ggml_tensor * x     = scan->src[1];
+    const ggml_tensor * A     = scan->src[3];
+    const ggml_tensor * ids   = scan->src[6];
+    if (state == nullptr || x == nullptr || A == nullptr || ids == nullptr || state->data == nullptr) {
+        return 0;
+    }
+
+    // Mamba2 has one decay value per head (Mamba1 has d_state values), and
+    // this direct-cache path is intentionally restricted to one token, one
+    // sequence, and one physical cache slot. With one slot ids[0] can only be
+    // zero, so the cache destination is the identity-mapped input row.
+    if (A->ne[0] != 1 || x->ne[2] != 1 || x->ne[3] != 1 || ids->ne[0] != 1 || state->ne[3] != 1 ||
+        state->type != GGML_TYPE_F32 || !ggml_is_contiguous(state)) {
+        return 0;
+    }
+
+    const int64_t y_ne     = ggml_nelements(x);
+    const int64_t state_ne = state->ne[0] * state->ne[1] * state->ne[2];
+    if (ggml_nelements(scan) != y_ne + state_ne) {
+        return 0;
+    }
+    const size_t tail_off = ggml_row_size(GGML_TYPE_F32, y_ne);
+
+    // The writeback copy must be the first real node after the scan. Views and
+    // empty rollback copies are graph-only/no-op nodes and may sit between them.
+    const ggml_tensor * cpy = nullptr;
+    int skip = 0;
+    for (int j = node_idx + 1; j < cgraph->n_nodes && cpy == nullptr; ++j) {
+        const ggml_tensor * n = cgraph->nodes[j];
+        if (ggml_cuda_is_view_or_noop(n)) {
+            continue;
+        }
+        if (n->op != GGML_OP_CPY || (n->flags & GGML_TENSOR_FLAG_OUTPUT)) {
+            return 0;
+        }
+        cpy  = n;
+        skip = j - node_idx;
+    }
+    if (cpy == nullptr) {
+        return 0;
+    }
+
+    const ggml_tensor * src = cpy->src[0];
+    const ggml_tensor * dst = cpy->src[1];
+    if (src == nullptr || dst == nullptr ||
+        src->op != GGML_OP_VIEW || src->view_src != scan || src->view_offs != tail_off ||
+        src->type != GGML_TYPE_F32 || !ggml_is_contiguous(src) || ggml_nelements(src) != state_ne ||
+        dst->type != GGML_TYPE_F32 || dst->data == nullptr || !ggml_is_contiguous(dst) ||
+        ggml_nelements(dst) != state_ne || dst->nb[0] != sizeof(float)) {
+        return 0;
+    }
+
+    // Exact identity cache only: both the scan input and writeback destination
+    // begin at the sole state row. This also makes the kernel's in-place alias
+    // explicit rather than inferred from an uninspected device-side id.
+    if (dst->data != state->data) {
+        return 0;
+    }
+
+    // Do not leave any other reader of the normally-produced state tail behind.
+    // Prefix views used for y are fine; a view crossing tail_off is not.
+    for (int j = node_idx + 1; j < cgraph->n_nodes; ++j) {
+        const ggml_tensor * n = cgraph->nodes[j];
+        if (n == src) {
+            continue;
+        }
+        if (n->view_src == scan && n->view_offs + ggml_nbytes(n) > tail_off) {
+            return 0;
+        }
+        for (int k = 0; k < GGML_MAX_SRC; ++k) {
+            if (n->src[k] == scan && n->op != GGML_OP_VIEW && n->op != GGML_OP_RESHAPE) {
+                return 0;
+            }
+        }
+    }
+
+    // A fused skip must not cross a concurrent-region boundary. It is safe
+    // inside a region only when every skipped graph node is mapped to the same
+    // stream as the scan; otherwise fall back to the ordinary scan + CPY path.
+    for (const auto & [fork_node, event] : cuda_ctx->stream_context().concurrent_events) {
+        if (fork_node == scan || fork_node == cpy || event.join_node == scan || event.join_node == cpy) {
+            return 0;
+        }
+
+        const auto scan_it = event.stream_mapping.find(scan);
+        const auto cpy_it  = event.stream_mapping.find(cpy);
+        if ((scan_it == event.stream_mapping.end()) != (cpy_it == event.stream_mapping.end())) {
+            return 0;
+        }
+        if (scan_it != event.stream_mapping.end()) {
+            if (scan_it->second != cpy_it->second) {
+                return 0;
+            }
+            for (int j = node_idx + 1; j <= node_idx + skip; ++j) {
+                const auto it = event.stream_mapping.find(cgraph->nodes[j]);
+                if (it == event.stream_mapping.end() || it->second != scan_it->second) {
+                    return 0;
+                }
+            }
+        }
+    }
+
+    fused_cache.data = (float *) dst->data;
+    return skip;
+}
