+// Return the exact ADD chain length that stock's multi-ADD path would fuse.
+// The chain value is src0 of the first ADD followed, left-to-right, by src1 of
+// each ADD node.
+static int ggml_cuda_nemo_pre_add_chain_len(const ggml_cgraph * cgraph, const int i) {
+    int n_fuse = 0;
+    ggml_op ops[RMS_NORM_ADD_MAX_OPERANDS];
+    std::fill(ops, ops + RMS_NORM_ADD_MAX_OPERANDS, GGML_OP_ADD);
+
+    for (; n_fuse <= RMS_NORM_ADD_MAX_OPERANDS - 2; ++n_fuse) {
+        if (!ggml_can_fuse(cgraph, i + n_fuse, ops + n_fuse, 2)) {
+            break;
+        }
+        if (cgraph->nodes[i + n_fuse] != cgraph->nodes[i + n_fuse + 1]->src[0]) {
+            break;
+        }
+        if (!ggml_are_same_layout(cgraph->nodes[i + n_fuse]->src[1],
+                                  cgraph->nodes[i + n_fuse + 1]->src[1])) {
+            break;
+        }
+    }
+    return n_fuse + 1;
+}
+
+static bool ggml_cuda_nemo_pre_add_shape_ok(const ggml_tensor * t) {
+    return t != nullptr && t->type == GGML_TYPE_F32 &&
+        t->ne[0] == 2688 && t->ne[1] == 1 && t->ne[2] == 1 && t->ne[3] == 1 &&
+        t->nb[0] == ggml_type_size(t->type) && ggml_is_contiguous(t);
+}
+
+static bool ggml_cuda_nemo_same_allocation_or_disjoint(const ggml_tensor * a, const ggml_tensor * b) {
+    if (a == nullptr || b == nullptr || a->data == nullptr || b->data == nullptr ||
+            a->buffer == nullptr || b->buffer == nullptr) {
+        return false;
+    }
+    const uintptr_t a0 = (uintptr_t) a->data;
+    const uintptr_t b0 = (uintptr_t) b->data;
+    const size_t as = ggml_backend_buft_get_alloc_size(a->buffer->buft, a);
+    const size_t bs = ggml_backend_buft_get_alloc_size(b->buffer->buft, b);
+    if (a0 == b0) {
+        return as == bs;
+    }
+    return a0 + as <= b0 || b0 + bs <= a0;
+}
+
+// Match only Nemotron's batch-one outer block residual, never Mamba's internal
+// [4096,1] y + x*D operation.  Returns the number of ADD nodes, or zero.
+static int ggml_cuda_nemo_pre_add_norm_detect(const ggml_cgraph * cgraph, const int i) {
+    if (i >= cgraph->n_nodes || cgraph->nodes[i]->op != GGML_OP_ADD) {
+        return 0;
+    }
+
+    const int n_adds = ggml_cuda_nemo_pre_add_chain_len(cgraph, i);
+    const int inorm  = i + n_adds;
+    if (n_adds < 1 || n_adds >= RMS_NORM_ADD_MAX_OPERANDS || inorm + 1 >= cgraph->n_nodes) {
+        return 0;
+    }
+
+    ggml_tensor * add_last = cgraph->nodes[inorm - 1];
+    ggml_tensor * norm     = cgraph->nodes[inorm];
+    ggml_tensor * mul      = cgraph->nodes[inorm + 1];
+    if (!ggml_cuda_nemo_pre_add_shape_ok(add_last) ||
+            norm->op != GGML_OP_RMS_NORM || norm->src[0] != add_last ||
+            !ggml_cuda_nemo_pre_add_shape_ok(mul) || !ggml_are_same_shape(mul, add_last)) {
+        return 0;
+    }
+
+    // Retain the exact stock RMS_NORM+MUL eligibility and leave the separate
+    // RMS_NORM+MUL+ADD epilogue alone.
+    if (ggml_cuda_can_fuse(cgraph, inorm, { GGML_OP_RMS_NORM, GGML_OP_MUL, GGML_OP_ADD }, {}) ||
+            !ggml_cuda_can_fuse(cgraph, inorm, { GGML_OP_RMS_NORM, GGML_OP_MUL }, {})) {
+        return 0;
+    }
+
+    const ggml_tensor * mul_src = mul->src[0] == norm ? mul->src[1] :
+                                  mul->src[1] == norm ? mul->src[0] : nullptr;
+    if (!ggml_cuda_nemo_pre_add_shape_ok(mul_src)) {
+        return 0;
+    }
+
+    if (!ggml_cuda_nemo_pre_add_shape_ok(cgraph->nodes[i]->src[0])) {
+        return 0;
+    }
+    for (int k = 0; k < n_adds; ++k) {
+        const ggml_tensor * add = cgraph->nodes[i + k];
+        if (add->op != GGML_OP_ADD || !ggml_are_same_shape(add, add_last) ||
+                !ggml_cuda_nemo_pre_add_shape_ok(add->src[1])) {
+            return 0;
+        }
+    }
+
+    // Exact in-place ADD aliases are elementwise-safe; partial aliases are not.
+    if (!ggml_cuda_nemo_same_allocation_or_disjoint(cgraph->nodes[i]->src[0], add_last)) {
+        return 0;
+    }
+    for (int k = 0; k < n_adds; ++k) {
+        if (!ggml_cuda_nemo_same_allocation_or_disjoint(cgraph->nodes[i + k]->src[1], add_last)) {
+            return 0;
+        }
+    }
+    // The output loop reads the stored residual while writing the norm result.
+    // Require those allocations to be fully disjoint.
+    if (mul->data == add_last->data ||
+            !ggml_cuda_nemo_same_allocation_or_disjoint(mul, add_last)) {
+        return 0;
+    }
+    return n_adds;
+}
