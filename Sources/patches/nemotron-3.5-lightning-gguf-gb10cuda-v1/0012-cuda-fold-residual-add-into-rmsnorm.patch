diff --git a/ggml/src/ggml-cuda/norm.cu b/ggml/src/ggml-cuda/norm.cu
index a9e8434ee..a1f995f19 100644
--- a/ggml/src/ggml-cuda/norm.cu
+++ b/ggml/src/ggml-cuda/norm.cu
@@ -240,6 +240,205 @@ static __global__ void rms_norm_mul_quant_f32(const float * x,
     }
 }
 
+// ----- Nemotron residual ADD -> RMS norm (+ q8_1) ---------------------------
+//
+// Nemotron's batch-one block boundary is:
+//
+//   ADD [2688,1] -> RMS_NORM -> MUL -> quantize_q8_1 -> MMVQ
+//
+// The ADD destination remains materialized because it is the next block's
+// residual.  The same block then runs the stock RMS reduction/output expression
+// and, when requested, the exact padded q8_1 epilogue above.  ADD operands are
+// visited as src0 followed by every chained ADD src1, matching k_bin_bcast's
+// comma-fold order and preserving a distinct rounded F32 addition per step.
+
+struct rms_norm_pre_add_args {
+    const float * src[RMS_NORM_ADD_MAX_OPERANDS];
+    int64_t       stride_row[RMS_NORM_ADD_MAX_OPERANDS];
+};
+
+template <int block_size, int n_op, bool do_quant>
+static __global__ void rms_norm_pre_add_f32(const rms_norm_pre_add_args args,
+                                            float *       add_dst,
+                                            const int64_t add_stride_row,
+                                            float *       dst,
+                                            const int     ncols,
+                                            const int     q8_ncols,
+                                            const float   eps,
+                                            const float * mul,
+                                            const int64_t mul_stride_row,
+                                            const uint3   mul_ncols_packed,
+                                            const uint3   mul_nrows_packed,
+                                            void *        q8_1_dst) {
+    ggml_cuda_pdl_lc();
+    const int row = blockIdx.x;
+    const int tid = threadIdx.x;
+
+    add_dst += (int64_t) row * add_stride_row;
+    dst     += (int64_t) row * ncols;
+
+    const uint32_t mul_row = fastmodulo((uint32_t) row, mul_nrows_packed);
+    mul += (int64_t) mul_row * mul_stride_row;
+
+    float tmp = 0.0f;
+
+    ggml_cuda_pdl_sync();
+    for (int col = tid; col < ncols; col += block_size) {
+        float acc = args.src[0][(int64_t) row * args.stride_row[0] + col];
+#pragma unroll
+        for (int k = 1; k < n_op; ++k) {
+            acc = acc + args.src[k][(int64_t) row * args.stride_row[k] + col];
+        }
+        add_dst[col] = acc;
+        tmp += acc * acc;
+    }
+
+    extern __shared__ float s_sum[];
+    tmp = block_reduce<block_reduce_method::SUM, block_size>(tmp, s_sum);
+
+    const float mean  = tmp / ncols;
+    const float scale = rsqrtf(mean + eps);
+    const int64_t row_cont = row;
+    block_q8_1 * y = (block_q8_1 *) q8_1_dst;
+
+    const int output_cols = do_quant ? q8_ncols : ncols;
+    for (int col = tid; col < output_cols; col += block_size) {
+        float val = 0.0f;
+        if (col < ncols) {
+            const int mul_col = fastmodulo(col, mul_ncols_packed);
+            val      = scale * add_dst[col] * mul[mul_col];
+            dst[col] = val;
+        }
+
+        if constexpr (do_quant) {
+            const int64_t i_cont = row_cont*q8_ncols + col;
+            const int64_t ib     = i_cont / QK8_1;
+            const int64_t iqs    = i_cont % QK8_1;
+
+            const float xq = val;
+            float amax = fabsf(xq);
+            float sum  = xq;
+
+            amax = warp_reduce_max<QK8_1>(amax);
+            sum  = warp_reduce_sum<QK8_1>(sum);
+
+            const float  d = amax / 127.0f;
+            const int8_t q = amax == 0.0f ? 0 : roundf(xq / d);
+
+            y[ib].qs[iqs] = q;
+            if (iqs == 0) {
+                y[ib].ds = make_half2(d, sum);
+            }
+        }
+    }
+}
+
+template <int n_op, bool do_quant>
+static void rms_norm_pre_add_launch(const rms_norm_pre_add_args & args,
+                                    float * add_dst, int64_t add_stride_row,
+                                    float * dst, int ncols, int q8_ncols,
+                                    int nrows, float eps,
+                                    const float * mul, int64_t mul_stride_row,
+                                    uint32_t mul_ncols, uint32_t mul_nrows,
+                                    void * q8_1_dst, cudaStream_t stream) {
+    const dim3 blocks_num(nrows, 1, 1);
+    const uint3 mul_ncols_packed = init_fastdiv_values(mul_ncols);
+    const uint3 mul_nrows_packed = init_fastdiv_values(mul_nrows);
+
+    if (ncols < 1024) {
+        const dim3 block_dims(256, 1, 1);
+        const ggml_cuda_kernel_launch_params launch_params =
+            ggml_cuda_kernel_launch_params{blocks_num, block_dims, block_dims.x > WARP_SIZE ? 32 * sizeof(float) : 0, stream};
+        ggml_cuda_kernel_launch((rms_norm_pre_add_f32<256, n_op, do_quant>), launch_params,
+            args, add_dst, add_stride_row, dst, ncols, q8_ncols, eps, mul, mul_stride_row,
+            mul_ncols_packed, mul_nrows_packed, q8_1_dst);
+    } else {
+        const dim3 block_dims(1024, 1, 1);
+        const ggml_cuda_kernel_launch_params launch_params =
+            ggml_cuda_kernel_launch_params{blocks_num, block_dims, block_dims.x > WARP_SIZE ? 32 * sizeof(float) : 0, stream};
+        ggml_cuda_kernel_launch((rms_norm_pre_add_f32<1024, n_op, do_quant>), launch_params,
+            args, add_dst, add_stride_row, dst, ncols, q8_ncols, eps, mul, mul_stride_row,
+            mul_ncols_packed, mul_nrows_packed, q8_1_dst);
+    }
+}
+
+void ggml_cuda_op_rms_norm_fused_pre_add(ggml_backend_cuda_context & ctx,
+                                         ggml_tensor * const * adds, int n_adds,
+                                         ggml_tensor * norm, ggml_tensor * mul_tensor,
+                                         char * q8_1_dst) {
+    GGML_ASSERT(n_adds >= 1 && n_adds <= RMS_NORM_ADD_MAX_OPERANDS - 1);
+
+    ggml_tensor * add_last = adds[n_adds - 1];
+    const ggml_tensor * mul_src = nullptr;
+    if (mul_tensor->src[0] == norm) {
+        mul_src = mul_tensor->src[1];
+    } else if (mul_tensor->src[1] == norm) {
+        mul_src = mul_tensor->src[0];
+    } else {
+        GGML_ABORT("RMS norm MUL does not consume norm");
+    }
+
+    GGML_ASSERT(add_last->type == GGML_TYPE_F32);
+    GGML_ASSERT(norm->type == GGML_TYPE_F32);
+    GGML_ASSERT(mul_tensor->type == GGML_TYPE_F32);
+    GGML_ASSERT(add_last->ne[0] == 2688 && add_last->ne[1] == 1 &&
+                add_last->ne[2] == 1 && add_last->ne[3] == 1);
+
+    float eps = 0.0f;
+    memcpy(&eps, norm->op_params, sizeof(float));
+    GGML_ASSERT(eps >= 0.0f);
+
+    rms_norm_pre_add_args args = {};
+    int n_op = 0;
+    const ggml_tensor * s0 = adds[0]->src[0];
+    args.src[n_op]        = (const float *) s0->data;
+    args.stride_row[n_op] = s0->nb[1] / sizeof(float);
+    ++n_op;
+    for (int k = 0; k < n_adds; ++k) {
+        const ggml_tensor * s1 = adds[k]->src[1];
+        args.src[n_op]        = (const float *) s1->data;
+        args.stride_row[n_op] = s1->nb[1] / sizeof(float);
+        ++n_op;
+    }
+    for (int k = n_op; k < RMS_NORM_ADD_MAX_OPERANDS; ++k) {
+        args.src[k]        = args.src[0];
+        args.stride_row[k] = args.stride_row[0];
+    }
+
+    const int ncols      = (int) add_last->ne[0];
+    const int nrows      = (int) add_last->ne[1];
+    const int q8_ncols   = (int) GGML_PAD(add_last->ne[0], MATRIX_ROW_PADDING);
+    float * add_dst      = (float *) add_last->data;
+    float * dst          = (float *) mul_tensor->data;
+    const int64_t add_stride_row = add_last->nb[1] / sizeof(float);
+    const int64_t mul_stride_row = mul_src->nb[1] / sizeof(float);
+    const bool do_quant = q8_1_dst != nullptr;
+
+#define RMS_NORM_PRE_ADD_LAUNCH_CASE(N) \
+        case N: \
+            if (do_quant) { \
+                rms_norm_pre_add_launch<N, true>(args, add_dst, add_stride_row, dst, ncols, q8_ncols, nrows, eps, \
+                    (const float *) mul_src->data, mul_stride_row, (uint32_t) mul_src->ne[0], \
+                    (uint32_t) mul_src->ne[1], q8_1_dst, ctx.stream()); \
+            } else { \
+                rms_norm_pre_add_launch<N, false>(args, add_dst, add_stride_row, dst, ncols, q8_ncols, nrows, eps, \
+                    (const float *) mul_src->data, mul_stride_row, (uint32_t) mul_src->ne[0], \
+                    (uint32_t) mul_src->ne[1], nullptr, ctx.stream()); \
+            } \
+            break
+    switch (n_op) {
+        RMS_NORM_PRE_ADD_LAUNCH_CASE(2);
+        RMS_NORM_PRE_ADD_LAUNCH_CASE(3);
+        RMS_NORM_PRE_ADD_LAUNCH_CASE(4);
+        RMS_NORM_PRE_ADD_LAUNCH_CASE(5);
+        RMS_NORM_PRE_ADD_LAUNCH_CASE(6);
+        RMS_NORM_PRE_ADD_LAUNCH_CASE(7);
+        RMS_NORM_PRE_ADD_LAUNCH_CASE(8);
+        default: GGML_ABORT("unsupported RMS norm pre-add operand count");
+    }
+#undef RMS_NORM_PRE_ADD_LAUNCH_CASE
+}
+
