From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Claude Code (Opus 5) <noreply@anthropic.com>
Date: Fri, 14 Aug 2026 03:30:00 -0600
Subject: [PATCH 10/27] cuda: fold the MMVQ q8_1 quantization into RMS norm

Ported from the Nemotron R9700 HIP series to the GB10 CUDA track. Both tracks
pin llama.cpp 0b1bad14ff20 and llama.cpp's HIP backend is the CUDA backend
source-translated, so the diff applies to ggml/src/ggml-cuda unchanged.

The RMS norm already has the normalized row in registers; write the q8_1
blocks its consumer needs from the same kernel into the patch 0004 cache
instead of re-reading the row in a separate quantizer launch.

GB10 leave-one-out: 0.14% of decode.
---
diff --git a/ggml/src/ggml-cuda/ggml-cuda.cu b/ggml/src/ggml-cuda/ggml-cuda.cu
index 71189a157..f0aa9df67 100644
--- a/ggml/src/ggml-cuda/ggml-cuda.cu
+++ b/ggml/src/ggml-cuda/ggml-cuda.cu
@@ -3392,6 +3392,140 @@ static bool ggml_cuda_can_fuse(const struct ggml_cgraph *                cgraph,
     return false;
 }
 
+// Return the stream on which the concurrent-graph scheduler will issue a node.
+// Nodes outside a mapped branch run on stream zero.  This lets a producer avoid
+// doing speculative q8 work that the stream-keyed MMVQ cache could not reuse.
+static cudaStream_t ggml_cuda_norm_quant_node_stream(ggml_backend_cuda_context * ctx, const ggml_tensor * node) {
+    for (const auto & [fork_node, event] : ctx->stream_context().concurrent_events) {
+        GGML_UNUSED(fork_node);
+        const auto it = event.stream_mapping.find(node);
+        if (it != event.stream_mapping.end()) {
+            return ctx->stream(ctx->device, it->second);
+        }
+    }
+    return ctx->stream(ctx->device, 0);
+}
+
+// Find a quantized MMVQ consumer on the producer stream.  Return its src1 so
+// the cache entry can use the exact tuple that MMVQ will request.
+static const ggml_tensor * ggml_cuda_norm_quant_find_mmvq_consumer(ggml_backend_cuda_context * ctx,
+                                                                  const ggml_cgraph * cgraph,
+                                                                  const int from,
+                                                                  const ggml_tensor * t) {
+    const int cc = ggml_cuda_info().devices[ggml_cuda_get_device()].cc;
+    const cudaStream_t producer_stream = ctx->stream();
+
+    for (int j = from; j < cgraph->n_nodes; ++j) {
+        const ggml_tensor * n = cgraph->nodes[j];
+        if (n->op != GGML_OP_MUL_MAT && n->op != GGML_OP_MUL_MAT_ID) {
+            continue;
+        }
+        const ggml_tensor * s1 = n->src[1];
+        if (s1 == nullptr) {
+            continue;
+        }
+        const ggml_tensor * s1_origin = s1->view_src != nullptr ? s1->view_src : s1;
+        if (s1_origin != t || s1->data != t->data) {
+            continue;
+        }
+        const bool same_layout = s1->ne[0] == t->ne[0] && s1->ne[1] == t->ne[1] &&
+            s1->ne[2] == t->ne[2] && s1->ne[3] == t->ne[3] &&
+            s1->nb[1] == t->nb[1] && s1->nb[2] == t->nb[2] && s1->nb[3] == t->nb[3];
+        // Nemotron's grouped Mamba RMS norm is {512,8,1,1}, then reshaped to
+        // {4096,1,1,1} for ssm_out.  With padding-free contiguous rows, both
+        // layouts serialize exactly the same consecutive q8_1 blocks.
+        const bool padding_free_reshape = ggml_is_contiguous(s1) &&
+            ggml_nelements(s1) == ggml_nelements(t) &&
+            GGML_PAD(t->ne[0], MATRIX_ROW_PADDING) == t->ne[0] &&
+            GGML_PAD(s1->ne[0], MATRIX_ROW_PADDING) == s1->ne[0];
+        if (!same_layout && !padding_free_reshape) {
+            continue;
+        }
+        const ggml_tensor * w = n->src[0];
+        if (w == nullptr || !ggml_is_quantized(w->type) ||
+                t->type != GGML_TYPE_F32 || n->type != GGML_TYPE_F32 ||
+                !ggml_cuda_should_use_mmvq(w->type, cc, s1->ne[1])) {
+            continue;
+        }
+        if (ggml_cuda_norm_quant_node_stream(ctx, n) != producer_stream) {
+            continue;
+        }
+        return s1;
+    }
+    return nullptr;
+}
+
+static bool ggml_cuda_norm_quant_shape_ok(const ggml_tensor * t) {
+    if (t->type != GGML_TYPE_F32 || !ggml_is_contiguous(t)) {
+        return false;
+    }
+    // This port intentionally covers Nemotron's decode-shaped activations.
+    // The kernel supports padded q8 rows, but not higher-dimensional traffic.
+    if (t->ne[2] != 1 || t->ne[3] != 1 || t->ne[0] <= 0 ||
+            t->ne[0] > std::numeric_limits<int>::max()) {
+        return false;
+    }
+    return GGML_PAD(t->ne[0], MATRIX_ROW_PADDING) <= std::numeric_limits<int>::max();
+}
+
+static char * ggml_cuda_norm_quant_register(ggml_backend_cuda_context * ctx,
+                                            const ggml_cgraph * cgraph,
+                                            const int from,
+                                            ggml_tensor * t) {
+    if (!ggml_cuda_norm_quant_shape_ok(t)) {
+        return nullptr;
+    }
+    const ggml_tensor * consumer = ggml_cuda_norm_quant_find_mmvq_consumer(ctx, cgraph, from, t);
+    if (consumer == nullptr) {
+        return nullptr;
+    }
+
+    cudaStream_t stream = ctx->stream();
+    const size_t  ts          = ggml_type_size(consumer->type);
+    const int64_t ne10        = consumer->ne[0];
+    const int64_t s11         = consumer->nb[1] / ts;
+    const int64_t s12         = consumer->nb[2] / ts;
+    const int64_t s13         = consumer->nb[3] / ts;
+    const int64_t ne10_padded = GGML_PAD(ne10, MATRIX_ROW_PADDING);
+
+    if (ctx->quantized_src1_cache.find(consumer, stream, ne10, s11, s12, s13,
+            ne10_padded, consumer->ne[1], consumer->ne[2], consumer->ne[3]) != nullptr) {
+        return nullptr;
+    }
+
+    const size_t size_q8_1 = consumer->ne[3]*consumer->ne[2] * consumer->ne[1]*ne10_padded * sizeof(block_q8_1)/QK8_1;
+    return ctx->quantized_src1_cache.insert(ctx->pool(), consumer, stream,
+        ne10, s11, s12, s13, ne10_padded,
+        consumer->ne[1], consumer->ne[2], consumer->ne[3], size_q8_1);
+}
+
+// A stock-fusible rms_norm+mul, excluding the separate rms_norm+mul+add path.
+static bool ggml_cuda_norm_quant_plain_ok(const ggml_cgraph * cgraph, const int i) {
+    if (i + 1 >= cgraph->n_nodes || cgraph->nodes[i]->op != GGML_OP_RMS_NORM) {
+        return false;
+    }
+    if (ggml_cuda_can_fuse(cgraph, i, { GGML_OP_RMS_NORM, GGML_OP_MUL, GGML_OP_ADD }, {}) ||
+            !ggml_cuda_can_fuse(cgraph, i, { GGML_OP_RMS_NORM, GGML_OP_MUL }, {})) {
+        return false;
+    }
+
+    const ggml_tensor * norm = cgraph->nodes[i];
+    const ggml_tensor * mul  = cgraph->nodes[i + 1];
+    const ggml_tensor * x    = norm->src[0];
+    const ggml_tensor * mul_src = mul->src[0] == norm ? mul->src[1] : mul->src[0];
+
+    if (mul_src == nullptr || mul_src->type != GGML_TYPE_F32 ||
+            mul_src->nb[0] != ggml_type_size(mul_src->type) ||
+            mul_src->ne[2] != 1 || mul_src->ne[3] != 1) {
+        return false;
+    }
+    if (x == nullptr || x->type != GGML_TYPE_F32 || x->ne[2] != 1 || x->ne[3] != 1 ||
+            x->nb[0] != ggml_type_size(x->type)) {
+        return false;
+    }
+    return ggml_is_contiguous(mul) && ggml_are_same_shape(mul, x);
+}
