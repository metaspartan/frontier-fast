From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Claude Code (Opus 5) <noreply@anthropic.com>
Date: Fri, 14 Aug 2026 03:30:00 -0600
Subject: [PATCH 11/27] cuda: fold the Mamba2 x*D output path into the scan

Ported from the Nemotron R9700 HIP series to the GB10 CUDA track. Both tracks
pin llama.cpp 0b1bad14ff20 and llama.cpp's HIP backend is the CUDA backend
source-translated, so the diff applies to ggml/src/ggml-cuda unchanged.

Stock materializes x*D in one bin-broadcast kernel and adds the scan output
in a second. The scan already holds both operands, so it writes the exact
two-rounded-operation result directly to the ADD destination. __fmul_rn and
__fadd_rn keep it two roundings; the HIP-only asm barrier beside them is a
no-op under nvcc, which does not contract or reassociate those intrinsics
even at -use_fast_math.

GB10 leave-one-out: GGML_CUDA_DISABLE_SSM_OUTPUT_D_FUSION=1 costs 0.41%.
---
diff --git a/ggml/src/ggml-cuda/ggml-cuda.cu b/ggml/src/ggml-cuda/ggml-cuda.cu
index 71189a157..181af6d44 100644
--- a/ggml/src/ggml-cuda/ggml-cuda.cu
+++ b/ggml/src/ggml-cuda/ggml-cuda.cu
@@ -2807,7 +2807,8 @@ static int ggml_cuda_try_gdn_cache_fusion(
 // while removing a large D2D copy and its launch.
 static int ggml_cuda_try_ssm_state_writeback_fusion(
         ggml_backend_cuda_context * cuda_ctx,
-        const ggml_cgraph * cgraph, int node_idx, ggml_cuda_ssm_scan_fused_cache & fused_cache) {
+        const ggml_cgraph * cgraph, int node_idx, bool fuse_output_d,
+        ggml_cuda_ssm_scan_fused_cache & fused_cache) {
     const ggml_tensor * scan = cgraph->nodes[node_idx];
 
     if (scan->op != GGML_OP_SSM_SCAN || scan->type != GGML_TYPE_F32 ||
@@ -2875,6 +2876,85 @@ static int ggml_cuda_try_ssm_state_writeback_fusion(
         return 0;
     }
 
+    // Decode-only Mamba2 has two elementwise nodes immediately after the
+    // state writeback: x*D, then scan_y + x*D. The scan can materialize the
+    // same two-rounded-operation result directly in the ADD destination.
+    // Keep this optional: if any graph/detail check fails, retain the exact
+    // direct-state writeback above and execute the ordinary MUL + ADD nodes.
+    const ggml_tensor * output_mul = nullptr;
+    const ggml_tensor * output_add = nullptr;
+    const ggml_tensor * output_y   = nullptr;
+    const ggml_tensor * output_d   = nullptr;
+    int output_skip = skip;
+    if (fuse_output_d) {
+        const auto next_real_node = [&](int after, int & index) -> const ggml_tensor * {
+            for (int j = after + 1; j < cgraph->n_nodes; ++j) {
+                if (!ggml_cuda_is_view_or_noop(cgraph->nodes[j])) {
+                    index = j;
+                    return cgraph->nodes[j];
+                }
+            }
+            return nullptr;
+        };
+
+        int mul_idx = -1;
+        int add_idx = -1;
+        const ggml_tensor * mul = next_real_node(node_idx + skip, mul_idx);
+        const ggml_tensor * add = mul != nullptr ? next_real_node(mul_idx, add_idx) : nullptr;
+
+        if (mul != nullptr && add != nullptr && mul->op == GGML_OP_MUL && add->op == GGML_OP_ADD &&
+            !(mul->flags & GGML_TENSOR_FLAG_OUTPUT) && !(add->flags & GGML_TENSOR_FLAG_OUTPUT) &&
+            mul->type == GGML_TYPE_F32 && add->type == GGML_TYPE_F32 &&
+            ggml_is_contiguous(mul) && ggml_is_contiguous(add) &&
+            ggml_nelements(mul) == y_ne && ggml_nelements(add) == y_ne) {
+            if (mul->src[0] == x) {
+                output_d = mul->src[1];
+            } else if (mul->src[1] == x) {
+                output_d = mul->src[0];
+            }
+
+            if (add->src[0] == mul) {
+                output_y = add->src[1];
+            } else if (add->src[1] == mul) {
+                output_y = add->src[0];
+            }
+
+            const bool d_ok = output_d != nullptr && output_d->type == GGML_TYPE_F32 &&
+                output_d->data != nullptr && ggml_is_contiguous(output_d) &&
+                output_d->ne[0] == 1 && output_d->ne[1] == x->ne[1] &&
+                output_d->ne[2] == 1 && output_d->ne[3] == 1;
+            const bool y_ok = output_y != nullptr && output_y->view_src == scan &&
+                output_y->view_offs == 0 && output_y->type == GGML_TYPE_F32 &&
+                ggml_is_contiguous(output_y) && ggml_nelements(output_y) == y_ne;
+
+            bool users_ok = d_ok && y_ok && add->data != nullptr;
+            for (int j = node_idx + 1; users_ok && j < cgraph->n_nodes; ++j) {
+                const ggml_tensor * n = cgraph->nodes[j];
+                if (ggml_cuda_is_view_or_noop(n)) {
+                    continue;
+                }
+                for (int k = 0; k < GGML_MAX_SRC; ++k) {
+                    const ggml_tensor * input = n->src[k];
+                    const bool scan_input = input == scan || (input != nullptr && input->view_src == scan);
+                    if (scan_input && !((n == cpy && input == src) || (n == add && input == output_y))) {
+                        users_ok = false;
+                        break;
+                    }
+                    if (input == mul && n != add) {
+                        users_ok = false;
+                        break;
+                    }
+                }
+            }
+
+            if (users_ok) {
+                output_mul  = mul;
+                output_add  = add;
+                output_skip = add_idx - node_idx;
+            }
+        }
+    }
+
     // Do not leave any other reader of the normally-produced state tail behind.
     // Prefix views used for y are fine; a view crossing tail_off is not.
     for (int j = node_idx + 1; j < cgraph->n_nodes; ++j) {
@@ -2895,31 +2975,35 @@ static int ggml_cuda_try_ssm_state_writeback_fusion(
     // A fused skip must not cross a concurrent-region boundary. It is safe
     // inside a region only when every skipped graph node is mapped to the same
     // stream as the scan; otherwise fall back to the ordinary scan + CPY path.
+    const ggml_tensor * fused_end = output_add != nullptr ? output_add : cpy;
+    const int fused_skip = output_add != nullptr ? output_skip : skip;
     for (const auto & [fork_node, event] : cuda_ctx->stream_context().concurrent_events) {
-        if (fork_node == scan || fork_node == cpy || event.join_node == scan || event.join_node == cpy) {
+        if (fork_node == scan || fork_node == cpy || fork_node == fused_end ||
+            event.join_node == scan || event.join_node == cpy || event.join_node == fused_end) {
             return 0;
         }
 
         const auto scan_it = event.stream_mapping.find(scan);
-        const auto cpy_it  = event.stream_mapping.find(cpy);
-        if ((scan_it == event.stream_mapping.end()) != (cpy_it == event.stream_mapping.end())) {
-            return 0;
-        }
-        if (scan_it != event.stream_mapping.end()) {
-            if (scan_it->second != cpy_it->second) {
-                return 0;
-            }
-            for (int j = node_idx + 1; j <= node_idx + skip; ++j) {
-                const auto it = event.stream_mapping.find(cgraph->nodes[j]);
+        const bool scan_mapped = scan_it != event.stream_mapping.end();
+        for (int j = node_idx + 1; j <= node_idx + fused_skip; ++j) {
+            const auto it = event.stream_mapping.find(cgraph->nodes[j]);
+            if (scan_mapped) {
                 if (it == event.stream_mapping.end() || it->second != scan_it->second) {
                     return 0;
                 }
+            } else if (it != event.stream_mapping.end()) {
+                return 0;
             }
         }
     }
 
     fused_cache.data = (float *) dst->data;
-    return skip;
+    if (output_add != nullptr) {
+        GGML_ASSERT(output_mul != nullptr && output_d != nullptr);
+        fused_cache.output_d     = (const float *) output_d->data;
+        fused_cache.output_d_dst = (float *) output_add->data;
+    }
+    return fused_skip;
 }
 
