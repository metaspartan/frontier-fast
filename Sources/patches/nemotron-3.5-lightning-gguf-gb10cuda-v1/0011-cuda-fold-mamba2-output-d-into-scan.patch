@@ -3408,17 +3492,23 @@ static int ggml_cuda_try_fuse(ggml_backend_cuda_context * cuda_ctx, ggml_cgraph
     static const bool disable_ssm_state_writeback =
         getenv("GGML_CUDA_DISABLE_SSM_STATE_WRITEBACK_FUSION") != nullptr &&
         std::atoi(getenv("GGML_CUDA_DISABLE_SSM_STATE_WRITEBACK_FUSION"));
+    static const bool disable_ssm_output_d =
