     if (node->op == GGML_OP_SSM_SCAN && !disable_ssm_state_writeback) {
         ggml_cuda_ssm_scan_fused_cache fused_cache;
-        const int nodes_to_skip = ggml_cuda_try_ssm_state_writeback_fusion(cuda_ctx, cgraph, i, fused_cache);
+        const int nodes_to_skip = ggml_cuda_try_ssm_state_writeback_fusion(
+            cuda_ctx, cgraph, i, !disable_ssm_output_d, fused_cache);
         if (nodes_to_skip > 0) {
             static const bool print_stats = getenv("GGML_CUDA_SSM_STATE_WRITEBACK_STATS") != nullptr &&
                                             std::atoi(getenv("GGML_CUDA_SSM_STATE_WRITEBACK_STATS"));
             static std::atomic<uint64_t> n_fused{0};
             const uint64_t count = n_fused.fetch_add(1, std::memory_order_relaxed) + 1;
             if (print_stats && (count <= 23 || count % 23 == 0)) {
-                GGML_LOG_INFO("%s: direct Mamba2 state writeback fire=%" PRIu64 ", bytes=%zu, node=%s\n",
-                              __func__, count, ggml_nbytes(node->src[0]), node->name);
+                GGML_LOG_INFO("%s: direct Mamba2 state writeback fire=%" PRIu64
+                              ", bytes=%zu, output_d=%d, skipped=%d, node=%s\n",
+                              __func__, count, ggml_nbytes(node->src[0]), fused_cache.output_d != nullptr,
+                              nodes_to_skip, node->name);
             }
             ggml_cuda_op_ssm_scan(*cuda_ctx, node, &fused_cache);
             return nodes_to_skip;
