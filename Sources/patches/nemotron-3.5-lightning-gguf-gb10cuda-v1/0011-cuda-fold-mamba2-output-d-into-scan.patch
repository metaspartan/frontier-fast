         state_sum = warp_reduce_sum(state_sum);
 
         if (lane == 0) {
-            y_warp[i * stride_y] = state_sum;
+            if (output_d_ptr != nullptr) {
+                // Stock materializes x*D in one F32 bin-broadcast kernel and
+                // adds the scan output in a second one. Use explicit RN ops so
+                // this stays two rounded operations rather than contracting
+                // to an FMA after moving the work into the scan kernel.
+                float x_d = __fmul_rn(x_warp[i * stride_x], output_d_ptr[head_idx]);
+#if defined(__HIP_PLATFORM_AMD__)
+                // hipcc is invoked with unsafe-math and otherwise contracts
+                // even __fmul_rn + __fadd_rn. Make the rounded product cross
+                // an optimizer barrier, matching the stock kernel boundary.
+                asm volatile("" : "+v"(x_d));
