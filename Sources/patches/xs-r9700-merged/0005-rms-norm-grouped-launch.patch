 ggml/src/ggml-cuda/ggml-cuda.cu | 192 ++++++++++++++++++++++++++++++++
 ggml/src/ggml-cuda/norm.cu      | 148 ++++++++++++++++++++++++
 ggml/src/ggml-cuda/norm.cuh     |  11 ++
 3 files changed, 351 insertions(+)

diff --git a/ggml/src/ggml-cuda/ggml-cuda.cu b/ggml/src/ggml-cuda/ggml-cuda.cu
index f8c5544bd..b40fcc0d9 100644
--- a/ggml/src/ggml-cuda/ggml-cuda.cu
+++ b/ggml/src/ggml-cuda/ggml-cuda.cu
@@ -3338,6 +3338,174 @@ static int ggml_cuda_mmvq_collect_group(const ggml_cgraph * cgraph, const int st
 }
 
 
+
+// ----- grouped rms_norm (QK-norm class) launch detection ----------------------
+//
+// A decoder layer normalises Q and K with two independent rms_norm+mul pairs of
+// the same ncols/eps over disjoint tensors. Merging them into one launch removes
+// a dispatch without touching arithmetic: the grouped kernel gives every row
+// exactly the thread geometry, reduction and output expression it has in the
+// individual launch (see rms_norm_f32_grouped in norm.cu), so the outputs are
+// byte-identical by construction.
+//
+// The two pairs are separated by the ops that consume the first one (Q's rope),
+// so later members are hoisted to the position of the first. As for the grouped
+// mmvq launch that is legal only when the hoisted writes cannot touch memory any
+// skipped-over node still reads or writes, and the hoisted inputs cannot be
+// written in between; graph-allocator blocks are reused across disjoint
+// lifetimes, so this is checked against actual data ranges.
+
+static bool ggml_cuda_rms_norm_pair_groupable(const ggml_cgraph * cgraph, const int i) {
+    if (i + 1 >= cgraph->n_nodes) {
+        return false;
+    }
+    // stock must run exactly the rms_norm+mul fused path here: the +add variant
+    // is checked first in ggml_cuda_try_fuse and is left alone
+    if (ggml_cuda_can_fuse(cgraph, i, { GGML_OP_RMS_NORM, GGML_OP_MUL, GGML_OP_ADD }, {})) {
+        return false;
+    }
+    if (!ggml_cuda_can_fuse(cgraph, i, { GGML_OP_RMS_NORM, GGML_OP_MUL }, {})) {
+        return false;
+    }
+
+    const ggml_tensor * norm = cgraph->nodes[i];
+    const ggml_tensor * mul  = cgraph->nodes[i + 1];
+    const ggml_tensor * src0 = norm->src[0];
+
+    const ggml_tensor * mul_src = nullptr;
+    if (mul->src[0] == norm) {
+        mul_src = mul->src[1];
+    } else if (mul->src[1] == norm) {
+        mul_src = mul->src[0];
+    } else {
+        return false;
+    }
+
+    if (src0 == nullptr || mul_src == nullptr) {
+        return false;
+    }
+    if (src0->type != GGML_TYPE_F32 || norm->type != GGML_TYPE_F32 ||
+            mul->type != GGML_TYPE_F32 || mul_src->type != GGML_TYPE_F32) {
+        return false;
+    }
+    // 2D only: the grouped kernel constant-folds the channel/sample offsets
+    if (src0->ne[2] != 1 || src0->ne[3] != 1 || mul_src->ne[2] != 1 || mul_src->ne[3] != 1) {
+        return false;
+    }
+    if (norm->ne[2] != 1 || norm->ne[3] != 1 || mul->ne[2] != 1 || mul->ne[3] != 1) {
+        return false;
+    }
+    if (src0->nb[0] != ggml_type_size(src0->type) || mul_src->nb[0] != ggml_type_size(mul_src->type)) {
+        return false;
+    }
+    // dst is written as dst[row*ncols + col]
+    if (!ggml_is_contiguous(mul) || mul->ne[0] != src0->ne[0] || mul->ne[1] != src0->ne[1]) {
+        return false;
+    }
+    float eps = 0.0f;
+    memcpy(&eps, norm->op_params, sizeof(float));
+    if (!(eps >= 0.0f)) {
+        return false;
+    }
+    return true;
+}
+
+static bool ggml_cuda_rms_norm_hoist_legal(const ggml_cgraph * cgraph, const int start, const int j,
+                                           const std::unordered_set<const ggml_tensor *> & done,
+                                           const std::unordered_set<const ggml_tensor *> & done2) {
+    const ggml_tensor * norm = cgraph->nodes[j];
+    const ggml_tensor * mul  = cgraph->nodes[j + 1];
+    const ggml_tensor * in0  = norm->src[0];
+    const ggml_tensor * in1  = (mul->src[0] == norm) ? mul->src[1] : mul->src[0];
+
+    for (int k = start + 2; k < j; ++k) {
+        const ggml_tensor * mid = cgraph->nodes[k];
+        // Nodes already issued earlier in this pass (e.g. the K/V matvecs that a
+        // grouped mmvq launch hoisted) have finished before this launch point, so
+        // neither their reads nor their writes can race the hoisted write.
+        if (ggml_cuda_is_view_or_noop(mid) || done.count(mid) != 0 || done2.count(mid) != 0) {
+            continue;
+        }
+        // hoisted write vs. everything the intermediate reads / writes
+        for (int si = 0; si < GGML_MAX_SRC; ++si) {
+            if (mid->src[si] != nullptr && !ggml_cuda_mmvq_ranges_disjoint(mul, mid->src[si])) {
+                return false;
+            }
+        }
+        if (!ggml_cuda_mmvq_ranges_disjoint(mul, mid)) {
+            return false;
+        }
+        // the intermediate's write vs. the hoisted members' inputs
+        if (!ggml_cuda_mmvq_ranges_disjoint(mid, in0) || !ggml_cuda_mmvq_ranges_disjoint(mid, in1)) {
+            return false;
+        }
+        // the hoisted rms_norm intermediate is never materialised, but a
+        // skipped-over node must not depend on the pair's result either
+        for (int si = 0; si < GGML_MAX_SRC; ++si) {
+            if (mid->src[si] == norm || mid->src[si] == mul) {
+                return false;
+            }
+        }
+    }
+    return true;
+}
+
+static int ggml_cuda_rms_norm_collect_group(const ggml_cgraph * cgraph, const int start,
+                                            ggml_tensor ** norms, ggml_tensor ** muls,
+                                            const std::unordered_set<const ggml_tensor *> & done,
+                                            const std::unordered_set<const ggml_tensor *> & done2) {
+    ggml_tensor * first      = cgraph->nodes[start];
+    const int64_t ncols      = first->src[0]->ne[0];
+    float         eps_first  = 0.0f;
+    memcpy(&eps_first, first->op_params, sizeof(float));
+
+    norms[0] = first;
+    muls[0]  = cgraph->nodes[start + 1];
+    int n    = 1;
+
+    constexpr int scan_window = 12;
+    const int end = std::min(cgraph->n_nodes - 1, start + 2 + scan_window);
+
+    for (int j = start + 2; j < end && n < RMS_NORM_MAX_GROUP_SIZE; ++j) {
+        ggml_tensor * cand = cgraph->nodes[j];
+        if (ggml_cuda_is_view_or_noop(cand) || done.count(cand) != 0 || done2.count(cand) != 0) {
+            continue;
+        }
+        if (cand->op != GGML_OP_RMS_NORM) {
+            continue;
+        }
+        if (cand->src[0]->ne[0] != ncols) {
+            continue;
+        }
+        float eps_cand = 0.0f;
+        memcpy(&eps_cand, cand->op_params, sizeof(float));
+        if (eps_cand != eps_first) {
+            continue;
+        }
+        if (!ggml_cuda_rms_norm_pair_groupable(cgraph, j)) {
+            continue;
+        }
+        if (!ggml_cuda_rms_norm_hoist_legal(cgraph, start, j, done, done2)) {
+            continue;
+        }
+        // members must write disjoint destinations
+        bool overlap = false;
+        for (int m = 0; m < n; ++m) {
+            if (!ggml_cuda_mmvq_ranges_disjoint(muls[m], cgraph->nodes[j + 1])) {
+                overlap = true;
+                break;
+            }
+        }
+        if (overlap) {
+            continue;
+        }
+        norms[n] = cand;
+        muls[n]  = cgraph->nodes[j + 1];
+        ++n;
+    }
+    return n;
+}
+
 // try and fuse nodes and return the number of nodes to skip
 static int ggml_cuda_try_fuse(ggml_backend_cuda_context * cuda_ctx, ggml_cgraph * cgraph, int i) {
 
@@ -4164,6 +4332,10 @@ static void ggml_cuda_graph_evaluate_and_capture(ggml_backend_cuda_context * cud
 
             // Members of grouped mmvq launches already issued earlier in this pass.
             std::unordered_set<const ggml_tensor *> mmvq_grouped_done;
+            // Members of grouped rms_norm launches already issued earlier in this pass.
+            std::unordered_set<const ggml_tensor *> norm_grouped_done;
+            static const bool disable_norm_group = getenv("GGML_CUDA_DISABLE_NORM_GROUP") != nullptr &&
+                                                   std::atoi(getenv("GGML_CUDA_DISABLE_NORM_GROUP"));
             static const bool disable_mmvq_group = getenv("GGML_CUDA_DISABLE_MMVQ_GROUP") != nullptr &&
                                                    std::atoi(getenv("GGML_CUDA_DISABLE_MMVQ_GROUP"));
             const bool mmvq_group_enabled = !disable_mmvq_group && stream_ctx.concurrent_events.empty();
@@ -4224,6 +4396,26 @@ static void ggml_cuda_graph_evaluate_and_capture(ggml_backend_cuda_context * cud
                     continue; // already computed as part of a grouped mmvq launch
                 }
 
+                if (norm_grouped_done.count(node) != 0) {
+                    continue; // already computed as part of a grouped rms_norm launch
+                }
+
+                if (!disable_norm_group && stream_ctx.concurrent_events.empty() &&
+                        node->op == GGML_OP_RMS_NORM && ggml_cuda_rms_norm_pair_groupable(cgraph, i)) {
+                    ggml_tensor * norms[RMS_NORM_MAX_GROUP_SIZE];
+                    ggml_tensor * muls [RMS_NORM_MAX_GROUP_SIZE];
+                    const int n_members = ggml_cuda_rms_norm_collect_group(cgraph, i, norms, muls, norm_grouped_done, mmvq_grouped_done);
+                    if (n_members >= 2) {
+                        ggml_cuda_op_rms_norm_grouped(*cuda_ctx, norms, muls, n_members);
+                        for (int m = 1; m < n_members; ++m) {
+                            norm_grouped_done.insert(norms[m]);
+                            norm_grouped_done.insert(muls[m]);
+                        }
+                        i += 1; // the first pair's mul is consumed by the grouped launch
+                        continue;
+                    }
+                }
+
                 int nodes_to_skip = ggml_cuda_try_fuse(cuda_ctx, cgraph, i);
 
                 if (nodes_to_skip != 0) {
diff --git a/ggml/src/ggml-cuda/norm.cu b/ggml/src/ggml-cuda/norm.cu
index 09d9f3a7d..5ca960643 100644
--- a/ggml/src/ggml-cuda/norm.cu
+++ b/ggml/src/ggml-cuda/norm.cu
@@ -475,6 +475,154 @@ void ggml_cuda_op_group_norm(ggml_backend_cuda_context & ctx, ggml_tensor * dst)
     group_norm_f32_cuda(src0_d, dst_d, num_groups * src0->ne[3], eps, group_size, ggml_nelements(src0), stream);
 }
 
+
+// ----- grouped rms_norm launch: several independent rms_norm+mul pairs --------
+//
+// A decoder layer normalises Q and K with two separate rms_norm+mul launches
+// over disjoint tensors. Every row's work is independent of every other row, so
+// the row ranges of several such ops can be concatenated into ONE grid: a block
+// first routes itself to its segment (x / mul / dst base pointer + local row
+// index, all integer work), then performs exactly the per-row thread geometry,
+// reduction and output expression of the individual rms_norm_f32<block_size,
+// true> launch it replaces, so the results are byte-identical by construction.
+//
+// Only the 2D case (ne02 == ne03 == 1 for both the input and the mul operand) is
+// provided, which is the shape the graph-side detector groups; there the stock
+// channel/sample offsets are all zero and the dst offset reduces to row*ncols.
+
+struct rms_norm_grouped_args {
+    const float * x[RMS_NORM_MAX_GROUP_SIZE];
+    const float * mul[RMS_NORM_MAX_GROUP_SIZE];
+    float *       dst[RMS_NORM_MAX_GROUP_SIZE];
+    int64_t       stride_row[RMS_NORM_MAX_GROUP_SIZE];
+    int64_t       mul_stride_row[RMS_NORM_MAX_GROUP_SIZE];
+    uint3         mul_ncols_packed[RMS_NORM_MAX_GROUP_SIZE];
+    uint3         mul_nrows_packed[RMS_NORM_MAX_GROUP_SIZE];
+    // exclusive prefix sums of segment row counts; entries past the actual group
+    // size are padded with the total so the segment scan ignores them
+    uint32_t      seg_end[RMS_NORM_MAX_GROUP_SIZE];
+};
+
+template <int block_size>
+static __global__ void rms_norm_f32_grouped(const rms_norm_grouped_args args, const int ncols, const float eps) {
+    ggml_cuda_pdl_lc();
+
+    // Segment routing: uniform across the block (depends only on blockIdx.x),
+    // integer-only, and the sole difference from the individual launch.
+    uint32_t seg       = 0;
+    uint32_t seg_start = 0;
+#pragma unroll
+    for (int s = 0; s < RMS_NORM_MAX_GROUP_SIZE - 1; ++s) {
+        if (blockIdx.x >= args.seg_end[s]) {
+            seg       = s + 1;
+            seg_start = args.seg_end[s];
+        }
+    }
+
+    const int row = (int) (blockIdx.x - seg_start);
+    const int tid = threadIdx.x;
+
+    const float * x   = args.x[seg]   + (int64_t) row * args.stride_row[seg];
+    float *       dst = args.dst[seg] + (int64_t) row * ncols;
+
+    const uint32_t mul_row = fastmodulo((uint32_t) row, args.mul_nrows_packed[seg]);
+    const float *  mul     = args.mul[seg] + (int64_t) mul_row * args.mul_stride_row[seg];
+
+    float tmp = 0.0f; // partial sum for thread in warp
+
+    ggml_cuda_pdl_sync();
+    for (int col = tid; col < ncols; col += block_size) {
+        const float xi = x[col];
+        tmp += xi * xi;
+    }
+
+    // sum up partial sums
+    extern __shared__ float s_sum[];
+    tmp = block_reduce<block_reduce_method::SUM, block_size>(tmp, s_sum);
+
+    const float mean  = tmp / ncols;
+    const float scale = rsqrtf(mean + eps);
+
+    for (int col = tid; col < ncols; col += block_size) {
+        const int mul_col = fastmodulo(col, args.mul_ncols_packed[seg]);
+        dst[col]          = scale * x[col] * mul[mul_col];
+    }
+}
+
+void ggml_cuda_op_rms_norm_grouped(ggml_backend_cuda_context & ctx,
+                                   ggml_tensor * const * norms, ggml_tensor * const * muls, int n_nodes) {
+    GGML_ASSERT(n_nodes >= 2 && n_nodes <= RMS_NORM_MAX_GROUP_SIZE);
+
+    cudaStream_t stream = ctx.stream();
+
+    const ggml_tensor * src0_first = norms[0]->src[0];
+    const int64_t       ncols      = src0_first->ne[0];
+
+    float eps = 0.0f;
+    memcpy(&eps, norms[0]->op_params, sizeof(float));
+    GGML_ASSERT(eps >= 0.0f);
+
+    rms_norm_grouped_args args = {};
+    uint32_t total_rows = 0;
+
+    for (int m = 0; m < n_nodes; ++m) {
+        const ggml_tensor * norm = norms[m];
+        const ggml_tensor * mul  = muls[m];
+        const ggml_tensor * src0 = norm->src[0];
+
+        const ggml_tensor * mul_src = nullptr;
+        if (mul->src[0] == norm) {
+            mul_src = mul->src[1];
+        } else if (mul->src[1] == norm) {
+            mul_src = mul->src[0];
+        } else {
+            GGML_ASSERT(false);
+        }
+
+        float eps_m = 0.0f;
+        memcpy(&eps_m, norm->op_params, sizeof(float));
+        GGML_ASSERT(eps_m == eps);
+
+        GGML_ASSERT(src0->type == GGML_TYPE_F32 && norm->type == GGML_TYPE_F32);
+        GGML_ASSERT(mul->type == GGML_TYPE_F32 && mul_src->type == GGML_TYPE_F32);
+        GGML_ASSERT(src0->ne[0] == ncols);
+        GGML_ASSERT(src0->ne[2] == 1 && src0->ne[3] == 1);
+        GGML_ASSERT(mul_src->ne[2] == 1 && mul_src->ne[3] == 1);
+
+        const size_t ts0 = ggml_type_size(src0->type);
+        GGML_ASSERT(src0->nb[0] == ts0);
+        const size_t ts_mul = ggml_type_size(mul_src->type);
+        GGML_ASSERT(mul_src->nb[0] == ts_mul);
+
+        args.x[m]                = (const float *) src0->data;
+        args.mul[m]              = (const float *) mul_src->data;
+        args.dst[m]              = (float *) mul->data;
+        args.stride_row[m]       = src0->nb[1] / ts0;
+        args.mul_stride_row[m]   = mul_src->nb[1] / ts_mul;
+        args.mul_ncols_packed[m] = init_fastdiv_values((uint32_t) mul_src->ne[0]);
+        args.mul_nrows_packed[m] = init_fastdiv_values((uint32_t) mul_src->ne[1]);
+
+        total_rows     += (uint32_t) src0->ne[1];
+        args.seg_end[m] = total_rows;
+    }
+    for (int m = n_nodes; m < RMS_NORM_MAX_GROUP_SIZE; ++m) {
+        args.seg_end[m] = total_rows; // padding: the segment scan never selects these
+    }
+
+    const dim3 blocks_num(total_rows, 1, 1);
+    if (ncols < 1024) {
+        const dim3 block_dims(256, 1, 1);
+        const ggml_cuda_kernel_launch_params launch_params =
+            ggml_cuda_kernel_launch_params{blocks_num, block_dims, block_dims.x > WARP_SIZE ? 32 * sizeof(float) : 0, stream};
+        ggml_cuda_kernel_launch(rms_norm_f32_grouped<256>, launch_params, args, (int) ncols, eps);
+    } else {
+        const dim3 block_dims(1024, 1, 1);
+        const ggml_cuda_kernel_launch_params launch_params =
+            ggml_cuda_kernel_launch_params{blocks_num, block_dims, block_dims.x > WARP_SIZE ? 32 * sizeof(float) : 0, stream};
+        ggml_cuda_kernel_launch(rms_norm_f32_grouped<1024>, launch_params, args, (int) ncols, eps);
+    }
+}
+
 void ggml_cuda_op_rms_norm(ggml_backend_cuda_context & ctx, ggml_tensor * dst) {
     const ggml_tensor * src0 = dst->src[0];
     const float * src0_d = (const float *) src0->data;
diff --git a/ggml/src/ggml-cuda/norm.cuh b/ggml/src/ggml-cuda/norm.cuh
index a74f63767..820d62258 100644
--- a/ggml/src/ggml-cuda/norm.cuh
+++ b/ggml/src/ggml-cuda/norm.cuh
@@ -4,6 +4,17 @@ void ggml_cuda_op_norm(ggml_backend_cuda_context & ctx, ggml_tensor * dst);
 
 void ggml_cuda_op_group_norm(ggml_backend_cuda_context & ctx, ggml_tensor * dst);
 
+// Maximum number of independent rms_norm(+mul) ops that may merge into a single
+// grouped launch.
+#define RMS_NORM_MAX_GROUP_SIZE 4
+
+// Launch several independent rms_norm+mul pairs (same ncols/eps, 2D operands) as
+// ONE kernel. Per-row arithmetic is identical to the individual launches: only
+// the (x, mul, dst) base pointers and the local row index depend on the group
+// segment, and both are integer-only.
+void ggml_cuda_op_rms_norm_grouped(ggml_backend_cuda_context & ctx,
+                                   ggml_tensor * const * norms, ggml_tensor * const * muls, int n_nodes);
+
 void ggml_cuda_op_rms_norm(ggml_backend_cuda_context & ctx, ggml_tensor * dst);
 
 void ggml_cuda_op_rms_norm_fused(ggml_backend_cuda_context & ctx, ggml_tensor * dst, ggml_tensor * mul_tensor);
