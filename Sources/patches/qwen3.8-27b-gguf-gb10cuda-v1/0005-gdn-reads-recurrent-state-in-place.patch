@@ -3369,6 +3553,10 @@ static int ggml_cuda_try_fuse(ggml_backend_cuda_context * cuda_ctx, ggml_cgraph
         ggml_cuda_gdn_act_match act;
         const bool have_act = ggml_cuda_gdn_act_fold_enabled() && ggml_cuda_try_gdn_act_fusion(cgraph, i, act);
 
+        ggml_cuda_gated_delta_net_state_gather gather;
+        const ggml_tensor *                    gather_node = nullptr;
+        const bool have_gather = ggml_cuda_try_gdn_state_gather(cgraph, i, gather, &gather_node);
+
         ggml_cuda_gated_delta_net_fused_cache fused_state_cpy;
         const int nodes_to_skip = ggml_cuda_try_gdn_cache_fusion(cgraph, i, fused_state_cpy);
         if (nodes_to_skip > 0) {
@@ -3376,14 +3564,19 @@ static int ggml_cuda_try_fuse(ggml_backend_cuda_context * cuda_ctx, ggml_cgraph
