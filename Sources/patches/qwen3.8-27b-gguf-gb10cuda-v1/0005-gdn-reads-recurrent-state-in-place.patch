diff --git a/ggml/src/ggml-cuda/ggml-cuda.cu b/ggml/src/ggml-cuda/ggml-cuda.cu
index 6361ca0e..437d27ac 100644
--- a/ggml/src/ggml-cuda/ggml-cuda.cu
+++ b/ggml/src/ggml-cuda/ggml-cuda.cu
@@ -2914,6 +2914,190 @@ static bool ggml_cuda_gdn_act_producer_folded(const ggml_cgraph * cgraph, int i)
     return false;
 }
 
+// ---------------------------------------------------------------------------
+// gated_delta_net recurrent-state gather fold
+//
+// build_rs() selects this sequence's state row out of the persistent recurrent buffer with a
+// get_rows, and the gated_delta_net reads the gathered copy. At batch-1 decode that gather
+// moves the layer's ENTIRE state - H * S_v * S_v floats, 3 MB on a 48-head 128-wide layer -
+// in order to pick ONE row, and every block then reads back exactly the bytes it would have
+// read from the original.
+//
+// The gather is pure indirection, so the kernel can do it: each block resolves its own row
+// with a single scalar load from the index tensor and reads the state in place. Bit-exact by
+// construction - the bytes are the same bytes, in the same order, with no arithmetic anywhere
+// near it - and it removes one copy and one launch per linear-attention layer.
+// ---------------------------------------------------------------------------
+
+// 0 = off (run the get_rows), 1 = elide it and resolve the row in-kernel
+static int ggml_cuda_gdn_state_gather_mode() {
+    static const int mode = [] {
+        const char * e = getenv("GGML_GDN_STATE_GATHER");
+        return e == nullptr ? 1 : std::atoi(e);
+    }();
+    return mode;
+}
+
+// window (in nodes) searched between a build_rs gather and the gated_delta_net that consumes it
+static constexpr int GGML_CUDA_GDN_RS_WINDOW = 160;
+
+// every consumer of the elided gather - and of the view chain that carries it to the gdn - must
+// be the gdn itself, because eliding the copy means those bytes are never written at all.
+static bool ggml_cuda_gdn_chain_private(const ggml_cgraph * cgraph, const ggml_tensor * gdn,
+                                        const ggml_tensor * from, const ggml_tensor * to) {
+    const ggml_tensor * chain[8];
+    int                 n = 0;
+    for (const ggml_tensor * t = to; t != nullptr && n < 8; t = t->view_src) {
+        chain[n++] = t;
+        if (t == from) {
+            break;
+        }
+    }
+    if (n == 0 || chain[n - 1] != from) {
+        return false;
+    }
+    for (int c = 0; c < n; ++c) {
+        if (chain[c]->flags & GGML_TENSOR_FLAG_OUTPUT) {
+            return false;
+        }
+    }
+    for (int j = 0; j < cgraph->n_nodes; ++j) {
+        const ggml_tensor * node = cgraph->nodes[j];
+        if (node == gdn) {
+            continue;
+        }
+        bool is_chain = false;
+        for (int c = 0; c < n; ++c) {
+            is_chain = is_chain || (node == chain[c]);
+        }
+        if (is_chain) {
+            continue;
+        }
+        for (int sj = 0; sj < GGML_MAX_SRC; ++sj) {
+            for (int c = 0; c < n; ++c) {
+                if (node->src[sj] == chain[c]) {
+                    return false;
+                }
+            }
+        }
+    }
+    return true;
+}
+
+static bool ggml_cuda_try_gdn_state_gather(const ggml_cgraph *                       cgraph,
+                                           int                                       gdn_idx,
+                                           ggml_cuda_gated_delta_net_state_gather &  g,
+                                           const ggml_tensor **                      gather_node) {
+    if (ggml_cuda_gdn_state_gather_mode() == 0) {
+        return false;
+    }
+
+    const ggml_tensor * gdn = cgraph->nodes[gdn_idx];
+    if (gdn->op != GGML_OP_GATED_DELTA_NET) {
+        return false;
+    }
+
+    const ggml_tensor * src_v     = gdn->src[2];
+    const ggml_tensor * src_state = gdn->src[5];
+    if (src_v == nullptr || src_state == nullptr) {
+        return false;
+    }
+
+    const int64_t S_v    = src_v->ne[0];
+    const int64_t H      = src_v->ne[1];
+    const int64_t n_seqs = src_v->ne[3];
+
+    // Decode only, for both halves of the trade.
+    //
+    // VALUE: what the fold removes is one gather per LAYER, not per token. At n_tokens == 1 that
+    // gather is a whole extra pass over the layer's state for a single decoded token; across a
+    // 512-token prefill ubatch the same gather is amortised over 512 tokens and is worth nothing.
+    //
+    // SOUNDNESS: at n_tokens > 1 the kernel also takes its keep_rs_t path, writing rollback
+    // snapshots into the recurrent buffer DURING the token loop - the same buffer the fold would
+    // now have blocks reading from, with no ordering between them. Measured: enabled at prefill
+    // the gate-shape perplexity moved 2.9608 -> 2.9655 (+0.159%), while the decode shape
+    // (-b 512 -ub 1) stayed identical in every digit. Declining the fold where it pays nothing
+    // keeps every prefill kernel bit-identical to the parent frontier.
+    if (src_v->ne[2] != 1) {
+        return false;
+    }
+
+    const ggml_tensor * gr = ggml_cuda_gdn_writer(src_state);
+    if (gr == nullptr || gr->op != GGML_OP_GET_ROWS || gr->type != GGML_TYPE_F32 ||
+        !ggml_is_contiguous(gr) || (gr->flags & GGML_TENSOR_FLAG_OUTPUT)) {
+        return false;
+    }
+
+    const ggml_tensor * states = gr->src[0];
+    const ggml_tensor * idx    = gr->src[1];
+    if (states == nullptr || idx == nullptr || states->type != GGML_TYPE_F32 ||
+        idx->type != GGML_TYPE_I32 || !ggml_is_contiguous(states) || !ggml_is_contiguous(idx) ||
+        states->data == nullptr || idx->data == nullptr) {
+        return false;
+    }
+
+    // exactly one gathered row per sequence, and a row is exactly this layer's state
+    if (states->ne[0] != H * S_v * S_v || gr->ne[0] != states->ne[0] || gr->ne[1] != n_seqs ||
+        ggml_nelements(idx) != n_seqs || ggml_nelements(gr) != states->ne[0] * n_seqs) {
+        return false;
+    }
+
+    // the gather sits at ITS position in the graph and the kernel reads at the gdn's, so
+    // nothing may write into the recurrent buffer in between
+    int gr_idx = -1;
+    const int lo = gdn_idx - GGML_CUDA_GDN_RS_WINDOW < 0 ? 0 : gdn_idx - GGML_CUDA_GDN_RS_WINDOW;
+    for (int j = gdn_idx - 1; j >= lo; --j) {
+        if (cgraph->nodes[j] == gr) {
+            gr_idx = j;
+            break;
+        }
+    }
+    if (gr_idx < 0) {
+        return false;
+    }
+    for (int j = gr_idx + 1; j < gdn_idx; ++j) {
+        const ggml_tensor * n = cgraph->nodes[j];
+        if (ggml_cuda_is_view_or_noop(n)) {
+            continue;
+        }
+        if (n->buffer == states->buffer) {
+            return false;
+        }
+    }
+
+    if (!ggml_cuda_gdn_chain_private(cgraph, gdn, gr, src_state)) {
+        return false;
+    }
+
+    g.base       = (const float *) states->data;
+    g.idx        = (const int32_t *) idx->data;
+    g.row_stride = states->ne[0];
+    *gather_node = gr;
+    return true;
+}
+
+// is node i a build_rs gather that a downstream gated_delta_net will perform itself?
+static bool ggml_cuda_gdn_state_gather_folded(const ggml_cgraph * cgraph, int i) {
+    const ggml_tensor * node = cgraph->nodes[i];
+    if (node->op != GGML_OP_GET_ROWS) {
+        return false;
+    }
+    const int hi = i + GGML_CUDA_GDN_RS_WINDOW < cgraph->n_nodes ? i + GGML_CUDA_GDN_RS_WINDOW
+                                                                 : cgraph->n_nodes - 1;
+    for (int j = i + 1; j <= hi; ++j) {
+        if (cgraph->nodes[j]->op != GGML_OP_GATED_DELTA_NET) {
+            continue;
+        }
+        ggml_cuda_gated_delta_net_state_gather g;
+        const ggml_tensor *                    gr = nullptr;
+        if (ggml_cuda_try_gdn_state_gather(cgraph, j, g, &gr) && gr == node) {
+            return true;
+        }
+    }
+    return false;
+}
+
