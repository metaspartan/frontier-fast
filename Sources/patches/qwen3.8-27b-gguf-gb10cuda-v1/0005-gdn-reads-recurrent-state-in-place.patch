diff --git a/ggml/src/ggml-cuda/gated_delta_net.cuh b/ggml/src/ggml-cuda/gated_delta_net.cuh
index 272318c1..04784dd2 100644
--- a/ggml/src/ggml-cuda/gated_delta_net.cuh
+++ b/ggml/src/ggml-cuda/gated_delta_net.cuh
@@ -17,6 +17,22 @@ struct ggml_cuda_gated_delta_net_act_fold {
     const float * b_raw   = nullptr;
 };
 
+// recurrent-state gather fold.
+//
+// build_rs() hands the kernel this sequence's state row by GATHERING it out of the persistent
+// recurrent buffer with a get_rows. At batch-1 decode that is a copy of the layer's entire
+// state - H * S_v * S_v floats, 3 MB on a 48-head 128-wide layer - in order to select ONE row,
+// and the gated_delta_net then reads the copy once and never looks at it again.
+//
+// The copy is pure indirection: the kernel can resolve the row itself with a single scalar load
+// and read the state in place. Every block reads exactly the bytes the copy would have handed
+// it, so this is bit-exact by construction, and it removes both the copy's traffic and its launch.
+struct ggml_cuda_gated_delta_net_state_gather {
+    const float *   base       = nullptr; // whole recurrent state buffer
+    const int32_t * idx        = nullptr; // device-side row index per sequence (build_rs s_copy_main)
+    int64_t         row_stride = 0;       // elements between state rows
+};
+
 void ggml_cuda_op_gated_delta_net(ggml_backend_cuda_context & ctx, ggml_tensor * dst);
 
 // same op, but writes the snapshot(s) into the cache instead of dst (see ggml_cuda_try_gdn_cache_fusion)
@@ -25,5 +41,6 @@ void ggml_cuda_op_gated_delta_net_fused_cache(ggml_backend_cuda_context & ctx, g
 
 // same op with either/both of the state-cpy fusion and the activation fold applied
