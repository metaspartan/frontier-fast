+    // Multi-token prediction is on by default for a model that carries its own head.
+    //
+    // Qwen3.8 27B ships a trained NextN/MTP head inside the same GGUF
+    // (`qwen35.nextn_predict_layers = 1`, tensors under blk.64), and llama.cpp
+    // can run it against the target model itself - there is no second model to
+    // download and no draft weights to load. It just never runs unless a
+    // speculative type asks for it: `mparams.load_mtp` and the draft context's
+    // LLAMA_CONTEXT_TYPE_MTP are both derived from `params.speculative.types`,
+    // so a server started without `--spec-type` reads the trunk only and spends
+    // one full pass over 17 GB of weights per generated token.
+    //
+    // The draft depth is 2 because that is what GB10 measures. Sweeping n_max
+    // over a paired benchmark, two passes per depth, ascending and descending:
+    //
+    //   depth  decode tok/s  acceptance  mean accepted length
+    //     1       17.879       78.6%           1.786
+    //     2       21.837       66.9%           2.338
+    //     3       21.575       56.0%           2.681
+    //     4       21.035       43.9%           2.756
+    //
+    // The single trained head re-run autoregressively loses acceptance at every
+    // extra step, so the useful depth is set by how cheap the wider verify pass
+    // is. A GB10 decode pass is bandwidth-bound on the whole weight set, so
+    // verifying a second position costs much less than it returns; past two the
+    // acceptance decay outruns it. This is hardware-specific - the same patch on
+    // the Radeon AI PRO R9700 measures depth 1 fastest, because there the head
+    // is a larger fraction of a much cheaper trunk pass.
+    //
+    // Server only: llama-perplexity and the other tools keep decoding exactly as
+    // they did, so the correctness gates measure an untouched engine.
+    if (ctx_arg.ex == LLAMA_EXAMPLE_SERVER &&
+            spec_types_is_default(params) &&
+            !params.speculative.has_dft() &&
+            params.speculative.draft.n_max == common_params_speculative_draft().n_max &&
+            model_ships_nextn_head(params.model.path)) {
+        params.speculative.types       = { COMMON_SPECULATIVE_TYPE_DRAFT_MTP };
+        params.speculative.draft.n_max = 2;
+
+        LOG_INF("%s: model ships a NextN head - enabling MTP self-speculation "
+                "(equivalent to --spec-type draft-mtp --spec-draft-n-max %d)\n",
+                __func__, params.speculative.draft.n_max);
+    }
+
     if (params.escape) {
