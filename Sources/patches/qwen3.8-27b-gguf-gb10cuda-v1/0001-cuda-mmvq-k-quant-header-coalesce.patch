+
+// The 16 bytes at the start of a block_q4_K / block_q5_K are a contiguous
+// header: ggml_half2 dm followed by the twelve 6-bit-packed scale/min bytes.
+// Fetching it with one 128-bit load and picking the needed words out of
+// registers replaces three to four narrow global loads per super-block, each of
+// which every thread of the lane group issued for the same bytes. These helpers
+// do the register-side selection; the arithmetic that consumes them is
+// unchanged, so results are bit-identical.
+static __device__ __forceinline__ uint16_t ggml_cuda_k_hdr_scale16(
+        const int hy, const int hz, const int hw, const int k) {
+    const int s = k < 2 ? hy : (k < 4 ? hz : hw);
+    return (uint16_t) ((k & 1) ? (((unsigned int) s) >> 16) : ((unsigned int) s));
+}
+
+static __device__ __forceinline__ half2 ggml_cuda_k_hdr_dm(const int hx) {
+    return __halves2half2(__ushort_as_half((unsigned short)  (((unsigned int) hx)        & 0xffff)),
+                          __ushort_as_half((unsigned short)  (((unsigned int) hx) >> 16)         ));
+}
