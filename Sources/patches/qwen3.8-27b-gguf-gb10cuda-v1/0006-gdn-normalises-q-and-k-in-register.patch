+    // that is not the shape in front of us, decline instead of reaching for bytes we cannot keep.
+    const ggml_tensor * root = ggml_cuda_gdn_view_root(qr);
+    if (root == nullptr || root != ggml_cuda_gdn_view_root(kr) ||
+        root != ggml_cuda_gdn_view_root(src_v)) {
