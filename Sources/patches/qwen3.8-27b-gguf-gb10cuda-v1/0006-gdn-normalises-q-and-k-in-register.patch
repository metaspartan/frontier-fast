+// l2-norm fold: the kernel normalises q and k itself.
+//
+// A Qwen3.5-style linear-attention layer l2-normalises the convolved q and k before the
+// gated_delta_net consumes them. Each l2_norm_f32<32> launch is ONE workgroup per k-head -
+// 16 workgroups of a single warp reading 8 KB - so the pair costs about as much dispatch
+// latency as it does work, twice per layer.
+//
+// Price this on ALU, not on the grid ratio. The grid ratio is far worse than it looks
+// (gated_delta_net runs 1536 workgroups of 4 warps against l2_norm's 16 single-warp ones,
+// so each reduction is recomputed 384x, not 3x) and it is also the wrong question, because
+// the recomputation needs no loads: a gated_delta_net warp ALREADY holds the full S_v-element
+// q and k in q_reg/k_reg, fetched with i = r*warp_size + lane - which is exactly the
+// element-to-lane mapping l2_norm_f32<32> uses (col = tid; col += 32) - and at block_size ==
+// WARP_SIZE its block_reduce<SUM> degenerates to the same warp_reduce_sum. So the fold
+// reproduces the kernel it replaces expression-for-expression on values already resident:
+// no extra traffic, and bit-exact by construction rather than by tolerance.
+struct ggml_cuda_gated_delta_net_l2_fold {
+    const float * q_raw = nullptr; // pre-normalisation q (the l2_norm's own src)
+    const float * k_raw = nullptr;
+    int64_t       s1    = 0;       // raw strides in elements; q and k are required to share them
+    int64_t       s2    = 0;
+    int64_t       s3    = 0;
+    float         eps   = 0.0f;
+};
+
 void ggml_cuda_op_gated_delta_net(ggml_backend_cuda_context & ctx, ggml_tensor * dst);
 
 // same op, but writes the snapshot(s) into the cache instead of dst (see ggml_cuda_try_gdn_cache_fusion)
@@ -43,4 +68,5 @@ void ggml_cuda_op_gated_delta_net_fused_cache(ggml_backend_cuda_context & ctx, g
