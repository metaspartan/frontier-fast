diff --git a/ggml/src/ggml-cuda/ggml-cuda.cu b/ggml/src/ggml-cuda/ggml-cuda.cu
index 437d27ac..f7f2f57a 100644
--- a/ggml/src/ggml-cuda/ggml-cuda.cu
+++ b/ggml/src/ggml-cuda/ggml-cuda.cu
@@ -3098,6 +3098,169 @@ static bool ggml_cuda_gdn_state_gather_folded(const ggml_cgraph * cgraph, int i)
     return false;
 }
 
+// ---------------------------------------------------------------------------
+// gated_delta_net l2-norm fold
+//
+// build_layer_attn_linear l2-normalises the convolved q and k before the gated_delta_net
+// consumes them. Both launches are one workgroup per k-head - 16 single-warp workgroups
+// reading 8 KB - so at 2.05 us each they are dispatch latency far more than work, and there
+// are 96 of them per decoded token.
+//
+// The published decline of this fold priced it by the section 6b grid ratio ("16 workgroups
+// against 48, so the fold recomputes each reduction 3x"). Both halves are wrong. The real
+// ratio is much worse - gated_delta_net launches grid(H, n_seqs, S_v/4) with 4 warps a block,
+// 6144 warps against l2_norm's 16, so 384x - and the ratio is the wrong question anyway,
+// because a grid ratio prices RE-READING the producer's input and here there is nothing to
+// re-read: the gated_delta_net warp already holds the entire S_v-element q and k in registers,
+// loaded with exactly the element-to-lane mapping l2_norm_f32<32> uses. What the fold actually
+// costs is 2 warp_reduce_sums and 2 rsqrts per warp on resident values.
+// ---------------------------------------------------------------------------
+
+// 0 = off (run both l2_norms), 1 = fold them into the gated_delta_net
+static int ggml_cuda_gdn_l2_fold_mode() {
+    static const int mode = [] {
+        const char * e = getenv("GGML_GDN_L2_FOLD");
+        return e == nullptr ? 1 : std::atoi(e);
+    }();
+    return mode;
+}
+
+static constexpr int GGML_CUDA_GDN_L2_WINDOW = 64;
+
+// the tensor that owns the bytes, regardless of view offset
+static const ggml_tensor * ggml_cuda_gdn_view_root(const ggml_tensor * t) {
+    while (t != nullptr && t->view_src != nullptr) {
+        t = t->view_src;
+    }
+    return t;
+}
+
+static bool ggml_cuda_try_gdn_l2_fold(const ggml_cgraph *                  cgraph,
+                                      int                                  gdn_idx,
+                                      ggml_cuda_gated_delta_net_l2_fold &  f,
+                                      const ggml_tensor **                 skip_q,
+                                      const ggml_tensor **                 skip_k) {
+    if (ggml_cuda_gdn_l2_fold_mode() == 0) {
+        return false;
+    }
+
+    const ggml_tensor * gdn = cgraph->nodes[gdn_idx];
+    if (gdn->op != GGML_OP_GATED_DELTA_NET) {
+        return false;
+    }
+
+    const ggml_tensor * src_q = gdn->src[0];
+    const ggml_tensor * src_k = gdn->src[1];
+    const ggml_tensor * src_v = gdn->src[2];
+    if (src_q == nullptr || src_k == nullptr || src_v == nullptr) {
+        return false;
+    }
+
+    const int64_t S_v = src_v->ne[0];
+
+    // Decode only, for the same reason the activation fold is: at prefill the kernel loops
+    // over n_tokens INSIDE each block, so the fold would recompute both reductions once per
+    // (token, column block) rather than once per (token, head), while the two launches it
+    // removes are amortised over the whole ubatch and are worth nothing there.
+    if (src_v->ne[2] != 1) {
+        return false;
+    }
+
+    const ggml_tensor * l2q = ggml_cuda_gdn_writer(src_q);
+    const ggml_tensor * l2k = ggml_cuda_gdn_writer(src_k);
+    if (l2q == nullptr || l2k == nullptr || l2q == l2k ||
+        l2q->op != GGML_OP_L2_NORM || l2k->op != GGML_OP_L2_NORM ||
+        l2q->type != GGML_TYPE_F32 || l2k->type != GGML_TYPE_F32 ||
+        (l2q->flags & GGML_TENSOR_FLAG_OUTPUT) || (l2k->flags & GGML_TENSOR_FLAG_OUTPUT)) {
+        return false;
+    }
+
+    const ggml_tensor * qr = l2q->src[0];
+    const ggml_tensor * kr = l2k->src[0];
+    if (qr == nullptr || kr == nullptr || qr->type != GGML_TYPE_F32 || kr->type != GGML_TYPE_F32 ||
+        qr->data == nullptr || kr->data == nullptr) {
+        return false;
+    }
+
+    // The fold reproduces l2_norm_f32<32>: one warp per row, reducing ncols elements as
+    // col = r*WARP_SIZE + lane. That is the gated_delta_net warp's own q_reg/k_reg mapping
+    // only when the normalised row is exactly S_v wide, and only while l2_norm still picks
+    // its single-warp kernel (it switches to a 1024-thread block reduction at 1024 columns).
+    if (l2q->ne[0] != S_v || l2k->ne[0] != S_v || S_v >= 1024 || S_v < WARP_SIZE ||
+        (S_v % WARP_SIZE) != 0) {
+        return false;
+    }
+
+    // the gdn indexes q and k with the normalised tensors' shape, so the raw ones must agree
+    if (!std::equal(qr->ne, qr->ne + GGML_MAX_DIMS, kr->ne) ||
+        !std::equal(qr->ne, qr->ne + GGML_MAX_DIMS, src_q->ne) ||
+        !std::equal(qr->ne, qr->ne + GGML_MAX_DIMS, src_k->ne)) {
+        return false;
+    }
+
+    // raw q and k must be contiguous rows and share strides (the kernel keeps one stride set)
