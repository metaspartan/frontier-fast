+    f.q_raw = (const float *) qr->data;
+    f.k_raw = (const float *) kr->data;
+    f.s1    = (int64_t) (qr->nb[1] / sizeof(float));
+    f.s2    = (int64_t) (qr->nb[2] / sizeof(float));
