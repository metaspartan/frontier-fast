@@ -512,8 +512,89 @@ class RotatingKVCache(_BaseCache):
     def update_and_fetch(self, keys, values):
         if keys.shape[2] == 1:
             return self._update_in_place(keys, values)
+        if (
+            2 <= keys.shape[2] <= 8
