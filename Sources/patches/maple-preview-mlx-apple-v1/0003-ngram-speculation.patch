         return self._update_concat(keys, values)
 
+    # --- speculative (loose-draft) support -------------------------------
+    # A 2-token verify step [certain, draft] commits only the certain token
+    # into the ring (the stock S=1 in-place write) and carries the draft's
+    # K/V as loose tensors appended to the fetched view. Accepting the draft
+    # commits the loose slot exactly as the stock S=1 write would have;
+    # rejecting it drops the loose tensors and leaves the ring untouched, so
+    # no rollback (and no clobbered window slot) can ever occur. Attention
+    # semantics match processing the two tokens one at a time through the
+    # stock path; make_mask supplies the rotation-aware (2, size+1) mask.
+
+    spec_mode = False
+    _loose_k = None
+    _loose_v = None
+
+    def _spec_ready(self):
+        return (
+            self.keys is not None
+            and self.offset >= self.max_size
+            and self.max_size == self.keys.shape[2]
+        )
+
+    def _spec_update(self, keys, values):
+        k, v = self._update_in_place(keys[..., :1, :], values[..., :1, :])
+        self._loose_k = keys[..., 1:, :]
+        self._loose_v = values[..., 1:, :]
+        return (
+            mx.concatenate([k, self._loose_k], axis=2),
+            mx.concatenate([v, self._loose_v], axis=2),
+        )
+
+    def _spec_mask(self, n_loose):
+        # Called at model entry, before the certain token's write. Column
+        # layout of the fetched view: max_size ring slots then the loose
+        # drafts in order. Query row i sits at position p+i (row 0 is the
+        # certain token at p). It must see: the ring minus its i
+        # out-of-window oldest slots (the slots that i further stock S=1
+        # writes would have evicted, starting at the one past the certain
+        # token's own write), and loose drafts j <= i-1 plus nothing newer —
+        # exactly what 1+n consecutive stock S=1 steps would attend to.
+        size = self.max_size
+        w = self.keep if self._idx == size else self._idx
+        rows = []
+        cols = mx.arange(size + n_loose)
+        span = size - self.keep
+        for i in range(1 + n_loose):
+            ring_ok = cols < size
+            for j in range(i):
+                dead = self.keep + ((w - self.keep + 1 + j) % span)
+                ring_ok = ring_ok & (cols != dead)
+            loose_ok = (cols >= size) & (cols < size + i)
+            rows.append(ring_ok | loose_ok)
+        return mx.stack(rows)
+
+    def commit_spec(self, n=None):
+        if self._loose_k is None:
+            return
+        take = self._loose_k.shape[2] if n is None else n
+        for i in range(take):
+            if self._idx == self.max_size:
+                self._idx = self.keep
+            self.keys[..., self._idx : self._idx + 1, :] = self._loose_k[
+                ..., i : i + 1, :
+            ]
+            self.values[..., self._idx : self._idx + 1, :] = self._loose_v[
+                ..., i : i + 1, :
+            ]
+            self.offset += 1
+            self._idx += 1
+        self._loose_k = None
+        self._loose_v = None
+
+    def discard_spec(self):
+        self._loose_k = None
+        self._loose_v = None
+
     def size(self):
         return min(self.offset, self.max_size)
 
@@ -554,6 +635,8 @@ class RotatingKVCache(_BaseCache):
