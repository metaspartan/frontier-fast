+# Prompt-lookup n-gram proposer for speculative greedy decoding: remember the
+# token that followed each recent n-gram (longest n wins, most recent
+# occurrence wins) over prompt + generated context.
+_NGRAM_NS = (4, 3, 2)
+
+
+def _ngram_build(ctx):
+    tables = {n: {} for n in _NGRAM_NS}
+    for i in range(1, len(ctx)):
+        t = ctx[i]
+        for n in _NGRAM_NS:
+            if i >= n:
+                tables[n][tuple(ctx[i - n : i])] = t
+    return tables
+
+
+def _ngram_observe(tables, ctx):
+    length = len(ctx)
+    t = ctx[-1]
+    for n in _NGRAM_NS:
+        if length > n:
+            tables[n][tuple(ctx[length - 1 - n : length - 1])] = t
+
+
+def _ngram_propose(tables, ctx):
+    length = len(ctx)
+    for n in _NGRAM_NS:
+        if length >= n:
+            t = tables[n].get(tuple(ctx[length - n :]))
+            if t is not None:
+                return t
+    return None
+
+
