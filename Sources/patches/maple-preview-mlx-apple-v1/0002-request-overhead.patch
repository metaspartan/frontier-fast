diff --git a/mlx_lm/tokenizer_utils.py b/mlx_lm/tokenizer_utils.py
index 4bb44ea..f303952 100644
--- a/mlx_lm/tokenizer_utils.py
+++ b/mlx_lm/tokenizer_utils.py
@@ -164,10 +164,22 @@ class BPEStreamingDetokenizer(StreamingDetokenizer):
     _byte_decoder = None
 
     def __init__(self, tokenizer):
-        # Extract the tokens in a list from id to text
-        self.tokenmap = [None] * len(tokenizer.vocab)
-        for value, tokenid in tokenizer.vocab.items():
-            self.tokenmap[tokenid] = value
+        # Extract the tokens in a list from id to text. The map is immutable
+        # and identical for every detokenizer built from the same tokenizer,
+        # but `tokenizer.vocab` materializes a fresh ~vocab-size dict per
+        # access, so rebuilding it here cost ~50-100 ms on every
+        # stream_generate call. Build it once and cache it on the tokenizer.
+        tokenmap = getattr(tokenizer, "_bpe_streaming_tokenmap", None)
+        if tokenmap is None:
+            vocab = tokenizer.vocab
+            tokenmap = [None] * len(vocab)
+            for value, tokenid in vocab.items():
+                tokenmap[tokenid] = value
+            try:
+                tokenizer._bpe_streaming_tokenmap = tokenmap
+            except AttributeError:
+                pass
+        self.tokenmap = tokenmap
 
         self.reset()
 
diff --git a/mlx_lm/generate.py b/mlx_lm/generate.py
index 0013319..453357c 100644
--- a/mlx_lm/generate.py
+++ b/mlx_lm/generate.py
@@ -446,7 +446,11 @@ def generate_step(
                 if input_embeddings is not None
                 else input_embeddings
             )
-            mx.clear_cache()
+            # Only trim the buffer pool between chunks of a long prompt.
+            # Flushing after the final chunk (the common short-prompt case)
+            # just forces the first decode steps to re-allocate from the OS.
+            if total_prompt_tokens - prompt_processed_tokens > 1:
+                mx.clear_cache()
 
         y, logprobs = _step(input_tokens=prompt, input_embeddings=input_embeddings)
 
@@ -462,7 +466,10 @@ def generate_step(
         if n == max_tokens:
             break
         yield y.item(), logprobs
-        if n % 256 == 0:
+        # n=0 lands immediately after prefill: flushing there dumps the warm
+        # buffer pool right before decode re-allocates it. Keep the periodic
+        # trim for long generations only.
+        if n and n % 256 == 0:
             mx.clear_cache()
         y, logprobs = next_y, next_logprobs
         n += 1
