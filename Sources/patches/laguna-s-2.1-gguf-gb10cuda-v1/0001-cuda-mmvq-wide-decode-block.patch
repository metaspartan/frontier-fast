From d13f9679c09f118ee231fc87d352764cd23a8b74 Mon Sep 17 00:00:00 2001
From: "gainz.fast agent" <agent@gainz.fast>
Date: Tue, 4 Aug 2026 01:23:06 -0600
Subject: [PATCH] CUDA: wide decode block for mul_mat_vec_q where k-blocks
 divide evenly

mul_mat_vec_q strides the k loop by blocks_per_iter = vdr*nwarps*warp_size/qi
and a thread runs an iteration only when tid/(qi/vdr) lands below
blocks_per_row_x = K/qk. With the GENERIC table nwarps=4, Laguna-S-2.1-Q4_K_M
decode gets:

  ffn_gate/up_exps  Q4_K K=3072   12 k-blocks / 8  -> 2 trips, 75%% of slots used
  attn_q/output/head Q8_0 K=3072  96 k-blocks / 32 -> 3 trips, 100%%
  attn_output        Q8_0 K=9216 288 k-blocks / 32 -> 9 trips, 100%%

Each trip is a dependent memory round trip and sm_121 decode matvec is
memory-latency bound, so the trip COUNT is what decode pays. nwarps=6 makes
blocks_per_iter 12 for Q4_K (one balanced trip, zero idle slots) and 48 for
Q8_0 (2 trips instead of 3, 6 instead of 9).

Taken only where blocks_per_row_x is an exact multiple of the new
blocks_per_iter, so every other tensor keeps stock geometry.

Measured on DGX Spark GB10, Laguna-S-2.1-Q4_K_M, llama-bench -p 512 -n 128 -r 3,
three interleaved rounds against pristine b10237: decode +6.3%%.
---
 ggml/src/ggml-cuda/mmvq.cu | 137 +++++++++++++++++++++++++++++++++----
 1 file changed, 125 insertions(+), 12 deletions(-)

diff --git a/ggml/src/ggml-cuda/mmvq.cu b/ggml/src/ggml-cuda/mmvq.cu
index 0589e65..1bcef4a 100644
--- a/ggml/src/ggml-cuda/mmvq.cu
+++ b/ggml/src/ggml-cuda/mmvq.cu
@@ -4,6 +4,7 @@
 #include "vecdotq.cuh"
 
 #include <cstdint>
+#include <cstdlib>
 
 typedef float (*vec_dot_q_cuda_t)(const void * __restrict__ vbq, const block_q8_1 * __restrict__ bq8_1, const int & kbx, const int & iqs);
 
@@ -477,8 +478,65 @@ static constexpr __host__ __device__ int calc_rows_per_block(int ncols_dst, int
     return 1;
 }
 
-template <ggml_type type, int ncols_dst, bool has_fusion, bool small_k = false>
-__launch_bounds__(calc_nwarps(type, ncols_dst, get_device_table_id())*ggml_cuda_get_physical_warp_size(), 1)
+// gainz.fast laguna-s-2.1-gguf-gb10cuda-v1 ------------------------------------
+// mul_mat_vec_q walks the k dimension in strides of
+//     blocks_per_iter = vdr * nwarps * warp_size / qi
+// and a thread enters an iteration only when its own tid/(qi/vdr) maps below
+// blocks_per_row_x = K/qk.  With the GENERIC table's nwarps = 4 that gives, on
+// Laguna-S-2.1-Q4_K_M:
+//
+//   tensor                       type   K      k-blocks  blocks_per_iter  trips
+//   ffn_gate/up_exps             Q4_K   3072   12        8                2  (75% of slots used)
+//   attn_q / attn_output / head  Q8_0   3072   96        32               3  (100%)
+//   attn_output (72-head layers) Q8_0   9216   288       32               9  (100%)
+//
+// Every trip is a dependent memory round trip, and this part is memory-LATENCY
+// bound, so trip COUNT is what decode pays for.  nwarps = 6 makes
+// blocks_per_iter 12 for Q4_K (12/12 -> ONE balanced trip, no idle slots) and
+// 48 for Q8_0 (96/48 -> 2 trips instead of 3, 288/48 -> 6 instead of 9), at the
+// cost of a 6-way instead of 4-way cross-warp reduction.
+//
+// The override is taken ONLY where blocks_per_row_x is an exact multiple of the
+// new blocks_per_iter -- a non-dividing override would create a worse imbalance
+// than stock -- so every other tensor and every other model keeps stock geometry
+// bit for bit.
+//
+// GGML_CUDA_MMVQ_NW     : 0 = stock geometry, 6 = wide block (default 6)
+// GGML_CUDA_MMVQ_NW_Q4K : 1 = also apply to Q4_K (default), 0 = Q8_0 only
+#ifndef GGML_CUDA_MMVQ_NW_DEFAULT
+#define GGML_CUDA_MMVQ_NW_DEFAULT 6
+#endif
+#ifndef GGML_CUDA_MMVQ_NW_Q4K_DEFAULT
+#define GGML_CUDA_MMVQ_NW_Q4K_DEFAULT 1
+#endif
+
+static int mmvq_env_int(const char * name, int fallback, int lo, int hi) {
+    const char * e = getenv(name);
+    if (!e || !e[0]) {
+        return fallback;
+    }
+    const int v = atoi(e);
+    return (v >= lo && v <= hi) ? v : fallback;
+}
+
+static int get_mmvq_nw() {
+    static const int v = mmvq_env_int("GGML_CUDA_MMVQ_NW", GGML_CUDA_MMVQ_NW_DEFAULT, 0, 6);
+    return v == 6 ? 6 : 0;
+}
+
+static int get_mmvq_nw_q4k() {
+    static const int v = mmvq_env_int("GGML_CUDA_MMVQ_NW_Q4K", GGML_CUDA_MMVQ_NW_Q4K_DEFAULT, 0, 1);
+    return v;
+}
+
+// Only the quant types this track's model uses are eligible; every other type
+// keeps the stock instantiation, so the TU does not grow for them.
+static constexpr bool mmvq_nw_type_enabled(ggml_type type) {
+    return type == GGML_TYPE_Q4_K || type == GGML_TYPE_Q8_0;
+}
+
+template <ggml_type type, int ncols_dst, bool has_fusion, bool small_k = false, int nw_ovr = 0>
+__launch_bounds__((nw_ovr > 0 ? nw_ovr : calc_nwarps(type, ncols_dst, get_device_table_id()))*ggml_cuda_get_physical_warp_size(), 1)
 static __global__ void mul_mat_vec_q(
         const void * vx_ptr, const void * vy_ptr, const int32_t * ids_ptr, const ggml_cuda_mm_fusion_args_device fusion, float * dst_ptr,
         const uint32_t ncols_x, const uint3 nchannels_y, const uint32_t stride_row_x, const uint32_t stride_col_y,
@@ -495,7 +553,7 @@ static __global__ void mul_mat_vec_q(
     constexpr int qi  = ggml_cuda_type_traits<type>::qi;
     constexpr int vdr = get_vdr_mmvq(type);
     constexpr mmvq_parameter_table_id table_id = get_device_table_id();
-    constexpr int nwarps = calc_nwarps(type, ncols_dst, table_id);
+    constexpr int nwarps = nw_ovr > 0 ? nw_ovr : calc_nwarps(type, ncols_dst, table_id);
     constexpr int rows_per_cuda_block = calc_rows_per_block(ncols_dst, table_id, small_k, nwarps);
     constexpr int warp_size = ggml_cuda_get_physical_warp_size();
 
@@ -773,8 +831,9 @@ static __global__ void mul_mat_vec_q_moe(
 template<ggml_type type>
 static std::pair<dim3, dim3> calc_launch_params(
         const int ncols_dst, const int nrows_x, const int nchannels_dst, const int nsamples_or_ntokens,
-        const int warp_size, const mmvq_parameter_table_id table_id, const bool small_k = false) {
-    const int nwarps = calc_nwarps(type, ncols_dst, table_id);
+        const int warp_size, const mmvq_parameter_table_id table_id, const bool small_k = false,
+        const int nw_ovr = 0) {
+    const int nwarps = nw_ovr > 0 ? nw_ovr : calc_nwarps(type, ncols_dst, table_id);
     const int rpb = calc_rows_per_block(ncols_dst, table_id, small_k, nwarps);
     const int64_t nblocks = (nrows_x + rpb - 1) / rpb;
     const dim3 block_nums(nblocks, nchannels_dst, nsamples_or_ntokens);
@@ -782,7 +841,7 @@ static std::pair<dim3, dim3> calc_launch_params(
     return {block_nums, block_dims};
 }
 
-template<ggml_type type, int c_ncols_dst, bool small_k = false>
+template<ggml_type type, int c_ncols_dst, bool small_k = false, int nw_ovr = 0>
 static void mul_mat_vec_q_switch_fusion(
         const void * vx, const void * vy, const int32_t * ids, const ggml_cuda_mm_fusion_args_device fusion, float * dst,
         const uint32_t ncols_x, const uint3 nchannels_y, const uint32_t stride_row_x, const uint32_t stride_col_y,
@@ -797,7 +856,7 @@ static void mul_mat_vec_q_switch_fusion(
     if constexpr (c_ncols_dst == 1) {
         if (has_fusion) {
             const ggml_cuda_kernel_launch_params launch_params = ggml_cuda_kernel_launch_params(block_nums, block_dims, nbytes_shared, stream);
-            ggml_cuda_kernel_launch(mul_mat_vec_q<type, c_ncols_dst, true, small_k>, launch_params,
+            ggml_cuda_kernel_launch(mul_mat_vec_q<type, c_ncols_dst, true, small_k, nw_ovr>, launch_params,
                  vx, vy, ids, fusion, dst, ncols_x, nchannels_y, stride_row_x, stride_col_y, stride_col_dst,
                  channel_ratio, stride_channel_x, stride_channel_y, stride_channel_dst,
                  sample_ratio, stride_sample_x, stride_sample_y, stride_sample_dst, ids_stride);
@@ -808,12 +867,43 @@ static void mul_mat_vec_q_switch_fusion(
     GGML_ASSERT(!has_fusion && "fusion only supported for ncols_dst=1");
 
     const ggml_cuda_kernel_launch_params launch_params = ggml_cuda_kernel_launch_params(block_nums, block_dims, nbytes_shared, stream);
-    ggml_cuda_kernel_launch(mul_mat_vec_q<type, c_ncols_dst, false, small_k>, launch_params,
+    ggml_cuda_kernel_launch(mul_mat_vec_q<type, c_ncols_dst, false, small_k, nw_ovr>, launch_params,
         vx, vy, ids, fusion, dst, ncols_x, nchannels_y, stride_row_x, stride_col_y, stride_col_dst,
         channel_ratio, stride_channel_x, stride_channel_y, stride_channel_dst,
         sample_ratio, stride_sample_x, stride_sample_y, stride_sample_dst, ids_stride);
 }
 
+// Select the compile-time nwarps instantiation from the runtime knob.
+template<ggml_type type, int c_ncols_dst, bool small_k>
+static void mul_mat_vec_q_switch_nw(
+        const int nw,
+        const void * vx, const void * vy, const int32_t * ids, const ggml_cuda_mm_fusion_args_device fusion, float * dst,
+        const uint32_t ncols_x, const uint3 nchannels_y, const uint32_t stride_row_x, const uint32_t stride_col_y,
+        const uint32_t stride_col_dst, const uint3 channel_ratio, const uint32_t stride_channel_x,
+        const uint32_t stride_channel_y, const uint32_t stride_channel_dst, const uint3 sample_ratio,
+        const uint32_t stride_sample_x, const uint32_t stride_sample_y, const uint32_t stride_sample_dst,
+        const dim3 & block_nums, const dim3 & block_dims, const int nbytes_shared,
+        const uint32_t ids_stride, cudaStream_t stream) {
+
+    if constexpr (mmvq_nw_type_enabled(type) && c_ncols_dst == 1) {
+        if (nw == 6) {
+            mul_mat_vec_q_switch_fusion<type, c_ncols_dst, small_k, 6>(
+                vx, vy, ids, fusion, dst, ncols_x, nchannels_y, stride_row_x, stride_col_y, stride_col_dst,
+                channel_ratio, stride_channel_x, stride_channel_y, stride_channel_dst, sample_ratio,
+                stride_sample_x, stride_sample_y, stride_sample_dst, block_nums, block_dims, nbytes_shared,
+                ids_stride, stream);
+            return;
+        }
+    } else {
+        GGML_UNUSED(nw);
+    }
+    mul_mat_vec_q_switch_fusion<type, c_ncols_dst, small_k, 0>(
+        vx, vy, ids, fusion, dst, ncols_x, nchannels_y, stride_row_x, stride_col_y, stride_col_dst,
+        channel_ratio, stride_channel_x, stride_channel_y, stride_channel_dst, sample_ratio,
+        stride_sample_x, stride_sample_y, stride_sample_dst, block_nums, block_dims, nbytes_shared,
+        ids_stride, stream);
+}
+
 template <ggml_type type>
 static void mul_mat_vec_q_moe_launch(
         const void * vx, const void * vy, const int32_t * ids, float * dst,
@@ -918,18 +1008,41 @@ static void mul_mat_vec_q_switch_ncols_dst(
 
             bool use_small_k = should_use_small_k(c_ncols_dst);
 
+            // Take the wide-block geometry only where the k-blocks divide the
+            // new blocks_per_iter exactly; otherwise stock, bit for bit.
+            int nw = 0;
+            if constexpr (mmvq_nw_type_enabled(type)) {
+                nw = get_mmvq_nw();
+                if (nw > 0 && type == GGML_TYPE_Q4_K && !get_mmvq_nw_q4k()) {
+                    nw = 0;
+                }
+                if (nw > 0) {
+                    constexpr int qk_  = ggml_cuda_type_traits<type>::qk;
+                    constexpr int qi_  = ggml_cuda_type_traits<type>::qi;
+                    constexpr int vdr_ = get_vdr_mmvq(type);
+                    const int blocks_per_row = ncols_x / qk_;
+                    const int blocks_per_it  = (vdr_ * warp_size / qi_) * nw;
+                    if (blocks_per_it <= 0 || blocks_per_row % blocks_per_it != 0 ||
+                        nw * warp_size > 1024 || nw <= calc_nwarps(type, c_ncols_dst, table_id)) {
+                        nw = 0;
+                    }
+                }
+            }
+
             if (use_small_k) {
                 std::pair<dim3, dim3> dims = calc_launch_params<type>(c_ncols_dst, nrows_x, nchannels_dst,
-                                                                        nsamples_dst, warp_size, table_id, true);
-                mul_mat_vec_q_switch_fusion<type, c_ncols_dst, true>(
+                                                                        nsamples_dst, warp_size, table_id, true, nw);
+                mul_mat_vec_q_switch_nw<type, c_ncols_dst, true>(
+                    nw,
                     vx, vy, ids, fusion, dst, ncols_x, nchannels_y_fd, stride_row_x, stride_col_y, stride_col_dst,
                     channel_ratio_fd, stride_channel_x, stride_channel_y, stride_channel_dst, sample_ratio_fd,
                     stride_sample_x, stride_sample_y, stride_sample_dst, dims.first, dims.second, 0, ids_stride,
                     stream);
             } else {
                 std::pair<dim3, dim3> dims = calc_launch_params<type>(c_ncols_dst, nrows_x, nchannels_dst,
-                                                                        nsamples_dst, warp_size, table_id);
-                mul_mat_vec_q_switch_fusion<type, c_ncols_dst>(
+                                                                        nsamples_dst, warp_size, table_id, false, nw);
+                mul_mat_vec_q_switch_nw<type, c_ncols_dst, false>(
+                    nw,
                     vx, vy, ids, fusion, dst, ncols_x, nchannels_y_fd, stride_row_x, stride_col_y, stride_col_dst,
                     channel_ratio_fd, stride_channel_x, stride_channel_y, stride_channel_dst, sample_ratio_fd,
                     stride_sample_x, stride_sample_y, stride_sample_dst, dims.first, dims.second, 0, ids_stride,
