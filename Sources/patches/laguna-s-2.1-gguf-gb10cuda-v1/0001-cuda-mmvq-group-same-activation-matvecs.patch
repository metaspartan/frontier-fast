 }
 
+// ----- grouped mmvq detection ------------------------------------------------
+//
+// During decode several quantized matvecs read the SAME activation vector: the
+// K/V/gate attention projections all read the post-attn_norm hidden state, and
+// the shared-expert gate/up projections both read the post-ffn_norm hidden
+// state. Each is its own launch, and a launch that moves only ~3 MB cannot
+// amortise its ramp. Merging them into one launch (mul_mat_vec_q_grouped in
+// mmvq.cu) gives every row exactly the thread geometry, k-loop and reduction
+// sequence it has in the individual launch, so the outputs are byte-identical
+// by construction.
+//
+// Group members are not always adjacent in the graph, so later members are
+// issued at the position of the first. That is legal only when
+//   (a) every input of a hoisted member is already fully written at that point -
+//       true here: the shared src1 is produced before the first member and the
+//       weights are immutable - and
+//   (b) the hoisted write cannot touch memory any skipped-over node still reads
+//       or writes. Graph-allocator blocks are reused across disjoint lifetimes,
+//       so this is checked against actual data ranges below.
+
+// Grouping policy, re-read once per graph evaluation so that both arms can be
+// measured inside a single process (this box has a decode-rate state that is
+// fixed for a process launch, which whole-process A/B cannot cancel).
+//   0 = off, 1 = group only members with at most MMVQ_GROUP_SMALL_ROWS rows,
+//   2 = group any eligible member regardless of size.
+// Measured on Laguna-S-2.1-Q4_K_M / GB10 sm_121, 12 rotated reference-bracketed
+// cycles inside one server process (no-op floor 0.99994): mode 1 +1.109%
+// (spread 1.01066..1.01417), mode 2 +1.868% (spread 1.01849..1.02141). Mode 2
+// is the default: merging the large attn_q projection in with K and V helps
+// further, so the win is not launch-count reduction - it is that one larger
+// grid reaches the memory rate that three smaller ones do not.
+#define MMVQ_GROUP_SMALL_ROWS 2048
+#define MMVQ_GROUP_MODE_DEFAULT 2
+
+static int ggml_cuda_mmvq_group_mode() {
+    static const char * knob_file = getenv("GGML_CUDA_MMVQ_GROUP_FILE");
+    if (knob_file != nullptr) {
+        FILE * f = fopen(knob_file, "r");
+        if (f != nullptr) {
+            int v = MMVQ_GROUP_MODE_DEFAULT;
+            if (fscanf(f, "%d", &v) != 1) {
+                v = MMVQ_GROUP_MODE_DEFAULT;
+            }
+            fclose(f);
+            return v;
+        }
+        return MMVQ_GROUP_MODE_DEFAULT;
+    }
+    static const int mode = getenv("GGML_CUDA_MMVQ_GROUP") != nullptr
+        ? std::atoi(getenv("GGML_CUDA_MMVQ_GROUP")) : MMVQ_GROUP_MODE_DEFAULT;
+    return mode;
+}
+
+static bool ggml_cuda_mmvq_can_group(const ggml_tensor * node, const int mode) {
+    if (node->op != GGML_OP_MUL_MAT) {
+        return false;
+    }
+    const ggml_tensor * src0 = node->src[0];
+    const ggml_tensor * src1 = node->src[1];
+    if (src0 == nullptr || src1 == nullptr || node->src[2] != nullptr) {
+        return false;
+    }
+    if ((node->flags & GGML_TENSOR_FLAG_COMPUTE) == 0) {
+        return false;
+    }
+    // must be exactly the ggml_cuda_mul_mat_vec_q route of ggml_cuda_mul_mat:
+    // not FWHT, not the compute-buffer padding-clear case, quantized src0
+    // (which statically rejects the earlier mmvf/mmf routes), single dense
+    // column, and accepted by the mmvq batch-size gate.
+    if (ggml_get_op_params_i32(node, 1) == GGML_HINT_SRC0_IS_HADAMARD) {
+        return false;
+    }
+    if (!ggml_is_quantized(src0->type)) {
+        return false;
+    }
+    if (src1->type != GGML_TYPE_F32 || node->type != GGML_TYPE_F32) {
+        return false;
+    }
+    if (src0->ne[2] != 1 || src0->ne[3] != 1) {
+        return false;
+    }
+    if (src1->ne[1] != 1 || src1->ne[2] != 1 || src1->ne[3] != 1) {
+        return false;
+    }
+    if (node->ne[1] != 1 || node->ne[2] != 1 || node->ne[3] != 1) {
+        return false;
+    }
+    if (!ggml_is_contiguous(src0) || !ggml_is_contiguous(src1) || !ggml_is_contiguous(node)) {
+        return false;
+    }
+    if (src0->buffer == nullptr ||
+            ggml_backend_buffer_get_usage(src0->buffer) == GGML_BACKEND_BUFFER_USAGE_COMPUTE) {
+        return false;
+    }
+    // Size policy: a launch that is already large reaches the memory rate on its
+    // own, so mode 1 leaves it alone and merges only the small ones.
+    if (mode == 1 && src0->ne[1] > MMVQ_GROUP_SMALL_ROWS) {
+        return false;
+    }
+    const int cc = ggml_cuda_info().devices[ggml_cuda_get_device()].cc;
+    if (!ggml_cuda_should_use_mmvq(src0->type, cc, 1)) {
+        return false;
+    }
+    // the individual launch must be the shape the grouped kernel reproduces
+    // (rows_per_cuda_block == 1, non-small_k); the upstream small_k path fires
+    // for short rows and has a different per-row thread geometry.
+    if (!ggml_cuda_mmvq_group_shape_matches(src0->type, src0->ne[0])) {
+        return false;
+    }
+    return true;
+}
+
+static bool ggml_cuda_mmvq_ranges_disjoint(const ggml_tensor * a, const ggml_tensor * b) {
+    const int64_t a0 = (int64_t) a->data;
+    const int64_t a1 = a0 + (int64_t) ggml_nbytes(a);
+    const int64_t b0 = (int64_t) b->data;
+    const int64_t b1 = b0 + (int64_t) ggml_nbytes(b);
+    return a1 <= b0 || b1 <= a0;
+}
+
+// Is it legal to issue cgraph->nodes[j] at the position of cgraph->nodes[start]?
+// Nodes already accepted into this group are skipped: they are issued by the
+// same launch as the candidate and every member reads only the shared q8_1 copy
+// of src1 that the grouped call makes before any member writes, so their order
+// relative to the candidate cannot matter. Their destinations are checked
+// against the candidate's separately by the caller.
+static bool ggml_cuda_mmvq_hoist_legal(const ggml_cgraph * cgraph, const int start, const int j,
+                                       ggml_tensor * const * members, const int n_members) {
+    const ggml_tensor * cand = cgraph->nodes[j];
+    for (int k = start + 1; k < j; ++k) {
+        const ggml_tensor * mid = cgraph->nodes[k];
+        if (ggml_cuda_is_view_or_noop(mid)) {
+            continue;
+        }
+        bool is_member = false;
+        for (int m = 0; m < n_members; ++m) {
+            if (members[m] == mid) {
+                is_member = true;
+                break;
+            }
+        }
+        if (is_member) {
+            continue;
+        }
+        // hoisted write vs. everything the intermediate reads
+        for (int si = 0; si < GGML_MAX_SRC; ++si) {
+            if (mid->src[si] != nullptr && !ggml_cuda_mmvq_ranges_disjoint(cand, mid->src[si])) {
+                return false;
+            }
+        }
+        // hoisted write vs. the intermediate's own write
+        if (!ggml_cuda_mmvq_ranges_disjoint(cand, mid)) {
+            return false;
+        }
+        // the intermediate's write vs. the hoisted member's inputs
+        if (!ggml_cuda_mmvq_ranges_disjoint(mid, cand->src[0]) ||
+                !ggml_cuda_mmvq_ranges_disjoint(mid, cand->src[1])) {
+            return false;
+        }
+    }
+    return true;
+}
+
+// A candidate must not be pulled out of a mul_mat+glu fusion that stock would
+// actually perform. That decision is exactly ggml_cuda_can_fuse on the GLU
+// patterns - INCLUDING its allocation-dependent memory-range check, which in
+// practice blocks the fusion for most shared-expert gate/up pairs (their glu
+// output tends to reuse the activation's block). Ranges-blocked pairs run as
+// two plain matvec launches in stock, and grouping those changes no arithmetic.
+// Anything whose result reaches a GLU through a shape not tested here is
+// rejected conservatively.
+static bool ggml_cuda_mmvq_would_glu_fuse(const ggml_cgraph * cgraph, const int j) {
+    const auto fires = [&](const int p, std::initializer_list<enum ggml_op> ops) {
+        return p >= 0 && ggml_cuda_can_fuse(cgraph, p, ops, {});
+    };
+    // as the first (gate) or second (up) matvec of the 3-node pattern
+    if (fires(j,     { GGML_OP_MUL_MAT, GGML_OP_MUL_MAT, GGML_OP_GLU })) return true;
+    if (fires(j - 1, { GGML_OP_MUL_MAT, GGML_OP_MUL_MAT, GGML_OP_GLU })) return true;
+    // bias variants
+    if (fires(j,     { GGML_OP_MUL_MAT, GGML_OP_ADD, GGML_OP_MUL_MAT, GGML_OP_ADD, GGML_OP_GLU })) return true;
+    if (fires(j - 2, { GGML_OP_MUL_MAT, GGML_OP_ADD, GGML_OP_MUL_MAT, GGML_OP_ADD, GGML_OP_GLU })) return true;
+
+    const ggml_tensor * cand = cgraph->nodes[j];
+    const int end = std::min(cgraph->n_nodes, j + 6);
+    for (int k = j + 1; k < end; ++k) {
+        const ggml_tensor * n = cgraph->nodes[k];
+        if (n->op != GGML_OP_GLU) {
+            continue;
+        }
+        for (int si = 0; si < GGML_MAX_SRC; ++si) {
+            const ggml_tensor * src = n->src[si];
+            if (src == nullptr) {
+                continue;
+            }
+            const bool direct = src == cand;
+            const bool via_add = src->op == GGML_OP_ADD && (src->src[0] == cand || src->src[1] == cand);
+            if (direct || via_add) {
+                // reaches a GLU outside the exact patterns above: check whether the
+                // simple pattern is present but merely range-blocked (stock runs it
+                // unfused, safe to group); otherwise reject conservatively
+                const bool blocked_pair =
+                    (ggml_can_fuse_subgraph(cgraph, j, { GGML_OP_MUL_MAT, GGML_OP_MUL_MAT, GGML_OP_GLU }, { j + 2 }) &&
+                     ggml_cuda_should_fuse_mul_mat(cgraph->nodes[j + 1], cgraph->nodes[j], cgraph->nodes[j + 2])) ||
+                    (j >= 1 &&
+                     ggml_can_fuse_subgraph(cgraph, j - 1, { GGML_OP_MUL_MAT, GGML_OP_MUL_MAT, GGML_OP_GLU }, { j + 1 }) &&
+                     ggml_cuda_should_fuse_mul_mat(cgraph->nodes[j], cgraph->nodes[j - 1], cgraph->nodes[j + 1]));
+                if (!blocked_pair) {
+                    return true;
+                }
+            }
+        }
+    }
+    return false;
+}
+
+static int ggml_cuda_mmvq_collect_group(const ggml_cgraph * cgraph, const int start,
+                                        ggml_tensor ** members, const int mode) {
+    ggml_tensor * first = cgraph->nodes[start];
+    const ggml_tensor * src1 = first->src[1];
+    members[0] = first;
+    int n = 1;
+
+    constexpr int scan_window = 40;
+    const int end = std::min(cgraph->n_nodes, start + 1 + scan_window);
+
+    for (int j = start + 1; j < end && n < MMVQ_MAX_GROUP_SIZE; ++j) {
+        ggml_tensor * cand = cgraph->nodes[j];
+        if (ggml_cuda_is_view_or_noop(cand)) {
+            continue;
+        }
+        if (cand->op != GGML_OP_MUL_MAT || cand->src[1] != src1 ||
+                cand->src[0]->type  != first->src[0]->type  ||
+                cand->src[0]->ne[0] != first->src[0]->ne[0] ||
+                cand->src[0]->nb[1] != first->src[0]->nb[1]) {
+            continue;
+        }
+        if (!ggml_cuda_mmvq_can_group(cand, mode) ||
+                ggml_cuda_mmvq_would_glu_fuse(cgraph, j) ||
+                !ggml_cuda_mmvq_hoist_legal(cgraph, start, j, members, n)) {
+            continue;
+        }
+        // members must write disjoint destinations
+        bool overlaps = false;
+        for (int m = 0; m < n; ++m) {
+            if (!ggml_cuda_mmvq_ranges_disjoint(cand, members[m])) {
+                overlaps = true;
+                break;
+            }
+        }
+        if (overlaps) {
+            continue;
+        }
+        members[n++] = cand;
+    }
+    return n;
+}
+
 // try and fuse nodes and return the number of nodes to skip
 static int ggml_cuda_try_fuse(ggml_backend_cuda_context * cuda_ctx, ggml_cgraph * cgraph, int i) {
 
@@ -3978,6 +4236,13 @@ static void ggml_cuda_graph_evaluate_and_capture(ggml_backend_cuda_context * cud
                 stream_ctx.concurrent_events.clear();
             }
 
+            // Members of grouped mmvq launches already issued earlier in this pass.
+            std::unordered_set<const ggml_tensor *> mmvq_grouped_done;
+            const int  mmvq_group_mode    = ggml_cuda_mmvq_group_mode();
+            const bool mmvq_group_enabled = mmvq_group_mode != 0 && stream_ctx.concurrent_events.empty();
+            static const bool log_mmvq_group_stats = getenv("GGML_MMVQ_GROUP_STATS") != nullptr;
+            int64_t mmvq_group_stats[2] = {0, 0};
+
             for (int i = 0; i < cgraph->n_nodes; i++) {
                 ggml_tensor * node = cgraph->nodes[i];
                 if (is_concurrent_event_active) {
@@ -4020,6 +4285,10 @@ static void ggml_cuda_graph_evaluate_and_capture(ggml_backend_cuda_context * cud
                     continue;
                 }
 
+                if (!mmvq_grouped_done.empty() && mmvq_grouped_done.count(node) != 0) {
+                    continue; // already computed as part of a grouped mmvq launch
+                }
+
                 int nodes_to_skip = ggml_cuda_try_fuse(cuda_ctx, cgraph, i);
 
                 if (nodes_to_skip != 0) {
@@ -4032,6 +4301,21 @@ static void ggml_cuda_graph_evaluate_and_capture(ggml_backend_cuda_context * cud
                     i += nodes_to_skip;
                     continue;
                 }
+
+                if (mmvq_group_enabled && ggml_cuda_mmvq_can_group(node, mmvq_group_mode) &&
+                        !ggml_cuda_mmvq_would_glu_fuse(cgraph, i)) {
+                    ggml_tensor * members[MMVQ_MAX_GROUP_SIZE];
+                    const int n_members = ggml_cuda_mmvq_collect_group(cgraph, i, members, mmvq_group_mode);
+                    if (n_members >= 2) {
+                        ggml_cuda_mul_mat_vec_q_grouped(*cuda_ctx, members, n_members);
+                        for (int m = 1; m < n_members; ++m) {
+                            mmvq_grouped_done.insert(members[m]);
+                        }
+                        mmvq_group_stats[0] += 1;          // groups launched
+                        mmvq_group_stats[1] += n_members;  // members covered
+                        continue;
+                    }
+                }
 #ifndef NDEBUG
                 assert(node->buffer->buft == ggml_backend_cuda_buffer_type(cuda_ctx->device));
                 for (int j = 0; j < GGML_MAX_SRC; j++) {
@@ -4055,6 +4339,23 @@ static void ggml_cuda_graph_evaluate_and_capture(ggml_backend_cuda_context * cud
                     try_launch_concurrent_event(node);
                }
             }
+
+            if (log_mmvq_group_stats) {
+                // one line whenever the effective policy or its result changes, so that
+                // a runtime knob flip can be confirmed to have reached the backend
+                static int     last_mode    = -2;
+                static int64_t last_groups  = -1;
+                static int64_t last_members = -1;
+                if (mmvq_group_mode != last_mode || mmvq_group_stats[0] != last_groups ||
+                        mmvq_group_stats[1] != last_members) {
+                    last_mode    = mmvq_group_mode;
+                    last_groups  = mmvq_group_stats[0];
+                    last_members = mmvq_group_stats[1];
+                    fprintf(stderr, "[mmvq-group] mode=%d groups=%lld members=%lld n_nodes=%d\n",
+                        mmvq_group_mode, (long long) mmvq_group_stats[0],
+                        (long long) mmvq_group_stats[1], cgraph->n_nodes);
+                }
+            }
         }
 
