From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Claude Opus 5 <noreply@anthropic.com>
Date: Mon, 3 Aug 2026 20:05:00 -0600
Subject: [PATCH 11/11] CUDA: port mul_mat_vec_f load batching to nvcc; keep the
 upstream decode block on NVIDIA

Port of the R9700/HIP track patch 0014 ("CUDA/HIP: give mul_mat_vec_f a
single-warp decode block and batched k-loads", Claude Fable 5) to the GB10
CUDA track.  Two things had to change, and the second is the interesting one.

1. The HIP patch does not compile under nvcc.

mmvf_nunroll() is a plain `static constexpr` host function called from
mul_mat_vec_f, which is __global__.  clang/HIP accepts that; nvcc rejects it
("calling a constexpr __host__ function from a __global__ function is not
allowed") unless --expt-relaxed-constexpr is passed, which this build does not
pass.  Marking it __host__ __device__ fixes it for both toolchains and changes
nothing about the value it returns.  As it stands on main, patch 0014 fails the
GB10 CUDA build outright, so no CUDA-track series can carry it unmodified.

2. The single-warp decode block is a REGRESSION on sm_121; only the load
   batching is ported to NVIDIA.

On RDNA the win came from dropping the ncols_dst == 1 block to one warp, which
deletes the two-stage LDS reduction and both barriers.  That does not reproduce
on GB10.  This model's mul_mat_vec_f is the F32 MoE router (ffn_gate_inp,
2048x256 per layer, 39 launches per decoded token), and on GB10 it is not
anomalously slow to begin with: nsys measures it at 11.56 us for 2.10 MiB,
which is ~182 GB/s, essentially the same achieved bandwidth as the whole decode
step on this box (~1.8 GB of active weights at ~10.4 ms/token, ~173 GB/s of the
part's 273 GB/s theoretical).  There is no 3x gap to close here - unlike RDNA4,
where the same kernel ran at 183 GB/s next to quantized matvecs sustaining
500-530 GB/s.  Forcing the single-warp block only lengthens the k-loop:

  nsys, mul_mat_vec_f avg per launch, 10,023 launches, same session
    block 256 (upstream heuristic)   11,556 ns
    block 32  (the RDNA port)        12,985 ns    +12.4%

and end to end it is the worst of the block sizes tried.  llama-bench
(-p 512 -n 128 -r 3 -ngl 99), three interleaved rounds, medians:

    stock                     79.41 tok/s
    series + block 256        81.76 tok/s   (+2.96%)
    series + block 128        81.91 tok/s   (+3.15%)
    series + block 32         81.10 tok/s   (+2.13%)

128 and 256 are inside the run-to-run spread (individual rounds ranged 81.0-83.7
for both) and the box was under a concurrent load during this window, so this
patch does NOT claim a block-size win: it leaves NVIDIA on the upstream niter
heuristic, exactly the launch geometry of the verified series, and restricts the
single-warp override to RDNA where it was measured to pay.  What NVIDIA does get
is the batched k-loop, which is orthogonal to the block size.

GGML_CUDA_MMVF_DECODE_BLOCK forces a block size at runtime (-1 = upstream
heuristic, 0 = per-arch default) so the sweep can be repeated on an idle box
without a rebuild.

Arithmetic is unchanged, as in the original patch: the batched loop accumulates
u ascending, which is the same sequence of values in the same order as the
stock `col2 += block_size` loop, and the reduction path is untouched.
Perplexity over the fixed corpus is identical to every digit printed, on stock
and on this build, and also with the block forced to 32:

    llama-perplexity -f ~/gainz-ppl-corpus.txt -ngl 99 -c 512 --chunks 8
    stock                     PPL = 5.2709 +/- 0.35519
    this build                PPL = 5.2709 +/- 0.35519
    this build, block 32      PPL = 5.2709 +/- 0.35519

Relative delta 0.000%, against a gate of 0.5%.
---
diff --git a/ggml/src/ggml-cuda/mmvf.cu b/ggml/src/ggml-cuda/mmvf.cu
index d7dbc8b..f2e6b5c 100644
--- a/ggml/src/ggml-cuda/mmvf.cu
+++ b/ggml/src/ggml-cuda/mmvf.cu
@@ -4,6 +4,19 @@
 #include "mmvf.cuh"
 #include "convert.cuh"
 
+// Number of strided k-steps whose loads are issued back-to-back before the FMAs that
+// consume them.  Scaled down as the per-step register footprint grows (one float2 of y
+// per dst column per step, plus one float2 of x, doubled when a gate is fused) so the
+// kernel keeps full occupancy.
+#define GGML_CUDA_MMVF_NUNROLL 4
+
+template <int ncols_dst, bool has_fusion>
+static __host__ __device__ constexpr int mmvf_nunroll() {
+    return ncols_dst > 2 ? 1
+         : ncols_dst > 1 ? (has_fusion ? 1 : 2)
+         : (has_fusion ? 2 : GGML_CUDA_MMVF_NUNROLL);
+}
+
 template <typename T, typename type_acc, int ncols_dst, int block_size, bool has_fusion = false, bool is_multi_token_id = false>
 static __global__ void mul_mat_vec_f(
         const T * x_ptr, const float * y_ptr, const int32_t * ids_ptr, const ggml_cuda_mm_fusion_args_device fusion, float * dst_ptr,
@@ -133,7 +146,56 @@ static __global__ void mul_mat_vec_f(
             }
         }
 
-        for (int col2 = tid; col2 < ncols2; col2 += block_size) {
+        // Issue MMVF_NUNROLL strided k-steps before the dependent FMAs.  The original
+        // loop reloads into the same registers every iteration, so a wave stalls on one
+        // full memory round-trip per k-step (16 VGPRs, zero loads in flight).  Batching
+        // the loads only changes *when* values arrive: the accumulation sequence into
+        // sumf[]/sumf_gate[] is identical (u ascending == the original col2 += block_size
+        // order), so every result is bit-for-bit unchanged.
+        constexpr int nunroll = mmvf_nunroll<ncols_dst, has_fusion>();
+        int col2 = tid;
+        for (; col2 + (nunroll - 1)*block_size < ncols2; col2 += nunroll*block_size) {
+            float2 tmpx[nunroll];
+            float2 tmpy[nunroll][ncols_dst];
+            [[maybe_unused]] float2 tmpx_gate[has_fusion ? nunroll : 1];
+
+#pragma unroll
+            for (int u = 0; u < nunroll; ++u) {
+                tmpx[u] = x2[col2 + u*block_size];
+            }
+            if constexpr (has_fusion) {
+                if (use_gate) {
+#pragma unroll
+                    for (int u = 0; u < nunroll; ++u) {
+                        tmpx_gate[u] = gate_x2[col2 + u*block_size];
+                    }
+                }
+            }
+#pragma unroll
+            for (int u = 0; u < nunroll; ++u) {
+#pragma unroll
+                for (int j = 0; j < ncols_dst; ++j) {
+                    tmpy[u][j] = y2[j*stride_col_y2 + col2 + u*block_size];
+                }
+            }
+
+#pragma unroll
+            for (int u = 0; u < nunroll; ++u) {
+#pragma unroll
+                for (int j = 0; j < ncols_dst; ++j) {
+                    ggml_cuda_mad(sumf[j], tmpx[u].x, tmpy[u][j].x);
+                    ggml_cuda_mad(sumf[j], tmpx[u].y, tmpy[u][j].y);
+
+                    if constexpr (has_fusion) {
+                        if (use_gate) {
+                            ggml_cuda_mad(sumf_gate[j], tmpx_gate[u].x, tmpy[u][j].x);
+                            ggml_cuda_mad(sumf_gate[j], tmpx_gate[u].y, tmpy[u][j].y);
+                        }
+                    }
+                }
+            }
+        }
+        for (; col2 < ncols2; col2 += block_size) {
             const float2 tmpx = x2[col2];
             float2 tmpx_gate = make_float2(0.0f, 0.0f);
             if constexpr (has_fusion) {
@@ -166,7 +228,58 @@ static __global__ void mul_mat_vec_f(
         }
 
         if (std::is_same_v<type_acc, float>) {
-            for (int col2 = tid; col2 < ncols2; col2 += block_size) {
+            // Same load batching as the f32 path above; accumulation order unchanged.
+            constexpr int nunroll = mmvf_nunroll<ncols_dst, has_fusion>();
+            int col2 = tid;
+            for (; col2 + (nunroll - 1)*block_size < ncols2; col2 += nunroll*block_size) {
+                half2 rawx[nunroll];
+                float2 tmpy[nunroll][ncols_dst];
+                [[maybe_unused]] half2 rawx_gate[has_fusion ? nunroll : 1];
+
+#pragma unroll
+                for (int u = 0; u < nunroll; ++u) {
+                    rawx[u] = x2[col2 + u*block_size];
+                }
+                if constexpr (has_fusion) {
+                    if (use_gate) {
+#pragma unroll
+                        for (int u = 0; u < nunroll; ++u) {
+                            rawx_gate[u] = gate_x2[col2 + u*block_size];
+                        }
+                    }
+                }
+#pragma unroll
+                for (int u = 0; u < nunroll; ++u) {
+#pragma unroll
+                    for (int j = 0; j < ncols_dst; ++j) {
+                        tmpy[u][j] = y2[j*stride_col_y2 + col2 + u*block_size];
+                    }
+                }
+
+#pragma unroll
+                for (int u = 0; u < nunroll; ++u) {
+                    const float2 tmpx = __half22float2(rawx[u]);
+                    float2 tmpx_gate = make_float2(0.0f, 0.0f);
+                    if constexpr (has_fusion) {
+                        if (use_gate) {
+                            tmpx_gate = __half22float2(rawx_gate[u]);
+                        }
+                    }
+#pragma unroll
+                    for (int j = 0; j < ncols_dst; ++j) {
+                        ggml_cuda_mad(sumf[j], tmpx.x, tmpy[u][j].x);
+                        ggml_cuda_mad(sumf[j], tmpx.y, tmpy[u][j].y);
+
+                        if constexpr (has_fusion) {
+                            if (use_gate) {
+                                ggml_cuda_mad(sumf_gate[j], tmpx_gate.x, tmpy[u][j].x);
+                                ggml_cuda_mad(sumf_gate[j], tmpx_gate.y, tmpy[u][j].y);
+                            }
+                        }
+                    }
+                }
+            }
+            for (; col2 < ncols2; col2 += block_size) {
                 const float2 tmpx = __half22float2(x2[col2]);
                 float2 tmpx_gate = make_float2(0.0f, 0.0f);
                 if constexpr (has_fusion) {
@@ -409,6 +522,23 @@ static void mul_mat_vec_f_switch_fusion(
 
 }
 
+// Decode-block override for mul_mat_vec_f (ncols_dst == 1).
+// >0: force that block size.  0: per-arch default.  <0: keep the upstream niter heuristic.
+// GGML_CUDA_MMVF_DECODE_BLOCK selects at runtime (-1 restores the stock heuristic).
+static int64_t mmvf_decode_block_size(const int warp_size) {
+    static const int64_t env = []() -> int64_t {
+        const char * s = getenv("GGML_CUDA_MMVF_DECODE_BLOCK");
+        return s ? (int64_t) atoi(s) : 0;
+    }();
+    if (env <= 0) {
+        return env;
+    }
+    int64_t bs = (env / warp_size) * warp_size;
+    if (bs < warp_size) bs = warp_size;
+    if (bs > 256)       bs = 256;
+    return bs;
+}
+
 template <typename T, typename type_acc, int ncols_dst, bool is_multi_token_id = false>
 void launch_mul_mat_vec_f_cuda(
         const T * x, const float * y, const int32_t * ids, const ggml_cuda_mm_fusion_args_device fusion, float * dst,
@@ -444,6 +574,24 @@ void launch_mul_mat_vec_f_cuda(
         }
     }
 
+    // Single-token decode on RDNA: a block wider than one warp forces the two-stage
+    // reduction (LDS staging + two __syncthreads per dst column).  On RDNA that tail is
+    // more expensive than the k-loop it shortens, because a 256-thread block is 8 wave32s
+    // that all have to meet at the barrier after only a handful of loads each.  Keeping the
+    // block at one warp removes the LDS round-trip and both barriers; the per-thread k-loop
+    // grows, which the batched loads above already cover.  Restricted to ncols_dst == 1 so
+    // the batched/prefill shapes keep the upstream heuristic.
+    if (ncols_dst == 1) {
+        const int64_t forced = mmvf_decode_block_size(warp_size);
+        if (forced > 0) {
+            block_size_best = forced;
+        } else if (forced == 0 && GGML_CUDA_CC_IS_RDNA(ggml_cuda_info().devices[device].cc)) {
+            // RDNA only: measured on GB10 (sm_121) the single-warp block is the WORST of the
+            // block sizes tried (see the patch message), so NVIDIA keeps the upstream heuristic.
+            block_size_best = warp_size;
+        }
+    }
+
     const bool has_fusion = fusion.gate != nullptr || fusion.x_bias != nullptr || fusion.gate_bias != nullptr;
 
     const int nbytes_shared = warp_size*sizeof(float) + (has_fusion ? warp_size*sizeof(float) : 0);
