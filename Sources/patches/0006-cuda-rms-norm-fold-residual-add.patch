+
+// ----- add-chain folded into the following rms_norm+mul ----------------------
+//
+// Every decoder layer feeds a residual add straight into the next rms_norm:
+//   ffn_inp = add(attn_out, inpSA);  cur = rms_norm(ffn_inp) * ffn_norm_w
+// and the layer output add feeds the next layer's attn_norm the same way. Stock
+// runs these as two dispatches - one k_bin_bcast (possibly an n-ary fused add)
+// and one rms_norm_f32<block_size, true>.
+//
+// Because the rms_norm block already covers a whole row, the same block can
+// produce that row's add result first and then normalise it. The add result is
+// still stored to the add's destination (other nodes consume it), and the norm
+// then reads back exactly the float values it would have read from memory, in
+// the same order, so results are byte-identical by construction:
+//
+//   - each operand is combined with a separate rounded float add, left to right
+//     in the same order as the k_bin_bcast fold (src0, then each add's src1);
+//   - the sum-of-squares loop, block_reduce, rsqrtf and output expression are
+//     the stock rms_norm_f32<block_size, true> ones, unchanged.
+
+struct rms_norm_pre_add_args {
+    const float * src[RMS_NORM_ADD_MAX_OPERANDS];
+    int64_t       stride_row[RMS_NORM_ADD_MAX_OPERANDS];
+};
+
+template <int block_size, int n_add>
+static __global__ void rms_norm_pre_add_f32(const rms_norm_pre_add_args args,
+                                            float *        add_dst,
+                                            const int64_t  add_stride_row,
+                                            float *        dst,
+                                            const int      ncols,
+                                            const float    eps,
+                                            const float *  mul,
+                                            const int64_t  mul_stride_row,
+                                            const uint3    mul_ncols_packed,
+                                            const uint3    mul_nrows_packed) {
+    ggml_cuda_pdl_lc();
+    const int row = blockIdx.x;
+    const int tid = threadIdx.x;
+
+    add_dst += (int64_t) row * add_stride_row;
+    dst     += (int64_t) row * ncols;
+
+    const uint32_t mul_row = fastmodulo((uint32_t) row, mul_nrows_packed);
+    mul += (int64_t) mul_row * mul_stride_row;
+
+    float tmp = 0.0f; // partial sum for thread in warp
+
+    ggml_cuda_pdl_sync();
+
+    // add chain: identical operand order and identical per-element rounding to
+    // the k_bin_bcast fold it replaces
+    for (int col = tid; col < ncols; col += block_size) {
+        float acc = args.src[0][(int64_t) row * args.stride_row[0] + col];
+#pragma unroll
+        for (int k = 1; k < n_add; ++k) {
+            acc = acc + args.src[k][(int64_t) row * args.stride_row[k] + col];
+        }
+        add_dst[col] = acc;
+
+        const float xi = acc;
+        tmp += xi * xi;
+    }
+
+    // sum up partial sums
+    extern __shared__ float s_sum[];
+    tmp = block_reduce<block_reduce_method::SUM, block_size>(tmp, s_sum);
+
+    const float mean  = tmp / ncols;
+    const float scale = rsqrtf(mean + eps);
+
+    for (int col = tid; col < ncols; col += block_size) {
+        const int mul_col = fastmodulo(col, mul_ncols_packed);
+        dst[col]          = scale * add_dst[col] * mul[mul_col];
+    }
+}
+
+template <int n_add>
+static void rms_norm_pre_add_launch(const rms_norm_pre_add_args & args,
+                                    float * add_dst, int64_t add_stride_row,
+                                    float * dst, int ncols, int nrows, float eps,
+                                    const float * mul, int64_t mul_stride_row,
+                                    uint32_t mul_ncols, uint32_t mul_nrows,
+                                    cudaStream_t stream) {
+    const dim3 blocks_num(nrows, 1, 1);
+    const uint3 mul_ncols_packed = init_fastdiv_values(mul_ncols);
+    const uint3 mul_nrows_packed = init_fastdiv_values(mul_nrows);
+
+    if (ncols < 1024) {
+        const dim3 block_dims(256, 1, 1);
+        const ggml_cuda_kernel_launch_params launch_params =
+            ggml_cuda_kernel_launch_params{blocks_num, block_dims, block_dims.x > WARP_SIZE ? 32 * sizeof(float) : 0, stream};
+        ggml_cuda_kernel_launch(rms_norm_pre_add_f32<256, n_add>, launch_params,
+            args, add_dst, add_stride_row, dst, ncols, eps, mul, mul_stride_row, mul_ncols_packed, mul_nrows_packed);
+    } else {
+        const dim3 block_dims(1024, 1, 1);
+        const ggml_cuda_kernel_launch_params launch_params =
+            ggml_cuda_kernel_launch_params{blocks_num, block_dims, block_dims.x > WARP_SIZE ? 32 * sizeof(float) : 0, stream};
+        ggml_cuda_kernel_launch(rms_norm_pre_add_f32<1024, n_add>, launch_params,
+            args, add_dst, add_stride_row, dst, ncols, eps, mul, mul_stride_row, mul_ncols_packed, mul_nrows_packed);
+    }
+}
+
+void ggml_cuda_op_rms_norm_fused_pre_add(ggml_backend_cuda_context & ctx,
+                                         ggml_tensor * const * adds, int n_adds,
+                                         ggml_tensor * norm, ggml_tensor * mul_tensor) {
+    GGML_ASSERT(n_adds >= 1 && n_adds <= RMS_NORM_ADD_MAX_OPERANDS - 1);
+
+    cudaStream_t stream = ctx.stream();
+
+    ggml_tensor * add_last = adds[n_adds - 1];
+
+    const ggml_tensor * mul_src = nullptr;
+    if (mul_tensor->src[0] == norm) {
+        mul_src = mul_tensor->src[1];
+    } else if (mul_tensor->src[1] == norm) {
+        mul_src = mul_tensor->src[0];
+    } else {
+        GGML_ASSERT(false);
+    }
+
+    float eps = 0.0f;
+    memcpy(&eps, norm->op_params, sizeof(float));
+    GGML_ASSERT(eps >= 0.0f);
+
+    // operand order of the k_bin_bcast fold: src0 of the first add, then the
+    // right operand of each add in the chain
+    rms_norm_pre_add_args args = {};
+    int n_op = 0;
+    {
+        const ggml_tensor * s0 = adds[0]->src[0];
+        args.src[n_op]        = (const float *) s0->data;
+        args.stride_row[n_op] = s0->nb[1] / sizeof(float);
+        ++n_op;
+    }
+    for (int i = 0; i < n_adds; ++i) {
+        const ggml_tensor * s1 = adds[i]->src[1];
+        args.src[n_op]        = (const float *) s1->data;
+        args.stride_row[n_op] = s1->nb[1] / sizeof(float);
+        ++n_op;
+    }
+    for (int i = n_op; i < RMS_NORM_ADD_MAX_OPERANDS; ++i) {
+        args.src[i]        = args.src[0];
+        args.stride_row[i] = args.stride_row[0];
+    }
+
+    const int64_t ncols = add_last->ne[0];
+    const int64_t nrows = add_last->ne[1];
+
+    float * add_dst = (float *) add_last->data;
+    float * dst     = (float *) mul_tensor->data;
+
+    const int64_t add_stride_row = add_last->nb[1] / sizeof(float);
+    const int64_t mul_stride_row = mul_src->nb[1] / sizeof(float);
+
+    switch (n_op) {
+        case 2: rms_norm_pre_add_launch<2>(args, add_dst, add_stride_row, dst, (int) ncols, (int) nrows, eps,
+                    (const float *) mul_src->data, mul_stride_row, (uint32_t) mul_src->ne[0], (uint32_t) mul_src->ne[1], stream); break;
+        case 3: rms_norm_pre_add_launch<3>(args, add_dst, add_stride_row, dst, (int) ncols, (int) nrows, eps,
+                    (const float *) mul_src->data, mul_stride_row, (uint32_t) mul_src->ne[0], (uint32_t) mul_src->ne[1], stream); break;
+        case 4: rms_norm_pre_add_launch<4>(args, add_dst, add_stride_row, dst, (int) ncols, (int) nrows, eps,
+                    (const float *) mul_src->data, mul_stride_row, (uint32_t) mul_src->ne[0], (uint32_t) mul_src->ne[1], stream); break;
+        case 5: rms_norm_pre_add_launch<5>(args, add_dst, add_stride_row, dst, (int) ncols, (int) nrows, eps,
+                    (const float *) mul_src->data, mul_stride_row, (uint32_t) mul_src->ne[0], (uint32_t) mul_src->ne[1], stream); break;
+        case 6: rms_norm_pre_add_launch<6>(args, add_dst, add_stride_row, dst, (int) ncols, (int) nrows, eps,
+                    (const float *) mul_src->data, mul_stride_row, (uint32_t) mul_src->ne[0], (uint32_t) mul_src->ne[1], stream); break;
+        case 7: rms_norm_pre_add_launch<7>(args, add_dst, add_stride_row, dst, (int) ncols, (int) nrows, eps,
+                    (const float *) mul_src->data, mul_stride_row, (uint32_t) mul_src->ne[0], (uint32_t) mul_src->ne[1], stream); break;
+        case 8: rms_norm_pre_add_launch<8>(args, add_dst, add_stride_row, dst, (int) ncols, (int) nrows, eps,
+                    (const float *) mul_src->data, mul_stride_row, (uint32_t) mul_src->ne[0], (uint32_t) mul_src->ne[1], stream); break;
+        default: GGML_ABORT("fatal error");
+    }
+}
