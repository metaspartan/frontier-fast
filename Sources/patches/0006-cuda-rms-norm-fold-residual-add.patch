+// ----- add chain folded into the following rms_norm+mul ----------------------
+//
+// The residual add that feeds a pre-norm is a separate dispatch in stock even
+// though the rms_norm block already covers the whole row. This detects
+//   [ADD (chain)] -> RMS_NORM -> MUL
+// and runs it as one kernel. The add chain is exactly the one the upstream
+// multi-(add|mul) fusion would build - same operands, same order, same single
+// destination - so the stored result is unchanged, and the norm then consumes
+// the same float values it would have read back from that store.
+
+static int ggml_cuda_rms_norm_pre_add_chain_len(const ggml_cgraph * cgraph, const int i) {
+    // mirrors the multi-add fusion loop in ggml_cuda_try_fuse
+    int     n_fuse = 0;
+    ggml_op ops[8];
+    std::fill(ops, ops + 8, GGML_OP_ADD);
+
+    for (; n_fuse <= 6; ++n_fuse) {
+        if (!ggml_can_fuse(cgraph, i + n_fuse, ops + n_fuse, 2)) {
+            break;
+        }
+        if (cgraph->nodes[i + n_fuse] != cgraph->nodes[i + n_fuse + 1]->src[0]) {
+            break;
+        }
+        if (!ggml_are_same_layout(cgraph->nodes[i + n_fuse]->src[1], cgraph->nodes[i + n_fuse + 1]->src[1])) {
+            break;
+        }
+    }
+    return n_fuse + 1;
+}
+
+static bool ggml_cuda_rms_norm_pre_add_operand_ok(const ggml_tensor * t, const ggml_tensor * ref) {
+    return t != nullptr && t->type == GGML_TYPE_F32 && ggml_are_same_shape(t, ref) &&
+           ggml_is_contiguous(t) && t->nb[0] == ggml_type_size(t->type);
+}
+
+// returns the number of chained ADD nodes to fold, or 0
+static int ggml_cuda_rms_norm_pre_add_detect(const ggml_cgraph * cgraph, const int i) {
+    if (cgraph->nodes[i]->op != GGML_OP_ADD) {
+        return 0;
+    }
+
+    const int n_adds = ggml_cuda_rms_norm_pre_add_chain_len(cgraph, i);
+    const int inorm  = i + n_adds;
+    if (inorm + 1 >= cgraph->n_nodes) {
+        return 0;
+    }
+    if (n_adds < 1 || n_adds > RMS_NORM_ADD_MAX_OPERANDS - 1) {
+        return 0;
+    }
+
+    ggml_tensor * add_last = cgraph->nodes[inorm - 1];
+    ggml_tensor * norm     = cgraph->nodes[inorm];
+    ggml_tensor * mul      = cgraph->nodes[inorm + 1];
+
+    if (norm->op != GGML_OP_RMS_NORM || norm->src[0] != add_last) {
+        return 0;
+    }
+    // the norm+mul pair must be exactly what stock would fuse, and the +add
+    // variant is left alone
+    if (ggml_cuda_can_fuse(cgraph, inorm, { GGML_OP_RMS_NORM, GGML_OP_MUL, GGML_OP_ADD }, {})) {
+        return 0;
+    }
+    if (!ggml_cuda_can_fuse(cgraph, inorm, { GGML_OP_RMS_NORM, GGML_OP_MUL }, {})) {
+        return 0;
+    }
+
+    const ggml_tensor * mul_src = nullptr;
+    if (mul->src[0] == norm) {
+        mul_src = mul->src[1];
+    } else if (mul->src[1] == norm) {
+        mul_src = mul->src[0];
+    } else {
+        return 0;
+    }
+    if (mul_src == nullptr || mul_src->type != GGML_TYPE_F32 ||
+            mul_src->nb[0] != ggml_type_size(mul_src->type)) {
+        return 0;
+    }
+    if (mul_src->ne[2] != 1 || mul_src->ne[3] != 1) {
+        return 0;
+    }
+
+    // 2D, non-broadcast add operands only
+    if (add_last->type != GGML_TYPE_F32 || add_last->ne[2] != 1 || add_last->ne[3] != 1) {
+        return 0;
+    }
+    if (!ggml_is_contiguous(add_last) || add_last->nb[0] != ggml_type_size(add_last->type)) {
+        return 0;
+    }
+    if (!ggml_cuda_rms_norm_pre_add_operand_ok(cgraph->nodes[i]->src[0], add_last)) {
+        return 0;
+    }
+    for (int k = 0; k < n_adds; ++k) {
+        const ggml_tensor * a = cgraph->nodes[i + k];
+        if (a->op != GGML_OP_ADD || !ggml_are_same_shape(a, add_last)) {
+            return 0;
+        }
+        if (!ggml_cuda_rms_norm_pre_add_operand_ok(a->src[1], add_last)) {
+            return 0;
+        }
+    }
+    // the norm output must not alias the stored add result: the kernel reads the
+    // add result back after writing it
+    if (!ggml_cuda_mmvq_ranges_disjoint(mul, add_last)) {
+        return 0;
+    }
+    if (!ggml_is_contiguous(mul) || !ggml_are_same_shape(mul, add_last)) {
+        return 0;
+    }
+    // and the intermediate norm result is never materialised, so nothing else
+    // may read it (guaranteed by ggml_cuda_can_fuse's single-use check)
+    return n_adds;
+}
